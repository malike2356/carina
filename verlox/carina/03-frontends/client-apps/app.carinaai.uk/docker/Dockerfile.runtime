# Runtime image for VPS: expects a pre-built Next.js standalone tree in the build
# context (server.js, .next/, node_modules/, public/). Build the app before
# `docker compose build carina-cloud`, e.g. via app.carinaai.uk/deploy.sh.
#
# Debian slim (not Alpine) so pip can install faster-whisper / ctranslate2 wheels
# for app-local voice transcription (CARINA_LOCAL_WHISPER=false skips the probe).
FROM node:22-bookworm-slim
WORKDIR /app
ARG BUILD_REVISION=unknown
ARG BUILD_TIME=unknown
ARG SOURCE_CONTENT_DIGEST=unknown
ENV NODE_ENV=production
ENV BUILD_REVISION=${BUILD_REVISION}
ENV BUILD_TIME=${BUILD_TIME}
ENV SOURCE_CONTENT_DIGEST=${SOURCE_CONTENT_DIGEST}
LABEL org.opencontainers.image.revision=${BUILD_REVISION}
LABEL uk.co.hireaiva.source-content-digest=${SOURCE_CONTENT_DIGEST}
ENV PORT=4100
ENV HOSTNAME=0.0.0.0
ENV CARINA_HOME=/app/data
RUN apt-get update \
  && apt-get install -y --no-install-recommends tini python3 python3-pip ffmpeg \
  && pip3 install --break-system-packages faster-whisper \
  && python3 -c "from faster_whisper import WhisperModel; print('faster-whisper ok')" \
  && mkdir -p /app/data/whisper-models \
  && rm -rf /var/lib/apt/lists/*
COPY server.js package.json ./
COPY .next ./.next
COPY public ./public
COPY node_modules ./node_modules
COPY src/lib/support ./src/lib/support
COPY src/lib/builtin-profiles ./src/lib/builtin-profiles
COPY content/legal ./content/legal
EXPOSE 4100
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "server.js"]
