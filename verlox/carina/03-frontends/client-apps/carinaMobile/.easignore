# Keep EAS upload under 2GB. Patterns match .gitignore style.

node_modules/
.pnpm-store/
.expo/
dist/
web-build/
.env
.env*.local
*.apk
*.aab
*.ipa
*.log
.git/
.turbo/
coverage/
**/*.tsbuildinfo

# Native build outputs (EAS regenerates / rebuilds these)
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/.cxx/
android/app/intermediates/
android/app/outputs/
ios/build/
ios/Pods/
ios/DerivedData/
**/build/
**/.gradle/
**/.cxx/
**/.kotlin/
**/intermediates/
**/outputs/

# Local model / heavy native artifacts if present outside node_modules
**/*.so
**/libreactnative.so

# Heavy local native build trees (must not upload)
android/app/build/
android/app/.cxx/
android/.gradle/
ios/Pods/
_qa-screenshots/
