<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <script>
    (function () {
      var p = window.location.pathname;
      if (p === '/business' || (p.indexOf('/business/') === 0 && p.indexOf('/business/_next/') !== 0)) {
        var rest = p === '/business' ? '/customers' : p.slice('/business'.length);
        window.location.replace('/business-inner' + rest + window.location.search + window.location.hash);
      }
    })();
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Carina Ops</title>
  <link rel="icon" href="/brand/carina-icon.png" type="image/png">
  <link rel="stylesheet" href="/theme/index.css?v=<%= typeof uiVersion !== 'undefined' ? uiVersion : '1' %>">
  <link rel="stylesheet" href="/styles.css?v=<%= typeof uiVersion !== 'undefined' ? uiVersion : '1' %>">
  <link rel="stylesheet" href="/ops-shell.css?v=<%= typeof uiVersion !== 'undefined' ? uiVersion : '10' %>">
</head>
<body class="ops-app">
  <button type="button" id="sidebar-toggle" class="sidebar-toggle" aria-label="Toggle menu" aria-expanded="false">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <aside id="sidebar" class="ops-sidebar">
    <div class="sidebar-logo">
      <a href="/" title="Carina Ops Dashboard">
        <img class="logo-mark" src="/brand/carina-logo.png" alt="" aria-hidden="true">
        <div>
          <div class="logo-name">Carina</div>
          <div class="logo-sub">Ops</div>
        </div>
      </a>
    </div>

    <div class="radar-wrap">
      <canvas id="ops-radar" width="86" height="86"></canvas>
    </div>

    <div class="nav-pinned">
      <% var ap = activePath || ''; %>
      <% function navOpen(paths) {
        for (var pi = 0; pi < paths.length; pi++) {
          var p = paths[pi];
          if (ap === p || ap.indexOf(p + '/') === 0) return true;
        }
        return false;
      } %>
      <a href="/" class="nav-link<%= ap === '/' ? ' active' : '' %>">Dashboard</a>
      <a href="<%= withV('/control-center') %>" class="nav-link<%= ap.startsWith('/control-center') ? ' active' : '' %>">Control Center</a>
      <a href="<%= withV('/scout') %>" class="nav-link scout-pinned<%= ap.startsWith('/scout') ? ' active' : '' %>">
        <span>Scout</span>
        <span id="scout-dot" class="status-dot"></span>
      </a>
      <a href="<%= withV('/trust') %>" class="nav-link trust-pinned<%= ap === '/trust' || ap === '/governance/trust' ? ' active' : '' %>">Blockchain Trust</a>
    </div>

    <div class="nav-scroll">
      <div class="nav-body">

        <details class="nav-group"<%= navOpen(['/business-inner/customers', '/business-inner/fleet', '/business-inner/va-queue', '/business-inner/revenue', '/business-inner/audit-log', '/business-inner/partners', '/business-inner/marketplace', '/business/customers', '/business/fleet', '/business/va-queue', '/business/revenue', '/business/audit-log', '/business/partners', '/business/marketplace']) ? ' open' : '' %>>
          <summary>Business</summary>
          <div class="nav-group-body">
            <a href="<%= withV('/business-inner/customers') %>" class="nav-link<%= ap.startsWith('/business-inner/customers') || ap.startsWith('/business/customers') ? ' active' : '' %>">Customers</a>
            <a href="<%= withV('/business-inner/fleet') %>" class="nav-link<%= ap.startsWith('/business-inner/fleet') || ap.startsWith('/business/fleet') ? ' active' : '' %>">Aiva Fleet</a>
            <a href="<%= withV('/business-inner/va-queue') %>" class="nav-link<%= ap.startsWith('/business-inner/va-queue') || ap.startsWith('/business/va-queue') ? ' active' : '' %>">VA Queue</a>
            <a href="<%= withV('/business-inner/revenue') %>" class="nav-link<%= ap.startsWith('/business-inner/revenue') || ap.startsWith('/business/revenue') ? ' active' : '' %>">Revenue</a>
            <a href="<%= withV('/business-inner/audit-log') %>" class="nav-link<%= ap.startsWith('/business-inner/audit-log') || ap.startsWith('/business/audit-log') ? ' active' : '' %>">Audit Log</a>
            <a href="<%= withV('/business-inner/partners') %>" class="nav-link<%= ap.startsWith('/business-inner/partners') || ap.startsWith('/business/partners') ? ' active' : '' %>">Partners</a>
            <a href="<%= withV('/business-inner/marketplace') %>" class="nav-link<%= ap.startsWith('/business-inner/marketplace') || ap.startsWith('/business/marketplace') ? ' active' : '' %>">Marketplace</a>
          </div>
        </details>

        <details class="nav-group"<%= navOpen(['/tenants', '/subscriptions', '/scout/accounts', '/pricing', '/billing-config', '/ai-usage', '/google-oauth', '/human-assist-bridge', '/usage-gates', '/spreadsheet-processor', '/admin/provision-business']) ? ' open' : '' %>>
          <summary>Fleet</summary>
          <div class="nav-group-body">
            <a href="<%= withV('/tenants') %>" class="nav-link<%= ap.startsWith('/tenants') ? ' active' : '' %>">All Tenants</a>
            <a href="<%= withV('/admin/provision-business') %>" class="nav-link<%= ap.startsWith('/admin/provision-business') ? ' active' : '' %>">Provision Business</a>
