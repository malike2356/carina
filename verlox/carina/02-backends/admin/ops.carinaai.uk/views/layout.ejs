            <a href="<%= withV('/billing-config') %>" class="nav-link<%= ap.startsWith('/billing-config') ? ' active' : '' %>">Billing and launch config</a>
            <a href="<%= withV('/pricing') %>" class="nav-link<%= ap.startsWith('/pricing') ? ' active' : '' %>">Platform Pricing</a>
            <a href="<%= withV('/subscriptions') %>" class="nav-link<%= ap.startsWith('/subscriptions') ? ' active' : '' %>">Subscriptions</a>
            <a href="<%= withV('/usage-gates') %>" class="nav-link<%= ap.startsWith('/usage-gates') ? ' active' : '' %>">Free usage gates</a>
            <a href="<%= withV('/google-oauth') %>" class="nav-link<%= ap.startsWith('/google-oauth') ? ' active' : '' %>">Google OAuth</a>
            <a href="<%= withV('/human-assist-bridge') %>" class="nav-link<%= ap.startsWith('/human-assist-bridge') ? ' active' : '' %>">Human assist bridge</a>
            <a href="<%= withV('/spreadsheet-processor') %>" class="nav-link<%= ap.startsWith('/spreadsheet-processor') ? ' active' : '' %>">Spreadsheet Processor</a>
            <a href="<%= withV('/scout/accounts') %>" class="nav-link<%= ap.startsWith('/scout/accounts') ? ' active' : '' %>">Scout Accounts</a>
          </div>
        </details>

        <details class="nav-group"<%= navOpen(['/operator']) ? ' open' : '' %>>
