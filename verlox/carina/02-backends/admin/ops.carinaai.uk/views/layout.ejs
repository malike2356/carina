          <div class="nav-group-body">
            <a href="<%= withV('/operator') %>" class="nav-link<%= ap === '/operator' ? ' active' : '' %>">Overview</a>
            <a href="<%= withV('/operator/status') %>" class="nav-link<%= ap === '/operator/status' ? ' active' : '' %>">Status</a>
            <a href="<%= withV('/operator/pending') %>" class="nav-link<%= ap.startsWith('/operator/pending') || ap.startsWith('/operator/learning/pending') ? ' active' : '' %>">Pending Review</a>
