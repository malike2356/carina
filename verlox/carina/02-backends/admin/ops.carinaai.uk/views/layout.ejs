  <main class="ops-main">
    <div class="ops-content">
      <%- body %>
    </div>
  </main>

  <!-- Ops Assistant floating chat -->
  <div id="ops-assist" class="opsai-wrap">
    <button type="button" id="opsai-fab" class="opsai-fab" aria-label="Open Ops Assistant" title="Ops Assistant">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        <path d="M8 10h.01M12 10h.01M16 10h.01"/>
      </svg>
    </button>
    <div id="opsai-panel" class="opsai-panel" style="display:none;">
      <div class="opsai-header">
        <div class="opsai-header-text">
          <span class="opsai-title">Ops Assistant</span>
          <span class="opsai-sub">Ask anything about this panel</span>
        </div>
        <button type="button" id="opsai-close" class="opsai-close" aria-label="Close">&times;</button>
      </div>
      <div id="opsai-messages" class="opsai-messages"></div>
      <form id="opsai-form" class="opsai-input-wrap" autocomplete="off">
        <input type="text" id="opsai-input" class="opsai-input" placeholder="Ask about this page..." />
        <button type="submit" id="opsai-send" class="opsai-send" aria-label="Send">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </form>
    </div>
  </div>
  <style>
    .opsai-wrap { position: fixed; bottom: 20px; right: 20px; z-index: 9999; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .opsai-fab {
      width: 50px; height: 50px; border-radius: 50%; border: none;
      background: linear-gradient(135deg, #7c3aed, #3b82f6);
      color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 20px rgba(124,58,237,0.35);
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .opsai-fab:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(124,58,237,0.45); }
    .opsai-fab.hidden { display: none; }
    .opsai-panel {
      position: absolute; bottom: 60px; right: 0;
      width: 380px; max-height: 520px;
      border-radius: 14px; overflow: hidden;
      background: #0f1219; border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 16px 48px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05);
      display: flex; flex-direction: column;
    }
    .opsai-header {
      display: flex; align-items: center; padding: 14px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      background: rgba(255,255,255,0.02);
    }
    .opsai-header-text { flex: 1; }
    .opsai-title { display: block; font-size: 0.85rem; font-weight: 700; color: #f1f5f9; }
    .opsai-sub { display: block; font-size: 0.68rem; color: #64748b; margin-top: 1px; }
    .opsai-close { background: none; border: none; color: #64748b; font-size: 22px; cursor: pointer; padding: 4px 8px; border-radius: 6px; line-height: 1; }
    .opsai-close:hover { color: #f1f5f9; background: rgba(255,255,255,0.06); }
    .opsai-messages {
      flex: 1; overflow-y: auto; padding: 14px 16px;
      min-height: 260px; max-height: 360px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .opsai-msg { padding: 10px 14px; border-radius: 10px; font-size: 0.78rem; line-height: 1.55; max-width: 92%; word-wrap: break-word; white-space: pre-wrap; }
    .opsai-msg-user { background: rgba(59,130,246,0.12); color: #93c5fd; align-self: flex-end; border-bottom-right-radius: 4px; }
    .opsai-msg-ai { background: rgba(255,255,255,0.04); color: #e2e8f0; align-self: flex-start; border-bottom-left-radius: 4px; }
    .opsai-msg-err { background: rgba(239,68,68,0.08); color: #fca5a5; align-self: flex-start; }
    .opsai-typing { color: #64748b; font-size: 0.72rem; font-style: italic; padding: 4px 14px; }
    .opsai-input-wrap {
      display: flex; align-items: center; padding: 10px 12px;
      border-top: 1px solid rgba(255,255,255,0.06);
      background: rgba(0,0,0,0.2);
    }
    .opsai-input {
      flex: 1; padding: 9px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.03); color: #f1f5f9; font-size: 0.78rem; outline: none;
      transition: border-color 0.15s;
    }
    .opsai-input:focus { border-color: rgba(124,58,237,0.5); }
    .opsai-input::placeholder { color: #475569; }
    .opsai-send {
      margin-left: 8px; width: 34px; height: 34px; border-radius: 8px;
      border: none; background: linear-gradient(135deg, #7c3aed, #6d28d9);
      color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: opacity 0.15s;
    }
    .opsai-send:hover { opacity: 0.85; }
    .opsai-send:disabled { opacity: 0.4; cursor: not-allowed; }
    @media (max-width: 480px) {
      .opsai-panel { width: calc(100vw - 32px); right: -4px; bottom: 56px; max-height: 70vh; }
    }
  </style>

  <script>
    // Mobile sidebar toggle
    (function() {
      var btn = document.getElementById('sidebar-toggle');
      var sidebar = document.getElementById('sidebar');
      if (!btn || !sidebar) return;

      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = sidebar.classList.toggle('sidebar-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      sidebar.addEventListener('click', function(e) {
        var t = e.target;
        if (t && t.tagName === 'A' && window.innerWidth <= 900) {
          sidebar.classList.remove('sidebar-open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('click', function(e) {
        if (window.innerWidth > 900) return;
        if (!sidebar.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
          sidebar.classList.remove('sidebar-open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    })();

    // Scout live status
    (function() {
      var dot = document.getElementById('scout-dot');
      var lbl = document.getElementById('scout-label');
      if (!dot || !lbl) return;
      fetch('/security/events', { credentials: 'same-origin' })
        .then(function(r) {
          dot.className = r.ok ? 'status-dot live' : 'status-dot dead';
          lbl.textContent = r.ok ? 'Scout live' : 'Scout offline';
          if (r.ok) lbl.style.color = '#00c864';
        })
        .catch(function() {
          dot.className = 'status-dot dead';
          lbl.textContent = 'Scout offline';
        });
    })();

    // Nav group accordion: single-open + scroll to eye level
    (function() {
      var groups = Array.prototype.slice.call(document.querySelectorAll('.nav-group'));
      groups.forEach(function(group) {
        group.addEventListener('toggle', function() {
          if (!group.open) return;
          groups.forEach(function(other) {
            if (other !== group && other.open) other.removeAttribute('open');
          });
          requestAnimationFrame(function() {
            group.scrollIntoView({ block: 'start', behavior: 'smooth' });
          });
        });
      });
    })();

    // Ops Assistant chat widget
    (function() {
      var fab = document.getElementById('opsai-fab');
      var panel = document.getElementById('opsai-panel');
      var closeBtn = document.getElementById('opsai-close');
      var form = document.getElementById('opsai-form');
      var input = document.getElementById('opsai-input');
      var msgBox = document.getElementById('opsai-messages');
      var sendBtn = document.getElementById('opsai-send');
      if (!fab || !panel || !form || !input || !msgBox) return;

      var messages = [];
      var isOpen = false;
      var busy = false;

      function toggle() {
        isOpen = !isOpen;
        panel.style.display = isOpen ? 'flex' : 'none';
        fab.classList.toggle('hidden', isOpen);
        if (isOpen && !messages.length) {
          addMsg('ai', 'Hi! I am your Ops Assistant. Ask me about any page, feature, or configuration in this panel. I know the entire system.');
        }
        if (isOpen) input.focus();
      }

      fab.addEventListener('click', toggle);
      closeBtn.addEventListener('click', toggle);

      function addMsg(role, text) {
        var el = document.createElement('div');
        el.className = 'opsai-msg opsai-msg-' + role;
        el.textContent = text;
        msgBox.appendChild(el);
        msgBox.scrollTop = msgBox.scrollHeight;
        if (role === 'user' || role === 'ai') {
          messages.push({ role: role === 'ai' ? 'assistant' : 'user', content: text });
        }
        return el;
      }

      function setTyping(show) {
        var existing = msgBox.querySelector('.opsai-typing');
        if (show && !existing) {
          var t = document.createElement('div');
          t.className = 'opsai-typing';
          t.textContent = 'Thinking...';
          msgBox.appendChild(t);
          msgBox.scrollTop = msgBox.scrollHeight;
        } else if (!show && existing) {
          existing.remove();
        }
      }

      async function sendMessage(text) {
        if (busy || !text.trim()) return;
        busy = true;
        sendBtn.disabled = true;
        addMsg('user', text.trim());
        input.value = '';
        setTyping(true);

        try {
          var resp = await fetch('/ops-assistant/chat', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              messages: messages.filter(function(m) { return m.role === 'user' || m.role === 'assistant'; }),
              currentPage: window.location.pathname,
            }),
          });

          setTyping(false);

          if (!resp.ok) {
            var errData = await resp.json().catch(function() { return {}; });
            addMsg('err', errData.error || 'Request failed (' + resp.status + ')');
            busy = false;
            sendBtn.disabled = false;
            return;
          }

          var aiEl = addMsg('ai', '');
          var reader = resp.body.getReader();
          var decoder = new TextDecoder();
          var buffer = '';
          var fullText = '';

          while (true) {
            var result = await reader.read();
            if (result.done) break;
            buffer += decoder.decode(result.value, { stream: true });
            var lines = buffer.split('\n');
            buffer = lines.pop() || '';
            for (var li = 0; li < lines.length; li++) {
              var line = lines[li].trim();
              if (!line.startsWith('data: ')) continue;
              var payload = line.slice(6);
              if (payload === '[DONE]') continue;
              try {
                var parsed = JSON.parse(payload);
                var delta = parsed.choices && parsed.choices[0] && parsed.choices[0].delta;
                if (delta && delta.content) {
                  fullText += delta.content;
                  aiEl.textContent = fullText;
                  msgBox.scrollTop = msgBox.scrollHeight;
                }
              } catch (e) {}
            }
          }
          messages[messages.length - 1].content = fullText;
        } catch (err) {
          setTyping(false);
          addMsg('err', 'Connection error: ' + (err.message || err));
        }
        busy = false;
        sendBtn.disabled = false;
        input.focus();
      }

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        sendMessage(input.value);
      });
    })();

    // Platform activity radar
    (function() {
      var canvas = document.getElementById('ops-radar');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var W = canvas.width, H = canvas.height;
      var cx = W / 2, cy = H / 2;
      var r = Math.min(cx, cy) - 5;
      var sweep = 0;
      var dots = [];
      var lastDot = Date.now();

      for (var i = 0; i < 3; i++) {
        dots.push({ a: Math.random() * Math.PI * 2, d: 0.25 + Math.random() * 0.65, born: Date.now() - Math.random() * 9000 });
      }

      function frame() {
        ctx.clearRect(0, 0, W, H);
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0,200,100,0.02)'; ctx.fill();
        [0.33, 0.66, 1.0].forEach(function(f) {
          ctx.beginPath(); ctx.arc(cx, cy, r * f, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(0,200,100,0.07)'; ctx.lineWidth = 1; ctx.stroke();
        });
        ctx.strokeStyle = 'rgba(0,200,100,0.05)'; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(cx, cy - r); ctx.lineTo(cx, cy + r); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx - r, cy); ctx.lineTo(cx + r, cy); ctx.stroke();
        var span = Math.PI * 0.55;
        for (var ti = 0; ti < 28; ti++) {
          var ta = sweep - (span / 28) * ti;
          ctx.beginPath(); ctx.moveTo(cx, cy); ctx.arc(cx, cy, r, ta, ta + span / 28); ctx.closePath();
          ctx.fillStyle = 'rgba(0,200,100,' + ((1 - ti / 28) * 0.14) + ')'; ctx.fill();
        }
        ctx.beginPath(); ctx.moveTo(cx, cy);
        ctx.lineTo(cx + Math.cos(sweep) * r, cy + Math.sin(sweep) * r);
        ctx.strokeStyle = 'rgba(0,200,100,0.6)'; ctx.lineWidth = 1.5; ctx.stroke();
        var now = Date.now();
        var keep = [];
        for (var di = 0; di < dots.length; di++) {
          if (now - dots[di].born < 13000) keep.push(dots[di]);
        }
        dots = keep;
        for (var di2 = 0; di2 < dots.length; di2++) {
          var d = dots[di2];
          var age = (now - d.born) / 13000;
          ctx.beginPath();
          ctx.arc(cx + Math.cos(d.a) * r * d.d, cy + Math.sin(d.a) * r * d.d, 2.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(0,200,100,' + (1 - age).toFixed(2) + ')'; ctx.fill();
        }
        if (now - lastDot > 3500) {
          dots.push({ a: Math.random() * Math.PI * 2, d: 0.2 + Math.random() * 0.72, born: now });
          lastDot = now;
        }
        sweep += 0.016;
        if (sweep > Math.PI * 2) sweep -= Math.PI * 2;
        requestAnimationFrame(frame);
      }
      frame();
    })();
  </script>
</body>
</html>
