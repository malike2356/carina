<% title = 'Billing and launch config' %>
<%
  const groups = ['aiva', 'integrations', 'support', 'scout', 'carina_ops', 'addons', 'keys_server'];
  const chipLabels = {
    aiva: 'Aiva',
    integrations: 'Integrations',
    support: 'Support',
    scout: 'Scout',
    carina_ops: 'Carina',
    addons: 'Add-ons',
    keys_server: 'Keys',
  };
  const groupNotes = {
    aiva: 'Price IDs, trial message cap, and quiet prepaid top-up prices.',
    integrations: 'Stripe, Paddle, Resend, and Cloudflare credentials.',
    support: 'Support readiness metadata. DNS/MX stays at your provider.',
    scout: 'Scout plan price IDs.',
    carina_ops: 'Internal platform billing. Leave empty unless sold.',
    addons: 'Legacy top-ups and metered add-ons.',
    keys_server: 'Visibility only until keys-server reads this table.',
  };
  const availableGroups = groups.filter(function(g) {
    return (grouped[g] || []).length > 0;
  });
  let activeGroup = typeof group === 'string' ? group : '';
  if (availableGroups.indexOf(activeGroup) === -1) {
    activeGroup = availableGroups.indexOf('aiva') !== -1
      ? 'aiva'
      : (availableGroups[0] || 'aiva');
  }
  function unsetCount(rows) {
    return rows.filter(function(row) { return !row.effectiveValue; }).length;
  }
%>
<div class="ops-page billing-config-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Billing and launch config</div>
      <div class="ops-page-sub">
        Save here; Core reloads immediately. Env vars are fallbacks only.
      </div>
    </div>
  </div>

  <% if (saved) { %>
    <div class="ops-flash ok">Value saved. Core reloaded billing clients.</div>
  <% } %>
  <% if (cleared) { %>
    <div class="ops-flash ok">Database override cleared. Core will use the env var fallback if set.</div>
  <% } %>
  <% if (bulkSaved) { %>
    <div class="ops-flash ok">Bulk import saved <%= bulkSaved %> key(s)<% if (bulkSkipped) { %>; skipped <%= bulkSkipped %><% } %>.</div>
  <% } %>
  <% if (reloadWarn) { %>
    <div class="ops-flash err">Saved to database but Core reload failed. Values still apply within ~30 seconds, or retry when Core is reachable.</div>
  <% } %>
  <% if (errMsg) { %>
    <div class="ops-flash err"><%= errMsg %></div>
  <% } %>

  <details class="ops-surface billing-config-paste">
    <summary class="billing-config-paste__summary">Paste credential bundle</summary>
    <div class="billing-config-paste__body">
      <p class="ops-section-note">
        One <code class="ops-code">KEY=value</code> per line. Only keys listed below are imported.
      </p>
      <form method="post" action="<%= withV('/billing-config/bulk') %>">
        <input type="hidden" name="group" value="<%= activeGroup %>">
        <textarea
          name="bundle"
          class="ops-input"
          rows="5"
          placeholder="STRIPE_SECRET_KEY=sk_live_...&#10;STRIPE_WEBHOOK_SECRET=whsec_..."
        ></textarea>
        <div class="billing-config-paste__actions">
          <button type="submit" class="ops-btn ops-btn-green">Import and reload Core</button>
        </div>
      </form>
    </div>
  </details>

  <nav class="ops-subnav billing-config-nav" aria-label="Config groups">
    <% availableGroups.forEach(function(groupKey) {
      const groupRows = grouped[groupKey] || [];
      const unset = unsetCount(groupRows);
      const href = withV('/billing-config?group=' + encodeURIComponent(groupKey));
    %>
      <a
        href="<%= href %>"
        class="ops-subnav-link<%= activeGroup === groupKey ? ' active' : '' %>"
      >
        <%= chipLabels[groupKey] || groupLabels[groupKey] %>
        <% if (unset > 0) { %>
          <span class="billing-config-nav__unset"><%= unset %> unset</span>
        <% } %>
      </a>
    <% }); %>
  </nav>

  <% const activeRows = grouped[activeGroup] || []; %>
  <%
    // Sub-section classification for better readability
    function rowSection(row) {
      var k = row.key || '';
      if (k.indexOf('SOFT_WALL') !== -1 || k.indexOf('TRIAL_') !== -1 || k.indexOf('DAILY_CAP') !== -1 || k.indexOf('PAID_DAILY') !== -1 || k.indexOf('DEFAULT_MODEL') !== -1 || k.indexOf('MARGIN_FLOOR') !== -1) return 'controls';
      if (k.indexOf('PREPAID') !== -1) return 'topups';
      if (k.indexOf('STRIPE_PRICE') !== -1 || k.indexOf('PADDLE_PRICE') !== -1 || k.indexOf('SEAT_') !== -1) return 'pricing';
      return 'other';
    }
    var sectionLabels = {
      controls: 'Usage controls',
      pricing: 'Subscription price IDs (set once)',
      topups: 'Prepaid top-up prices (set once)',
      other: 'Other'
    };
    var sectionDescriptions = {
      controls: 'These directly affect what trial and paid users can do. Change anytime.',
      pricing: 'Stripe/Paddle price IDs. Set these once when you create prices; rarely change after.',
      topups: 'Linked to the in-app credit top-up buttons.',
      other: ''
    };
    var sectionOrder = ['controls', 'other', 'topups', 'pricing'];
    var rowsBySection = {};
    activeRows.forEach(function(row) {
      var sec = (activeGroup === 'aiva') ? rowSection(row) : 'other';
      if (!rowsBySection[sec]) rowsBySection[sec] = [];
      rowsBySection[sec].push(row);
    });
  %>
  <section class="ops-surface billing-config-panel">
    <div class="billing-config-panel__head">
      <h2 class="ops-section-title"><%= groupLabels[activeGroup] || activeGroup %></h2>
      <% if (groupNotes[activeGroup]) { %>
        <p class="ops-section-note"><%= groupNotes[activeGroup] %></p>
      <% } %>
    </div>

    <% sectionOrder.forEach(function(sec) {
      var secRows = rowsBySection[sec];
      if (!secRows || secRows.length === 0) return;
      var showSubHead = (activeGroup === 'aiva' && sec !== 'other');
    %>
      <% if (showSubHead) { %>
        <div class="billing-config-subhead" style="margin: 1.5rem 0 0.5rem; padding: 0.5rem 0; border-top: 1px solid var(--border, #333);">
          <h3 style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary, #aaa); margin: 0;">
            <%= sectionLabels[sec] || sec %>
          </h3>
          <% if (sectionDescriptions[sec]) { %>
            <p style="font-size: 0.72rem; color: var(--text-muted, #777); margin: 0.25rem 0 0;">
              <%= sectionDescriptions[sec] %>
            </p>
          <% } %>
        </div>
      <% } %>

    <div class="billing-config-rows">
      <% secRows.forEach(function(row) {
        const isSecret = row.valueKind === 'secret';
        const isEnum = row.valueKind === 'enum' && row.enumOptions && row.enumOptions.length;
        const inputValue = isSecret ? row.maskedValue : row.value;
      %>
        <div class="billing-config-row">
          <div class="billing-config-row__meta">
            <div class="billing-config-row__label">
              <strong><%= row.label %></strong>
              <% if (row.interval === 'annual') { %>
                <span class="ops-badge ops-badge-gray">Annual</span>
              <% } else if (row.interval === 'monthly') { %>
                <span class="ops-badge ops-badge-gray">Monthly</span>
              <% } %>
            </div>
            <code class="ops-code billing-config-row__key"><%= row.key %></code>
          </div>

          <div class="billing-config-row__status">
            <% if (row.source === 'database') { %>
              <span class="ops-badge ops-badge-green">Database</span>
            <% } else if (row.source === 'env') { %>
              <span class="ops-badge">Env</span>
            <% } else { %>
              <span class="ops-badge ops-badge-gray">Unset</span>
            <% } %>
          </div>

          <div class="billing-config-row__edit">
            <form method="post" action="<%= withV('/billing-config/update') %>" class="billing-config-row__form">
              <input type="hidden" name="key" value="<%= row.key %>">
              <input type="hidden" name="group" value="<%= activeGroup %>">
              <% if (isEnum) { %>
                <select name="value" class="ops-input ops-input--sm">
                  <option value="">(clear)</option>
                  <% row.enumOptions.forEach(function(opt) { %>
                    <option value="<%= opt %>"<%= row.value === opt ? ' selected' : '' %>><%= opt %></option>
                  <% }); %>
                </select>
              <% } else { %>
                <input
                  type="<%= isSecret ? 'password' : 'text' %>"
                  name="value"
                  value="<%= inputValue %>"
                  placeholder="<%= row.effectiveValue ? '' : (row.placeholder || row.envFallback || 'Enter value') %>"
                  class="ops-input ops-input--sm"
                  spellcheck="false"
                  autocomplete="off"
                  <% if (isSecret && row.effectiveValue) { %>title="Configured; enter a new value to replace"<% } %>
                >
              <% } %>
              <button type="submit" class="ops-btn ops-btn-green ops-btn-sm">Save</button>
            </form>
            <% if (row.value) { %>
              <form method="post" action="<%= withV('/billing-config/update') %>" class="billing-config-row__clear">
                <input type="hidden" name="key" value="<%= row.key %>">
                <input type="hidden" name="group" value="<%= activeGroup %>">
                <input type="hidden" name="value" value="">
                <button type="submit" class="billing-config-clear-link">Clear DB override</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
    <% }); %>
  </section>
</div>
