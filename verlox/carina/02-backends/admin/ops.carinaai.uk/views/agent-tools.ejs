<% title = 'Agent Tools' %>
<style>
  .at-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 28px 24px;
  }

  /* Header */
  .at-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .at-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(59,130,246,0.14), rgba(34,197,94,0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .at-icon svg { width: 20px; height: 20px; color: #60a5fa; }
  .at-header-text h1 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }
  .at-header-text p {
    margin: 3px 0 0;
    font-size: 0.78rem;
    color: #94a3b8;
  }
  .at-header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .at-tenant-input {
    padding: 7px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(0,0,0,0.25);
    color: #f1f5f9;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', 'SF Mono', monospace;
    width: 180px;
    outline: none;
    transition: border-color 0.15s;
  }
  .at-tenant-input:focus { border-color: rgba(59,130,246,0.5); }
  .at-tenant-input::placeholder { color: #475569; }
  .at-tenant-btn {
    padding: 7px 14px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
    color: #cbd5e1;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .at-tenant-btn:hover { background: rgba(255,255,255,0.08); color: #f1f5f9; }

  /* Flash */
  .at-flash {
    margin-bottom: 16px;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.78rem;
  }
  .at-flash.ok { background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.25); color: #86efac; }
  .at-flash.err { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25); color: #fca5a5; }

  /* Tool grid */
  .at-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
    margin-bottom: 28px;
  }
  .at-card {
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.02);
    padding: 16px 18px;
    transition: border-color 0.15s;
  }
  .at-card:hover { border-color: rgba(255,255,255,0.12); }
  .at-card.is-off { opacity: 0.6; }
  .at-card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .at-card-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #f1f5f9;
  }
  .at-card-code {
    margin-left: auto;
    font-size: 0.62rem;
    font-family: 'JetBrains Mono', monospace;
    color: #475569;
    background: rgba(255,255,255,0.04);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .at-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .at-badge-on { background: rgba(34,197,94,0.12); color: #4ade80; }
  .at-badge-off { background: rgba(148,163,184,0.08); color: #64748b; }
  .at-badge-approval { background: rgba(251,191,36,0.1); color: #fbbf24; }
  .at-card-desc {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.4;
    margin-bottom: 12px;
  }
  .at-card-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .at-field label {
    display: block;
    font-size: 0.62rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 3px;
  }
  .at-field select,
  .at-field input {
    width: 100%;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(0,0,0,0.2);
    color: #e2e8f0;
    font-size: 0.75rem;
    outline: none;
    transition: border-color 0.15s;
  }
  .at-field select:focus,
  .at-field input:focus { border-color: rgba(59,130,246,0.4); }
  .at-card-save {
    grid-column: 1 / -1;
    margin-top: 4px;
  }
  .at-card-save button {
    width: 100%;
    padding: 7px;
    border-radius: 6px;
    border: none;
    background: rgba(34,197,94,0.12);
    color: #4ade80;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .at-card-save button:hover { background: rgba(34,197,94,0.2); }

  /* Log section */
  .at-log {
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.02);
    padding: 18px 20px;
  }
  .at-log-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: #e2e8f0;
    margin: 0 0 12px;
  }
  .at-log table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
  }
  .at-log th {
    text-align: left;
    font-size: 0.65rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 6px 10px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .at-log td {
    padding: 8px 10px;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }
  .at-log tr:last-child td { border-bottom: none; }
  .at-log-mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: #94a3b8;
  }
  .at-log-empty {
    text-align: center;
    padding: 20px;
    color: #64748b;
    font-size: 0.78rem;
  }
  .at-log-status {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.62rem;
    font-weight: 600;
  }
  .at-log-status-ok { background: rgba(34,197,94,0.1); color: #4ade80; }
  .at-log-status-err { background: rgba(239,68,68,0.1); color: #f87171; }

  @media (max-width: 640px) {
    .at-page { padding: 16px 12px; }
    .at-header { flex-wrap: wrap; }
    .at-header-actions { margin-left: 0; width: 100%; margin-top: 10px; }
    .at-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="at-page">
  <header class="at-header">
    <div class="at-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    </div>
    <div class="at-header-text">
      <h1>Agent Tools</h1>
      <p>Global tool category config for all hosted workspaces. Override per tenant below.</p>
    </div>
    <form class="at-header-actions" method="get" action="/admin/agent-tools/tenant/" onsubmit="event.preventDefault(); var v = this.workspaceId.value.trim(); if (v) window.location.href = '/admin/agent-tools/tenant/' + encodeURIComponent(v);">
      <input name="workspaceId" placeholder="Workspace ID..." class="at-tenant-input" />
      <button type="submit" class="at-tenant-btn">Open tenant</button>
    </form>
  </header>

  <% if (message) { %>
    <div class="at-flash <%= messageIsError ? 'err' : 'ok' %>"><%= message %></div>
  <% } %>

  <div class="at-grid">
    <% categories.forEach((cat) => { %>
      <div class="at-card<%= cat.enabled ? '' : ' is-off' %>">
        <div class="at-card-head">
          <span class="at-badge <%= cat.enabled ? 'at-badge-on' : 'at-badge-off' %>"><%= cat.enabled ? 'On' : 'Off' %></span>
          <% if (cat.requiresApproval) { %><span class="at-badge at-badge-approval">Approval</span><% } %>
          <span class="at-card-code"><%= cat.category %></span>
        </div>
        <div class="at-card-name"><%= cat.label %></div>
        <% if (cat.description) { %><div class="at-card-desc"><%= cat.description %></div><% } %>
        <form method="post" action="/admin/agent-tools/<%= encodeURIComponent(cat.category) %>">
          <div class="at-card-form">
            <div class="at-field">
              <label>Status</label>
              <select name="enabled">
                <option value="true" <%= cat.enabled ? 'selected' : '' %>>Enabled</option>
                <option value="false" <%= !cat.enabled ? 'selected' : '' %>>Disabled</option>
              </select>
            </div>
            <div class="at-field">
              <label>Approval</label>
              <select name="requiresApproval">
                <option value="false" <%= !cat.requiresApproval ? 'selected' : '' %>>No</option>
                <option value="true" <%= cat.requiresApproval ? 'selected' : '' %>>Yes</option>
              </select>
            </div>
            <div class="at-field">
              <label>Max calls/msg</label>
              <input type="number" name="maxCalls" value="<%= cat.maxCalls %>" min="1" max="50" />
            </div>
            <div class="at-field">
              <label>Timeout (ms)</label>
              <input type="number" name="timeoutMs" value="<%= cat.timeoutMs %>" min="1000" max="120000" step="1000" />
            </div>
            <div class="at-card-save"><button type="submit">Save</button></div>
          </div>
        </form>
      </div>
    <% }) %>
  </div>

  <div class="at-log">
    <h2 class="at-log-title">Recent tool calls</h2>
    <% if (!log?.length) { %>
      <div class="at-log-empty">No tool calls recorded yet.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Time</th><th>Tool</th><th>Workspace</th><th>Status</th></tr></thead>
        <tbody>
          <% log.forEach((call) => { %>
            <tr>
              <td><%= new Date(call.createdAt).toLocaleString() %></td>
              <td><%= call.toolName %></td>
              <td class="at-log-mono"><%= call.workspaceId?.slice(0, 8) || '-' %>...</td>
              <td><span class="at-log-status <%= (call.status === 'error' || call.status === 'failed') ? 'at-log-status-err' : 'at-log-status-ok' %>"><%= call.status || '-' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
