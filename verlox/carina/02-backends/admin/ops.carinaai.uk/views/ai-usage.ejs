<% title = 'AI usage' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">AI usage</div>
      <div class="ops-page-sub">Provider cost, BYOK separation, cache savings, and margin health for the last <%= days %> days.</div>
    </div>
    <div class="ops-toolbar-actions">
      <a class="ops-btn" href="/ai-usage?days=7">7 days</a>
      <a class="ops-btn" href="/ai-usage?days=30">30 days</a>
      <a class="ops-btn" href="/ai-usage?days=90">90 days</a>
    </div>
  </div>

  <% if (saved) { %>
    <div class="ops-empty" style="border-color:rgba(34,197,94,0.55);color:#bbf7d0;background:#052e16;">AI usage pricing settings saved.</div>
  <% } %>
  <div class="ops-surface" style="margin-bottom:16px;border-color:rgba(20,184,166,0.45);">
    <div class="ops-section-title">Pricing controls</div>
    <p class="ops-inline-note" style="color:#d7e5ee;max-width:760px;">
      Configure the commercial add-ons used by the AI usage ledger. These values affect new usage records only; old records keep the rates used when they were written.
    </p>
    <form method="post" action="/ai-usage/pricing" style="display:grid;grid-template-columns:repeat(3,minmax(160px,1fr));gap:14px;align-items:end;margin-top:14px;">
      <input type="hidden" name="days" value="<%= days %>">
      <label style="display:grid;gap:6px;color:#f8fafc;font-weight:700;">
        Payment fee buffer (%)
        <input
          class="ops-input"
          name="paymentOverheadPercent"
          type="number"
          min="0"
          max="100"
          step="0.01"
          value="<%= percent(summary.pricingConfig.paymentOverheadRate) %>"
          style="background:#07131f;color:#ffffff;border:1px solid #5eead4;"
        >
      </label>
      <label style="display:grid;gap:6px;color:#f8fafc;font-weight:700;">
        Platform margin (%)
        <input
          class="ops-input"
          name="platformMarginPercent"
          type="number"
          min="0"
          max="100"
          step="0.01"
          value="<%= percent(summary.pricingConfig.platformMarginRate) %>"
          style="background:#07131f;color:#ffffff;border:1px solid #5eead4;"
        >
      </label>
      <button class="ops-btn primary" type="submit" style="min-height:42px;">Save pricing</button>
    </form>
    <div class="ops-inline-note" style="margin-top:10px;color:#cbd5e1;">
      Current: <strong style="color:#ffffff;"><%= percent(summary.pricingConfig.paymentOverheadRate) %>%</strong> fee buffer,
      <strong style="color:#ffffff;"><%= percent(summary.pricingConfig.platformMarginRate) %>%</strong> platform margin.
      <% if (summary.pricingConfig.updatedAt) { %>
        Last updated <%= new Date(summary.pricingConfig.updatedAt).toLocaleString('en-GB') %><% if (summary.pricingConfig.updatedBy) { %> by <%= summary.pricingConfig.updatedBy %><% } %>.
      <% } %>
    </div>
  </div>

  <% if (!summary.ready) { %>
    <div class="ops-empty">Usage ledger is not ready yet. It will appear after the first routed model call writes `ai_usage_ledger`.</div>
  <% } else { %>
    <div class="ops-metrics">
      <div class="ops-metric"><div class="ops-metric-label">Calls</div><div class="ops-metric-value"><%= summary.totals.calls.toLocaleString() %></div></div>
      <div class="ops-metric"><div class="ops-metric-label">Tokens</div><div class="ops-metric-value"><%= summary.totals.tokens.toLocaleString() %></div></div>
      <div class="ops-metric"><div class="ops-metric-label">Provider cost</div><div class="ops-metric-value warn"><%= money(summary.totals.providerCostMinor) %></div></div>
      <div class="ops-metric"><div class="ops-metric-label">Internal basis</div><div class="ops-metric-value ok"><%= money(summary.totals.internalChargeBasisMinor) %></div></div>
      <div class="ops-metric"><div class="ops-metric-label">Fee buffer</div><div class="ops-metric-value"><%= money(summary.totals.paymentOverheadMinor) %></div></div>
      <div class="ops-metric"><div class="ops-metric-label">Platform margin</div><div class="ops-metric-value"><%= money(summary.totals.platformMarginMinor) %></div></div>
      <div class="ops-metric"><div class="ops-metric-label">BYOK calls</div><div class="ops-metric-value"><%= summary.totals.byokCalls.toLocaleString() %></div></div>
      <div class="ops-metric"><div class="ops-metric-label">Saved tokens</div><div class="ops-metric-value ok"><%= (summary.totals.cachedTokens + summary.totals.optimizedTokensSaved).toLocaleString() %></div></div>
    </div>

    <% if (summary.alerts.length) { %>
      <div class="ops-section" style="margin-bottom:16px;">
        <div class="ops-section-title">Alerts</div>
        <% for (const alert of summary.alerts) { %>
          <div class="ops-empty" style="border-color:rgba(255,34,68,0.35);color:#ff6080;"><%= alert.message %></div>
        <% } %>
      </div>
    <% } %>

    <div class="ops-surface ops-grid-surface ops-grid ops-grid-3" style="margin-bottom:16px;">
      <div class="ops-section">
        <div class="ops-section-title">Provider cost</div>
        <table class="ops-table">
          <thead><tr><th>Provider</th><th>Calls</th><th>Cost</th></tr></thead>
          <tbody>
            <% for (const row of summary.byProvider) { %>
              <tr>
                <td><%= row.provider %><div class="ops-inline-note"><%= row.model %></div></td>
                <td><%= row.calls.toLocaleString() %></td>
                <td><%= money(row.providerCostMinor) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="ops-section">
        <div class="ops-section-title">Tier mix</div>
        <table class="ops-table">
          <thead><tr><th>Tier</th><th>Calls</th><th>Tokens</th></tr></thead>
          <tbody>
            <% for (const row of summary.byTier) { %>
              <tr><td><%= row.tier %></td><td><%= row.calls.toLocaleString() %></td><td><%= row.tokens.toLocaleString() %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="ops-section">
        <div class="ops-section-title">Top users</div>
        <table class="ops-table">
          <thead><tr><th>Tenant</th><th>Tokens</th><th>Basis</th></tr></thead>
          <tbody>
            <% for (const row of summary.byTenant) { %>
              <tr>
                <td><%= row.tenantId.slice(0, 18) %></td>
                <td><%= row.tokens.toLocaleString() %></td>
                <td><%= money(row.internalChargeBasisMinor) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
