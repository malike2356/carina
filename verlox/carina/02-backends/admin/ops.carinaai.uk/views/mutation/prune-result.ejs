<% title = 'Prune Results' %>
<div class="ops-page">
<%- include('_nav') %>

<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Prune Results</div>
    <div class="ops-page-sub"><%= dryRun ? 'Dry run: no data was modified.' : 'Full prune completed.' %></div>
  </div>
  <div class="ops-actions">
    <a href="/mutation" class="ops-btn ops-btn-ghost">Back to Overview</a>
  </div>
</div>

<% if (dryRun) { %>
  <div class="ops-card" style="margin-bottom:16px;border-color:rgba(245,158,11,0.3);">
    <div style="font-size:13px;color:#f59e0b;">This was a dry run. No database rows or registry entries were modified.</div>
  </div>
<% } %>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;">
  <div class="ops-card">
    <div class="ops-card-label">Tools Pruned</div>
    <div class="ops-card-val"><%= report && report.prunedTools ? report.prunedTools.length : 0 %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Expired Proposals</div>
    <div class="ops-card-val"><%= report ? report.expiredProposals : 0 %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Expired Overrides</div>
    <div class="ops-card-val"><%= report ? report.expiredStagedOverrides : 0 %></div>
  </div>
</div>

<div class="ops-card" style="margin-bottom:16px;">
  <div class="ops-section-title">Total Pruned: <%= report ? report.totalPruned : 0 %></div>
  <% if (report && report.prunedTools && report.prunedTools.length) { %>
    <ul style="margin:12px 0 0;padding-left:20px;font-size:13px;">
      <% report.prunedTools.forEach(function(name) { %>
        <li><code><%= name %></code></li>
      <% }); %>
    </ul>
  <% } else { %>
    <div class="ops-empty" style="margin-top:12px;">No tools were pruned.</div>
  <% } %>
</div>

<% if (dryRun) { %>
  <form method="post" action="/mutation/prune">
    <input type="hidden" name="dry_run" value="false">
    <button type="submit" class="ops-btn" style="border-color:rgba(239,68,68,0.5);">Run Real Prune</button>
  </form>
<% } %>
</div>
