<% title = 'Egress Control' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Egress Control</div>
    <div class="ops-page-sub">Operator blocklist for outbound domains (Scout egress filter).</div>
  </div>
  <button onclick="loadEgress()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
</div>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;">
  <div class="ops-card"><div class="ops-card-label">Blocked Domains</div><div class="ops-card-val red" id="eg-rules">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Blocked (24h)</div><div class="ops-card-val amber" id="eg-blocked">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Egress Filter</div><div class="ops-card-val cyan" id="eg-allowed" style="font-size:13px;margin-top:4px;">-</div></div>
</div>

<div class="ops-card">
  <div class="ops-section-title">Operator Blocklist</div>
  <div id="eg-loading" class="ops-loading">Loading egress blocklist...</div>
  <table class="ops-table" id="eg-table" style="display:none;">
    <thead><tr><th>Domain</th><th>Action</th><th>Status</th><th></th></tr></thead>
    <tbody id="eg-body"></tbody>
  </table>
  <div id="eg-empty" class="ops-empty" style="display:none;">No domains blocked by operators.</div>
</div>

<script>
function loadEgress() {
  document.getElementById('eg-loading').style.display = '';
  document.getElementById('eg-table').style.display = 'none';
  document.getElementById('eg-empty').style.display = 'none';

  Promise.all([
    fetch('/scout-api/api/egress/blocklist', { credentials: 'same-origin' }).then(function(r) {
      if (!r.ok) throw new Error('blocklist ' + r.status);
      return r.json();
    }),
    fetch('/scout-api/api/stats/egress-blocked', { credentials: 'same-origin' }).then(function(r) {
      return r.ok ? r.json() : { count: '-' };
    }).catch(function() { return { count: '-' }; }),
    fetch('/scout-api/api/admin/platform-settings', { credentials: 'same-origin' }).then(function(r) {
      return r.ok ? r.json() : null;
    }).catch(function() { return null; }),
  ]).then(function(res) {
    var blocklist = res[0];
    var stats = res[1];
    var settings = res[2];
    var items = blocklist.blocked || blocklist.blocklist || blocklist.domains || [];
    if (!Array.isArray(items)) items = [];

    document.getElementById('eg-rules').textContent = items.length;
    document.getElementById('eg-blocked').textContent = stats.count != null ? stats.count : '-';
    var filterOn = settings && settings.settings && settings.settings.egress_filter_enabled;
    document.getElementById('eg-allowed').textContent = filterOn === true ? 'enabled' : filterOn === false ? 'disabled' : 'unknown';

    document.getElementById('eg-loading').style.display = 'none';
    if (!items.length) {
      document.getElementById('eg-empty').style.display = '';
      return;
    }

    document.getElementById('eg-table').style.display = '';
    document.getElementById('eg-body').innerHTML = items.slice(0, 80).map(function(entry) {
      var domain = typeof entry === 'string' ? entry : (entry.domain || entry.name || '-');
      return '<tr><td style="font-family:monospace;font-size:10px;">' + esc(domain) + '</td>' +
        '<td><span class="ops-badge ops-badge-red">block</span></td>' +
        '<td><span class="ops-badge ops-badge-amber">active</span></td>' +
        '<td><button type="button" class="ops-btn eg-unblock-btn" data-domain="' + esc(domain) + '" style="padding:3px 8px;font-size:9px;">Unblock</button></td></tr>';
    }).join('');
    document.querySelectorAll('.eg-unblock-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        unblockDomain(btn.getAttribute('data-domain') || '');
      });
    });
  }).catch(function() {
    document.getElementById('eg-loading').style.display = 'none';
    document.getElementById('eg-empty').style.display = '';
    document.getElementById('eg-empty').textContent = 'Egress blocklist unavailable. Check SCOUT_API_KEY and SCOUT_OPERATOR_INSTANCE_ID in ops.';
  });
}

function unblockDomain(domain) {
  if (!confirm('Unblock domain ' + domain + '?')) return;
  fetch('/scout-api/api/egress/block/' + encodeURIComponent(domain), {
    method: 'DELETE',
    credentials: 'same-origin',
  }).then(function(r) {
    if (!r.ok) throw new Error('unblock failed');
    loadEgress();
  }).catch(function() {
    alert('Failed to unblock domain.');
  });
}

function esc(s) {
  return String(s).replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

loadEgress();
</script>
</div>
