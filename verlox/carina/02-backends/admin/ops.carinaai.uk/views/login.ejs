<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VERLOX Console · Login</title>
  <link rel="stylesheet" href="/theme/index.css">
</head>
<body class="ops-auth">
  <form method="post" action="/login" class="ops-auth-card">
    <h1>VERLOX Console</h1>
    <p class="ops-auth-lead">One login for engineering ops and Aiva business admin</p>
    <% if (error) { %>
      <p class="ops-auth-error"><%= error %></p>
    <% } %>
    <% if (typeof callbackUrl === 'string' && callbackUrl) { %>
      <input type="hidden" name="callbackUrl" value="<%= callbackUrl %>">
    <% } %>
    <% if (totpStep) { %>
      <input type="hidden" name="totpStep" value="<%= totpStep %>">
      <input type="hidden" name="pendingToken" value="<%= pendingToken %>">
      <input type="hidden" name="email" value="<%= email %>">
      <% if (totpStep === 'totp_setup' && otpauthUrl) { %>
        <p class="ops-auth-lead">Scan this authenticator setup in your app, then enter the 6-digit code.</p>
        <p class="ops-auth-lead" style="word-break:break-all;font-size:11px;"><%= otpauthUrl %></p>
      <% } else { %>
        <p class="ops-auth-lead">Enter the 6-digit code from your authenticator app.</p>
      <% } %>
      <label for="totpCode">Authentication code</label>
      <input type="text" id="totpCode" name="totpCode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus autocomplete="one-time-code">
    <% } else { %>
      <% if (googleOidcEnabled) { %>
        <a
          href="/auth/google<%= typeof callbackUrl === 'string' && callbackUrl ? ('?callbackUrl=' + encodeURIComponent(callbackUrl)) : '' %>"
          class="ops-auth-google"
        >
          <svg class="google-auth-logo" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.56 2.95-2.24 5.45-4.78 7.14l7.73 6c4.51-4.16 7.09-10.28 7.09-17.61z"></path>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
          </svg>
          <span>Continue with Google</span>
        </a>
        <p class="ops-auth-divider">or sign in with email</p>
      <% } %>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" required autofocus autocomplete="email">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required autocomplete="current-password">
    <% } %>
    <button type="submit" class="ops-auth-submit">Sign in</button>
  </form>
</body>
</html>
