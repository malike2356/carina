<% title = 'Platform Pricing' %>
<div class="ops-page ops-pricing-page" style="max-width:860px;margin:0 auto;padding:24px 32px;">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Platform Pricing</div>
      <div class="ops-page-sub">Edit public monthly display prices. Checkout IDs stay in <a href="<%= withV('/billing-config') %>">Billing and launch config</a>.</div>
    </div>
  </div>

  <% if (saved) { %>
    <div class="ops-flash ok">Price updated. The marketing site will reflect the new value on next page load.</div>
  <% } %>
  <% if (errMsg) { %>
    <div class="ops-flash err"><%= errMsg %></div>
  <% } %>

  <div class="ops-pricing-help">
    <div>
      <strong>What this changes</strong>
      <span>Marketing price labels only</span>
    </div>
    <div>
      <strong>Blank price</strong>
      <span>Shows custom pricing</span>
    </div>
    <div>
      <strong>Free price</strong>
      <span>Use 0</span>
    </div>
  </div>

  <% const groups = ['carina', 'aiva', 'scout', 'addons', 'separated']; %>
  <% groups.forEach(function(groupKey) {
    const groupRows = rows.filter(function(row) { return row.group === groupKey; });
    if (!groupRows.length) return;
  %>
    <section class="ops-surface ops-pricing-group">
      <div class="ops-pricing-group-head">
        <div>
          <h2 class="ops-section-title"><%= groupRows[0].groupLabel %></h2>
          <% if (groupKey === 'carina') { %>
            <p class="ops-section-note">Drives <code class="ops-code">carinaai.uk/pricing</code>.</p>
          <% } else if (groupKey === 'separated') { %>
            <p class="ops-section-note">Visibility only for separated product tracks.</p>
          <% } %>
        </div>
        <span class="ops-badge ops-badge-gray"><%= groupRows.length %> plans</span>
      </div>
      <% if (groupKey === 'carina') { %>
        <p class="ops-pricing-extra-note">Use Stripe Price IDs separately when checkout is enabled.</p>
      <% } else if (groupKey === 'separated') { %>
        <p class="ops-pricing-extra-note">Mutant and Petraclus may be billed from their own services.</p>
      <% } %>
      <div class="ops-pricing-list">
        <% groupRows.forEach(function(row, index) { %>
          <div class="ops-pricing-row">
            <div class="ops-pricing-main">
              <span class="ops-pricing-order"><%= index + 1 %></span>
              <div>
                <div class="ops-pricing-name"><%= row.label %></div>
                <div class="ops-pricing-meta">
                  <code class="ops-code"><%= row.id %></code>
                  <span>Updated <%= row.updated_at %></span>
                </div>
                <% if (row.helpText) { %>
                  <div class="ops-pricing-helptext"><%= row.helpText %></div>
                <% } %>
              </div>
            </div>
            <div class="ops-pricing-edit">
              <% if (row.monthly_gbp !== null && row.monthly_gbp !== undefined) { %>
                <% if (row.monthly_gbp === 0) { %>
                  <span class="ops-badge ops-badge-green">Free</span>
                <% } else { %>
                  <span class="ops-badge ops-badge-green">£<%= row.monthly_gbp %>/mo</span>
                <% } %>
              <% } else { %>
                <span class="ops-badge ops-badge-gray">Custom</span>
              <% } %>
              <form method="post" action="<%= withV('/pricing/update') %>" class="ops-inline-form ops-pricing-form">
                <input type="hidden" name="id" value="<%= row.id %>">
                <input
                  type="number"
                  name="monthly_gbp"
                  min="0"
                  step="1"
                  value="<%= row.monthly_gbp !== null && row.monthly_gbp !== undefined ? row.monthly_gbp : '' %>"
                  placeholder="Custom"
                  class="ops-input ops-input--sm"
                >
                <button type="submit" class="ops-btn ops-btn-green ops-btn-sm">Save</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% }); %>

  <div class="ops-pricing-footer-note">
    Public endpoint: <code class="ops-code">https://core.carinaai.uk/api/public/pricing</code>. Marketing pages fetch it on page load.
  </div>
</div>
