<% title = 'Analytics' %>
<div class="ops-page">
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Analytics<% if (coreConnected) { %> <span class="text-xs font-normal text-[#22c55e]">live</span><% } %></h1>

<% if (!coreConnected) { %>
  <div class="mb-4 rounded border border-yellow-700 bg-yellow-900/30 px-4 py-2 text-sm text-yellow-300">
    Core not connected. Showing local data only. Pair Carina in Settings to see live metrics.
  </div>
<% } %>

<form method="get" class="mb-6 flex items-center gap-3 text-sm">
  <label class="text-gray-400">Period</label>
  <select name="days" onchange="this.form.submit()" class="bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-1 text-white">
    <option value="7" <%= days === 7 ? 'selected' : '' %>>7 days</option>
    <option value="30" <%= days === 30 ? 'selected' : '' %>>30 days</option>
    <option value="90" <%= days === 90 ? 'selected' : '' %>>90 days</option>
  </select>
</form>

<% if (coreTelemetry) { %>
<%
  const tSessions = coreTelemetry.sessions && coreTelemetry.sessions.summary
    ? coreTelemetry.sessions.summary
    : (coreTelemetry.health && coreTelemetry.health.sessions ? coreTelemetry.health.sessions : null);
%>
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
  <div class="ops-stat-cell">
    <p class="text-gray-400 text-xs">Turns (24h)</p>
    <p class="text-lg font-bold text-white"><%= coreTelemetry.metrics.turns.total %></p>
  </div>
  <div class="ops-stat-cell">
    <p class="text-gray-400 text-xs">Sessions (24h)</p>
    <p class="text-lg font-bold text-white"><%= tSessions ? tSessions.uniqueSessions : 0 %></p>
  </div>
  <div class="ops-stat-cell">
    <p class="text-gray-400 text-xs">Avg latency</p>
    <p class="text-lg font-bold text-white"><%= (coreTelemetry.metrics.turns.avgLatencyMs / 1000).toFixed(1) %>s</p>
  </div>
  <div class="ops-stat-cell">
    <p class="text-gray-400 text-xs">Cache hits</p>
    <p class="text-lg font-bold text-white"><%= coreTelemetry.metrics.providers.cacheHits || 0 %></p>
  </div>
</div>
<% } else { %>
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
  <% const metrics = [
    ['Requests', summary.requests],
    ['Tokens in', summary.tokensIn.toLocaleString()],
    ['Tokens out', summary.tokensOut.toLocaleString()],
    ['Cache hits', summary.cacheHits.toLocaleString()],
    ['Batch jobs', summary.batchJobs],
    ['Est. cost', '$' + summary.estimatedCost.toFixed(4)],
  ]; %>
  <% for (const [label, val] of metrics) { %>
    <div class="ops-stat-cell">
      <p class="text-gray-400 text-xs"><%= label %></p>
      <p class="text-lg font-bold text-white"><%= val %></p>
    </div>
  <% } %>
</div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <section class="ops-stat-cell">
    <h2 class="text-sm font-semibold text-white mb-3">By provider<% if (coreConnected) { %> (live, 24h)<% } %></h2>
    <% if (coreByProvider && coreByProvider.length) { %>
      <table class="w-full text-xs">
        <thead>
          <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
            <th class="py-2 pr-2">Provider</th>
            <th class="py-2">Turns</th>
          </tr>
        </thead>
        <tbody>
          <% for (const p of coreByProvider) { %>
            <tr class="border-b border-[#2a2a2a]/50">
              <td class="py-2 pr-2 text-white"><%= p.provider %></td>
              <td class="py-2"><%= p.calls %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } else if (!byModel.length) { %>
      <p class="text-gray-500 text-sm">No usage in this period.</p>
    <% } else { %>
      <table class="w-full text-xs">
        <thead>
          <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
            <th class="py-2 pr-2">Provider</th>
            <th class="py-2 pr-2">Model</th>
            <th class="py-2 pr-2">Req</th>
            <th class="py-2 pr-2">Tokens</th>
            <th class="py-2">Cost</th>
          </tr>
        </thead>
        <tbody>
          <% for (const row of byModel) { %>
            <tr class="border-b border-[#2a2a2a]/50">
              <td class="py-2 pr-2 text-white"><%= row.provider %></td>
              <td class="py-2 pr-2 text-gray-400 font-mono"><%= row.model %></td>
              <td class="py-2 pr-2"><%= row.requests %></td>
              <td class="py-2 pr-2 text-gray-400"><%= (row.tokensIn + row.tokensOut).toLocaleString() %></td>
              <td class="py-2">$<%= row.estimatedCost.toFixed(4) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </section>

  <% if (coreTelemetry && coreTelemetry.health && coreTelemetry.health.turns24h) { %>
  <section class="ops-stat-cell">
    <h2 class="text-sm font-semibold text-white mb-3">Turn quality (24h)</h2>
    <dl class="text-sm space-y-2">
      <% for (const [bucket, count] of Object.entries(coreTelemetry.health.turns24h)) { %>
        <div class="flex justify-between">
          <dt class="text-gray-400"><%= bucket %></dt>
          <dd class="text-white font-medium"><%= count %></dd>
        </div>
      <% } %>
    </dl>
  </section>
  <% } %>

  <section class="ops-stat-cell">
    <h2 class="text-sm font-semibold text-white mb-3">Daily ledger (local)</h2>
    <% if (!daily.length) { %>
      <p class="text-gray-500 text-sm">No daily rows yet. Workbench runs populate this ledger.</p>
    <% } else { %>
      <div class="max-h-96 overflow-y-auto">
        <table class="w-full text-xs">
          <thead>
            <tr class="text-left text-gray-500 border-b border-[#2a2a2a] sticky top-0 bg-[#1a1a1a]">
              <th class="py-2 pr-2">Date</th>
              <th class="py-2 pr-2">Model</th>
              <th class="py-2 pr-2">Req</th>
              <th class="py-2">Cost</th>
            </tr>
          </thead>
          <tbody>
            <% for (const row of daily) { %>
              <tr class="border-b border-[#2a2a2a]/50">
                <td class="py-2 pr-2 text-gray-400"><%= row.usageDate %></td>
                <td class="py-2 pr-2 text-gray-300"><%= row.provider %>/<%= row.model %></td>
                <td class="py-2 pr-2"><%= row.requests %></td>
                <td class="py-2">$<%= row.estimatedCost.toFixed(4) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
</div>
