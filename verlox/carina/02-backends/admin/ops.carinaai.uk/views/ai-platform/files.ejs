<% title = 'Files' %>
<div class="ops-page">
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Files</h1>
<% if (saved) { %><p class="text-sm text-[#22c55e] mb-4">Saved.</p><% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <form method="post" action="/ai-platform/files" class="ops-stat-cell space-y-3 h-fit">
    <h2 class="text-sm font-semibold text-white">Add file record</h2>
    <p class="text-xs text-gray-500">Metadata-only registry. Upload binary content via Carina tools when paired.</p>
    <input name="name" required placeholder="File name" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <input name="mimeType" placeholder="MIME type" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <input name="tags" placeholder="Tags (comma separated)" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <button type="submit" class="w-full py-2 bg-[#22c55e] text-black rounded text-sm font-medium">Create</button>
  </form>

  <div class="lg:col-span-2 ops-stat-cell">
    <% if (!files.length) { %>
      <p class="text-gray-500 text-sm">No files registered. Add a record to track platform assets.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="ops-table w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
              <th class="py-2 pr-3">Name</th>
              <th class="py-2 pr-3">Status</th>
              <th class="py-2 pr-3">Tags</th>
              <th class="py-2 pr-3">Created</th>
              <th class="py-2">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (const f of files) { %>
              <tr class="border-b border-[#2a2a2a]/50 align-top">
                <td class="py-2 pr-3 text-white"><%= f.name %></td>
                <td class="py-2 pr-3 text-gray-400"><%= f.status %></td>
                <td class="py-2 pr-3 text-gray-400 text-xs"><%= (f.metadataJson.tags || []).join(', ') %></td>
                <td class="py-2 pr-3 text-gray-500 text-xs"><%= new Date(f.createdAt).toLocaleDateString() %></td>
                <td class="py-2">
                  <form method="post" action="/ai-platform/files/<%= f.id %>" class="inline-flex gap-1 flex-wrap">
                    <input type="hidden" name="name" value="<%= f.name %>">
                    <select name="status" class="bg-[#0f0f0f] border border-[#2a2a2a] rounded px-1 py-0.5 text-xs text-white">
                      <option value="active" <%= f.status === 'active' ? 'selected' : '' %>>active</option>
                      <option value="archived" <%= f.status === 'archived' ? 'selected' : '' %>>archived</option>
                    </select>
                    <button type="submit" class="text-xs text-[#06b6d4] hover:underline">Update</button>
                  </form>
                  <form method="post" action="/ai-platform/files/<%= f.id %>/delete" class="inline ml-2" onsubmit="return confirm('Delete this file record?')">
                    <button type="submit" class="text-xs text-red-400 hover:underline">Delete</button>
                  </form>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
</div>
