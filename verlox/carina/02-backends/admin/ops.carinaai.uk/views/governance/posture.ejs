<% title = 'Security Posture' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Security Posture</div>
    <div class="ops-page-sub">Aggregate assessment of the platform security stance across all tenants.</div>
  </div>
  <button onclick="loadPosture()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
</div>

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;">
  <div class="ops-card"><div class="ops-card-label">Overall Posture</div><div class="ops-card-val green" id="pos-overall">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Weak Points</div><div class="ops-card-val red" id="pos-weak">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Mitigations Applied</div><div class="ops-card-val cyan" id="pos-mitigations">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Risk Level</div><div class="ops-card-val amber" id="pos-risk" style="font-size:14px;margin-top:4px;">-</div></div>
</div>

<div class="ops-card" style="margin-bottom:16px;">
  <div class="ops-section-title">Posture Dimensions</div>
  <div id="pos-loading" class="ops-loading">Loading posture data...</div>
  <div id="pos-dims" style="display:none;"></div>
  <div id="pos-empty" class="ops-empty" style="display:none;">Posture data unavailable.</div>
  <p id="pos-onchain-note" class="ops-inline-note" style="display:none;margin-top:12px;"></p>
</div>

<div class="ops-card">
  <div class="ops-section-title">Risk Areas</div>
  <table class="ops-table" id="pos-risks-table" style="display:none;">
    <thead><tr><th>Area</th><th>Risk</th><th>Impact</th><th>Mitigation</th></tr></thead>
    <tbody id="pos-risks-body"></tbody>
  </table>
  <div id="pos-risks-empty" class="ops-empty">Loading...</div>
</div>

<script>
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

function labelizeFramework(key) {
  return String(key)
    .replace(/_readiness$/, '')
    .replace(/_/g, ' ')
    .replace(/\b\w/g, function(c) { return c.toUpperCase(); });
}

function renderDimensionBar(label, value) {
  var v = typeof value === 'number' ? value : parseInt(value, 10);
  if (!Number.isFinite(v)) return '';
  v = Math.min(100, Math.max(0, v));
  var bclr = v >= 80 ? 'var(--green)' : v >= 60 ? 'var(--amber)' : 'var(--red)';
  return '<div style="margin-bottom:10px;"><div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px;">' +
    '<span>' + esc(label) + '</span><span style="color:' + bclr + '">' + v + '%</span></div>' +
    '<div style="height:5px;background:var(--border);border-radius:2px;">' +
    '<div style="height:5px;width:' + v + '%;background:' + bclr + ';border-radius:2px;"></div></div></div>';
}

function loadPosture() {
  document.getElementById('pos-loading').style.display = '';
  document.getElementById('pos-empty').style.display = 'none';
  document.getElementById('pos-dims').style.display = 'none';
  document.getElementById('pos-onchain-note').style.display = 'none';

  Promise.all([
    fetch('/scout-api/api/governance/posture', { credentials: 'same-origin' }).then(function(r) { return r.ok ? r.json() : Promise.reject(); }),
    fetch('/scout-api/api/security/posture', { credentials: 'same-origin' }).then(function(r) { return r.ok ? r.json() : null; }).catch(function() { return null; }),
  ]).then(function(results) {
    var gov = results[0] || {};
    var sec = results[1] || {};

    var overall = gov.governance_score;
    document.getElementById('pos-overall').textContent = Number.isFinite(overall) ? overall + '%' : '-';
    document.getElementById('pos-overall').style.color = overall >= 80 ? 'var(--green)' : overall >= 60 ? 'var(--amber)' : overall > 0 ? 'var(--red)' : 'var(--muted)';

    var weakCount = (gov.action_items || []).length + (gov.eu_ai_act && gov.eu_ai_act.gaps ? gov.eu_ai_act.gaps.length : 0);
    if (sec.injection_blocks_24h) weakCount = Math.max(weakCount, sec.injection_blocks_24h);
    document.getElementById('pos-weak').textContent = weakCount || '0';

    var mitigations = sec.critical_attestations_24h;
    if (!Number.isFinite(mitigations)) mitigations = (gov.attestations || []).length;
    document.getElementById('pos-mitigations').textContent = Number.isFinite(mitigations) ? mitigations : '0';

    var risk = gov.governance_label || (sec.weekly_on_chain && sec.weekly_on_chain.status) || '-';
    document.getElementById('pos-risk').textContent = risk;
    document.getElementById('pos-risk').style.color =
      risk === 'Compliant' || risk === 'LOW' ? 'var(--green)' :
      risk === 'At Risk' || risk === 'MEDIUM' || risk === 'partial' ? 'var(--amber)' :
      risk === 'Non-Compliant' || risk === 'HIGH' ? 'var(--red)' : 'var(--muted)';

    document.getElementById('pos-loading').style.display = 'none';

    var dimsHtml = '';
    if (gov.frameworks && typeof gov.frameworks === 'object') {
      dimsHtml = Object.keys(gov.frameworks).map(function(k) {
        return renderDimensionBar(labelizeFramework(k), gov.frameworks[k]);
      }).join('');
    }
    if (dimsHtml) {
      document.getElementById('pos-dims').style.display = '';
      document.getElementById('pos-dims').innerHTML = dimsHtml;
    } else {
      document.getElementById('pos-empty').style.display = '';
    }

    if (sec.weekly_on_chain && sec.weekly_on_chain.note) {
      var noteEl = document.getElementById('pos-onchain-note');
      noteEl.textContent = 'On-chain attestation: ' + sec.weekly_on_chain.note;
      noteEl.style.display = '';
    }

    var risks = [];
    (gov.action_items || []).forEach(function(item) {
      risks.push({
        area: item.label || item.framework || '-',
        risk: item.priority || 'medium',
        impact: (item.framework || '-') + (item.article ? ' (' + item.article + ')' : ''),
        mitigation: 'Open action item',
      });
    });
    (gov.eu_ai_act && gov.eu_ai_act.gaps || []).forEach(function(gap) {
      risks.push({ area: gap, risk: 'high', impact: gov.eu_ai_act.tier_label || 'EU AI Act', mitigation: 'Address compliance gap' });
    });
    (sec.recent_critical_attestations || []).forEach(function(x) {
      risks.push({
        area: x.event_type || x.id,
        risk: 'high',
        impact: 'Recent critical attestation',
        mitigation: x.attested_at ? new Date(x.attested_at).toLocaleString() : '-',
      });
    });
  (gov.agents && gov.agents.rows || []).forEach(function(agent) {
      if (agent.incidents > 0) {
        risks.push({
          area: agent.id,
          risk: agent.status === 'suspended' ? 'high' : 'medium',
          impact: agent.incidents + ' open incident(s)',
          mitigation: agent.identified ? 'Agent identified on-chain' : 'Register agent identity',
        });
      }
    });

    if (!risks.length) {
      document.getElementById('pos-risks-empty').textContent = 'No risk areas identified.';
      document.getElementById('pos-risks-table').style.display = 'none';
      return;
    }
    document.getElementById('pos-risks-table').style.display = '';
    document.getElementById('pos-risks-empty').style.display = 'none';
    document.getElementById('pos-risks-body').innerHTML = risks.map(function(r) {
      var rclr = r.risk === 'high' || r.risk === 'critical' ? 'ops-badge-red' : r.risk === 'medium' ? 'ops-badge-amber' : 'ops-badge-gray';
      return '<tr><td>' + esc(r.area || '-') + '</td>' +
        '<td><span class="ops-badge ' + rclr + '">' + esc(r.risk || '-') + '</span></td>' +
        '<td>' + esc(r.impact || '-') + '</td>' +
        '<td>' + esc(r.mitigation || '-') + '</td></tr>';
    }).join('');
  }).catch(function() {
    document.getElementById('pos-loading').style.display = 'none';
    document.getElementById('pos-empty').style.display = '';
    document.getElementById('pos-risks-empty').textContent = 'Posture endpoint unavailable. Check SCOUT_API_KEY in ops Settings.';
  });
}
loadPosture();
</script>
</div>
