<% title = 'Scout Dashboard' %>
<div class="ops-page ops-scout-page">
  <div class="ops-scout-kill-bar">
    <div class="ops-scout-kill-copy">
      <div class="ops-scout-kill-title">Platform kill switch</div>
      <div class="ops-scout-kill-sub">Halt all agent instances immediately. Logged and auditable.</div>
    </div>
    <div class="ops-scout-kill-actions">
      <a href="/security/killswitch" class="ops-btn ops-btn-red ops-scout-kill-btn">Open kill switch</a>
      <span id="scout-sse-status" class="ops-scout-live"><span class="status-dot" id="scout-sse-dot"></span><span id="scout-sse-label">Connecting...</span></span>
    </div>
  </div>

  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Scout Dashboard</div>
      <div class="ops-page-sub">Live threat telemetry, instance control, and event stream from Labyrinth Scout.</div>
    </div>
    <div class="ops-actions" style="margin-top:0;">
      <a href="<%= scoutConsolePublicUrl %>" target="_blank" rel="noopener" class="ops-btn-ghost">Open Scout console</a>
      <a href="/scout/accounts" class="ops-link">Scout accounts</a>
    </div>
  </div>

  <% if (!scoutOnline) { %>
    <div class="ops-flash warn">
      Scout engine is offline at <code class="ops-code"><%= scoutUrl %></code>.
      Check supervisor or pair Scout under <a href="/settings#connections" class="ops-link">Settings</a>.
    </div>
  <% } %>

  <div class="ops-metrics">
    <div class="ops-metric">
      <div class="ops-metric-label">Scout score</div>
      <div class="ops-metric-value" id="scout-score-val"><%= score != null ? score : '-' %></div>
      <div class="ops-inline-note" id="scout-score-note"><%= scoreLabel %></div>
    </div>
    <div class="ops-metric">
      <div class="ops-metric-label">Critical (24h)</div>
      <div class="ops-metric-value warn" id="stat-critical"><%= scoutOnline ? stats.critical : '-' %></div>
    </div>
    <div class="ops-metric">
      <div class="ops-metric-label">Warning (24h)</div>
      <div class="ops-metric-value" id="stat-warning"><%= scoutOnline ? stats.warning : '-' %></div>
    </div>
    <div class="ops-metric">
      <div class="ops-metric-label">Info (24h)</div>
      <div class="ops-metric-value ok" id="stat-info"><%= scoutOnline ? stats.info : '-' %></div>
    </div>
    <div class="ops-metric">
      <div class="ops-metric-label">Breach (24h)</div>
      <div class="ops-metric-value warn" id="stat-breach"><%= scoutOnline ? stats.breach : '-' %></div>
    </div>
    <div class="ops-metric">
      <div class="ops-metric-label">Instances</div>
      <div class="ops-metric-value"><%= instances.length %></div>
      <div class="ops-inline-note"><%= activeCount %> active</div>
    </div>
  </div>

  <div class="ops-scout-grid">
    <section class="ops-surface ops-scout-stream-wrap">
      <div class="ops-scout-stream-head">
        <div class="ops-section-title" style="margin:0;">Live events</div>
        <div class="ops-filter-bar" style="margin:0;padding:0;border:none;">
          <% ['all', 'critical', 'warning', 'info', 'breach'].forEach(function(f) { %>
            <button type="button" data-filter="<%= f %>" class="filter-btn ops-filter-btn<%= f === 'all' ? ' active' : '' %>">
              <%= f === 'all' ? 'All' : f.charAt(0).toUpperCase() + f.slice(1) %>
            </button>
          <% }) %>
        </div>
      </div>
      <div id="event-stream" class="ops-scout-stream"></div>
    </section>

    <aside class="ops-scout-rail">
      <section class="ops-surface ops-scout-instances">
        <div class="ops-section-title">Agent instances</div>
        <div id="instances-panel">
          <% if (!instances.length) { %>
            <div class="ops-empty">No instances registered.</div>
          <% } %>
          <% for (const inst of instances) { %>
            <div class="ops-scout-inst instance-row" data-id="<%= inst.id %>">
              <div class="ops-scout-inst-head">
                <div>
                  <div class="ops-scout-inst-name"><%= inst.name %></div>
                  <div class="ops-inline-note"><%= inst.id %></div>
                </div>
                <span class="instance-status ops-badge <%= inst.status === 'active' ? 'ops-badge-green' : inst.status === 'suspended' ? 'ops-badge-red' : 'ops-badge-gray' %>"><%= inst.status %></span>
              </div>
              <div class="instance-heartbeat ops-inline-note" data-heartbeat="<%= inst.last_heartbeat || '' %>">
                Last seen: <%= inst.secondsAgo != null ? inst.secondsAgo + 's ago' : 'never' %>
              </div>
              <div class="instance-actions ops-scout-inst-actions">
                <% if (inst.status === 'active') { %>
                  <button type="button" class="kill-btn ops-btn ops-btn-red" data-id="<%= inst.id %>" data-name="<%= inst.name %>">Kill instance</button>
                <% } else if (inst.status === 'suspended') { %>
                  <button type="button" class="resume-btn ops-btn ops-btn-green" data-id="<%= inst.id %>">Resume instance</button>
                <% } %>
              </div>
              <p class="instance-error ops-inline-note" style="display:none;color:var(--red);"></p>
            </div>
          <% } %>
        </div>
      </section>

      <section class="ops-surface">
        <div class="ops-section-title">Quick links</div>
        <div class="ops-link-grid">
          <a href="/security/threats" class="ops-link-row"><div class="ops-link-row-title">Live threats</div><div class="ops-link-row-sub">Real-time security events</div></a>
          <a href="/security/killswitch" class="ops-link-row"><div class="ops-link-row-title">Kill switch</div><div class="ops-link-row-sub">Platform halt control</div></a>
          <a href="/security/score" class="ops-link-row"><div class="ops-link-row-title">Scout score</div><div class="ops-link-row-sub">Composite health score</div></a>
          <a href="/security/incidents" class="ops-link-row"><div class="ops-link-row-title">Incidents</div><div class="ops-link-row-sub">Confirmed incidents</div></a>
        </div>
      </section>
    </aside>
  </div>
</div>

  <div class="ops-scout-grid" style="margin-top:24px;">
    <section class="ops-surface ops-scout-stream-wrap" id="self-mod-panel">
      <div class="ops-scout-stream-head">
        <div class="ops-section-title" style="margin:0;">Self-Mod Security</div>
        <div style="display:flex;gap:8px;align-items:center;">
          <span class="ops-inline-note" id="selfmod-stats-text">Loading...</span>
          <button type="button" class="ops-btn-ghost" onclick="loadSelfModData()">Refresh</button>
        </div>
      </div>

      <div id="selfmod-pending" style="margin:12px 0;">
        <div class="ops-section-title" style="font-size:13px;margin-bottom:6px;">Pending approval</div>
        <div id="selfmod-pending-list" class="ops-empty">Loading...</div>
      </div>

      <div id="selfmod-active" style="margin:12px 0;">
        <div class="ops-section-title" style="font-size:13px;margin-bottom:6px;">Active runtime tools</div>
        <div id="selfmod-active-list" class="ops-empty">Loading...</div>
      </div>

      <div id="selfmod-stream" style="margin-top:12px;">
        <div class="ops-section-title" style="font-size:13px;margin-bottom:6px;">Live self-mod events</div>
        <div id="selfmod-event-list" class="ops-scout-stream" style="max-height:200px;"></div>
      </div>
    </section>
  </div>

<div id="kill-modal" class="ops-modal-backdrop" style="display:none;">
  <div class="ops-modal ops-modal-neutral" style="border-color:rgba(255,34,68,0.45);">
    <div class="ops-section-title" style="color:var(--red);">Kill instance</div>
    <p id="kill-target-name" class="ops-inline-note" style="margin-bottom:12px;"></p>
    <textarea id="kill-reason" rows="3" placeholder="Reason for suspension..." class="ops-input" style="margin-bottom:12px;"></textarea>
    <div class="ops-actions" style="justify-content:flex-end;">
      <button type="button" id="kill-cancel" class="ops-btn-ghost">Cancel</button>
      <button type="button" id="kill-confirm" class="ops-btn ops-btn-red">Confirm kill</button>
    </div>
  </div>
</div>

<script>
  const SCOUT_ONLINE = <%= scoutOnline ? 'true' : 'false' %>;
  let activeFilter = 'all';
  let reconnectDelay = 2000;
  let es = null;
  let killTargetId = null;

  const streamEl = document.getElementById('event-stream');
  const killModal = document.getElementById('kill-modal');
  const sseDot = document.getElementById('scout-sse-dot');
  const sseLabel = document.getElementById('scout-sse-label');

  function setDot(connected) {
    if (!sseDot || !sseLabel) return;
    sseDot.className = 'status-dot ' + (connected ? 'live' : 'dead');
    sseLabel.textContent = connected ? 'Live stream connected' : 'Stream disconnected';
    sseLabel.style.color = connected ? 'var(--green)' : 'var(--red)';
  }

  function severityBadge(sev) {
    if (sev === 'critical' || sev === 'breach') return 'ops-badge-red';
    if (sev === 'warning') return 'ops-badge-amber';
    return 'ops-badge-cyan';
  }

  function formatTime(iso) {
    try {
      return new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    } catch { return '--:--:--'; }
  }

  function appendEvent(ev) {
    const sev = (ev.severity || 'info').toLowerCase();
    if (activeFilter !== 'all' && sev !== activeFilter) return;
    const row = document.createElement('div');
    row.className = 'ops-scout-event event-row';
    row.dataset.severity = sev;
    const desc = (ev.description || ev.message || ev.detail || '').slice(0, 120);
    row.innerHTML =
      '<span class="ops-scout-event-time">' + formatTime(ev.created_at || ev.timestamp) + '</span>' +
      '<span class="ops-badge ' + severityBadge(sev) + '">' + sev + '</span>' +
      '<span class="ops-scout-event-type">' + (ev.event_type || ev.type || '-') + '</span>' +
      '<span class="ops-scout-event-desc">' + desc + '</span>' +
      '<span class="ops-scout-event-inst">' + (ev.instance_id || ev.source || '-') + '</span>';
    streamEl.appendChild(row);
    streamEl.scrollTop = streamEl.scrollHeight;
  }

  function updateStats(s) {
    if (!s) return;
    const map = { critical: 'stat-critical', warning: 'stat-warning', info: 'stat-info', breach: 'stat-breach' };
    for (const [k, id] of Object.entries(map)) {
      const el = document.getElementById(id);
      if (el && s[k] != null) el.textContent = s[k];
    }
  }

  function connectStream() {
    if (es) { es.close(); es = null; }
    es = new EventSource('/security/stream');
    es.onopen = function() { setDot(true); reconnectDelay = 2000; };
    es.onerror = function() {
      setDot(false);
      es.close();
      setTimeout(connectStream, reconnectDelay);
      reconnectDelay = Math.min(reconnectDelay * 2, 30000);
    };
    es.onmessage = function(e) {
      try {
        const msg = JSON.parse(e.data);
        if (msg.type === 'event') appendEvent(msg.data);
        if (msg.type === 'stats') updateStats(msg.data);
      } catch {}
    };
  }

  document.querySelectorAll('.filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activeFilter = btn.dataset.filter || 'all';
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.querySelectorAll('.event-row').forEach(function(row) {
        row.style.display = (activeFilter === 'all' || row.dataset.severity === activeFilter) ? '' : 'none';
      });
    });
  });

  document.getElementById('kill-cancel')?.addEventListener('click', function() { killModal.style.display = 'none'; });
  document.getElementById('kill-confirm')?.addEventListener('click', async function() {
    if (!killTargetId) return;
    const reason = document.getElementById('kill-reason').value.trim() || 'ops scout dashboard kill';
    const row = document.querySelector('.instance-row[data-id="' + killTargetId + '"]');
    const errEl = row?.querySelector('.instance-error');
    try {
      const r = await fetch('/security/kill/' + encodeURIComponent(killTargetId), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Kill failed');
      const statusEl = row?.querySelector('.instance-status');
      if (statusEl) { statusEl.textContent = 'suspended'; statusEl.className = 'instance-status ops-badge ops-badge-red'; }
      const actions = row?.querySelector('.instance-actions');
      if (actions) {
        actions.innerHTML = '<button type="button" class="resume-btn ops-btn ops-btn-green" data-id="' + killTargetId + '">Resume instance</button>';
        bindResume(actions.querySelector('.resume-btn'));
      }
      killModal.style.display = 'none';
      if (errEl) errEl.style.display = 'none';
    } catch (err) {
      if (errEl) { errEl.textContent = err.message || 'Kill failed'; errEl.style.display = ''; }
    }
  });

  function bindKill(btn) {
    btn?.addEventListener('click', function() {
      killTargetId = btn.dataset.id;
      document.getElementById('kill-target-name').textContent = btn.dataset.name || killTargetId;
      document.getElementById('kill-reason').value = '';
      killModal.style.display = 'flex';
    });
  }

  function bindResume(btn) {
    btn?.addEventListener('click', async function() {
      const id = btn.dataset.id;
      const row = document.querySelector('.instance-row[data-id="' + id + '"]');
      const errEl = row?.querySelector('.instance-error');
      try {
        const r = await fetch('/security/resume/' + encodeURIComponent(id), { method: 'POST' });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Resume failed');
        const statusEl = row?.querySelector('.instance-status');
        if (statusEl) { statusEl.textContent = 'active'; statusEl.className = 'instance-status ops-badge ops-badge-green'; }
        const actions = row?.querySelector('.instance-actions');
        if (actions) {
          actions.innerHTML = '<button type="button" class="kill-btn ops-btn ops-btn-red" data-id="' + id + '" data-name="' + id + '">Kill instance</button>';
          bindKill(actions.querySelector('.kill-btn'));
        }
        if (errEl) errEl.style.display = 'none';
      } catch (err) {
        if (errEl) { errEl.textContent = err.message || 'Resume failed'; errEl.style.display = ''; }
      }
    });
  }

  document.querySelectorAll('.kill-btn').forEach(bindKill);
  document.querySelectorAll('.resume-btn').forEach(bindResume);

  setInterval(function() {
    document.querySelectorAll('.instance-heartbeat').forEach(function(el) {
      const hb = el.dataset.heartbeat;
      if (!hb) return;
      const sec = Math.max(0, Math.floor((Date.now() - new Date(hb).getTime()) / 1000));
      el.textContent = 'Last seen: ' + sec + 's ago';
    });
  }, 5000);

  if (SCOUT_ONLINE) {
    fetch('/security/events').then(function(r) { return r.ok ? r.json() : null; }).then(function(data) {
      const events = data?.events ?? data ?? [];
      if (Array.isArray(events)) events.slice().reverse().forEach(appendEvent);
    }).catch(function() {});
    connectStream();
    fetch('/scout-api/api/score').then(function(r) { return r.ok ? r.json() : null; }).then(function(d) {
      if (!d) return;
      const s = d.score || d.overall || d.value;
      const el = document.getElementById('scout-score-val');
      const note = document.getElementById('scout-score-note');
      if (el && s != null) {
        el.textContent = s;
        el.className = 'ops-metric-value ' + (s >= 80 ? 'ok' : s >= 60 ? 'warn' : 'muted');
      }
      if (note && s != null) {
        note.textContent = s >= 80 ? 'Healthy' : s >= 60 ? 'Fair' : s > 0 ? 'Needs attention' : 'No data';
      }
    }).catch(function() {});
  } else {
    setDot(false);
    if (sseLabel) sseLabel.textContent = 'Scout offline';
  }

  // ── Self-Mod panel ──────────────────────────────────────────────────────
  function renderTool(tool, isPending) {
    var riskClass = tool.risk_level === 'high' ? 'warn' : tool.risk_level === 'medium' ? 'muted' : 'ok';
    var actions = '';
    if (isPending) {
      actions = '<button class="ops-btn ops-btn-green selfmod-approve-btn" style="padding:2px 8px;font-size:11px;" data-id="' + tool.id + '" data-name="' + tool.name + '">Approve</button>' +
                '<button class="ops-btn ops-btn-red selfmod-disable-btn" style="padding:2px 8px;font-size:11px;" data-id="' + tool.id + '">Reject</button>';
    } else {
      actions = '<button class="ops-btn ops-btn-red selfmod-disable-btn" style="padding:2px 8px;font-size:11px;" data-id="' + tool.id + '">Disable</button>';
    }
    return '<div class="ops-scout-inst" style="display:flex;align-items:center;gap:12px;padding:8px 12px;">' +
      '<div style="flex:1;">' +
        '<div class="ops-scout-inst-name">' + tool.name + '</div>' +
        '<div class="ops-inline-note">' + (tool.description || '') + '</div>' +
      '</div>' +
      '<span class="ops-badge ops-badge-' + (riskClass === 'ok' ? 'green' : riskClass === 'warn' ? 'red' : 'gray') + '" style="font-size:10px;">' + tool.risk_level + '</span>' +
      '<span class="ops-inline-note" style="font-size:10px;">' + tool.times_used + ' uses</span>' +
      '<div style="display:flex;gap:4px;">' + actions + '</div>' +
    '</div>';
  }

  function loadSelfModData() {
    fetch('/api/carina-ops/tools/runtime').then(function(r) { return r.ok ? r.json() : null; }).then(function(d) {
      if (!d) return;
      var stats = d.stats || {};
      var statsEl = document.getElementById('selfmod-stats-text');
      if (statsEl) statsEl.textContent = (stats.active || 0) + ' active, ' + (stats.pending || 0) + ' pending, ' + (stats.total_uses || 0) + ' total uses';

      var tools = d.tools || [];
      var pending = tools.filter(function(t) { return t.status === 'pending'; });
      var active = tools.filter(function(t) { return t.status === 'active'; });

      var pendingEl = document.getElementById('selfmod-pending-list');
      if (pendingEl) pendingEl.innerHTML = pending.length ? pending.map(function(t) { return renderTool(t, true); }).join('') : '<div class="ops-empty">No tools pending approval.</div>';

      var activeEl = document.getElementById('selfmod-active-list');
      if (activeEl) activeEl.innerHTML = active.length ? active.map(function(t) { return renderTool(t, false); }).join('') : '<div class="ops-empty">No active runtime tools.</div>';

    }).catch(function() {});
  }

  document.addEventListener('click', function(e) {
    var btn = e.target;
    if (btn.classList.contains('selfmod-approve-btn')) {
      if (!confirm('Approve tool "' + (btn.dataset.name || btn.dataset.id) + '"?')) return;
      fetch('/api/carina-ops/tools/runtime/' + btn.dataset.id + '/approve', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(d) { alert(d.message || d.error); loadSelfModData(); })
        .catch(function() { alert('Request failed.'); });
    }
    if (btn.classList.contains('selfmod-disable-btn')) {
      if (!confirm('Disable/reject this tool?')) return;
      fetch('/api/carina-ops/tools/runtime/' + btn.dataset.id + '/disable', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(d) { alert(d.message || d.error); loadSelfModData(); })
        .catch(function() { alert('Request failed.'); });
    }
  });

  // Listen for self-mod events on the Scout SSE stream
  var selfModEventsEl = document.getElementById('selfmod-event-list');
  if (selfModEventsEl && typeof EventSource !== 'undefined') {
    var selfModEs = new EventSource('/scout/stream');
    selfModEs.addEventListener('self_mod', function(ev) {
      try {
        var data = JSON.parse(ev.data);
        var row = document.createElement('div');
        row.className = 'ops-scout-event ops-scout-event-' + (data.severity || 'info');
        row.textContent = '[' + (data.type || '') + '] ' + (data.detail ? JSON.stringify(data.detail) : '');
        selfModEventsEl.prepend(row);
        if (selfModEventsEl.children.length > 50) selfModEventsEl.lastChild.remove();
      } catch (err) {}
    });
  }

  loadSelfModData();
</script>
