# VPS-only backup configuration (never commit real values).
# Copy to /etc/verlox/backup.env on the server:
#   sudo mkdir -p /etc/verlox
#   sudo cp docker/scripts/backup.env.example /etc/verlox/backup.env
#   sudo chmod 600 /etc/verlox/backup.env
#
# Scripts source this before .env.docker.runtime when present.

# Postgres (usually matches docker-compose.prod.yml)
POSTGRES_DB=carina
POSTGRES_USER=carina

# Backblaze B2 via rclone (private bucket verlox-backups)
BACKUP_REMOTE=backblaze:verlox-backups/postgres/daily
WAL_REMOTE=backblaze:verlox-backups/wal

# Restore-test and small-backup alerts
BACKUP_ALERT_EMAIL=lordsesame@gmail.com

# Optional overrides
# BACKUP_DIR=/var/backups/postgres/daily
# LOG_DIR=/var/log/verlox
# BACKUP_SIZE_WARN_BYTES=102400
