{
  "name": "@verlox/carina-scout",
  "version": "0.2.0",
  "description": "Labyrinth Scout client SDK for Carina (MIT). Reports telemetry to a Scout server; does not include the server.",
  "homepage": "https://labyrinthscout.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "imports": {
    "#core/*": "@verlox/carina-core/internal/*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@verlox/carina-core": "^0.2.0"
  },
  "devDependencies": {
    "@verlox/carina-core": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "carina",
    "scout",
    "labyrinth",
    "security",
    "sdk"
  ],
  "author": "VERLOX Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malike2356/carina-agent.git",
    "directory": "packages/scout-client"
  },
  "publishConfig": {
    "access": "public"
  }
}
