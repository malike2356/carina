# Primary domain. All subdomain URLs (app., core., ops., hub., docs., etc.) derive from this.
# Change this one value when migrating to a new domain.
CARINA_DOMAIN=carinaai.uk

DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Comma-separated API key pools (auto-rotate on rate limit / auth errors)
DEEPSEEK_API_KEYS=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
OPENAI_API_KEY=
OPENAI_API_KEYS=

# Image generation (plugin backends; auto picks first configured: fal, openai, replicate, comfyui)
# IMAGE_GEN_PROVIDER=auto
# IMAGE_GEN_PROVIDER=fal
# FAL_KEY=                        # Recommended for Flux (~$0.006/image Klein); https://fal.ai/dashboard/keys
# REPLICATE_API_TOKEN=            # Replicate Flux Schnell fallback
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=          # Exported ComfyUI API workflow JSON (local GPU: >=6GB SD, >=12GB Flux)
# IMAGE_GEN_MODEL=                # Override default model for active provider
# REMOVE_BG_API_KEY=              # Optional background removal
GROQ_API_KEYS=
GEMINI_API_KEYS=

# GitHub Copilot API fallback (plugins/providers/github-copilot.ts; run: gh auth token)
# Loaded by default unless CARINA_PROVIDER_PLUGINS=false. Used after paid BYOK keys fail.
GITHUB_TOKEN=
GITHUB_COPILOT_MODEL=gpt-4o
# CARINA_PROVIDER_PLUGINS=false

# Free Copilot preset (local/low-cost providers only; requires configured endpoints)
# CARINA_LLM_PRESET=free-copilot
# CARINA_FREE_PROVIDERS=github-copilot
# Local OpenAI-compatible backends (set *_ENABLED=true and optional *_BASE_URL)
# OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LMSTUDIO_ENABLED=false
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# VLLM_ENABLED=false
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# CARINA_LOCAL_LLM_ENABLED=false
# LiteLLM / SGLang local proxies
# LITELLM_ENABLED=false
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# SGLANG_ENABLED=false
# SGLANG_BASE_URL=http://127.0.0.1:30000/v1
# Google Vertex / Cloudflare AI Gateway (OpenAI-compatible proxy required)
# VERTEX_BASE_URL=
# VERTEX_API_KEY=
# CLOUDFLARE_AI_GATEWAY_URL=
# CLOUDFLARE_AI_API_KEY=
# Regional providers
# BYTEPLUS_API_KEY=
# TENCENT_API_KEY=
# HUNYUAN_API_KEY=
# VOLCENGINE_API_KEY=
# VOYAGE_API_KEY=
# Force embedding backend order for RAG/memory: gemini | voyage | openai
# CARINA_EMBEDDING_PROVIDER=voyage
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CARINA_EMBEDDING_DIMENSIONS=768
# CARINA_EMBEDDING_MAX_CHARS=8000
# CARINA_EMBEDDING_VOYAGE_MAX_CHARS=16000
# VOYAGE_BASE_URL=https://api.voyageai.com/v1

# Agent runtime limits (defaults shown)
# CARINA_MAX_TURNS=20
# CARINA_SUBAGENT_MAX_TURNS=10
# CARINA_TASKFLOW_MAX_TURNS=8
# CARINA_PARENT_ITERATION_BUDGET=90
# CARINA_SUBAGENT_ITERATION_BUDGET=50
# CARINA_ITERATION_GRACE_CALL=true
# CARINA_LLM_MONTHLY_BUDGET_USD=
# CARINA_LLM_TURN_WARN_USD=0.05
# CARINA_BUDGET_WARN_PERCENT=80
# CARINA_BLOCK_EXPENSIVE_ON_BUDGET_WARN=false
# Optional typed runtime overrides: ~/.carina/runtime.yaml (carina config validate)
# CARINA_SESSION_TIMEOUT_MS=3600000
# CARINA_MAX_MEMORY_CONTEXT=20

# Search and integration API bases (optional overrides)
# BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
# TAVILY_SEARCH_URL=https://api.tavily.com/search
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_BASE_URL=https://api.trello.com/1

# OAuth device flow (carina credentials oauth login <provider>)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google OAuth2 for Gmail IMAP. Required scope: https://mail.google.com/
# Must match the redirect URI registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=https://core.carinaai.uk/api/aiva/email/oauth/gmail/callback
# Microsoft OAuth2 for Outlook / Microsoft 365 IMAP
# Register app at portal.azure.com -> Microsoft Entra ID -> App registrations
# Required permissions: IMAP.AccessAsUser.All, offline_access
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Use 'common' to allow personal, work, and school accounts. Use a tenant ID to restrict access.
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=https://core.carinaai.uk/api/aiva/email/oauth/outlook/callback
AZURE_OAUTH_CLIENT_ID=
AZURE_OAUTH_CLIENT_SECRET=
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
NVIDIA_API_KEY=
TENANT_KEY_ENCRYPTION_KEY=
DATABASE_URL=postgresql://localhost:5432/carina
# Docker production: port 6432 via PgBouncer (postgres is 5432, apps use the pooler)
# sync-docker-env.py rewrites to postgresql://carina:PASS@pgbouncer:6432/carina (PGBOUNCER_ENABLED=1 default)
# Local Docker stack: redis://:dev-redis-local@127.0.0.1:6379 (see docker-compose.yml)
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=dev-redis-local

# Memory backend: builtin | postgres | sqlite | honcho | mem0
# builtin = PostgreSQL (or SQLite when CARINA_LOCAL_MODE=true)
CARINA_MEMORY_BACKEND=builtin
CARINA_SQLITE_MEMORY_PATH=
# Honcho (https://honcho.dev)
HONCHO_API_KEY=
HONCHO_URL=https://api.honcho.dev
HONCHO_WORKSPACE_ID=carina
HONCHO_PEER_ID=user
# REM (Reflective Episodic Memory): short-term -> long-term promotion + DREAMS.md review
CARINA_REM_ENABLED=true
CARINA_REM_PROMOTE_THRESHOLD=0.72
CARINA_REM_AUTO_PROMOTE_THRESHOLD=0.92
CARINA_REM_MIN_AGE_MINUTES=30
CARINA_REM_CYCLE_MS=300000
# Push wake parent session when background subagents complete (default on)
# CARINA_SUBAGENT_PUSH_WAKE=false
# Embedding-based tool subset for large tool registries / small context models
# CARINA_TOOL_EMBED_SELECT=true
# CARINA_TOOL_EMBED_MIN_TOOLS=18
# CARINA_TOOL_EMBED_TOP_K=24
# CARINA_TOOL_EMBED_CONTEXT_MAX=128000
# Optional file overlays: ~/.carina/system/{tool_enforcement,anti_fabrication,turn_end_model,memory_discipline,execution_checklist}.md
# Legacy fallback: ~/.karina/system/*.md

# Operations (carina ops ...)
CARINA_SANDBOX_ENABLED=true
CARINA_SANDBOX_IMAGE=alpine:latest
CARINA_SANDBOX_MEMORY_MB=256
CARINA_DEBUG_PROXY_PORT=19229
# Bearer token used by ops.carinaai.uk to authenticate API calls to core.
# Must be a plain random string - NOT a bcrypt hash.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in ops.carinaai.uk/.env as CARINA_OPS_TOKEN.
# Keep separate from CARINA_WEB_PASSWORD (that is a bcrypt hash for the web UI login).
CARINA_OPS_TOKEN=

# OpenAI-compatible REST API (/v1/models, /v1/chat/completions, /v1/embeddings, /v1/responses)
# Requires Bearer auth (CARINA_OPS_TOKEN, CARINA_INTERNAL_KEY, or control auth).
CARINA_OPENAI_API_ENABLED=false

# Per-session token spend alert threshold (USD); shown in chat when exceeded
# CARINA_TOKEN_ALERT_THRESHOLD_USD=5

# Default thinking level when session has none set: off|minimal|low|medium|high|xhigh|max|adaptive
# CARINA_THINKING_DEFAULT=medium

# Command queue (gateway message coordination)
# CARINA_QUEUE_MAX_CONCURRENT=4
# CARINA_QUEUE_DEBOUNCE_MS=500
# CARINA_QUEUE_CAP=20
# CARINA_QUEUE_DROP=summarize
# CARINA_QUEUE_DEFAULT_MODE=steer

# Standing orders (persistent agent directives)
# CARINA_STANDING_ORDERS_ENABLED=true

# Identity links, shared sessions, and channel docking (default on; set false to disable)
# CARINA_IDENTITY_LINKS_ENABLED=true

# Inferred commitments (OpenClaw-style follow-up memories; opt-in)
CARINA_COMMITMENTS_ENABLED=false
CARINA_COMMITMENTS_TICK_MINUTES=5
CARINA_COMMITMENTS_MIN_DELAY_MINUTES=5
CARINA_COMMITMENTS_MIN_CONFIDENCE=0.75
CARINA_COMMITMENTS_MAX_PER_SESSION=3
# CARINA_COMMITMENTS_LLM=true

# Node host (remote machines connect back to gateway; opt-in on gateway)
# CARINA_NODE_HOST_ENABLED=true
# CARINA_GATEWAY_URL=http://127.0.0.1:3000
# CARINA_NODE_MAX_FILE_BYTES=5242880
# CARINA_NODE_FILE_ROOTS=$CARINA_HOME/node-files
# CARINA_NODE_FILE_POLICY=on
# CARINA_NODE_POLL_MS=3000
# CARINA_NODE_SHELL_POLICY=on
# CARINA_NODE_SHELL_TIMEOUT_MS=30000
# CARINA_NODE_TRANSPORT=auto
# CARINA_NODE_WS=true
# CARINA_NODE_CONTAINER_IMAGE=alpine:3.20
# CARINA_PHONE_NODE_ID=

# Sandbox backends: default docker-runner, or openshell (hardened read-only profile)
# CARINA_SANDBOX_BACKEND=openshell
# Command flagging: Carina flags risky shell commands before executing.
# Default: on. Set to 'off' to disable (not recommended for production).
# CARINA_COMMAND_FLAG=on
# CARINA_COMMAND_FLAG_OVERRIDE=1
# CARINA_APPROVAL_POLICY=off
# CARINA_APPROVAL_SHELL_SCAN=on
# CARINA_APPROVAL_AUTO_LOW=true
# CARINA_APPROVAL_REMEMBER_MS=3600000
# CARINA_SANDBOX_SESSION=true
# Exec approval levels (OpenClaw parity): off | on-miss | full
# CARINA_EXEC_APPROVAL_LEVEL=on-miss
# Security advisories feed (optional remote JSON URL; builtin advisories always included)
# CARINA_SECURITY_ADVISORIES_URL=
# Channel interactive approval UI (default on; set false or off to disable)
# CARINA_CHANNEL_APPROVAL_UI=true
# Block streaming for Telegram (OpenClaw-style paragraph/code-fence chunks)
# CARINA_BLOCK_STREAM=true
# Provider API quota polling (rate-limit headers + optional OpenAI usage probe)
# CARINA_PROVIDER_QUOTA_POLL=true
# CARINA_PROVIDER_QUOTA_HOUR=4
# CARINA_PROVIDER_QUOTA_MINUTE=15

# Extension bundles (opt-in; skills/tools/prompts/RAG/MCP/hooks from carina extensions install)
# CARINA_EXTENSIONS_ENABLED=false
# CARINA_EVAL_GATE=off
# CARINA_EVAL_GATE=require
# Eval gate blocks enable unless bundle passes offline eval (or use --bypass-eval)

# TaskFlows (enabled by default; durable automation outside chat path)
# CARINA_TASKFLOWS_ENABLED=false
# CARINA_TASKFLOWS_WEBHOOK_HOOK=false
# CARINA_TASKFLOWS_WORKER=true
# CARINA_TASKFLOWS_WORKER_POOL=2
# CARINA_TASKFLOWS_WORKER_INTERVAL_MS=30000
# CARINA_ORCHESTRATOR_KANBAN=true
# CARINA_KANBAN_LANE_POOL=3
# CARINA_TASKFLOWS_WORKER_INTERVAL_MS=30000
# CARINA_TASKFLOWS_DELIVERY_WORKER=true
# CARINA_TASKFLOWS_RUN_TIMEOUT_MS=900000

# ACP bridge (IDE/client integration; gateway routes at /acp/*)
# CARINA_ACP_ENABLED=false
# CARINA_ACP_MODE=server
# CARINA_ACP_PROVENANCE=relaxed
# CARINA_ACP_AUTH=required
# CARINA_ACP_PASSWORD_FILE=
# CARINA_ACP_PASSWORD=

# Provider debug proxy (operator-only traffic inspection)
# CARINA_DEBUG_PROXY_PORT=19229
# CARINA_DEBUG_PROXY_CAPTURE=false
# CARINA_DEBUG_PROXY_PROVIDERS=*
# CARINA_DEBUG_PROXY_ROUTING=false

# Memory injection (chat context; default full; minimal = persistent+history only; off = none)
# CARINA_MEMORY_INJECTION=full
# CARINA_MEMORY_INJECTION=minimal
# CARINA_MEMORY_INJECTION=off

# Workspace import and file watcher (audit log at session-lineage.json sibling paths)
# CARINA_IMPORT_WORKSPACE=true
# CARINA_IMPORT_WORKSPACE_FROM=~/.openclaw
# CARINA_WORKSPACE_WATCH=false
# CARINA_WORKSPACE_WATCH_DEBOUNCE_MS=400

# Skill auto-capture from completed tasks (default on; set false to disable)
# CARINA_AUTO_SKILL=false
# Index compact work summaries in session memory when no skill is extracted (default on)
# CARINA_TASK_OUTCOMES=false
# Teacher escalation when a cheap/local model fails a turn (default on)
# CARINA_TEACHER_ESCALATION=false
# CARINA_TEACHER_PROVIDER=anthropic
# CARINA_TEACHER_MODEL=
# CARINA_RESEARCH_QUALITY_MIN=75
# SKILL_AUTO_WRITE=true

# Skill workshop (queue auto-captured skills for operator review before publish)
# CARINA_SKILL_WORKSHOP=false
# CARINA_AUTO_SKILL_LEARN=false

# Operator tooling (CLI-only; does not affect chat path)
# CARINA_HOME=~/.carina
# CARINA_GLOBAL_HOME=~/.carina
# CARINA_CREDENTIALS_FILE=
# CARINA_LOCAL_MODE=true
# CARINA_SKIP_POSTGRES=true
# SKILLS_HUB_PUBLISH_API_KEY=
# CARINA_HUB_TOKEN=              # alias for publish API key (carina pack publish)

# Mem0 cloud (https://mem0.ai) or self-hosted OSS
MEM0_API_KEY=
MEM0_URL=
MEM0_MODE=cloud
MEM0_USER_ID=
# Optional vertical skill packs (comma-separated). Leave empty for a general-purpose agent.
# Example: ACTIVE_SKILL_PACKS=property-uk,core-engineering
ACTIVE_SKILL_PACKS=

# Trajectory compression (long agent tool loops / context window management)
CARINA_TRAJECTORY_COMPRESSION=true
CARINA_TRAJECTORY_MAX_CHARS=120000
CARINA_TRAJECTORY_TOOL_MAX_CHARS=4000
CARINA_TRAJECTORY_KEEP_RECENT=4
CARINA_TRAJECTORY_COMPRESS_AFTER=6
CARINA_TRAJECTORY_SUMMARY_MAX_CHARS=600

# Web search (web-search tool). Tavily is the default (free tier at tavily.com).
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# Optional paid fallback only (~$5 per 1,000 queries at brave.com/search/api):
# SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=

# --- Channels ---
# Share one gateway session across CLI, web, TUI, and messengers (optional)
# CARINA_OPERATOR_SESSION=true
# Comma-separated provider failover order when the active provider errors
# CARINA_PROVIDER_FALLBACK=deepseek,anthropic,openai

# carina channels list | carina channels setup <name>

# Web (browser chat UI; enabled by default)
WEB_ENABLED=true
WEB_PORT=3000
# Use a single origin in production (not *). Example: https://core.carinaai.uk
CORS_ORIGIN=*

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_CHANNEL_IDS=

# Slack (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_SOCKET_MODE=false
SLACK_PORT=3002
SLACK_ALLOWED_CHANNEL_IDS=

# Ambient channel-resident agent (default off until tested)
CARINA_AMBIENT_MODE_ENABLED=false
CARINA_AMBIENT_SIGNAL_THRESHOLD=40
CARINA_AMBIENT_CHECK_INTERVAL_MS=7200000
CARINA_AMBIENT_CROSS_CHANNEL=false
CARINA_AMBIENT_LLM_EXTRACTION=false
CARINA_SLACK_AMBIENT_ENABLED=true
CARINA_SLACK_AMBIENT_CHANNELS=
CARINA_SLACK_AMBIENT_EXCLUDE_CHANNELS=
CARINA_SLACK_AMBIENT_BATCH_INTERVAL_MS=60000
CARINA_SLACK_AMBIENT_MAX_MESSAGES_PER_BATCH=50

# WhatsApp via Twilio webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_FROM_NUMBER=

# WhatsApp via Baileys (native; alternative to Twilio)
BAILEYS_WHATSAPP_ENABLED=false
WHATSAPP_BAILEYS_ENABLED=false
BAILEYS_QR_TERMINAL=true
BAILEYS_AUTH_DIR=
# Per-account session isolation (default account id when only one WhatsApp bridge is linked)
CARINA_WHATSAPP_ACCOUNT_ID=default
# WhatsApp session encryption key - REQUIRED when Baileys is enabled.
# Generate with: openssl rand -base64 32
# CRITICAL: Back this up. If lost, you must re-link all WhatsApp accounts.
# CRITICAL: Rotate if the VPS is compromised.
CARINA_WHATSAPP_SESSION_SECRET=
CARINA_WHATSAPP_GROUPS=false
CARINA_WHATSAPP_SELF_BRIDGE=false
CARINA_WHATSAPP_AUTO_TRANSCRIBE=true

# Channel policy (opt-in; no effect on chat speed when off)
# CARINA_THREAD_OWNERSHIP=true
# CARINA_CROSS_AGENT_LEARNING=false
# CARINA_CHANNEL_DM_PAIRING=true
# Required before connecting Telegram/Discord/Slack/WhatsApp to the public internet.
# Unknown DMs stay pending until: carina channels dm approve <channel> <peerId>
# CARINA_CHANNEL_PEER_SCOPING=true
# CARINA_INSTANCE_ID=default
# Per-channel DM pairing opt-out: CARINA_TELEGRAM_DM_PAIRING=false

# IRC (live TLS client; optional webhook fallback at POST /webhooks/irc)
# IRC_ENABLED=false
# IRC_LIVE=true
# IRC_SERVER=irc.libera.chat
# IRC_PORT=6697
# IRC_TLS=true
# IRC_NICK=carina-bot
# IRC_USERNAME=carina
# IRC_REALNAME=Carina AI
# IRC_PASSWORD=
# IRC_CHANNELS=#carina
# IRC_MENTION_ONLY=true
# IRC_NICKSERV_IDENTIFY=false

# Catalog webhook channels (former stubs; enable per platform)
# ZULIP_SITE=https://chat.example.com
# ZULIP_BOT_EMAIL=carina-bot@example.com
# ZULIP_API_KEY=
# REDDIT_WEBHOOK_SECRET=
# BLUESKY_HANDLE=carina.bsky.social
# BLUESKY_APP_PASSWORD=
# SKYPE_APP_ID=
# SKYPE_APP_SECRET=
# PUMBLE_WEBHOOK_URL=
# TWIST_INTEGRATION_TOKEN=
# RYVER_WEBHOOK_URL=
# WORKPLACE_APP_SECRET=
# WORKPLACE_VERIFY_TOKEN=
# WORKPLACE_PAGE_ACCESS_TOKEN=
# NAVER_WORKS_BOT_ID=
# NAVER_WORKS_BOT_SECRET=
# QQ_BOT_APP_ID=
# QQ_BOT_TOKEN=
# WEIBO_APP_KEY=
# WEIBO_APP_SECRET=
# OPENHAB_URL=http://localhost:8080
# OPENHAB_TOKEN=
# SYNOLOGY_CHAT_TOKEN=
# GITTER_TOKEN=
# ELEMENT_WEBHOOK_URL=
# MASTODON_INSTANCE=https://mastodon.social
# MASTODON_ACCESS_TOKEN=
# SNAPCHAT_WEBHOOK_SECRET=
# BRIDGE_CHANNEL_ENABLED=true
# BRIDGE_CHANNEL_SECRET=
# ABC_MERCHANT_ID=
# ABC_API_KEY=

# SMS (Twilio; uses TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER above)

# Signal (signal-cli-rest-api sidecar)
SIGNAL_API_URL=
SIGNAL_API_KEY=
SIGNAL_PHONE_NUMBER=
SIGNAL_POLL_ENABLED=true

# Matrix
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=
MATRIX_SYNC_ENABLED=true

# Mattermost
MATTERMOST_URL=
MATTERMOST_TOKEN=

# DingTalk
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
DINGTALK_APP_KEY=

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Viber Public Account
VIBER_AUTH_TOKEN=

# Google Chat
GOOGLE_CHAT_VERIFICATION_TOKEN=
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=

# Microsoft Teams (Bot Framework)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# WeChat Work (WeCom)
WECHAT_WEBHOOK_URL=
WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=

# iMessage (BlueBubbles macOS bridge)
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
IMESSAGE_API_URL=
IMESSAGE_API_KEY=

# Email channel (inbound webhook)
EMAIL_CHANNEL_ENABLED=false
EMAIL_CHANNEL_WEBHOOK_SECRET=

# Home Assistant
HA_CHANNEL_ENABLED=false
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
HA_CHANNEL_NOTIFY_SERVICE=notify
HA_CHANNEL_WEBHOOK_SECRET=

# API channel (HTTP; POST /webhooks/api/message)
API_CHANNEL_ENABLED=false
API_CHANNEL_API_KEY=
CARINA_API_KEY=

# Generic webhook channel (POST /webhooks/webhooks)
WEBHOOK_CHANNEL_ENABLED=false
WEBHOOK_CHANNEL_SECRET=
WEBHOOK_CHANNEL_DEFAULT_CALLBACK_URL=

# Private-instance gate for the web chat UI (core.carinaai.uk)
# Required to sign in at /login. Leave unset to keep the instance closed to everyone.
# Stored as a bcrypt hash. Set via: carina ops set-password
# Docker Compose: quote bcrypt hashes (they contain $), e.g. CARINA_WEB_PASSWORD='$2a$10$...'
# This is NOT the same as CARINA_OPS_TOKEN (which is a plain random string for inter-service auth).
CARINA_WEB_PASSWORD=
# Optional TOTP secret (base32) for web UI 2FA after password login.
# Enable via env or: carina security totp enable
CARINA_WEB_TOTP_SECRET=
WEB_SESSION_SECRET=change_me_generate_a_random_64_char_hex_string

HOSTED_MODE=false
# Product surface split (same codebase, different hosts):
#   app.carinaai.uk  -> hosted SaaS (CARINA_OPERATOR_HOSTS must NOT include app host)
#   core.carinaai.uk -> private instance (listed in CARINA_OPERATOR_HOSTS)
#   ops.carinaai.uk  -> separate ops console (not served by core web gateway)
# Optional override for local testing: CARINA_PRODUCT_MODE=hosted|private|ops
# CARINA_PRODUCT_MODE=
# Carina Cloud product (hosted SaaS at app.carinaai.uk). Requires HOSTED_MODE=true.
CARINA_CLOUD_ENABLED=false
# Free tier daily chat message cap for hosted tenants.
CARINA_CLOUD_FREE_DAILY_MESSAGES=100
JWT_SECRET=
CARINA_OPERATOR_HOSTS=core.carinaai.uk,localhost
CARINA_HOSTED_APP_HOST=app.carinaai.uk
CARINA_OPS_PRODUCT_ENABLED=false
# Allow workbench runs on platform API keys when tenant has no Vault BYOK key.
# CARINA_OPS_MANAGED_WORKBENCH_ENABLED=true
# Compare ops_credit_ledger provider cost vs model_usage monthly; log drift above 5%.
# CARINA_OPS_RECONCILIATION_ENABLED=true
# CARINA_OPS_RECONCILIATION_INTERVAL_HOURS=24
STRIPE_PRO_PRICE_ID=
SKILLS_HUB_URL=https://hub.carinaai.uk

# Hub premium pack checkout (Stripe). Uses same account as Carina Cloud or separate keys.
# HUB_STRIPE_SECRET_KEY=
# HUB_STRIPE_WEBHOOK_SECRET=
# HUB_CHECKOUT_SUCCESS_URL=https://hub.carinaai.uk/?purchase=success
# HUB_CHECKOUT_CANCEL_URL=https://hub.carinaai.uk/?purchase=cancel
# Per-pack Stripe Price ID (optional): STRIPE_PRICE_PACK_<SLUG_UPPERCASE>=price_...
# HUB_PACK_AUTHOR_REVENUE_SHARE_BPS=7000
# HUB_PACK_CARINA_REVENUE_SHARE_BPS=2000
# HUB_PACK_PLATFORM_FEE_BPS=1000

# Bootstrap / recovery account (operator use only).
# On startup, Carina creates this account if it does not already exist.
# Existing accounts are NOT overwritten unless you run: carina hosted bootstrap --reset
# Clear these vars once you have a permanent account to prevent accidental resets.
HOSTED_BOOTSTRAP_EMAIL=
HOSTED_BOOTSTRAP_PASSWORD=

# Stripe billing. Supply test/live values from your Stripe account; never commit real secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Aiva subscription prices (create with: tsx scripts/stripe-setup-aiva.ts)
# STRIPE_PRICE_AIVA_STARTER_MONTHLY=
# STRIPE_PRICE_AIVA_STARTER_ANNUAL=
# STRIPE_PRICE_AIVA_GROWTH_MONTHLY=
# STRIPE_PRICE_AIVA_GROWTH_ANNUAL=
# STRIPE_PRICE_AIVA_SEAT_MONTHLY=
# Optional special client rate (not marketed; e.g. Prompt Rate £30 from credentials file):
# STRIPE_PRICE_AIVA_PROMPT_RATE_MONTHLY=
# Legacy (grandfathered subscriptions only):
# STRIPE_PRICE_AIVA_TEAM_MONTHLY=
# STRIPE_PRICE_AIVA_TEAM_ANNUAL=
# STRIPE_PRICE_AIVA_BUSINESS_MONTHLY=
# STRIPE_PRICE_AIVA_BUSINESS_ANNUAL=
# Aiva webhook: https://core.carinaai.uk/api/billing/stripe/webhook
AIVA_BILLING_ENABLED=true
AIVA_GRACE_PERIOD_DAYS=7
# Aiva admin panel (admin.carinaai.uk)
# ADMIN_TOKEN_SECRET=
# ADMIN_SETUP_TOKEN=
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

STRIPE_PRICE_SCOUT_MONITOR=
STRIPE_PRICE_SCOUT_PRO=
STRIPE_PRICE_SCOUT_STANDARD=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_CARINA_OPS_STARTER=price_placeholder_starter
STRIPE_PRICE_CARINA_OPS_TEAM=price_placeholder_team

# Resend transactional email (org invites, password reset). Required for invite emails in Carina Ops.
RESEND_API_KEY=
EMAIL_FROM=noreply@carinaai.uk
EMAIL_FROM_NAME=Carina by VERLOX
RESEND_PREVIEW_MODE=false
# Aiva product URLs for transactional email links
# AIVA_APP_URL=https://admin.hireaiva.co.uk
# AIVA_EMAIL_CRON_ENABLED=true

# Resend inbound webhook signature (Svix secret from Resend dashboard)
RESEND_WEBHOOK_SECRET=

# Enterprise security (gap-08: SSO, audit, residency, DR, zero trust)
# CARINA_PUBLIC_URL=https://app.carinaai.uk
# CARINA_SSO_OIDC_ISSUER=https://your-idp.example.com
# CARINA_SSO_OIDC_CLIENT_ID=
# CARINA_SSO_OIDC_CLIENT_SECRET=
# CARINA_SSO_SAML_ENTRYPOINT=
# CARINA_SSO_SAML_ISSUER=https://app.carinaai.uk/auth/saml/metadata
# CARINA_SSO_LDAP_URL=ldaps://ldap.example.com
# CARINA_SSO_LDAP_BASE_DN=dc=example,dc=com
# CARINA_SSO_LOCAL_ADMIN_BYPASS=true
# CARINA_SSO_JIT_PROVISIONING=true
# CARINA_SSO_DEFAULT_ROLE=viewer
# DATA_RESIDENCY_REGION=eu-west
# DATA_RESIDENCY_MODE=strict
# DATA_RESIDENCY_ENCRYPTION=aws-kms
# CARINA_DR_TIER=enterprise
# CARINA_DR_PRIMARY_REGION=eu-west-1
# CARINA_DR_STANDBY_REGION=us-east-1
# CARINA_DR_PRIMARY_HEALTH_URL=https://app.carinaai.uk/health
# CARINA_MTLS_ENABLED=false
# CARINA_MTLS_CERT_DIR=/etc/carina/mtls
# SPIFFE_TRUST_DOMAIN=carina.ai

# Labyrinth Scout integration (security control plane)
# Set LABYRINTH_ENABLED=true to activate reporting. Safe to leave false in development.
LABYRINTH_ENABLED=false
LABYRINTH_URL=http://localhost:4444
LABYRINTH_API_KEY=your_scout_api_key_here
# Scout Engine product API (carina scout score|targets|agents|alerts|compliance)
SCOUT_ENGINE_URL=http://localhost:4444
SCOUT_ENGINE_API_KEY=
SCOUT_PROVISION_SECRET=
LABYRINTH_INSTANCE_ID=carina-local
LABYRINTH_INSTANCE_NAME=Carina Local
LABYRINTH_LLM_ROUTER_URL=http://localhost:3000
LABYRINTH_JUDGE_MODEL=deepseek/deepseek-chat
# LABYRINTH_JUDGE_TIMEOUT_MS=3000

# Tool Policy (Labyrinth Scout)
SCOUT_BLOCKLIST=
SCOUT_RATE_LIMIT_MINUTE=15
SCOUT_RATE_LIMIT_HOUR=200

# Defence-in-depth (enabled automatically when LABYRINTH_ENABLED=true)
# TOOL_SEQUENCE_GUARD_ENABLED=true
# JIT_CREDENTIALS_ENABLED=true
SCOUT_CONTROL_MODE=enforce
SCOUT_ENFORCEMENT_ENABLED=true
# JIT_CREDENTIAL_TOOLS=shell-exec,email-send,file-write,http-request,code-exec
# AGENT_GUARD_ENABLED=false
# AGENT_GUARD_THRESHOLD=0.4
# AGENT_GUARD_PYTHON=python3

# Egress Filter (Labyrinth Scout)
SCOUT_ALLOWED_DOMAINS=

# AI Workers (Aiva)
AI_WORKERS_ENABLED=true
# Run each Aiva worker in an isolated worker_thread (512MB heap limit). Set false to disable.
AIVA_WORKER_ISOLATION=true
EMAIL_INGESTION_ENABLED=false
AIVA_EMAIL_POLL_CRON=*/5 * * * *
AIVA_EMAIL_POLL_LIMIT=25
PROPREENEUR_BRIDGE_ENABLED=false
PROPREENEUR_BRIDGE_WRITES=false
AIVA_DAILY_SUMMARY_ENABLED=false
AIVA_DAILY_SUMMARY_CRON=0 7 * * *
AIVA_SUMMARY_TTS_MAX_CHARS=1500
PROPREENEUR_EVENT_WEBHOOKS=false
PROPREENEUR_WEBHOOK_HMAC_SECRET=
PROPREENEUR_TENANT_BASE_DOMAIN=propreneur.uk
# Shared secret for Carina Hub <-> Propreneur async reply webhooks
CARINA_HUB_WEBHOOK_SECRET=
# Load kb-* skills generated from synced Propreneur brain knowledge (property-uk pack only)
BRAIN_KNOWLEDGE_SKILLS_ENABLED=false
BRAIN_KNOWLEDGE_PATH=
ESCALATION_HOLDING_MESSAGE="I am checking on this and will get back to you shortly."
SCOUT_OPS_TOKEN=
AIVA_SCOUT_FLEET_ENABLED=true
AIVA_CHAIN_ATTEST_ENABLED=true

# Aiva channel delivery (encrypt credentials at rest)
# openssl rand -hex 32
CHANNEL_CREDENTIAL_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SLACK_SIGNING_SECRET=
POSTMARK_INBOUND_WEBHOOK_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CORE_URL=https://core.carinaai.uk

# Turn telemetry (offline JSONL at <CARINA_HOME>/data/logs/turns.jsonl; no chat latency cost)
# CARINA_TURN_LOG=false
# CARINA_TURN_LOG_SLOW_MS=8000

# OpenTelemetry trace export (mirrors Carina trace spans when enabled)
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=carina-core
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_TRACES_EXPORTER=console

# Proactive check-in / heartbeat (OpenClaw pattern)
# CARINA_CHECK_IN_ENABLED=false
# CARINA_CHECK_IN_INTERVAL_MINUTES=30
# CARINA_QUIET_START_HOUR=23
# CARINA_QUIET_END_HOUR=8

# Hub shared-skills sync (pull from SKILLS_HUB_URL on interval)
# CARINA_HUB_SYNC_ENABLED=true
# CARINA_HUB_SYNC_INTERVAL_HOURS=24

# REM memory dreaming / nightly consolidation (Postgres episodic backend)
# CARINA_REM_ENABLED=true
# CARINA_REM_NIGHTLY=false
# CARINA_REM_NIGHTLY_HOUR=3
# CARINA_REM_NIGHTLY_MINUTE=0
# CARINA_REM_CYCLE_MS=300000
# CARINA_REM_PROMOTE_THRESHOLD=0.72
# CARINA_REM_AUTO_PROMOTE_THRESHOLD=0.92

# Skill curator daemon (on by default in Postgres runtime; set false to disable)
# CARINA_SKILL_CURATOR_ENABLED=false
# CARINA_SKILL_CURATOR_INTERVAL_HOURS=6
# CARINA_CURATOR_INTERVAL_DAYS=1
# CARINA_SKILL_CURATOR_MAX_AGE_DAYS=90
# CARINA_SKILL_CURATOR_MIN_USAGE=0
# CARINA_SKILL_CURATOR_REPORT_DIR=

# MCP server mode (opt-in: carina mcp server; does not affect normal chat/runtime)
# CARINA_MCP_ALLOW_DANGEROUS=false
# CARINA_MCP_SERVER_TOKEN=
# CARINA_MCP_HTTP_PORT=8765
# CARINA_MCP_HTTP_HOST=127.0.0.1
