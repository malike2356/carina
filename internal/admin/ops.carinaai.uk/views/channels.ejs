<% title = 'Channels' %>
<% const stateBadge = (state) => {
  switch (state) {
    case 'connected': return 'ops-badge-green';
    case 'configured': return 'ops-badge-cyan';
    case 'partial': return 'ops-badge-amber';
    case 'error': return 'ops-badge-red';
    default: return 'ops-badge-gray';
  }
}; %>
<% const connectedCount = channels.filter((c) => c.state === 'connected').length;
   const configuredCount = channels.filter((c) => c.state === 'configured' || c.state === 'partial').length;
   const disabledCount = channels.filter((c) => c.state === 'disabled' || c.state === 'unsupported').length; %>

<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Channel health</div>
      <div class="ops-page-sub">Gateway adapter status from core env and registry. Live connected state requires Carina at <code class="ops-code"><%= carinaApiUrl %></code>.</div>
    </div>
  </div>

  <div class="ops-metrics">
    <div class="ops-metric"><div class="ops-metric-label">Connected</div><div class="ops-metric-value ok"><%= connectedCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Configured</div><div class="ops-metric-value"><%= configuredCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Disabled</div><div class="ops-metric-value muted"><%= disabledCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Total</div><div class="ops-metric-value"><%= channels.length %></div></div>
  </div>

  <div class="ops-surface ops-table-wrap">
    <table class="ops-table">
      <thead>
        <tr><th>Channel</th><th>State</th><th>Active</th><th>Transport</th><th>Notes</th></tr>
      </thead>
      <tbody>
        <% for (const ch of channels) { %>
          <tr>
            <td style="font-weight:600;color:var(--heading);"><%= ch.name %></td>
            <td><span class="ops-badge <%= stateBadge(ch.state) %>"><%= ch.state %></span></td>
            <td><%= ch.active ? 'yes' : 'no' %></td>
            <td><%= ch.transport || '-' %></td>
            <td style="color:var(--muted);max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= ch.notes || '-' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
