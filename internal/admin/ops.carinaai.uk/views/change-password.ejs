<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carina Admin · Change Password</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="min-h-screen flex items-center justify-center bg-[#0f0f0f] text-[#e0e0e0]">
  <form method="post" action="/users/change-password" class="w-full max-w-sm bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-8">
    <h1 class="text-xl font-bold text-white mb-2">Set a new password</h1>
    <p class="text-sm text-gray-400 mb-6">Your account requires a password change before continuing.</p>
    <% if (error) { %><p class="text-red-400 text-sm mb-4"><%= error %></p><% } %>
    <label class="block text-sm text-gray-400 mb-1" for="password">New password</label>
    <input type="password" id="password" name="password" required minlength="8" autofocus
           class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 mb-4 text-white focus:border-[#22c55e] outline-none">
    <label class="block text-sm text-gray-400 mb-1" for="confirm">Confirm password</label>
    <input type="password" id="confirm" name="confirm" required minlength="8"
           class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 mb-6 text-white focus:border-[#22c55e] outline-none">
    <button type="submit" class="w-full bg-[#22c55e] text-black font-medium py-2 rounded hover:opacity-90">
      Update password
    </button>
  </form>
</body>
</html>
