<% title = 'Tenant Tool Overrides' %>
<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-white">Tenant Tool Overrides</h1>
    <p class="text-sm text-gray-400 mt-1">Workspace <code class="text-[#06b6d4]"><%= workspaceId %></code></p>
  </div>
  <a href="/admin/agent-tools" class="text-sm text-[#06b6d4] hover:underline">Back to global tools</a>
</div>

<% if (message) { %>
  <div class="mb-4 rounded-lg border px-4 py-3 text-sm <%= messageIsError ? 'border-red-600/50 bg-red-950/30 text-red-200' : 'border-green-600/50 bg-green-950/30 text-green-200' %>">
    <%= message %>
  </div>
<% } %>

<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
      <thead class="text-gray-400 border-b border-[#2a2a2a] bg-[#141414]">
        <tr>
          <th class="px-4 py-3 font-medium">Category</th>
          <th class="px-4 py-3 font-medium">Global</th>
          <th class="px-4 py-3 font-medium">Override</th>
          <th class="px-4 py-3 font-medium">Limits</th>
          <th class="px-4 py-3 font-medium"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#2a2a2a]">
        <% categories.forEach((cat) => { const override = overrideByCategory.get(cat.category); %>
          <tr class="align-top hover:bg-[#222]">
            <td class="px-4 py-3">
              <div class="font-medium text-white"><%= cat.label %></div>
              <div class="text-xs text-gray-500 font-mono"><%= cat.category %></div>
            </td>
            <td class="px-4 py-3 text-xs text-gray-400">
              <div><%= cat.enabled ? 'Enabled' : 'Disabled' %></div>
              <div><%= cat.maxCalls %> calls</div>
              <div><%= cat.timeoutMs %>ms</div>
              <div><%= cat.requiresApproval ? 'Approval required' : 'No approval' %></div>
            </td>
            <td class="px-4 py-3" colspan="3">
              <form method="post" action="/admin/agent-tools/tenant/<%= encodeURIComponent(workspaceId) %>/<%= encodeURIComponent(cat.category) %>" class="grid grid-cols-1 md:grid-cols-[150px_140px_140px_160px_80px] gap-2 items-end">
                <label>
                  <span class="block text-xs text-gray-400 mb-1">Status</span>
                  <select name="enabled" class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-2">
                    <option value="inherit" <%= !override || override.enabled === null ? 'selected' : '' %>>Inherit</option>
                    <option value="true" <%= override && override.enabled === true ? 'selected' : '' %>>Enabled</option>
                    <option value="false" <%= override && override.enabled === false ? 'selected' : '' %>>Disabled</option>
                  </select>
                </label>
                <label>
                  <span class="block text-xs text-gray-400 mb-1">Max calls</span>
                  <input type="number" name="maxCalls" value="<%= override?.maxCalls ?? '' %>" min="1" max="50" placeholder="<%= cat.maxCalls %>"
                    class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-2" />
                </label>
                <label>
                  <span class="block text-xs text-gray-400 mb-1">Timeout</span>
                  <input type="number" name="timeoutMs" value="<%= override?.timeoutMs ?? '' %>" min="1000" max="120000" step="1000" placeholder="<%= cat.timeoutMs %>"
                    class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-2" />
                </label>
                <label>
                  <span class="block text-xs text-gray-400 mb-1">Approval</span>
                  <select name="requiresApproval" class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-2">
                    <option value="inherit" <%= !override || override.requiresApproval === null ? 'selected' : '' %>>Inherit</option>
                    <option value="true" <%= override && override.requiresApproval === true ? 'selected' : '' %>>Required</option>
                    <option value="false" <%= override && override.requiresApproval === false ? 'selected' : '' %>>Not required</option>
                  </select>
                </label>
                <button type="submit" class="rounded bg-[#22c55e] hover:bg-green-400 text-black text-sm font-semibold px-3 py-2">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
