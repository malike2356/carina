<% title = 'Batches' %>
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Batches</h1>
<% if (saved) { %><p class="text-sm text-[#22c55e] mb-4">Saved.</p><% } %>

<% if (!org.batchEnabled) { %>
  <p class="text-sm text-amber-400 mb-4">Batch API is disabled for this org. Enable it under <a href="/ai-platform/credits" class="underline">Credits</a>.</p>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <form method="post" action="/ai-platform/batches" class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4 space-y-3 h-fit <%= org.batchEnabled ? '' : 'opacity-50 pointer-events-none' %>">
    <h2 class="text-sm font-semibold text-white">Create batch job</h2>
    <input name="name" placeholder="Job name" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <input name="promptCount" type="number" min="1" value="10" placeholder="Prompt count" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <textarea name="notes" rows="3" placeholder="Notes" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white"></textarea>
    <button type="submit" class="w-full py-2 bg-[#22c55e] text-black rounded text-sm font-medium">Queue batch</button>
  </form>

  <div class="lg:col-span-2 bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <% if (!batches.length) { %>
      <p class="text-gray-500 text-sm">No batch jobs. Jobs persist locally until async execution is wired.</p>
    <% } else { %>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
            <th class="py-2 pr-3">Name</th>
            <th class="py-2 pr-3">Status</th>
            <th class="py-2 pr-3">Prompts</th>
            <th class="py-2 pr-3">Created</th>
            <th class="py-2">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for (const b of batches) { %>
            <tr class="border-b border-[#2a2a2a]/50">
              <td class="py-2 pr-3 text-white"><%= b.name %></td>
              <td class="py-2 pr-3"><%= b.metadataJson.status || b.status %></td>
              <td class="py-2 pr-3 text-gray-400"><%= b.metadataJson.completedCount || 0 %> / <%= b.metadataJson.promptCount || 0 %></td>
              <td class="py-2 pr-3 text-gray-500 text-xs"><%= new Date(b.createdAt).toLocaleString() %></td>
              <td class="py-2">
                <% if ((b.metadataJson.status || b.status) !== 'cancelled' && (b.metadataJson.status || b.status) !== 'completed') { %>
                  <form method="post" action="/ai-platform/batches/<%= b.id %>/cancel" class="inline">
                    <button type="submit" class="text-xs text-red-400 hover:underline">Cancel</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
