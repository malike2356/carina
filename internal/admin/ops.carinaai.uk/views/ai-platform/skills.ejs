<% title = 'Skills' %>
<div class="ops-page">
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Skills</h1>
<% if (saved) { %><p class="text-sm text-[#22c55e] mb-4">Saved.</p><% } %>
<% if (error) { %><p class="text-sm text-amber-400 mb-4"><%= error %></p><% } %>

<p class="text-sm text-gray-400 mb-4">Installed skill packs from Carina core. Toggle platform visibility without duplicating pack storage.</p>

<% if (!available.length) { %>
  <div class="ops-surface p-6 text-center">
    <p class="text-gray-500 text-sm">No skill packs loaded. Pair Carina and install packs from <a href="/packs" class="ops-link">Skill Packs</a>.</p>
  </div>
<% } else { %>
  <div class="space-y-3">
    <% for (const pack of available) { %>
      <% const ov = overrides.get(pack.name) || { featured: false, enabled: true }; %>
      <form method="post" action="/ai-platform/skills" class="ops-stat-cell flex flex-wrap items-center justify-between gap-4">
        <input type="hidden" name="slug" value="<%= pack.name %>">
        <input type="hidden" name="name" value="<%= pack.name %>">
        <div>
          <p class="text-white font-medium"><%= pack.name %> <span class="text-gray-500 text-xs">v<%= pack.version %></span></p>
          <p class="text-xs text-gray-400 mt-1"><%= pack.description %></p>
          <p class="text-xs text-gray-500 mt-1"><%= pack.skillCount ?? '?' %> skills<% if (pack.category) { %> · <%= pack.category %><% } %></p>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <label class="flex items-center gap-2 text-gray-400">
            <input type="checkbox" name="enabled" value="1" <%= ov.enabled ? 'checked' : '' %>> Enabled
          </label>
          <label class="flex items-center gap-2 text-gray-400">
            <input type="checkbox" name="featured" value="1" <%= ov.featured ? 'checked' : '' %>> Featured
          </label>
          <button type="submit" class="px-3 py-1 bg-[#2a2a2a] rounded text-white text-xs hover:bg-[#333]">Save</button>
        </div>
      </form>
    <% } %>
  </div>
<% } %>
</div>
