<% title = 'Sessions' %>
<div class="ops-page">
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Sessions</h1>
<% if (saved) { %><p class="text-sm text-[#22c55e] mb-4">Saved.</p><% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <form method="post" action="/ai-platform/sessions" class="ops-stat-cell space-y-3 h-fit">
    <h2 class="text-sm font-semibold text-white">Log session</h2>
    <input name="title" required placeholder="Session title" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <select name="agentId" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
      <option value="">No agent</option>
      <% for (const a of agents) { %>
        <option value="<%= a.id %>"><%= a.name %></option>
      <% } %>
    </select>
    <textarea name="summary" rows="3" placeholder="Summary" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white"></textarea>
    <button type="submit" class="w-full py-2 bg-[#22c55e] text-black rounded text-sm font-medium">Create</button>
  </form>

  <div class="lg:col-span-2 ops-stat-cell">
    <% if (!sessions.length) { %>
      <p class="text-gray-500 text-sm">No sessions recorded.</p>
    <% } else { %>
      <table class="ops-table w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
            <th class="py-2 pr-3">Title</th>
            <th class="py-2 pr-3">Status</th>
            <th class="py-2 pr-3">Started</th>
            <th class="py-2">Summary</th>
          </tr>
        </thead>
        <tbody>
          <% for (const s of sessions) { %>
            <tr class="border-b border-[#2a2a2a]/50">
              <td class="py-2 pr-3 text-white"><%= s.title %></td>
              <td class="py-2 pr-3 text-gray-400"><%= s.status %></td>
              <td class="py-2 pr-3 text-gray-500 text-xs"><%= new Date(s.startedAt).toLocaleString() %></td>
              <td class="py-2 text-gray-400 text-xs truncate max-w-xs"><%= s.summary || '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
</div>
