<% title = 'Workbench' %>
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Workbench</h1>

<% if (saved) { %><p class="text-sm text-[#22c55e] mb-4">Saved.</p><% } %>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <div class="xl:col-span-2 space-y-4">
    <form method="post" action="/ai-platform/workbench" class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4 space-y-3">
      <div>
        <label class="block text-xs text-gray-400 mb-1">Title</label>
        <input name="title" type="text" value="<%= selectedRun ? selectedRun.title : '' %>"
               class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white" placeholder="Optional run title">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-gray-400 mb-1">Model</label>
          <select name="modelId" id="model-select" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
            <% for (const m of models) { %>
              <option value="<%= m.id %>" data-provider="<%= m.provider %>" data-model="<%= m.model %>"
                <%= selectedRun && selectedRun.provider === m.provider && selectedRun.model === m.model ? 'selected' : (m.isDefault && !selectedRun ? 'selected' : '') %>>
                <%= m.provider %> / <%= m.model %>
              </option>
            <% } %>
          </select>
        </div>
        <div class="flex items-end">
          <label class="flex items-center gap-2 text-xs text-gray-400 pb-2">
            <input type="checkbox" disabled <%= org.promptCachingEnabled ? 'checked' : '' %>>
            Prompt cache (org: <%= org.promptCachingEnabled ? 'on' : 'off' %>)
          </label>
        </div>
      </div>
      <div>
        <label class="block text-xs text-gray-400 mb-1">Prompt</label>
        <textarea name="prompt" id="prompt-input" rows="8"
                  class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white font-mono"><%= selectedRun ? selectedRun.prompt : '' %></textarea>
      </div>
      <div class="flex gap-2">
        <button type="submit" name="action" value="draft" class="px-4 py-2 text-sm border border-[#2a2a2a] rounded text-gray-300 hover:bg-[#2a2a2a]">Save draft</button>
        <button type="submit" name="action" value="run" id="run-btn" class="px-4 py-2 text-sm bg-[#22c55e] text-black rounded font-medium">Run now</button>
      </div>
    </form>

    <section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4 min-h-[200px]">
      <h2 class="text-sm font-semibold text-white mb-2">Response</h2>
      <div id="response-panel" class="text-sm text-gray-300 whitespace-pre-wrap font-mono"><%= selectedRun && selectedRun.responseText ? selectedRun.responseText : '' %></div>
      <dl id="run-meta" class="mt-4 grid grid-cols-3 gap-2 text-xs text-gray-500 <%= selectedRun && selectedRun.status === 'completed' ? '' : 'hidden' %>">
        <div><dt>Status</dt><dd id="meta-status" class="text-gray-300"><%= selectedRun ? selectedRun.status : '' %></dd></div>
        <div><dt>Tokens</dt><dd id="meta-tokens" class="text-gray-300"><%= selectedRun ? (selectedRun.tokensIn + ' / ' + selectedRun.tokensOut) : '' %></dd></div>
        <div><dt>Cost</dt><dd id="meta-cost" class="text-gray-300"><%= selectedRun ? ('$' + selectedRun.costEstimate.toFixed(4)) : '' %></dd></div>
      </dl>
    </section>
  </div>

  <aside class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <h2 class="text-sm font-semibold text-white mb-3">Recent runs</h2>
    <% if (!runs.length) { %>
      <p class="text-gray-500 text-xs">No runs yet.</p>
    <% } else { %>
      <ul class="space-y-2 text-xs max-h-[70vh] overflow-y-auto">
        <% for (const run of runs) { %>
          <li class="border-b border-[#2a2a2a] pb-2">
            <a href="/ai-platform/workbench?run=<%= run.id %>" class="text-[#06b6d4] hover:underline block truncate"><%= run.title %></a>
            <span class="text-gray-500"><%= run.status %> · <%= new Date(run.createdAt).toLocaleString() %></span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </aside>
</div>

<script>
  const RUN_ID = <%= selectedRun ? JSON.stringify(selectedRun.id) : 'null' %>;
  const AUTORUN = <%= autorun ? 'true' : 'false' %>;
  const promptEl = document.getElementById('prompt-input');
  const responseEl = document.getElementById('response-panel');
  const runMeta = document.getElementById('run-meta');

  async function streamRun(runId, prompt) {
    responseEl.textContent = '';
    runMeta.classList.remove('hidden');
    document.getElementById('meta-status').textContent = 'running';

    let full = '';
    const sessionId = crypto.randomUUID();
    const url = new URL('/ai-platform/stream', window.location.origin);
    url.searchParams.set('message', prompt);
    url.searchParams.set('sessionId', sessionId);

    return new Promise((resolve) => {
      const es = new EventSource(url.toString());
      es.onmessage = async (e) => {
        if (e.data === '[DONE]') {
          es.close();
          const tokensIn = Math.ceil(prompt.length / 4);
          const tokensOut = Math.ceil(full.length / 4);
          if (runId) {
            const r = await fetch('/ai-platform/workbench/' + runId + '/complete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ responseText: full, tokensIn, tokensOut }),
            });
            const data = await r.json();
            document.getElementById('meta-status').textContent = 'completed';
            document.getElementById('meta-tokens').textContent = data.tokensIn + ' / ' + data.tokensOut;
            document.getElementById('meta-cost').textContent = '$' + Number(data.costEstimate).toFixed(4);
          }
          resolve(full);
          return;
        }
        try {
          const chunk = JSON.parse(e.data);
          if (typeof chunk === 'string') full += chunk;
          else if (chunk.error) full = 'Error: ' + chunk.error;
          else full += String(chunk);
        } catch {
          full += e.data;
        }
        responseEl.textContent = full;
      };
      es.onerror = () => {
        es.close();
        if (!full) responseEl.textContent = 'Connection error. Is Carina running?';
        resolve(full);
      };
    });
  }

  if (RUN_ID && AUTORUN && promptEl.value.trim()) {
    streamRun(RUN_ID, promptEl.value.trim());
  }
</script>
