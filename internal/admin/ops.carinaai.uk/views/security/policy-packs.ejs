<% title = 'Policy Packs' %>
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Policy Packs</div>
    <div class="ops-page-sub">Pre-built security policy bundles available for deployment.</div>
  </div>
  <button onclick="loadPolicyPacks()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
</div>

<div id="pp-loading" class="ops-loading" style="margin-bottom:16px;">Loading policy packs...</div>
<div id="pp-grid" style="display:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-bottom:20px;"></div>
<div id="pp-empty" class="ops-empty" style="display:none;">No policy packs available.</div>

<script>
function loadPolicyPacks() {
  fetch('/scout-api/api/policy-packs', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var packs = d.packs || d || [];
      if (!Array.isArray(packs)) packs = [];
      document.getElementById('pp-loading').style.display = 'none';
      if (!packs.length) { document.getElementById('pp-empty').style.display = ''; return; }
      var grid = document.getElementById('pp-grid');
      grid.style.display = '';
      grid.innerHTML = packs.map(function(p) {
        var active = p.active || p.enabled;
        return '<div class="ops-card" style="border-color:' + (active ? 'rgba(0,200,100,0.2)' : 'var(--border)') + ';">' +
          '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">' +
          '<span style="font-size:12px;font-weight:600;color:var(--heading);">' + esc(p.name || p.id) + '</span>' +
          '<span class="ops-badge ' + (active ? 'ops-badge-green' : 'ops-badge-gray') + '">' + (active ? 'Active' : 'Inactive') + '</span></div>' +
          '<div style="font-size:10px;color:var(--muted);margin-bottom:10px;">' + esc(p.description || '') + '</div>' +
          '<div style="display:flex;gap:8px;">' +
          (active ? '<button onclick="togglePack(\'' + esc(p.id) + '\',false)" class="ops-btn ops-btn-amber" style="padding:3px 8px;font-size:9px;">Deactivate</button>' :
            '<button onclick="togglePack(\'' + esc(p.id) + '\',true)" class="ops-btn ops-btn-green" style="padding:3px 8px;font-size:9px;">Activate</button>') +
          '</div></div>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('pp-loading').style.display = 'none';
      document.getElementById('pp-empty').style.display = '';
      document.getElementById('pp-empty').textContent = 'Policy packs endpoint unavailable.';
    });
}
function togglePack(id, enable) {
  fetch('/scout-api/api/policy-packs/' + encodeURIComponent(id) + (enable ? '/activate' : '/deactivate'), {
    method: 'POST', credentials: 'same-origin', headers: {'Content-Type':'application/json'}, body: '{}'
  }).then(function() { loadPolicyPacks(); }).catch(function() {});
}
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadPolicyPacks();
</script>
