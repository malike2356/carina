<% title = 'Attack Surface' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Attack Surface</div>
    <div class="ops-page-sub">Mapped exposure points and public-facing touchpoints.</div>
  </div>
  <button onclick="loadSurface()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
</div>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;">
  <div class="ops-card"><div class="ops-card-label">Exposed Endpoints</div><div class="ops-card-val amber" id="as-endpoints">-</div></div>
  <div class="ops-card"><div class="ops-card-label">High-Risk Points</div><div class="ops-card-val red" id="as-highrisk">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Last Scan</div><div class="ops-card-val cyan" id="as-lastscan" style="font-size:14px;margin-top:4px;">-</div></div>
</div>

<div class="ops-card">
  <div class="ops-section-title">Exposure Map</div>
  <div id="as-loading" class="ops-loading">Loading attack surface data...</div>
  <table class="ops-table" id="as-table" style="display:none;">
    <thead><tr><th>Risk</th><th>Endpoint</th><th>Type</th><th>Instance</th><th>Detected</th></tr></thead>
    <tbody id="as-body"></tbody>
  </table>
  <div id="as-empty" class="ops-empty" style="display:none;">No attack surface data available.</div>
</div>

<script>
function loadSurface() {
  fetch('/scout-api/api/attack-surface', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var items = d.points || d.surface || d || [];
      if (!Array.isArray(items)) items = [];
      document.getElementById('as-endpoints').textContent = items.length;
      var high = items.filter(function(i){ return (i.risk || i.severity || '').toLowerCase() === 'high'; }).length;
      document.getElementById('as-highrisk').textContent = high;
      var ts = d.scanned_at || d.last_scan;
      document.getElementById('as-lastscan').textContent = ts ? new Date(ts).toLocaleString() : '-';
      document.getElementById('as-loading').style.display = 'none';
      if (!items.length) { document.getElementById('as-empty').style.display = ''; return; }
      document.getElementById('as-table').style.display = '';
      document.getElementById('as-body').innerHTML = items.slice(0, 80).map(function(i) {
        var risk = (i.risk || i.severity || 'low').toLowerCase();
        var clr = risk === 'high' ? 'ops-badge-red' : risk === 'medium' ? 'ops-badge-amber' : 'ops-badge-gray';
        return '<tr><td><span class="ops-badge ' + clr + '">' + esc(risk) + '</span></td>' +
          '<td style="font-family:monospace;font-size:10px;">' + esc(i.endpoint || i.url || '-') + '</td>' +
          '<td>' + esc(i.type || '-') + '</td>' +
          '<td>' + esc(i.instance_id || '-') + '</td>' +
          '<td>' + (i.created_at ? new Date(i.created_at).toLocaleDateString() : '-') + '</td></tr>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('as-loading').style.display = 'none';
      document.getElementById('as-empty').style.display = '';
      document.getElementById('as-empty').textContent = 'Attack surface endpoint unavailable.';
    });
}
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadSurface();
</script>
</div>
