<% title = 'Reports' %>
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Reports</div>
    <div class="ops-page-sub">Generated security and compliance reports.</div>
  </div>
  <button onclick="loadReports()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
</div>

<div id="rep-loading" class="ops-loading" style="margin-bottom:16px;">Loading reports...</div>
<div id="rep-content" style="display:none;">
  <div class="ops-card">
    <div class="ops-section-title">Available Reports</div>
    <table class="ops-table" id="rep-table">
      <thead><tr><th>Report</th><th>Type</th><th>Period</th><th>Generated</th><th>Status</th></tr></thead>
      <tbody id="rep-body"></tbody>
    </table>
  </div>
</div>
<div id="rep-empty" class="ops-empty" style="display:none;">No reports generated yet.</div>

<script>
function loadReports() {
  fetch('/scout-api/api/reports', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var items = d.reports || d || [];
      if (!Array.isArray(items)) items = [];
      document.getElementById('rep-loading').style.display = 'none';
      if (!items.length) { document.getElementById('rep-empty').style.display = ''; return; }
      document.getElementById('rep-content').style.display = '';
      document.getElementById('rep-body').innerHTML = items.slice(0, 50).map(function(r) {
        var sclr = r.status === 'ready' ? 'ops-badge-green' : r.status === 'generating' ? 'ops-badge-amber' : 'ops-badge-gray';
        var ts = r.generated_at || r.created_at;
        return '<tr><td>' + esc(r.name || r.title || '-') + '</td>' +
          '<td>' + esc(r.type || '-') + '</td>' +
          '<td>' + esc(r.period || '-') + '</td>' +
          '<td>' + (ts ? new Date(ts).toLocaleDateString() : '-') + '</td>' +
          '<td><span class="ops-badge ' + sclr + '">' + esc(r.status || 'unknown') + '</span></td></tr>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('rep-loading').style.display = 'none';
      document.getElementById('rep-empty').style.display = '';
      document.getElementById('rep-empty').textContent = 'Reports endpoint unavailable.';
    });
}
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadReports();
</script>
