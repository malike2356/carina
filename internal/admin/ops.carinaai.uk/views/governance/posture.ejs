<% title = 'Security Posture' %>
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Security Posture</div>
    <div class="ops-page-sub">Aggregate assessment of the platform security stance across all tenants.</div>
  </div>
  <button onclick="loadPosture()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
</div>

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;">
  <div class="ops-card"><div class="ops-card-label">Overall Posture</div><div class="ops-card-val green" id="pos-overall">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Weak Points</div><div class="ops-card-val red" id="pos-weak">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Mitigations Applied</div><div class="ops-card-val cyan" id="pos-mitigations">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Risk Level</div><div class="ops-card-val amber" id="pos-risk" style="font-size:14px;margin-top:4px;">-</div></div>
</div>

<div class="ops-card" style="margin-bottom:16px;">
  <div class="ops-section-title">Posture Dimensions</div>
  <div id="pos-loading" class="ops-loading">Loading posture data...</div>
  <div id="pos-dims" style="display:none;"></div>
  <div id="pos-empty" class="ops-empty" style="display:none;">Posture data unavailable.</div>
</div>

<div class="ops-card">
  <div class="ops-section-title">Risk Areas</div>
  <table class="ops-table" id="pos-risks-table" style="display:none;">
    <thead><tr><th>Area</th><th>Risk</th><th>Impact</th><th>Mitigation</th></tr></thead>
    <tbody id="pos-risks-body"></tbody>
  </table>
  <div id="pos-risks-empty" class="ops-empty">Loading...</div>
</div>

<script>
function loadPosture() {
  fetch('/scout-api/api/posture', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      document.getElementById('pos-overall').textContent = d.overall ? d.overall + '%' : '-';
      var oc = d.overall || 0;
      document.getElementById('pos-overall').style.color = oc >= 80 ? 'var(--green)' : oc >= 60 ? 'var(--amber)' : oc > 0 ? 'var(--red)' : 'var(--muted)';
      document.getElementById('pos-weak').textContent = d.weak_points || '-';
      document.getElementById('pos-mitigations').textContent = d.mitigations || '-';
      var risk = d.risk_level || (oc >= 80 ? 'LOW' : oc >= 60 ? 'MEDIUM' : oc > 0 ? 'HIGH' : '-');
      document.getElementById('pos-risk').textContent = risk;
      document.getElementById('pos-risk').style.color = risk === 'LOW' ? 'var(--green)' : risk === 'MEDIUM' ? 'var(--amber)' : risk === 'HIGH' ? 'var(--red)' : 'var(--muted)';
      document.getElementById('pos-loading').style.display = 'none';
      var dims = d.dimensions || d.areas;
      if (dims && Object.keys(dims).length) {
        document.getElementById('pos-dims').style.display = '';
        document.getElementById('pos-dims').innerHTML = Object.keys(dims).map(function(k) {
          var v = Math.min(100, Math.max(0, dims[k] || 0));
          var bclr = v >= 80 ? 'var(--green)' : v >= 60 ? 'var(--amber)' : 'var(--red)';
          return '<div style="margin-bottom:10px;"><div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px;">' +
            '<span>' + esc(k) + '</span><span style="color:' + bclr + '">' + v + '%</span></div>' +
            '<div style="height:5px;background:var(--border);border-radius:2px;">' +
            '<div style="height:5px;width:' + v + '%;background:' + bclr + ';border-radius:2px;"></div></div></div>';
        }).join('');
      } else {
        document.getElementById('pos-empty').style.display = '';
      }
      var risks = d.risk_areas || d.risks || [];
      if (!risks.length) { document.getElementById('pos-risks-empty').textContent = 'No risk areas identified.'; return; }
      document.getElementById('pos-risks-table').style.display = '';
      document.getElementById('pos-risks-empty').style.display = 'none';
      document.getElementById('pos-risks-body').innerHTML = risks.map(function(r) {
        var rclr = r.risk === 'high' ? 'ops-badge-red' : r.risk === 'medium' ? 'ops-badge-amber' : 'ops-badge-gray';
        return '<tr><td>' + esc(r.area || r.name || '-') + '</td>' +
          '<td><span class="ops-badge ' + rclr + '">' + esc(r.risk || '-') + '</span></td>' +
          '<td>' + esc(r.impact || '-') + '</td>' +
          '<td>' + esc(r.mitigation || '-') + '</td></tr>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('pos-loading').style.display = 'none';
      document.getElementById('pos-empty').style.display = '';
      document.getElementById('pos-risks-empty').textContent = 'Posture endpoint unavailable.';
    });
}
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadPosture();
</script>
