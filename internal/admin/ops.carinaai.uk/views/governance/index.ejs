<% title = 'Governance' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Governance</div>
    <div class="ops-page-sub">Policy compliance, data handling, and security programme overview.</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;">
  <div class="ops-card"><div class="ops-card-label">Compliance Score</div><div class="ops-card-val green" id="gov-compliance">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Open Controls</div><div class="ops-card-val amber" id="gov-open">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Passed Controls</div><div class="ops-card-val green" id="gov-passed">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Exceptions</div><div class="ops-card-val red" id="gov-exceptions">-</div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
  <a href="/governance/soc2" class="ops-card" style="display:block;text-decoration:none;border-color:rgba(168,85,247,0.2);">
    <div class="ops-card-label">SOC2</div>
    <div style="color:var(--heading);font-size:14px;font-weight:600;margin:6px 0;">SOC2 Compliance Posture</div>
    <div style="color:var(--muted);font-size:10px;">Trust Service Criteria status across all controls.</div>
  </a>
  <a href="/governance/trust" class="ops-card" style="display:block;text-decoration:none;border-color:rgba(0,212,255,0.15);">
    <div class="ops-card-label">Trust</div>
    <div style="color:var(--heading);font-size:14px;font-weight:600;margin:6px 0;">Trust Verification</div>
    <div style="color:var(--muted);font-size:10px;">Instance trust settings and verification status.</div>
  </a>
  <a href="/governance/posture" class="ops-card" style="display:block;text-decoration:none;">
    <div class="ops-card-label">Posture</div>
    <div style="color:var(--heading);font-size:14px;font-weight:600;margin:6px 0;">Security Posture</div>
    <div style="color:var(--muted);font-size:10px;">Aggregate posture assessment across all tenants.</div>
  </a>
  <a href="/governance/audit" class="ops-card" style="display:block;text-decoration:none;">
    <div class="ops-card-label">Audit</div>
    <div style="color:var(--heading);font-size:14px;font-weight:600;margin:6px 0;">Audit Logs</div>
    <div style="color:var(--muted);font-size:10px;">Tamper-evident log of all admin and platform events.</div>
  </a>
</div>

<div class="ops-card">
  <div class="ops-section-title">Framework Status</div>
  <div id="gov-loading" class="ops-loading">Loading governance data...</div>
  <table class="ops-table" id="gov-table" style="display:none;">
    <thead><tr><th>Framework</th><th>Controls</th><th>Passed</th><th>Status</th><th>Last Assessed</th></tr></thead>
    <tbody id="gov-body"></tbody>
  </table>
  <div id="gov-empty" class="ops-empty" style="display:none;">No governance data available.</div>
</div>

<script>
function loadGovernance() {
  fetch('/scout-api/api/governance', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var score = d.compliance_score || d.score || 0;
      document.getElementById('gov-compliance').textContent = score ? score + '%' : '-';
      document.getElementById('gov-open').textContent = d.open_controls || '-';
      document.getElementById('gov-passed').textContent = d.passed_controls || '-';
      document.getElementById('gov-exceptions').textContent = d.exceptions || '-';
      document.getElementById('gov-loading').style.display = 'none';
      var frameworks = d.frameworks || [];
      if (!frameworks.length) { document.getElementById('gov-empty').style.display = ''; return; }
      document.getElementById('gov-table').style.display = '';
      document.getElementById('gov-body').innerHTML = frameworks.map(function(f) {
        var pct = f.total > 0 ? Math.round(f.passed / f.total * 100) : 0;
        var clr = pct >= 80 ? 'ops-badge-green' : pct >= 60 ? 'ops-badge-amber' : 'ops-badge-red';
        var ts = f.last_assessed || f.assessed_at;
        return '<tr><td style="font-weight:600;">' + esc(f.name || f.framework || '-') + '</td>' +
          '<td>' + (f.total || '-') + '</td>' +
          '<td>' + (f.passed || '0') + '</td>' +
          '<td><span class="ops-badge ' + clr + '">' + pct + '%</span></td>' +
          '<td>' + (ts ? new Date(ts).toLocaleDateString() : '-') + '</td></tr>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('gov-loading').style.display = 'none';
      document.getElementById('gov-empty').style.display = '';
    });
}
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadGovernance();
</script>
</div>
