<% title = 'Dashboard' %>

<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Carina Ops</div>
    <div class="ops-page-sub">Platform control centre. All systems read below.</div>
  </div>
  <div style="display:flex;align-items:center;gap:10px;">
    <span id="platform-badge" class="ops-badge ops-badge-gray">Checking...</span>
    <span style="font-size:10px;color:var(--muted);" id="dash-ts"></span>
  </div>
</div>

<!-- Primary platform tiles -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px;">
  <div class="ops-card" style="border-color:rgba(0,200,100,0.15);">
    <div class="ops-card-label">Tenants</div>
    <div class="ops-card-val green"><%= tenantSummary ? tenantSummary.total : '-' %></div>
    <% if (tenantSummary) { %>
    <div style="font-size:10px;color:var(--muted);margin-top:4px;"><%= tenantSummary.freeCount %> free / <span style="color:var(--green);"><%= tenantSummary.proCount %></span> pro</div>
    <% } %>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Messages Today</div>
    <div class="ops-card-val cyan"><%= tenantSummary ? tenantSummary.messagesToday : '-' %></div>
    <div style="font-size:10px;color:var(--muted);margin-top:4px;">across all tenants</div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Monthly Tokens</div>
    <div class="ops-card-val" style="font-size:16px;margin-top:4px;"><%= tenantSummary ? tenantSummary.monthlyTokens.toLocaleString() : '-' %></div>
    <div style="font-size:10px;color:var(--muted);margin-top:4px;">this billing period</div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Scout Score</div>
    <div class="ops-card-val" id="scout-score-val" style="color:var(--muted);">-</div>
    <div style="font-size:10px;color:var(--muted);margin-top:4px;" id="scout-score-sub">Loading...</div>
  </div>
</div>

<!-- Secondary stat tiles -->
<div style="display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:14px;">
  <div class="ops-card">
    <div class="ops-card-label">Memories</div>
    <div class="ops-card-val" style="font-size:18px;"><%= stats.totalMemories %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Sessions</div>
    <div class="ops-card-val" style="font-size:18px;"><%= stats.sessions %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Skills</div>
    <div class="ops-card-val" style="font-size:18px;"><%= stats.skills %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">RAG Chunks</div>
    <div class="ops-card-val" style="font-size:18px;"><%= stats.ragChunks %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Emails</div>
    <div class="ops-card-val" style="font-size:18px;"><%= stats.unreadEmails %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Threats (24h)</div>
    <div class="ops-card-val red" id="dash-threats" style="font-size:18px;">-</div>
  </div>
</div>

<!-- Alert bar (shown if critical threats) -->
<div id="scout-alert" style="display:none;padding:10px 14px;margin-bottom:14px;border-radius:5px;border:1px solid;font-size:11px;align-items:center;gap:10px;"></div>

<!-- Three-column body -->
<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px;">
  <div class="ops-card">
    <div class="ops-section-title">Recent Sessions</div>
    <% if (!recentSessions.length) { %>
      <div class="ops-empty">No sessions yet.</div>
    <% } else { %>
      <table class="ops-table">
        <thead><tr><th>Session</th><th>Msgs</th><th>Last Seen</th></tr></thead>
        <tbody>
          <% for (const s of recentSessions) { %>
          <tr>
            <td><a href="/memories/session/<%= s.session_id %>" class="ops-link"><%= s.session_id.slice(0, 10) %>...</a></td>
            <td><%= s.message_count %></td>
            <td style="color:var(--muted);font-size:10px;"><%= new Date(s.last_seen).toLocaleDateString() %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="ops-card">
    <div class="ops-section-title">Recent Skills</div>
    <% if (!recentSkills.length) { %>
      <div class="ops-empty">No skills yet.</div>
    <% } else { %>
      <table class="ops-table">
        <thead><tr><th>Skill</th><th>Uses</th><th>Added</th></tr></thead>
        <tbody>
          <% for (const sk of recentSkills) { %>
          <tr>
            <td><a href="/skills/<%= sk.id %>" class="ops-link-green"><%= sk.name %></a></td>
            <td><%= sk.usage_count || 0 %></td>
            <td style="color:var(--muted);font-size:10px;"><%= new Date(sk.created_at).toLocaleDateString() %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
    <% if (stats.topSkill) { %>
    <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--border);font-size:10px;color:var(--muted);">
      Top skill: <span style="color:var(--green)"><%= stats.topSkill.name %></span> (<%= stats.topSkill.usage_count %> uses)
    </div>
    <% } %>
  </div>

  <div class="ops-card">
    <div class="ops-section-title">Live Threat Feed</div>
    <div id="threat-feed-loading" class="ops-loading">Loading...</div>
    <div id="threat-feed-list"></div>
    <div id="threat-feed-empty" class="ops-empty" style="display:none;">No active threats.</div>
    <a href="/security/threats" class="ops-link" style="display:block;margin-top:10px;font-size:10px;padding-top:8px;border-top:1px solid var(--border);">View all threats</a>
  </div>
</div>

<!-- Quick nav cards -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
  <a href="/control-center" class="ops-card" style="display:block;text-decoration:none;border-color:rgba(0,200,100,0.2);">
    <div style="font-size:9px;color:var(--green);letter-spacing:1px;text-transform:uppercase;margin-bottom:5px;">Platform</div>
    <div style="color:var(--heading);font-weight:600;font-size:12px;">Control Center</div>
    <div style="color:var(--muted);font-size:10px;margin-top:4px;">Core controls and surface map.</div>
  </a>
  <a href="/security/killswitch" class="ops-card" style="display:block;text-decoration:none;border-color:rgba(255,34,68,0.15);">
    <div style="font-size:9px;color:var(--red);letter-spacing:1px;text-transform:uppercase;margin-bottom:5px;">Defence</div>
    <div style="color:var(--heading);font-weight:600;font-size:12px;">Kill Switch</div>
    <div style="color:var(--muted);font-size:10px;margin-top:4px;">Arm or disarm platform halt.</div>
  </a>
  <a href="/governance" class="ops-card" style="display:block;text-decoration:none;border-color:rgba(168,85,247,0.15);">
    <div style="font-size:9px;color:var(--purple);letter-spacing:1px;text-transform:uppercase;margin-bottom:5px;">Governance</div>
    <div style="color:var(--heading);font-weight:600;font-size:12px;">Governance</div>
    <div style="color:var(--muted);font-size:10px;margin-top:4px;">SOC2, trust, posture, audit.</div>
  </a>
  <a href="/admin/incident-blog" class="ops-card" style="display:block;text-decoration:none;border-color:rgba(212,175,55,0.12);">
    <div style="font-size:9px;color:var(--amber);letter-spacing:1px;text-transform:uppercase;margin-bottom:5px;">Incident</div>
    <div style="color:var(--heading);font-weight:600;font-size:12px;">Incident Blog</div>
    <div style="color:var(--muted);font-size:10px;margin-top:4px;">Draft, publish and review records.</div>
  </a>
</div>

<% if (stats.packs.length) { %>
<div class="ops-card">
  <div class="ops-section-title">RAG Packs Active</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <% for (const p of stats.packs) { %>
    <span class="ops-badge ops-badge-cyan"><%= p %></span>
    <% } %>
  </div>
</div>
<% } %>

<script>
document.getElementById('dash-ts').textContent = new Date().toLocaleString();

// Platform ping
fetch('/settings', { credentials: 'same-origin', method: 'HEAD' })
  .then(function() {
    var b = document.getElementById('platform-badge');
    b.textContent = 'Online'; b.className = 'ops-badge ops-badge-green';
  })
  .catch(function() {
    var b = document.getElementById('platform-badge');
    b.textContent = 'Degraded'; b.className = 'ops-badge ops-badge-red';
  });

// Scout score
fetch('/scout-api/api/score', { credentials: 'same-origin' })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    var s = d.score || d.overall || d.value || 0;
    var el = document.getElementById('scout-score-val');
    el.textContent = s || '-';
    el.style.color = s >= 80 ? 'var(--green)' : s >= 60 ? 'var(--amber)' : s > 0 ? 'var(--red)' : 'var(--muted)';
    document.getElementById('scout-score-sub').textContent = s >= 80 ? 'Healthy' : s >= 60 ? 'Fair' : s > 0 ? 'Needs attention' : 'No data';
  })
  .catch(function() { document.getElementById('scout-score-sub').textContent = 'Scout offline'; });

// Threat feed
fetch('/security/events', { credentials: 'same-origin' })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    var events = d.events || d || [];
    if (!Array.isArray(events)) events = [];
    document.getElementById('dash-threats').textContent = events.length;
    document.getElementById('threat-feed-loading').style.display = 'none';
    var crit = events.filter(function(e){ return (e.severity||'').toLowerCase() === 'critical'; });
    if (crit.length) {
      var al = document.getElementById('scout-alert');
      al.style.display = 'flex';
      al.style.cssText += ';background:rgba(255,34,68,0.06);border-color:rgba(255,34,68,0.3);color:#ff6080;';
      al.innerHTML = '<span style="font-weight:700;letter-spacing:1px;">CRITICAL:</span>&nbsp;' + crit.length + ' critical threat(s). <a href="/security/threats" class="ops-link" style="margin-left:6px;">Investigate</a>';
    }
    if (!events.length) { document.getElementById('threat-feed-empty').style.display = ''; return; }
    document.getElementById('threat-feed-list').innerHTML = events.slice(0, 8).map(function(e) {
      var sev = (e.severity || 'info').toLowerCase();
      var c = sev === 'critical' ? 'var(--red)' : sev === 'warning' || sev === 'warn' ? 'var(--amber)' : 'var(--muted)';
      var ts = e.created_at || e.timestamp;
      return '<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:10px;">' +
        '<span style="color:' + c + ';text-transform:uppercase;font-size:9px;font-weight:700;width:52px;flex-shrink:0;">' + sev + '</span>' +
        '<span style="color:var(--text);flex:1;margin:0 6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + esc(e.type || e.event_type || '-') + '</span>' +
        '<span style="color:var(--muted);white-space:nowrap;font-size:9px;">' + (ts ? new Date(ts).toLocaleTimeString() : '') + '</span></div>';
    }).join('');
  })
  .catch(function() {
    document.getElementById('threat-feed-loading').style.display = 'none';
    document.getElementById('threat-feed-empty').style.display = '';
    document.getElementById('threat-feed-empty').textContent = 'Scout offline.';
  });

function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
</script>
