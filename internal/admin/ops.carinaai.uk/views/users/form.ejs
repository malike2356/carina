<div class="max-w-lg">
  <div class="mb-6">
    <h2 class="text-xl font-semibold text-white"><%= title %></h2>
    <a href="/users" class="text-sm text-gray-400 hover:text-gray-200">Back to users</a>
  </div>

  <% if (error) { %>
    <div class="mb-4 p-3 bg-red-900/30 border border-red-700 rounded text-red-300 text-sm"><%= error %></div>
  <% } %>

  <form method="post" action="/users/<%= user ? user.id + '/edit' : 'new' %>"
        class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 space-y-4">
    <div>
      <label class="block text-sm text-gray-400 mb-1" for="name">Full name</label>
      <input type="text" id="name" name="name" required
             value="<%= user ? user.name : '' %>"
             class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white focus:border-[#22c55e] outline-none">
    </div>
    <div>
      <label class="block text-sm text-gray-400 mb-1" for="email">Email</label>
      <input type="email" id="email" name="email" required
             value="<%= user ? user.email : '' %>"
             class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white focus:border-[#22c55e] outline-none">
    </div>
    <% if (!user) { %>
    <div>
      <label class="block text-sm text-gray-400 mb-1" for="password">Password</label>
      <input type="password" id="password" name="password" required minlength="8"
             class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white focus:border-[#22c55e] outline-none">
      <p class="text-xs text-gray-500 mt-1">Minimum 8 characters. User can change after first login.</p>
    </div>
    <% } %>
    <div>
      <label class="block text-sm text-gray-400 mb-1" for="role">Role</label>
      <select id="role" name="role"
              class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white focus:border-[#22c55e] outline-none">
        <option value="admin" <%= (!user || user.role === 'admin') ? 'selected' : '' %>>Admin - full ops access</option>
        <option value="superadmin" <%= (user && user.role === 'superadmin') ? 'selected' : '' %>>Superadmin - admin + user management</option>
        <option value="viewer" <%= (user && user.role === 'viewer') ? 'selected' : '' %>>Viewer - read only</option>
      </select>
    </div>
    <div class="pt-2">
      <button type="submit" class="px-6 py-2 bg-[#22c55e] text-black text-sm font-medium rounded hover:opacity-90">
        <%= user ? 'Save changes' : 'Create user' %>
      </button>
    </div>
  </form>
</div>
