<%- /* title set by route */ %>
<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-xl font-semibold text-white">Users</h2>
    <p class="text-sm text-gray-400 mt-1">Manage operator panel access</p>
  </div>
  <a href="/users/new" class="px-4 py-2 bg-[#22c55e] text-black text-sm font-medium rounded hover:opacity-90">Add user</a>
</div>

<% if (locals.error) { %>
  <div class="mb-4 p-3 bg-red-900/30 border border-red-700 rounded text-red-300 text-sm"><%= error %></div>
<% } %>
<% const flash = new URLSearchParams(locals.query || ''); %>
<% if (flash.get('created')) { %><div class="mb-4 p-3 bg-green-900/30 border border-green-700 rounded text-green-300 text-sm">User created.</div><% } %>
<% if (flash.get('updated')) { %><div class="mb-4 p-3 bg-green-900/30 border border-green-700 rounded text-green-300 text-sm">User updated.</div><% } %>
<% if (flash.get('deleted')) { %><div class="mb-4 p-3 bg-green-900/30 border border-green-700 rounded text-green-300 text-sm">User deleted.</div><% } %>
<% if (flash.get('deactivated')) { %><div class="mb-4 p-3 bg-yellow-900/30 border border-yellow-700 rounded text-yellow-300 text-sm">User deactivated.</div><% } %>
<% if (flash.get('activated')) { %><div class="mb-4 p-3 bg-green-900/30 border border-green-700 rounded text-green-300 text-sm">User re-activated.</div><% } %>
<% if (flash.get('password_set')) { %><div class="mb-4 p-3 bg-green-900/30 border border-green-700 rounded text-green-300 text-sm">Password updated.</div><% } %>

<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-[#2a2a2a] text-gray-400 text-xs uppercase tracking-wide">
        <th class="px-4 py-3 text-left">Name</th>
        <th class="px-4 py-3 text-left">Email</th>
        <th class="px-4 py-3 text-left">Role</th>
        <th class="px-4 py-3 text-left">Status</th>
        <th class="px-4 py-3 text-left">Last login</th>
        <th class="px-4 py-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr class="border-b border-[#2a2a2a] hover:bg-[#222]">
          <td class="px-4 py-3 text-white font-medium"><%= u.name %></td>
          <td class="px-4 py-3 text-gray-300"><%= u.email %></td>
          <td class="px-4 py-3">
            <span class="px-2 py-0.5 rounded text-xs font-medium
              <%= u.role === 'superadmin' ? 'bg-purple-900/40 text-purple-300' :
                  u.role === 'admin' ? 'bg-blue-900/40 text-blue-300' :
                  'bg-gray-800 text-gray-400' %>">
              <%= u.role %>
            </span>
          </td>
          <td class="px-4 py-3">
            <span class="px-2 py-0.5 rounded text-xs <%= u.is_active ? 'bg-green-900/40 text-green-400' : 'bg-red-900/40 text-red-400' %>">
              <%= u.is_active ? 'Active' : 'Inactive' %>
            </span>
          </td>
          <td class="px-4 py-3 text-gray-400 text-xs">
            <%= u.last_login_at ? new Date(u.last_login_at).toLocaleString() : 'Never' %>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center justify-end gap-2 flex-wrap">
              <a href="/users/<%= u.id %>/edit"
                 class="px-2 py-1 text-xs border border-[#333] rounded hover:border-[#555] text-gray-300">Edit</a>
              <form method="post" action="/users/<%= u.id %>/reset-password" class="inline">
                <button class="px-2 py-1 text-xs border border-[#333] rounded hover:border-[#555] text-gray-300">Reset link</button>
              </form>
              <% if (u.is_active) { %>
                <form method="post" action="/users/<%= u.id %>/deactivate" class="inline"
                      onsubmit="return confirm('Deactivate <%= u.name %>?')">
                  <button class="px-2 py-1 text-xs border border-red-900 rounded text-red-400 hover:border-red-700">Deactivate</button>
                </form>
              <% } else { %>
                <form method="post" action="/users/<%= u.id %>/activate" class="inline">
                  <button class="px-2 py-1 text-xs border border-green-900 rounded text-green-400 hover:border-green-700">Activate</button>
                </form>
              <% } %>
              <form method="post" action="/users/<%= u.id %>/delete" class="inline"
                    onsubmit="return confirm('Permanently delete <%= u.name %>? This cannot be undone.')">
                <button class="px-2 py-1 text-xs border border-red-900 rounded text-red-500 hover:border-red-600">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
