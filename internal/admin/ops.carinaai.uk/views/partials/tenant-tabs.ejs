<% const tabs = [
  { id: 'overview', label: 'Overview' },
  { id: 'subscription', label: 'Subscription' },
  { id: 'payments', label: 'Payments' },
  { id: 'usage', label: 'Usage' },
  { id: 'packs', label: 'Skill packs' },
  { id: 'access', label: 'Access' },
  { id: 'byok', label: 'BYOK' },
  { id: 'audit', label: 'Audit log' },
]; %>
<nav class="ops-tabs" aria-label="Tenant sections" style="margin-bottom:20px;">
  <% for (const t of tabs) { %>
    <a href="/tenants/<%= tenant.id %>?tab=<%= t.id %>"
       class="ops-tab<%= tab === t.id ? ' active' : '' %>" style="text-decoration:none;display:inline-block;">
      <%= t.label %>
    </a>
  <% } %>
</nav>
