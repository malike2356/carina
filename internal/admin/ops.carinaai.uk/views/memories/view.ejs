<% title = 'Memory' %>
<div class="mb-4">
  <a href="/memories" class="text-[#22c55e] text-sm hover:underline">Back to list</a>
</div>
<h1 class="text-2xl font-bold text-white mb-4">Memory detail</h1>

<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 space-y-4">
  <div class="text-sm text-gray-400">
    <p>Session: <a href="/memories/session/<%= memory.session_id %>" class="text-[#06b6d4]"><%= memory.session_id %></a></p>
    <p>Role: <span class="<%= memory.role === 'user' ? 'badge-user' : 'badge-assistant' %> px-2 py-0.5 rounded text-xs"><%= memory.role %></span></p>
    <p>Created: <%= new Date(memory.created_at).toLocaleString() %></p>
    <p>Embedding: <%= hasEmbedding ? '1536-dim vector' : 'no embedding' %></p>
  </div>
  <pre class="whitespace-pre-wrap text-sm text-[#e0e0e0] bg-[#0f0f0f] p-4 rounded border border-[#2a2a2a]"><%= memory.content %></pre>
  <form method="post" action="/memories/<%= memory.id %>/delete" onsubmit="return confirm('Delete this memory?')">
    <button type="submit" class="text-red-400 hover:text-red-300 text-sm">Delete memory</button>
  </form>
</div>
