<% title = 'Session' %>
<div class="mb-4 flex justify-between items-center">
  <a href="/memories" class="text-[#22c55e] text-sm hover:underline">Back to list</a>
  <form method="post" action="/memories/session/<%= sessionId %>/delete" onsubmit="return confirm('Delete entire session?')">
    <button type="submit" class="text-red-400 text-sm hover:text-red-300">Delete session</button>
  </form>
</div>
<h1 class="text-xl font-bold text-white mb-2 font-mono text-sm"><%= sessionId %></h1>

<div class="flex flex-col gap-4 w-full">
  <% for (const m of messages) { %>
    <div class="flex <%= m.role === 'user' ? 'justify-end' : 'justify-start' %>">
      <div class="max-w-[85%] rounded-lg px-4 py-3 text-sm
        <%= m.role === 'user' ? 'bg-[#06b6d4] text-black' : 'bg-[#1a1a1a] border border-[#2a2a2a] text-[#e0e0e0]' %>">
        <p class="text-xs opacity-70 mb-1"><%= m.role %> · <%= new Date(m.created_at).toLocaleString() %></p>
        <p class="whitespace-pre-wrap"><%= m.content %></p>
        <a href="/memories/<%= m.id %>" class="text-xs opacity-60 hover:opacity-100 mt-1 inline-block">detail</a>
      </div>
    </div>
  <% } %>
</div>
<% if (!messages.length) { %>
  <p class="text-gray-500">No messages in this session.</p>
<% } %>
