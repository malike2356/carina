<% title = 'MCP Servers' %>
<h1 class="text-2xl font-bold text-white mb-3">MCP Servers</h1>
<p class="text-sm text-gray-400 mb-6">Wraps the existing core `/api/mcp` endpoints. No separate storage layer.</p>

<% if (reloadOk) { %>
  <div class="mb-4 rounded-lg border border-green-600/50 bg-green-950/30 px-4 py-3 text-sm text-green-200">
    Action completed successfully.
  </div>
<% } %>
<% if (reloadErr) { %>
  <div class="mb-4 rounded-lg border border-red-600/50 bg-red-950/30 px-4 py-3 text-sm text-red-200"><%= reloadErr %></div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-6">
  <section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4 h-fit">
    <h2 class="text-lg font-semibold text-white mb-3">Add server</h2>
    <% if (!coreConnected) { %>
      <p class="text-sm text-amber-300">Core is not connected. Set the inter-service token before using this page.</p>
    <% } else { %>
      <form method="post" action="/mcp/add" class="space-y-3">
        <label class="block">
          <span class="block text-xs text-gray-400 mb-1">Name</span>
          <input name="name" required class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-3 py-2 font-mono" />
        </label>
        <label class="block">
          <span class="block text-xs text-gray-400 mb-1">Transport</span>
          <select name="transport" class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-3 py-2">
            <option value="stdio">stdio</option>
            <option value="http">http</option>
          </select>
        </label>
        <label class="block">
          <span class="block text-xs text-gray-400 mb-1">Command</span>
          <input name="command" placeholder="node server.js" class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-3 py-2 font-mono" />
        </label>
        <label class="block">
          <span class="block text-xs text-gray-400 mb-1">Args</span>
          <textarea name="args" rows="3" placeholder="--stdio&#10;--port 3001" class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-3 py-2 font-mono"></textarea>
        </label>
        <label class="block">
          <span class="block text-xs text-gray-400 mb-1">URL</span>
          <input name="url" placeholder="https://example.test/mcp" class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-3 py-2 font-mono" />
        </label>
        <label class="block">
          <span class="block text-xs text-gray-400 mb-1">Env</span>
          <textarea name="env" rows="4" placeholder="TOKEN=abc&#10;MODE=prod" class="w-full rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-3 py-2 font-mono"></textarea>
        </label>
        <button type="submit" class="px-4 py-2 rounded bg-[#22c55e] hover:bg-green-400 text-black text-sm font-semibold">
          Add server
        </button>
      </form>
    <% } %>
  </section>

  <section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg overflow-hidden">
    <div class="px-4 py-3 border-b border-[#2a2a2a] flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-semibold text-white">Configured servers</h2>
        <p class="text-xs text-gray-500 mt-1">Status comes from the live core API.</p>
      </div>
      <div class="text-xs text-gray-500">
        <%= payload?.summary?.configured ?? 0 %> configured · <%= payload?.summary?.liveConnections ?? 0 %> live
      </div>
    </div>

    <% if (!payload?.servers?.length) { %>
      <p class="p-6 text-sm text-gray-500">No MCP servers configured yet.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-gray-400 border-b border-[#2a2a2a] bg-[#141414]">
            <tr>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Transport</th>
              <th class="px-4 py-3 font-medium">Endpoint</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3 font-medium">Tools</th>
              <th class="px-4 py-3 font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#2a2a2a]">
            <% payload.servers.forEach((server, index) => { const formId = `mcp-save-${index}`; %>
              <tr class="align-top hover:bg-[#222]">
                <td class="px-4 py-3">
                  <input form="<%= formId %>" name="name" value="<%= server.name %>" class="w-44 rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-1 font-mono" />
                </td>
                <td class="px-4 py-3">
                  <select form="<%= formId %>" name="transport" class="w-24 rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-1">
                    <option value="stdio" <%= server.transport === 'stdio' ? 'selected' : '' %>>stdio</option>
                    <option value="http" <%= server.transport === 'http' ? 'selected' : '' %>>http</option>
                  </select>
                </td>
                <td class="px-4 py-3">
                  <% if (server.transport === 'http') { %>
                    <input form="<%= formId %>" name="url" value="<%= server.url ?? '' %>" class="w-72 rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-1 font-mono" />
                  <% } else { %>
                    <input form="<%= formId %>" name="command" value="<%= server.command ?? '' %>" class="w-72 rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-1 font-mono" />
                    <textarea form="<%= formId %>" name="args" rows="2" class="mt-2 w-72 rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-1 font-mono"><%= (server.args ?? []).join('\n') %></textarea>
                    <textarea form="<%= formId %>" name="env" rows="2" class="mt-2 w-72 rounded bg-[#0f0f0f] border border-[#3a3a3a] text-white text-sm px-2 py-1 font-mono"><%= server.env ? Object.entries(server.env).map(([k, v]) => `${k}=${v}`).join('\n') : '' %></textarea>
                  <% } %>
                  <form id="<%= formId %>" method="post" action="/mcp/<%= encodeURIComponent(server.name) %>/save" class="hidden"></form>
                </td>
                <td class="px-4 py-3">
                  <div class="space-y-1 text-xs">
                    <span class="inline-flex rounded-full px-2 py-0.5 <%= server.liveConnected ? 'bg-green-950 text-green-300' : 'bg-gray-800 text-gray-300' %>">
                      <%= server.liveConnected ? 'Live' : 'Stored' %>
                    </span>
                    <% if (server.connectedAt) { %>
                      <p class="text-gray-500"><%= new Date(server.connectedAt).toLocaleString() %></p>
                    <% } %>
                  </div>
                </td>
                <td class="px-4 py-3 text-gray-300">
                  <%= (server.tools ?? []).slice(0, 3).join(', ') || 'None' %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-2">
                    <button form="<%= formId %>" type="submit" class="rounded bg-[#22c55e] px-3 py-1.5 text-xs font-semibold text-black">Save</button>
                    <form method="post" action="/mcp/<%= encodeURIComponent(server.name) %>/test">
                      <button type="submit" class="rounded border border-[#2a2a2a] px-3 py-1.5 text-xs text-gray-300 hover:border-[#16c97e] hover:text-white">Ping</button>
                    </form>
                    <form method="post" action="/mcp/<%= encodeURIComponent(server.name) %>/delete" onsubmit="return confirm('Delete MCP server <%= server.name %>?');">
                      <button type="submit" class="rounded border border-red-900/70 px-3 py-1.5 text-xs text-red-300 hover:bg-red-950/30">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
