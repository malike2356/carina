<% title = 'Subscriptions' %>
<div class="ops-page">
<div class="ops-page-head"><div><div class="ops-page-title">Subscriptions</div><div class="ops-page-sub">All tenant subscription state across SaaS and manual provisioning.</div></div></div>
<a href="/tenants/new" class="px-4 py-2 rounded bg-[#22c55e] hover:bg-green-400 text-black text-sm font-medium">
    Create tenant
  </a>
</div>

<% if (!ready) { %>
  <div class="rounded-lg border border-amber-600/50 bg-amber-950/30 px-4 py-4 text-sm text-amber-200">
    <p>Hosted schema not initialized. <a href="/tenants" class="underline">Go to Tenants</a> to initialize.</p>
  </div>
<% } else { %>

  <div class="flex flex-wrap gap-2 mb-4 text-sm">
    <a href="/subscriptions" class="px-3 py-1 rounded <%= !statusFilter && !sourceFilter ? 'bg-[#22c55e] text-black' : 'bg-[#2a2a2a] text-gray-300' %>">All</a>
    <a href="/subscriptions?source=manual" class="px-3 py-1 rounded <%= sourceFilter === 'manual' ? 'bg-[#22c55e] text-black' : 'bg-[#2a2a2a] text-gray-300' %>">Manual/direct</a>
    <a href="/subscriptions?source=saas" class="px-3 py-1 rounded <%= sourceFilter === 'saas' ? 'bg-[#22c55e] text-black' : 'bg-[#2a2a2a] text-gray-300' %>">SaaS</a>
    <a href="/subscriptions?status=active" class="px-3 py-1 rounded <%= statusFilter === 'active' ? 'bg-[#22c55e] text-black' : 'bg-[#2a2a2a] text-gray-300' %>">Active</a>
    <a href="/subscriptions?status=suspended" class="px-3 py-1 rounded <%= statusFilter === 'suspended' ? 'bg-[#22c55e] text-black' : 'bg-[#2a2a2a] text-gray-300' %>">Suspended</a>
  </div>

  <div class="ops-surface ops-table-wrap">
    <% if (!subscriptions.length) { %>
      <p class="p-6 text-gray-500 text-sm">No subscription records yet.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="ops-table w-full text-sm text-left">
          <thead class="text-gray-400 border-b border-[#2a2a2a] bg-[#141414]">
            <tr>
              <th class="px-4 py-3 font-medium">Tenant</th>
              <th class="px-4 py-3 font-medium">Plan</th>
              <th class="px-4 py-3 font-medium">Billing state</th>
              <th class="px-4 py-3 font-medium">Source</th>
              <th class="px-4 py-3 font-medium">Access</th>
              <th class="px-4 py-3 font-medium">Renewal</th>
              <th class="px-4 py-3 font-medium"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#2a2a2a]">
            <% for (const s of subscriptions) { %>
              <tr class="hover:bg-[#222]">
                <td class="px-4 py-3">
                  <div class="text-white"><%= tenantDisplayName(s) %></div>
                  <div class="text-xs text-gray-500"><%= s.email %></div>
                </td>
                <td class="px-4 py-3 text-gray-300"><%= plans[s.plan]?.name || s.plan %></td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded text-xs <%= s.status === 'active' ? 'bg-green-900/50 text-green-300' : 'bg-gray-800 text-gray-300' %>">
                    <%= s.status %>
                  </span>
                </td>
                <td class="px-4 py-3 text-xs text-gray-400">
                  <%= provisioningLabel(s.provisioningType, s.provisioningSource) %>
                </td>
                <td class="px-4 py-3 text-xs text-gray-400"><%= s.accessStatus %></td>
                <td class="px-4 py-3 text-xs text-gray-500">
                  <% if (s.stripeSubscriptionId) { %>
                    Stripe
                    <% if (s.currentPeriodEnd) { %>
                      <br>ends <%= new Date(s.currentPeriodEnd).toLocaleDateString() %>
                    <% } %>
                  <% } else { %>
                    Manual (no Stripe)
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <a href="/tenants/<%= s.tenantId %>?tab=subscription" class="ops-link">Manage</a>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% } %>
</div>
