<% title = 'Incident Subscribers' %>
<div class="ops-page">
<style>
  .blog-card { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 8px; padding: 1rem; }
  .blog-table { width: 100%; border-collapse: collapse; }
  .blog-table th, .blog-table td { padding: 0.7rem 0.5rem; border-bottom: 1px solid #2a2a2a; text-align: left; vertical-align: top; }
</style>
<div class="blog-card">
  <h1 class="text-2xl font-bold text-white mb-4">Incident Subscribers</h1>
  <table class="blog-table">
    <thead>
      <tr>
        <th>Email</th>
        <th>Confirmed</th>
        <th>Subscribed</th>
        <th>Unsubscribed</th>
        <th>Last sent</th>
      </tr>
    </thead>
    <tbody>
      <% for (const subscriber of subscribers) { %>
        <tr>
          <td><%= subscriber.email %></td>
          <td><%= subscriber.confirmed ? 'Yes' : 'No' %></td>
          <td><%= subscriber.subscribedAt ? new Date(subscriber.subscribedAt).toLocaleString() : '' %></td>
          <td><%= subscriber.unsubscribedAt ? new Date(subscriber.unsubscribedAt).toLocaleString() : '' %></td>
          <td><%= subscriber.lastSentAt ? new Date(subscriber.lastSentAt).toLocaleString() : '' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
</div>
