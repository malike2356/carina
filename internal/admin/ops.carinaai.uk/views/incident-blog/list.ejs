<% title = 'Incident Blog' %>
<div class="ops-page">
<style>
  .blog-shell { display: grid; gap: 1rem; }
  .blog-stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.75rem; }
  .blog-stat { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 8px; padding: 0.9rem; }
  .blog-stat .value { font-size: 1.4rem; font-weight: 700; color: #fff; }
  .blog-stat .label { font-size: 0.72rem; color: #8b8b8b; text-transform: uppercase; letter-spacing: 0.08em; }
  .blog-card { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 8px; padding: 1rem; }
  .blog-table { width: 100%; border-collapse: collapse; }
  .blog-table th, .blog-table td { padding: 0.7rem 0.5rem; border-bottom: 1px solid #2a2a2a; text-align: left; vertical-align: top; }
  .pill { display: inline-flex; padding: 0.2rem 0.5rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
  .draft { background: rgba(245,158,11,0.16); color: #f59e0b; }
  .approved { background: rgba(59,130,246,0.16); color: #60a5fa; }
  .published { background: rgba(22,201,126,0.16); color: #16c97e; }
  .rejected { background: rgba(77,96,112,0.16); color: #8a9bb0; }
  .actions { display:flex; flex-wrap:wrap; gap:.5rem; }
  .actions form { display:inline; }
  .button-inline {
    display:inline-flex; align-items:center; justify-content:center;
    background:#2a2a2a; color:#fff; border:1px solid #3a3a3a;
    border-radius:6px; padding:.45rem .7rem; font-size:.82rem; cursor:pointer;
  }
  .button-inline.primary { background:#16c97e; color:#06090f; border-color:#16c97e; }
  .button-inline.warn { background:#f59e0b; color:#06090f; border-color:#f59e0b; }
  .button-inline.danger { background:#e63946; color:#fff; border-color:#e63946; }
  .toolbar { display:flex; flex-wrap:wrap; gap:.5rem; margin: 0 0 1rem; }
  .toolbar a { color:#16c97e; text-decoration:none; }
</style>
<div class="blog-shell">
  <div class="blog-card">
    <div class="toolbar">
      <a href="/admin/incident-blog/new">Create New</a>
      <a href="/admin/incident-blog/subscribers/list">Subscribers</a>
    </div>
    <div class="blog-stats">
      <div class="blog-stat"><div class="value"><%= stats.draftCount %></div><div class="label">Drafts</div></div>
      <div class="blog-stat"><div class="value"><%= stats.approvedCount %></div><div class="label">Approved</div></div>
      <div class="blog-stat"><div class="value"><%= stats.publishedCount %></div><div class="label">Published</div></div>
      <div class="blog-stat"><div class="value"><%= stats.rejectedCount %></div><div class="label">Rejected</div></div>
      <div class="blog-stat"><div class="value"><%= stats.subscriberCount %></div><div class="label">Subscribers</div></div>
    </div>
  </div>

  <div class="blog-card">
    <form class="toolbar" method="get" action="/admin/incident-blog">
      <input type="text" name="status" value="<%= filters.status %>" placeholder="status">
      <input type="text" name="category" value="<%= filters.category %>" placeholder="category">
      <button class="button-inline primary" type="submit">Filter</button>
    </form>
    <div class="actions" style="margin-bottom:1rem;">
      <form method="post" action="/admin/incident-blog/research-run"><button class="button-inline warn" type="submit">Run Research</button></form>
      <form method="post" action="/admin/incident-blog/newsletter/send"><button class="button-inline warn" type="submit">Send Newsletter</button></form>
      <form method="post" action="/admin/incident-blog/generate-page"><button class="button-inline primary" type="submit">Regenerate Page</button></form>
    </div>
    <table class="blog-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Company</th>
          <th>Damage</th>
          <th>Status</th>
          <th>Date</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% for (const incident of incidents) { %>
          <tr>
            <td><%= incident.title %></td>
            <td><%= incident.company %></td>
            <td><span style="color:#e63946"><%= incident.damage %></span></td>
            <td><span class="pill <%= incident.status %>"><%= incident.status %></span></td>
            <td><%= incident.dateOccurred %></td>
            <td>
              <div class="actions">
                <a class="button-inline" href="/admin/incident-blog/<%= incident.id %>">View</a>
                <a class="button-inline" href="/admin/incident-blog/<%= incident.id %>/edit">Edit</a>
                <form method="post" action="/admin/incident-blog/<%= incident.id %>/approve"><button class="button-inline warn" type="submit">Approve</button></form>
                <form method="post" action="/admin/incident-blog/<%= incident.id %>/publish"><button class="button-inline primary" type="submit">Publish</button></form>
                <form method="post" action="/admin/incident-blog/<%= incident.id %>/reject"><input type="hidden" name="reason" value="Duplicate or needs review"><button class="button-inline" type="submit">Reject</button></form>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</div>
