<% title = 'Operator Tools' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Operator Tools</div>
      <div class="ops-page-sub">Curator, learning pipeline, capabilities audit, and security posture summaries.</div>
    </div>
  </div>

  <div class="ops-metrics" id="operator-metrics">
    <div class="ops-metric"><div class="ops-metric-label">Active skills</div><div class="ops-metric-value" id="op-active">-</div></div>
    <div class="ops-metric"><div class="ops-metric-label">Draft skills</div><div class="ops-metric-value warn" id="op-draft">-</div></div>
    <div class="ops-metric"><div class="ops-metric-label">Learning (24h)</div><div class="ops-metric-value" id="op-events">-</div></div>
    <div class="ops-metric"><div class="ops-metric-label">Promotions (7d)</div><div class="ops-metric-value ok" id="op-promotions">-</div></div>
  </div>

  <div class="ops-surface">
    <div class="ops-section">
      <div class="ops-section-title">Live endpoints</div>
      <p class="ops-section-sub">Read-only JSON APIs used by this page. Run curator and learning commands on the gateway host for writes.</p>
      <div class="ops-link-grid" style="margin-top:12px;">
        <a class="ops-link-row" href="/operator/status" target="_blank" rel="noopener"><div class="ops-link-row-title">Status</div><div class="ops-link-row-sub">Curator counts, kanban, learning metrics</div></a>
        <a class="ops-link-row" href="/operator/learning/pending" target="_blank" rel="noopener"><div class="ops-link-row-title">Learning pending</div><div class="ops-link-row-sub">Draft skills and recent corrections</div></a>
        <a class="ops-link-row" href="/operator/learning/improvements" target="_blank" rel="noopener"><div class="ops-link-row-title">Improvements</div><div class="ops-link-row-sub">Skill created, refined, rolled back events</div></a>
        <a class="ops-link-row" href="/operator/capabilities" target="_blank" rel="noopener"><div class="ops-link-row-title">Capabilities audit</div><div class="ops-link-row-sub">Tools, skills, channels inventory</div></a>
        <a class="ops-link-row" href="/operator/security" target="_blank" rel="noopener"><div class="ops-link-row-title">Security posture</div><div class="ops-link-row-sub">Scout + Carina trust state</div></a>
      </div>
    </div>
  </div>
</div>

<script>
fetch('/operator/status').then(function(r){ return r.json(); }).then(function(d){
  if (!d.ok) return;
  document.getElementById('op-active').textContent = d.curator?.active ?? '-';
  document.getElementById('op-draft').textContent = d.curator?.draft ?? '-';
  document.getElementById('op-events').textContent = d.learning?.events_last_24h ?? '-';
  document.getElementById('op-promotions').textContent = d.learning?.promotions_last_7d ?? '-';
}).catch(function(){});
</script>
