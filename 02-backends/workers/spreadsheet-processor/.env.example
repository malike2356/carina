# Aiva Spreadsheet Processor - env vars
# Copy to .env and fill in real values

# IMAP inbox to watch (Gmail app password recommended)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-inbox@gmail.com
IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Outbound email (Resend SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_XXXXXXXXXX
SMTP_FROM=contact@verlox.uk

# AI enrichment
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Poll interval in seconds (default 120 = 2 minutes)
POLL_INTERVAL=120

# State file for tracking processed UIDs
STATE_FILE=~/.hermes/data/spreadsheet-processor-state.json
