[Unit]
Description=Aiva Spreadsheet Processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=malike
WorkingDirectory=/home/malike/apps/carina/02-backends/workers/spreadsheet-processor
ExecStart=/home/malike/apps/carina/02-backends/workers/spreadsheet-processor/run.sh
Restart=on-failure
RestartSec=30
EnvironmentFile=/home/malike/apps/carina/02-backends/workers/spreadsheet-processor/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spreadsheet-processor

[Install]
WantedBy=multi-user.target
