# Laravel + Python/Celery shared env for docker-compose.yml (dev stack)
# Copy to laravel/.env before: docker compose up
# python-api and celery also read this file (env_file: ./laravel/.env)

APP_NAME=Carina
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=carina_central
DB_USERNAME=carina
DB_PASSWORD=secret

# Redis (must match docker-compose.yml REDIS_PASSWORD default)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=dev-redis-local
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Python API + Celery (redis://:password@host:port/db)
REDIS_URL=redis://:dev-redis-local@redis:6379/0
CELERY_BROKER_URL=redis://:dev-redis-local@redis:6379/1
CELERY_RESULT_BACKEND=redis://:dev-redis-local@redis:6379/2
