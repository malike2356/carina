{
  "name": "@verlox/carina-core",
  "version": "0.2.0",
  "description": "Carina kernel: tools, memory, model routing, channels, and CLI (MIT). Domain packs install separately.",
  "homepage": "https://carinaai.uk",
  "bugs": {
    "url": "https://carinaai.uk/docs/"
  },
  "main": "./dist/public-api/index.js",
  "types": "./dist/src/public-api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/public-api/index.d.ts",
      "import": "./dist/public-api/index.js"
    },
    "./pack": {
      "types": "./dist/src/public-api/pack.d.ts",
      "import": "./dist/public-api/pack.js"
    },
    "./tool": {
      "types": "./dist/src/public-api/tool.d.ts",
      "import": "./dist/public-api/tool.js"
    },
    "./channel": {
      "types": "./dist/src/public-api/channel.d.ts",
      "import": "./dist/public-api/channel.js"
    },
    "./memory": {
      "types": "./dist/src/public-api/memory.d.ts",
      "import": "./dist/public-api/memory.js"
    },
    "./provider": {
      "types": "./dist/src/public-api/provider.d.ts",
      "import": "./dist/public-api/provider.js"
    },
    "./extension": {
      "types": "./dist/src/public-api/extension.d.ts",
      "import": "./dist/public-api/extension.js"
    },
    "./plugin-sdk": {
      "types": "./dist/src/public-api/plugin-sdk.d.ts",
      "import": "./dist/public-api/plugin-sdk.js"
    },
    "./internal/*": "./dist/src/*",
    "./package.json": "./package.json",
    "./bin/carina": "./dist/bin/carina.js"
  },
  "imports": {
    "#core/*": "./dist/src/*"
  },
  "bin": {
    "carina": "./dist/bin/carina.js"
  },
  "files": [
    "dist/",
    "templates/",
    "brain/",
    "install.sh",
    "README.cli.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/kernel/STABLE_API.md",
    "docs/kernel/COMMERCIAL_BOUNDARIES.md",
    "docs/WINDOWS.md",
    "docs/benchmark/README.md",
    "docs/rfc/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "rm -rf dist && node_modules/.bin/tsc && mkdir -p dist/src/security dist/src/web dist/src/skills/hub dist/src/platform && cp src/security/injection-patterns.json dist/src/security/ && cp -r src/web/pricing dist/src/web/ && cp -r src/skills/hub/public dist/src/skills/hub/ && cp -r src/skills/hub/migrations dist/src/skills/hub/ && cp src/platform/platform-knowledge.md src/platform/platform-state.md dist/src/platform/ && node scripts/sync-public-api-dist.mjs && node_modules/.bin/esbuild packages/packs/property-uk/skills.ts --bundle=false --format=esm --outfile=packages/packs/property-uk/skills.js && node_modules/.bin/esbuild packages/packs/property-uk/prompts/system.ts --bundle=false --format=esm --outfile=packages/packs/property-uk/prompts/system.js && npm run build:widget",
    "build:widget": "cd widget && npm install && npm run build",
    "build:workspace": "pnpm build && pnpm --filter @verlox/carina-transport build && pnpm --filter @verlox/carina-web build && pnpm --filter @verlox/carina-scout build && pnpm --filter @verlox/pack-property build && pnpm --filter @verlox/pack-health build && pnpm --filter @verlox/pack-borehole-africa build",
    "cli": "tsx src/index.ts",
    "carina": "tsx bin/carina.ts",
    "hub": "tsx src/skills/hub/server.ts",
    "check": "pnpm --filter carina-cloud check && tsc --noEmit",
    "build:cloud": "pnpm --filter carina-cloud build",
    "ingest": "tsx src/skills/ingestion.ts --pack property-uk",
    "brain:sync": "bash ../../scripts/sync-brain-from-propreneur.sh",
    "brain:sync:dry-run": "bash ../../scripts/sync-brain-from-propreneur.sh --dry-run",
    "brain:check-drift": "bash ../../scripts/check-brain-drift.sh",
    "brain:sync-and-ingest": "bash ../../scripts/sync-brain-from-propreneur.sh && tsx src/skills/ingestion.ts --pack property-uk",
    "test": "vitest run",
    "seed:ops-demo": "tsx scripts/seed-ops-demo.ts",
    "email:preview": "email dev --dir src/email/templates --port 3100",
    "validate:windows": "vitest run src/windows/ src/tools/shell-exec.windows.test.ts",
    "benchmark:regression": "vitest run src/benchmark/benchmark.test.ts",
    "test:smoke": "bash scripts/smoke-install.sh",
    "test:white-label": "vitest run src/product/white-label-smoke.test.ts src/product/brand-compat.test.ts && node scripts/white-label-copy-guard.mjs",
    "test:identity-smoke": "vitest run src/product/identity-smoke.test.ts",
    "capability:check": "tsx scripts/capability-inventory-check.ts",
    "conveyor:audit": "tsx src/conveyor/cli.ts audit .",
    "conveyor:pipeline": "tsx src/conveyor/cli.ts pipeline . staging",
    "test:pack-contents": "bash scripts/test-pack-contents.sh",
    "boundary-check": "tsx scripts/check-kernel-boundaries.ts",
    "audit:security": "pnpm audit --audit-level=high",
    "audit:licenses": "npx license-checker --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD' --excludePrivatePackages",
    "release:changelog": "bash scripts/release/generate-changelog.sh",
    "release:publish": "bash scripts/release/npm-publish.sh",
    "test:watch": "vitest",
    "admin": "tsx ../ops.carinaai.uk/server.ts",
    "prepublishOnly": "pnpm build && pnpm boundary-check && pnpm test && pnpm test:smoke && node scripts/prune-pack-dist.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "llm",
    "carina",
    "kernel"
  ],
  "author": "VERLOX Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malike2356/carina-aiva.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@verlox/carina-scout": "^0.2.0",
    "@verlox/carina-web": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@verlox/carina-web": {
      "optional": true
    },
    "@verlox/carina-scout": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.100.1 <1.0.0",
    "@google/generative-ai": ">=0.24.1 <1.0.0",
    "@inquirer/prompts": "^7.10.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@paddle/paddle-node-sdk": ">=1.0.0 <2.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@sentry/node": ">=9.47.0 <10.0.0",
    "@slack/bolt": "^4.6.0",
    "@types/react-dom": "18.3.5",
    "@verlox/carina-transport": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "archiver": "^8.0.0",
    "bcryptjs": ">=2.4.3 <3.0.0",
    "better-sqlite3": ">=11.10.0 <12.0.0",
    "chalk": "^5.6.2",
    "croner": "^10.0.1",
    "discord.js": "^14.19.3",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": ">=5.2.1 <6.0.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "imapflow": "^1.4.0",
    "ink": "^5.2.1",
    "ink-gradient": "^4.0.1",
    "ink-markdown": "^1.0.4",
    "ink-text-input": "^6.0.0",
    "ioredis": ">=5.11.0 <6.0.0",
    "keybase-bot": "^3.6.1",
    "mammoth": "^1.9.0",
    "marked": "^18.0.5",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "^1.1.0",
    "nodemailer": ">=9.0.1 <10.0.0",
    "openai": ">=6.41.0 <7.0.0",
    "otplib": "^13.4.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "pgvector": "^0.3.0",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "readline-sync": "^1.4.10",
    "resend": "^6.12.4",
    "stripe": "^20.4.0",
    "tsx": ">=4.22.4 <5.0.0",
    "twilio": "^5.12.2",
    "uuid": "^14.0.0",
    "ws": ">=8.18.3 <9.0.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.0",
    "@types/node": "^25.9.1",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@verlox/carina-scout": "workspace:*",
    "@verlox/carina-web": "workspace:*",
    "@verlox/pack-borehole-africa": "workspace:*",
    "@verlox/pack-health": "workspace:*",
    "@verlox/pack-property": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": ">=0.28.1 <0.29.0",
    "nodemon": "^3.1.14",
    "ts-node": ">=10.9.2 <11.0.0",
    "typescript": ">=6.0.3 <7.0.0",
    "vitest": "4.1.10"
  }
}
