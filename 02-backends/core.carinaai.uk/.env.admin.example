# Production admin app runtime (copy to .env.admin.runtime; never commit secrets)
NODE_ENV=production
PORT=4200
HOSTNAME=0.0.0.0

ADMIN_CORE_URL=http://carina-web:3000
ADMIN_SESSION_SECRET=change-me-admin-session-min-32-chars
# Must match ADMIN_TOKEN_SECRET on core (.env.docker.runtime)
ADMIN_TOKEN_SECRET=change-me-admin-token-secret-min-32-chars
ADMIN_SETUP_TOKEN=change-me-admin-setup-token
NEXT_PUBLIC_APP_URL=https://admin.carinaai.uk
SENTRY_DSN_ADMIN=
