# Production .env for Carina on Contabo VPS
# Copy to .env on the VPS: /opt/carina/.env
# Never commit this file with real values.

# Primary domain. Change this one value when migrating to a new domain.
# All subdomains (app., core., ops., hub., docs., install., skills.) derive from this.
CARINA_DOMAIN=carinaai.uk

NODE_ENV=production
WEB_PORT=3000
WEB_ENABLED=true
SKIP_CLI=true
HOSTED_MODE=true
# Host split (same codebase, two nginx vhosts):
#   app.carinaai.uk  -> hosted SaaS (not in CARINA_OPERATOR_HOSTS)
#   core.carinaai.uk -> private instance (must be in CARINA_OPERATOR_HOSTS)
CARINA_OPERATOR_HOSTS=core.carinaai.uk
CARINA_HOSTED_APP_HOST=app.carinaai.uk

# --- Carina Ops (customer product on app.carinaai.uk) ---
CARINA_OPS_PRODUCT_ENABLED=true
# AES-256 key for BYOK vault encryption (generate random 32+ bytes)
TENANT_KEY_ENCRYPTION_KEY=

# --- LLM Providers ---
DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
# Primary: Gemini text-embedding-004 (cheapest)
GEMINI_API_KEY=
# OpenAI key above is used for text-embedding-3-small (1536 dims)
# If OpenAI quota is an issue, switch to Gemini embeddings (Phase 2)

# --- Database ---
# Docker production: use pgbouncer:6432 (PgBouncer transaction pooler). Postgres listens on postgres:5432 inside Compose only.
DATABASE_URL=postgresql://carina:CHANGE_ME@pgbouncer:6432/carina

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Search (web-search tool; Tavily free tier at tavily.com) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# Paid fallback only: SEARCH_PROVIDER=brave + BRAVE_SEARCH_API_KEY
# SearXNG self-hosted search (alternative to Tavily/Brave - free and private)
SEARXNG_URL=

# --- Email (Resend - verified for carinaai.uk; required for invites and password reset) ---
RESEND_API_KEY=

# --- Stripe (hosted billing) ---
# Get these from dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=

# Get this from Developers > Webhooks > select endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=

# Aiva subscription prices (create with: tsx scripts/stripe-setup-aiva.ts)
# Products > [plan] > Pricing: paste each price_XXXX ID for monthly and annual
STRIPE_PRICE_AIVA_STARTER_MONTHLY=
STRIPE_PRICE_AIVA_STARTER_ANNUAL=
STRIPE_PRICE_AIVA_TEAM_MONTHLY=
STRIPE_PRICE_AIVA_TEAM_ANNUAL=
STRIPE_PRICE_AIVA_BUSINESS_MONTHLY=
STRIPE_PRICE_AIVA_BUSINESS_ANNUAL=

# Scout billing (separate products in Stripe)
STRIPE_PRICE_SCOUT_MONITOR=
STRIPE_PRICE_SCOUT_GOVERN=

# Set to 'false' to disable checkout (e.g. during maintenance). Omit or set to 'true' to enable.
# AIVA_BILLING_ENABLED=true

STRIPE_PRICE_SCOUT_PRO=
STRIPE_PRICE_SCOUT_STANDARD=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_CARINA_OPS_STARTER=
STRIPE_PRICE_CARINA_OPS_TEAM=
# Metered billing for partner platform events (TB-004). Create via Stripe dashboard:
# 1. Create a Billing Meter with event_name=platform_events (Settings > Billing > Meters)
# 2. Create a tiered price linked to that meter: 0-50k free, 50k-500k GBP 0.001/event, 500k+ GBP 0.0005/event
# See SOP/009-cron-workflows.md for the nightly reporting cron job
STRIPE_METER_EVENT_NAME=platform_events
STRIPE_PRICE_PLATFORM_EVENTS_METERED=price_

# --- Auth (hosted mode) ---
JWT_SECRET=GENERATE_RANDOM_64_CHARS_HERE

# --- Property APIs ---
PROPERTY_DATA_API_KEY=
LAND_REGISTRY_API_KEY=
# Optional: defaults to PropertyData.co.uk (same key as PROPERTY_DATA_API_KEY if unset)
# LAND_REGISTRY_BASE_URL=https://api.propertydata.co.uk

# Trello (optional)
TRELLO_API_KEY=
TRELLO_TOKEN=

# CalDAV calendar sync (optional, strict opt-in)
# CALDAV_URL should be your calendar collection URL (Nextcloud personal calendar, Radicale collection, Fastmail calendar path).
# If discovery is needed, set CALDAV_PRINCIPAL_URL to your CalDAV principal/home URL instead.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_PRINCIPAL_URL=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
# Operator Telegram chat ID for security alerts (get from @userinfobot)
TELEGRAM_OPERATOR_CHAT_ID=
# Webhook endpoint is served by core (not app.carinaai.uk). Leave empty for polling mode.
TELEGRAM_WEBHOOK_URL=https://core.carinaai.uk/webhooks/telegram

# --- WhatsApp (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Skills Hub ---
SKILLS_HUB_DATABASE_URL=postgresql://carina:CHANGE_ME@pgbouncer:6432/carina_skills_hub
SKILLS_HUB_PORT=3001
SKILLS_HUB_PUBLISH_KEY=GENERATE_RANDOM_32_CHARS_HERE

# --- CORS ---
CORS_ORIGIN=https://app.carinaai.uk

# --- Post-GTM security (keep false until public GTM is stable; see docker/config/gtm-rollout.json) ---
NGINX_ADMIN_IP_ALLOWLIST=false
NGINX_STAGING_IP_ALLOWLIST=false

# --- Skill auto-write ---
SKILL_AUTO_WRITE=true

# Command flagging: Carina flags risky shell commands before executing.
# Default: on. Set to 'off' to disable (not recommended for production).
CARINA_COMMAND_FLAG=on

# --- Observability (optional) ---
SENTRY_DSN_CORE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=verlox
SENTRY_PROJECT_CORE=carina-core

# --- Self-configuration credential store ---
# AES-256-GCM encryption key for the tool_credentials table.
# Generate: openssl rand -hex 32
# If not set, Carina cannot store new credentials (env var fallback still works).
CREDENTIAL_ENCRYPTION_KEY=

# Scout self-modification security
SCOUT_SELF_MOD_AUTO_RESPONSE=true
SCOUT_SELF_MOD_AUTO_SUSPEND=true
SCOUT_SELF_MOD_ALERT_TELEGRAM=true
SCOUT_SELF_MOD_DAILY_AUDIT_TIME=02:00

# Dynamic tool generation - sandbox limits
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_MB=128
SANDBOX_MAX_GENERATIONS_PER_HOUR=10
# Set to true to auto-approve generated tools without the 3-gate auth flow (not recommended)
RUNTIME_TOOL_AUTO_APPROVE=false
