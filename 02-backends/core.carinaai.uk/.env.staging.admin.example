# Staging admin app runtime (copy to .env.staging.admin.runtime; never commit secrets)
NODE_ENV=staging
PORT=4200
HOSTNAME=0.0.0.0

ADMIN_CORE_URL=http://carina-staging-web:3000
ADMIN_SESSION_SECRET=change-me-staging-admin-session-min-32-chars
# Must match core .env.staging.runtime
ADMIN_TOKEN_SECRET=change-me-staging-admin-token-secret-min-32-chars
ADMIN_SETUP_TOKEN=change-me-staging-setup-token
NEXT_PUBLIC_APP_URL=https://staging.admin.carinaai.uk
SENTRY_DSN_ADMIN=
