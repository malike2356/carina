# Cloud app (app.carinaai.uk / admin.hireaiva.co.uk) runtime for Docker.
# Marketing site: https://hireaiva.co.uk/
# Copy to .env.cloud.runtime on the VPS, or run: python3 docker/scripts/sync-cloud-env.py
# Never commit this file with real values.

DATABASE_URL=postgresql://carina:CHANGE_ME@pgbouncer:6432/carina_cloud
VAULT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.carinaai.uk
NEXT_PUBLIC_APP_URL=https://app.carinaai.uk
AIVA_PRODUCT_HOST=admin.hireaiva.co.uk
AIVA_PRODUCT_HOSTS=admin.hireaiva.co.uk
AIVA_APP_URL=https://admin.hireaiva.co.uk
NEXT_PUBLIC_AIVA_APP_URL=https://admin.hireaiva.co.uk

# Leave unset to auto-disable cross-subdomain cookies when AIVA_PRODUCT_HOSTS
# includes a non-carinaai.uk host (required for admin.hireaiva.co.uk sessions).
# Set to carinaai.uk only when all Aiva hosts stay on *.carinaai.uk.
# BETTER_AUTH_COOKIE_DOMAIN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CARINA_OPS_STARTER=
STRIPE_PRICE_CARINA_OPS_TEAM=

# Docker internal (sync-cloud-env.py rewrites these)
PORT=4100
HOSTNAME=0.0.0.0
CARINA_CORE_URL=http://carina-web:3000
SKILLS_HUB_INTERNAL_URL=http://carina-hub:3001

# Required for logs, terminal, MCP, cron, webhooks, and core-proxy chat.
# Must match CARINA_OPS_TOKEN in core .env.docker.runtime / carina-web.
CARINA_USE_CORE_PROXY=true
CARINA_OPS_TOKEN=

# Optional: must match core CARINA_INTERNAL_KEY for password reset and internal webhooks
CARINA_INTERNAL_KEY=

GROQ_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
