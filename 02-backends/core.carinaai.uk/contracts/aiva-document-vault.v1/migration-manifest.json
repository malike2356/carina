{
  "version": "1.0.0",
  "modeDefault": "dry_run",
  "rollbackCriteria": [
    "Canonical vault service feature flag DOCUMENT_VAULT_V1_ENABLED can be set false without deleting legacy tables.",
    "Compatibility adapters remain on while DOCUMENT_VAULT_COMPAT_ADAPTERS=true.",
    "Dual-write (DOCUMENT_VAULT_DUAL_WRITE) can be disabled; readers fall back to legacy stores.",
    "DOCUMENT_VAULT_RETIRE_LEGACY_STORES must stay false until cutover checksums match and soak passes.",
    "Rollback restores routing only; never delete migrated vault rows until owner-approved purge job."
  ],
  "recordTypes": [
    {
      "id": "cloud_documents",
      "source": "carina_cloud.documents",
      "targetKind": "html|markdown|plain_text",
      "idStrategy": "preserve_uuid_as_vault_item_id",
      "fields": {
        "workspaceId": "workspace_id",
        "name": "title",
        "body": "content",
        "format": "format",
        "trashed": "archived",
        "createdAt": "created_at",
        "updatedAt": "updated_at"
      },
      "contentAuthority": "workspace",
      "parentId": null,
      "checksum": "sha256(content)",
      "risks": ["no_revision_history", "hard_delete_loss"]
    },
    {
      "id": "cloud_user_notes_files_union",
      "source": "carina_cloud.user_notes",
      "targetKind": "plain_text (optional projection only)",
      "idStrategy": "do_not_collide_with_vault; keep notes store canonical for Notes product",
      "fields": {
        "workspaceId": "workspace_id",
        "name": "title",
        "body": "content"
      },
      "contentAuthority": "workspace",
      "parentId": null,
      "note": "/files continues to union notes; vault migration does not absorb notes by default"
    },
    {
      "id": "host_carina_documents",
      "source": "sqlite.carina_documents",
      "targetKind": "out_of_scope_for_aiva_vault",
      "idStrategy": "none",
      "fields": {},
      "contentAuthority": "n/a",
      "note": "Operator host store only; never migrate into customer Aiva vault"
    },
    {
      "id": "aiva_knowledge_documents",
      "source": "postgres.aiva_knowledge_base where type=document",
      "targetKind": "plain_text|pdf_derived",
      "idStrategy": "preserve_uuid_as_vault_item_id with legacy_mapping knowledge:{id}",
      "fields": {
        "workspaceId": "workspace_id",
        "workerId": "worker_id",
        "name": "title",
        "body": "content",
        "enabled": "index_policy/enabled"
      },
      "contentAuthority": "workspace",
      "risks": ["worker_scoped_vs_workspace_tree", "missing_ddl_in_repo"]
    },
    {
      "id": "aiva_knowledge_faq",
      "source": "postgres.aiva_knowledge_base where type=faq",
      "targetKind": "faq_or_plain_text",
      "idStrategy": "preserve_uuid with legacy_mapping knowledge:{id}",
      "fields": {
        "workspaceId": "workspace_id",
        "workerId": "worker_id",
        "name": "title",
        "body": "content"
      },
      "contentAuthority": "workspace",
      "note": "Prefer keep FAQ API until explorer supports FAQ kind"
    },
    {
      "id": "workspace_ops_bindings",
      "source": "postgres.aiva_workspace_ops_bindings",
      "targetKind": "sync_root_config",
      "idStrategy": "preserve_uuid as vault_sync_binding_id",
      "fields": {
        "workspaceId": "workspace_id",
        "workerId": "worker_id"
      },
      "contentAuthority": "n/a"
    },
    {
      "id": "workspace_ops_mappings",
      "source": "postgres.aiva_workspace_ops_mappings",
      "targetKind": "provider_mapping",
      "idStrategy": "preserve unique (binding_id, drive_file_id)",
      "fields": {
        "localItemId": "aiva_document_id",
        "provider": "google",
        "providerItemId": "drive_file_id",
        "status": "sync_status",
        "contentHash": "content_hash"
      },
      "contentAuthority": "google_or_workspace_per_status",
      "risks": ["conflict_status_must_not_lww"]
    },
    {
      "id": "workspace_ops_folders",
      "source": "postgres.aiva_workspace_ops_folders + Drive folder ids",
      "targetKind": "folder",
      "idStrategy": "synthetic vault folder ids mapped to drive folder ids",
      "fields": {
        "providerItemId": "drive_folder_id",
        "name": "category_or_name"
      },
      "contentAuthority": "google"
    },
    {
      "id": "chat_upload_files",
      "source": "CARINA_DATA_DIR/aiva-uploads/{workspaceId}/...",
      "targetKind": "binary_upload (on confirmed import only)",
      "idStrategy": "new_vault_id; store legacy path in mapping",
      "fields": {
        "workspaceId": "path_segment",
        "name": "filename"
      },
      "contentAuthority": "workspace",
      "risks": ["orphans_without_db_row"]
    },
    {
      "id": "channel_shield_attachments",
      "source": "channel_shield_attachments",
      "targetKind": "binary_upload after quarantine scan",
      "idStrategy": "new_vault_id on import confirm",
      "fields": {
        "name": "filename",
        "mime": "content_type",
        "checksum": "sha256"
      },
      "contentAuthority": "workspace"
    },
    {
      "id": "google_drive_native_only",
      "source": "Google Drive via google-drive-* tools",
      "targetKind": "provider stub or import",
      "idStrategy": "provider:google:{fileId}",
      "fields": {},
      "contentAuthority": "google",
      "note": "Do not blind-import entire Drive; only selected sync roots"
    }
  ],
  "duplicateDetection": [
    "Same workspaceId + normalized name + checksum across cloud_documents and aiva_knowledge_documents",
    "Same drive_file_id mapped to multiple aiva_document_id values",
    "Same vault candidate id appearing in two source tables"
  ],
  "orphanDetection": [
    "Ops mapping with missing knowledge row",
    "Knowledge document with deleted mapping status but Drive file still present (report only)",
    "aiva-uploads files with no DB reference",
    "rag_chunks citing missing document ids"
  ],
  "conflictDetection": [
    "Ops sync_status=conflict",
    "Local content hash != remote hash with both sides newer than last_synced",
    "UUID collision between documents.id and aiva_knowledge_base.id when merging namespaces"
  ]
}
