{
  "version": "1.0.0",
  "converterVersion": "document-vault-formats/1.0.0",
  "limits": {
    "maxUploadBytes": 12582912,
    "maxTextChars": 2000000,
    "maxSpreadsheetRows": 50000,
    "maxSpreadsheetColumns": 250,
    "maxPdfSourceChars": 500000
  },
  "formats": [
    {
      "id": "markdown",
      "extensions": ["md", "markdown"],
      "mimeTypes": ["text/markdown"],
      "vaultKind": "markdown",
      "create": true,
      "edit": true,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": true,
      "fidelity": "lossless"
    },
    {
      "id": "html",
      "extensions": ["html", "htm"],
      "mimeTypes": ["text/html"],
      "vaultKind": "html",
      "create": true,
      "edit": true,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": true,
      "fidelity": "sanitized"
    },
    {
      "id": "plain_text",
      "extensions": ["txt", "text"],
      "mimeTypes": ["text/plain"],
      "vaultKind": "plain_text",
      "create": true,
      "edit": true,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": true,
      "fidelity": "lossless"
    },
    {
      "id": "rich_document",
      "extensions": ["docx"],
      "mimeTypes": ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"],
      "vaultKind": "rich_document",
      "create": true,
      "edit": true,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": true,
      "fidelity": "lossy_on_office_roundtrip",
      "warnings": ["DOCX import extracts text only; macros are never executed."]
    },
    {
      "id": "spreadsheet",
      "extensions": ["csv", "tsv", "xlsx", "xls", "ods"],
      "mimeTypes": [
        "text/csv",
        "text/tab-separated-values",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-excel",
        "application/vnd.oasis.opendocument.spreadsheet"
      ],
      "vaultKind": "spreadsheet",
      "create": true,
      "edit": true,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": false,
      "fidelity": "canonical_csv",
      "warnings": ["Spreadsheets normalize to CSV/JSON grid; formulas and macros are stripped."]
    },
    {
      "id": "presentation",
      "extensions": ["pptx"],
      "mimeTypes": ["application/vnd.openxmlformats-officedocument.presentationml.presentation"],
      "vaultKind": "presentation",
      "create": true,
      "edit": false,
      "import": true,
      "export": false,
      "preview": true,
      "pdfSource": false,
      "fidelity": "binary_preserve",
      "warnings": ["PPTX is stored as an original upload; structured slide editing is not supported yet."]
    },
    {
      "id": "json",
      "extensions": ["json"],
      "mimeTypes": ["application/json"],
      "vaultKind": "plain_text",
      "create": true,
      "edit": true,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": false,
      "fidelity": "lossless"
    },
    {
      "id": "pdf",
      "extensions": ["pdf"],
      "mimeTypes": ["application/pdf"],
      "vaultKind": "pdf",
      "create": false,
      "edit": false,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": false,
      "fidelity": "generated_or_original",
      "warnings": ["Generated PDFs are artifacts linked to the source revision; uploaded PDFs are originals."]
    },
    {
      "id": "image",
      "extensions": ["png", "jpg", "jpeg", "gif", "webp"],
      "mimeTypes": ["image/png", "image/jpeg", "image/gif", "image/webp"],
      "vaultKind": "binary_upload",
      "create": false,
      "edit": false,
      "import": true,
      "export": true,
      "preview": true,
      "pdfSource": false,
      "fidelity": "binary_preserve"
    },
    {
      "id": "rtf",
      "extensions": ["rtf"],
      "mimeTypes": ["application/rtf", "text/rtf"],
      "vaultKind": "plain_text",
      "create": false,
      "edit": false,
      "import": true,
      "export": false,
      "preview": false,
      "pdfSource": false,
      "fidelity": "lossy_text_strip",
      "warnings": ["RTF import strips control words to plain text."]
    },
    {
      "id": "odt",
      "extensions": ["odt"],
      "mimeTypes": ["application/vnd.oasis.opendocument.text"],
      "vaultKind": "binary_upload",
      "create": false,
      "edit": false,
      "import": true,
      "export": false,
      "preview": false,
      "pdfSource": false,
      "fidelity": "binary_preserve",
      "warnings": ["ODT is preserved as an original binary; text conversion is not enabled yet."]
    }
  ],
  "unsupported": [
    {
      "id": "archives",
      "extensions": ["zip", "tar", "gz", "7z", "rar"],
      "reason": "Archive bomb and nested-macro risk; unpack outside vault first."
    },
    {
      "id": "executables",
      "extensions": ["exe", "dll", "bat", "cmd", "sh", "js", "mjs", "vbs", "ps1"],
      "reason": "Executable content is rejected."
    }
  ]
}
