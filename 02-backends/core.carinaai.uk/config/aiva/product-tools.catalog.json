    {
      "slug": "hubspot",
      "label": "HubSpot",
      "category": "crm",
      "status": "live",
      "auth": "vault",
      "driver": "http",
      "scopes": [
        "read",
        "write"
      ],
      "vaultLabel": "hubspot-token",
      "probe": {
        "method": "GET",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts?limit=1",
        "authHeader": "Bearer {{token}}"
      },
      "actions": [
        {
          "id": "search_contacts",
          "scope": "read",
          "method": "POST",
          "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
          "authHeader": "Bearer {{token}}",
          "json": {
            "query": "{{query}}",
            "limit": 10
          }
        },
        {
          "id": "get_contact",
          "scope": "read",
          "method": "GET",
          "url": "https://api.hubapi.com/crm/v3/objects/contacts/{{contactId}}",
          "authHeader": "Bearer {{token}}"
        },
        {
          "id": "list_contacts",
          "scope": "read",
          "method": "GET",
          "url": "https://api.hubapi.com/crm/v3/objects/contacts?limit=10",
          "authHeader": "Bearer {{token}}"
        }
      ]
    },
