    {
      "slug": "trello",
      "label": "Trello",
      "category": "productivity",
      "status": "live",
      "auth": "vault",
      "driver": "http",
      "scopes": [
        "read",
        "write"
      ],
      "vaultLabel": "trello-token",
      "probe": {
        "method": "GET",
        "url": "https://api.trello.com/1/members/me?key={{apiKey}}&token={{token}}"
      },
      "configFields": [
        "apiKey"
      ],
      "actions": [
        {
          "id": "list-boards",
          "scope": "read",
          "method": "GET",
          "url": "https://api.trello.com/1/members/me/boards?fields=id,name,url&key={{apiKey}}&token={{token}}"
        },
        {
          "id": "list-lists",
          "scope": "read",
          "method": "GET",
          "url": "https://api.trello.com/1/boards/{{boardId}}/lists?fields=id,name&key={{apiKey}}&token={{token}}"
        },
        {
          "id": "list-cards",
          "scope": "read",
          "method": "GET",
          "url": "https://api.trello.com/1/lists/{{listId}}/cards?fields=id,name,desc,url,due&key={{apiKey}}&token={{token}}"
        },
        {
          "id": "create-card",
          "scope": "write",
          "method": "POST",
          "url": "https://api.trello.com/1/cards?idList={{listId}}&name={{name}}&desc={{desc}}&key={{apiKey}}&token={{token}}"
        },
        {
          "id": "move-card",
          "scope": "write",
          "method": "PUT",
          "url": "https://api.trello.com/1/cards/{{cardId}}?idList={{listId}}&key={{apiKey}}&token={{token}}"
        },
        {
          "id": "update-desc",
          "scope": "write",
          "method": "PUT",
          "url": "https://api.trello.com/1/cards/{{cardId}}/desc?value={{desc}}&key={{apiKey}}&token={{token}}"
        },
        {
          "id": "add-comment",
          "scope": "write",
          "method": "POST",
          "url": "https://api.trello.com/1/cards/{{cardId}}/actions/comments?text={{text}}&key={{apiKey}}&token={{token}}"
        },
        {
          "id": "archive-card",
          "scope": "write",
          "method": "PUT",
          "url": "https://api.trello.com/1/cards/{{cardId}}/closed?value=true&key={{apiKey}}&token={{token}}"
        }
      ]
    },
