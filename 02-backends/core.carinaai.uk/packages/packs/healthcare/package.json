{
  "name": "@verlox/pack-health",
  "version": "1.0.0",
  "description": "Healthcare administration domain pack for Carina",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "pack.json",
    "README.md"
  ],
  "carina": {
    "pack": "./pack.json",
    "slug": "healthcare"
  },
  "imports": {
    "#core/*": "@verlox/carina-core/internal/*"
  },
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "@verlox/carina-core": "^0.2.0"
  },
  "devDependencies": {
    "@verlox/carina-core": "workspace:*",
    "typescript": "^6.0.3"
  },
  "keywords": ["carina", "pack", "healthcare"],
  "author": "VERLOX Ltd",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
