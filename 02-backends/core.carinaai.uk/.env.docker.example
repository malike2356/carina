# Carina standalone Docker stack (.env.docker)
# Copy to .env.docker and fill secrets. Never commit real keys.

CARINA_BIND=127.0.0.1
CARINA_PORT=3000

# Operator profile (optional; seeds USER.md on first boot)
CARINA_OPERATOR_NAME=
CARINA_OPERATOR_CONTEXT=

# Cloud provider (pick one)
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Lightweight local mode (default; no Postgres required)
CARINA_LOCAL_MODE=true
CARINA_SKIP_POSTGRES=true
CARINA_MEMORY_BACKEND=builtin
WEB_ENABLED=true

# Full memory stack (enable postgres profile and set DATABASE_URL)
# DB_PASSWORD=change-me
# DATABASE_URL=postgresql://carina:change-me@postgres:5432/carina
# REDIS_PASSWORD=dev-redis-local
# REDIS_URL=redis://:dev-redis-local@redis:6379

# Local Ollama (enable ollama profile or gpu overlay)
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://ollama:11434/v1


# --- VPS deploy overrides (set these in .env.docker.runtime on the server) ---
# Build contexts: absolute paths to sibling repos on the VPS
# CARINA_OPS_CONTEXT=/home/malike/apps/ops.carinaai.uk
# CARINA_OPS_DOCKERFILE=docker/Dockerfile.runtime
# CARINA_CLOUD_CONTEXT=/home/malike/apps/app.carinaai.uk
# CARINA_CLOUD_DOCKERFILE=docker/Dockerfile

# SSL directory (managed by host certbot; docker/scripts/init-certs.sh bootstraps this)
# CARINA_SSL_DIR=/etc/carina/ssl

# Static site for labyrinthscout.com (served by Docker nginx)
# LABYRINTHSCOUT_STATIC=/home/malike/apps/labyrinthscout.com-static

# Post-GTM security (documented in docker/config/gtm-rollout.json; nginx geo blocks edited in repo when true)
# NGINX_ADMIN_IP_ALLOWLIST=false
# NGINX_STAGING_IP_ALLOWLIST=false
