# Staging cloud app runtime (copy to core/.env.staging.cloud.runtime; never commit secrets)
NODE_ENV=staging
PORT=4100
HOSTNAME=0.0.0.0

DATABASE_URL=postgresql://carina:CHANGE_ME@pgbouncer-staging:6432/carina_staging
VAULT_SECRET=change-me-staging-vault-secret-min-32-chars
BETTER_AUTH_SECRET=change-me-staging-auth-secret-min-32-chars
BETTER_AUTH_URL=https://staging.app.carinaai.uk
NEXT_PUBLIC_APP_URL=https://staging.app.carinaai.uk
AIVA_PRODUCT_HOST=staging.admin.hireaiva.co.uk

CARINA_CORE_URL=http://carina-staging-web:3000
CARINA_USE_CORE_PROXY=true
CARINA_OPS_TOKEN=change-me-staging-ops-token

# Optional Sentry (browser init gated on cookie consent)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
