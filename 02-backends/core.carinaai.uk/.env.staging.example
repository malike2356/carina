# Staging runtime (copy to .env.staging.runtime on VPS; never commit secrets)
NODE_ENV=staging
HOSTED_MODE=true

DATABASE_URL=postgresql://carina:CHANGE_ME@pgbouncer-staging:6432/carina_staging
REDIS_PASSWORD=staging-redis-local
REDIS_URL=redis://:staging-redis-local@redis-staging:6379

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_test_CHANGE_ME

AIVA_BILLING_ENABLED=true
AIVA_SCOUT_FLEET_ENABLED=false
AIVA_CHAIN_ATTEST_ENABLED=false
RESEND_PREVIEW_MODE=true

SENTRY_DSN_CORE=

# Bootstrap admin (used by seed-staging.sh and admin UI)
ADMIN_BOOTSTRAP_EMAIL=admin@staging.carinaai.uk
ADMIN_BOOTSTRAP_PASSWORD=AdminPassword123!
STAGING_CONTACT_EMAIL=test@staging.carinaai.uk
ADMIN_TOKEN_SECRET=change-me-staging-admin-token-secret-min-32-chars
ADMIN_SETUP_TOKEN=change-me-staging-setup-token
