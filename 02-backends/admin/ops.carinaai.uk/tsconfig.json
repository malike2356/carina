{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["dist", "node_modules", "vendor", "app", "bootstrap", "database", "public", "resources", "routes/web.php", "storage", "tests", "**/*.test.ts"]
}
