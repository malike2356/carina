# Build from the committed source context. Production never consumes host dist
# or node_modules directories.
FROM node:22-alpine AS builder
WORKDIR /build
RUN apk add --no-cache python3 make g++ \
  && corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM node:22-alpine
WORKDIR /app
ARG BUILD_REVISION=unknown
ARG BUILD_TIME=unknown
ENV NODE_ENV=production
ENV BUILD_REVISION=${BUILD_REVISION}
ENV BUILD_TIME=${BUILD_TIME}
RUN apk add --no-cache tini docker-cli util-linux python3 make g++ \
  && corepack enable \
  && corepack prepare pnpm@9.15.9 --activate
COPY --from=builder /build/package.json ./
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/views ./views
COPY --from=builder /build/public ./public
COPY --from=builder /build/data ./data
RUN mkdir -p /app/data && chown -R node:node /app/data || true
EXPOSE 4001
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
