<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Scout Accounts</div>
      <div class="ops-page-sub">Customer accounts on console.labyrinthscout.com (checkout provisioning, login, API keys).</div>
    </div>
    <div class="ops-actions" style="margin-top:0;">
      <a href="/tenants" class="ops-btn-ghost">Cloud tenants</a>
      <a href="/scout/summary" class="ops-btn-ghost">Scout summary</a>
    </div>
  </div>

  <% if (error) { %>
    <div class="ops-flash warn"><%= error %></div>
  <% } %>

  <% const flash = new URLSearchParams(locals.query || ''); %>
  <% if (flash.get('deactivated')) { %><div class="ops-flash ok">Account deactivated.</div><% } %>
  <% if (flash.get('activated')) { %><div class="ops-flash ok">Account re-activated.</div><% } %>
  <% if (flash.get('error')) { %><div class="ops-flash warn"><%= flash.get('error') %></div><% } %>

  <% if (resetUrl) { %>
    <div class="ops-surface" style="margin-bottom:16px;padding:16px;border-color:rgba(0,200,100,0.35);">
      <div class="ops-section-title" style="margin-bottom:8px;">Password setup link (7 days)</div>
      <p class="ops-inline-note" style="margin-bottom:10px;">Copy and send to the account holder. They use this once to set a new password.</p>
      <input type="text" readonly value="<%= resetUrl %>" class="ops-input" style="width:100%;font-family:JetBrains Mono,monospace;font-size:13px;" onclick="this.select()">
    </div>
  <% } %>

  <% if (apiKey) { %>
    <div class="ops-surface" style="margin-bottom:16px;padding:16px;border-color:rgba(212,175,55,0.45);">
      <div class="ops-section-title" style="margin-bottom:8px;">New API key (shown once)</div>
      <p class="ops-inline-note" style="margin-bottom:10px;">Prefix: <code class="ops-code"><%= keyPrefix || '-' %></code>. Previous active keys were revoked.</p>
      <input type="text" readonly value="<%= apiKey %>" class="ops-input" style="width:100%;font-family:JetBrains Mono,monospace;font-size:13px;" onclick="this.select()">
    </div>
  <% } %>

  <% if (!accounts.length && !error) { %>
    <div class="ops-empty">No Scout accounts yet.</div>
  <% } else if (accounts.length) { %>
    <div class="ops-surface" style="padding:0;overflow:hidden;">
      <table class="ops-table" style="width:100%;">
        <thead>
          <tr>
            <th>Email</th>
            <th>Plan</th>
            <th>Status</th>
            <th>API keys</th>
            <th>Carina tenant</th>
            <th>Created</th>
            <th style="text-align:right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% accounts.forEach(function(a) { %>
            <tr>
              <td><%= a.email %></td>
              <td><span class="ops-badge ops-badge-cyan"><%= a.subscriptionPlan %></span></td>
              <td>
                <span class="ops-badge <%= a.isActive ? 'ops-badge-green' : 'ops-badge-red' %>">
                  <%= a.isActive ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td><%= a.activeApiKeyCount %> / <%= a.apiKeyCount %></td>
              <td>
                <% if (a.carinaTenantId) { %>
                  <a href="/tenants/<%= a.carinaTenantId %>" class="ops-link" style="font-size:12px;"><%= a.carinaTenantId.slice(0, 8) %>...</a>
                <% } else { %>
                  <span class="ops-inline-note">-</span>
                <% } %>
              </td>
              <td class="ops-inline-note"><%= new Date(a.createdAt).toLocaleDateString() %></td>
              <td>
                <div class="ops-actions" style="justify-content:flex-end;flex-wrap:wrap;gap:6px;margin:0;">
                  <form method="post" action="/scout/accounts/<%= a.id %>/reset-password" class="inline">
                    <button type="submit" class="ops-btn-ghost" style="font-size:12px;padding:4px 8px;">Reset password</button>
                  </form>
                  <form method="post" action="/scout/accounts/<%= a.id %>/reset-api-key" class="inline"
                        onsubmit="return confirm('Revoke all active keys and generate a new API key for <%= a.email %>?')">
                    <button type="submit" class="ops-btn-ghost" style="font-size:12px;padding:4px 8px;">Reset API key</button>
                  </form>
                  <% if (a.isActive) { %>
                    <form method="post" action="/scout/accounts/<%= a.id %>/deactivate" class="inline"
                          onsubmit="return confirm('Deactivate <%= a.email %>? They cannot log in or use API keys.')">
                      <button type="submit" class="ops-btn ops-btn-red" style="font-size:12px;padding:4px 8px;">Deactivate</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/scout/accounts/<%= a.id %>/activate" class="inline">
                      <button type="submit" class="ops-btn ops-btn-green" style="font-size:12px;padding:4px 8px;">Activate</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
