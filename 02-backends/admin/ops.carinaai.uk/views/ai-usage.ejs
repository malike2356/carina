<% title = 'AI usage' %>
<div class="ops-page" style="padding:24px 32px;">
  <div class="ops-page-head" style="margin-bottom:24px;">
    <div>
      <div class="ops-page-title">AI usage</div>
      <div class="ops-page-sub" style="margin-top:4px;">Provider cost, BYOK separation, cache savings, and margin health for the last <%= days %> days.</div>
    </div>
    <div class="ops-toolbar-actions" style="gap:8px;">
      <a class="ops-btn<%= days === 7 ? ' primary' : '' %>" href="/ai-usage?days=7">7 days</a>
      <a class="ops-btn<%= days === 30 ? ' primary' : '' %>" href="/ai-usage?days=30">30 days</a>
      <a class="ops-btn<%= days === 90 ? ' primary' : '' %>" href="/ai-usage?days=90">90 days</a>
    </div>
  </div>

  <% if (saved) { %>
    <div class="ops-empty" style="border-color:rgba(34,197,94,0.55);color:#bbf7d0;background:#052e16;padding:12px 16px;margin-bottom:20px;border-radius:8px;">AI usage pricing settings saved.</div>
  <% } %>

  <div class="ops-surface" style="margin-bottom:24px;padding:20px 24px;border-color:rgba(20,184,166,0.45);border-radius:10px;">
    <div class="ops-section-title" style="margin-bottom:8px;">Pricing controls</div>
    <p class="ops-inline-note" style="color:#d7e5ee;max-width:760px;margin-bottom:16px;">
      Configure the commercial add-ons used by the AI usage ledger. These values affect new usage records only; old records keep the rates used when they were written.
    </p>
    <form method="post" action="/ai-usage/pricing" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;align-items:end;">
      <input type="hidden" name="days" value="<%= days %>">
      <label style="display:grid;gap:6px;color:#f8fafc;font-weight:700;font-size:13px;">
        Payment fee buffer (%)
        <input
          class="ops-input"
          name="paymentOverheadPercent"
          type="number"
          min="0"
          max="100"
          step="0.01"
          value="<%= percent(summary.pricingConfig.paymentOverheadRate) %>"
          style="background:#07131f;color:#ffffff;border:1px solid #5eead4;padding:10px 12px;border-radius:6px;"
        >
      </label>
      <label style="display:grid;gap:6px;color:#f8fafc;font-weight:700;font-size:13px;">
        Platform margin (%)
        <input
          class="ops-input"
          name="platformMarginPercent"
          type="number"
          min="0"
          max="100"
          step="0.01"
          value="<%= percent(summary.pricingConfig.platformMarginRate) %>"
          style="background:#07131f;color:#ffffff;border:1px solid #5eead4;padding:10px 12px;border-radius:6px;"
        >
      </label>
      <button class="ops-btn primary" type="submit" style="min-height:42px;border-radius:6px;">Save pricing</button>
    </form>
    <div class="ops-inline-note" style="margin-top:12px;color:#cbd5e1;font-size:12px;">
      Current: <strong style="color:#ffffff;"><%= percent(summary.pricingConfig.paymentOverheadRate) %>%</strong> fee buffer,
      <strong style="color:#ffffff;"><%= percent(summary.pricingConfig.platformMarginRate) %>%</strong> platform margin.
      <% if (summary.pricingConfig.updatedAt) { %>
        Last updated <%= new Date(summary.pricingConfig.updatedAt).toLocaleString('en-GB') %><% if (summary.pricingConfig.updatedBy) { %> by <%= summary.pricingConfig.updatedBy %><% } %>.
      <% } %>
    </div>
  </div>

  <% if (!summary.ready) { %>
    <div class="ops-empty" style="padding:24px;border-radius:8px;">Usage ledger is not ready yet. It will appear after the first routed model call writes <code>ai_usage_ledger</code>.</div>
  <% } else { %>
    <div class="ops-metrics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:24px;">
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">Calls</div><div class="ops-metric-value"><%= summary.totals.calls.toLocaleString() %></div></div>
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">Tokens</div><div class="ops-metric-value"><%= summary.totals.tokens.toLocaleString() %></div></div>
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">Provider cost</div><div class="ops-metric-value warn"><%= money(summary.totals.providerCostMinor) %></div></div>
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">Internal basis</div><div class="ops-metric-value ok"><%= money(summary.totals.internalChargeBasisMinor) %></div></div>
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">Fee buffer</div><div class="ops-metric-value"><%= money(summary.totals.paymentOverheadMinor) %></div></div>
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">Platform margin</div><div class="ops-metric-value"><%= money(summary.totals.platformMarginMinor) %></div></div>
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">BYOK calls</div><div class="ops-metric-value"><%= summary.totals.byokCalls.toLocaleString() %></div></div>
      <div class="ops-metric" style="padding:16px 18px;border-radius:8px;"><div class="ops-metric-label">Saved tokens</div><div class="ops-metric-value ok"><%= (summary.totals.cachedTokens + summary.totals.optimizedTokensSaved).toLocaleString() %></div></div>
    </div>

    <% if (summary.alerts.length) { %>
      <div class="ops-section" style="margin-bottom:20px;">
        <div class="ops-section-title" style="margin-bottom:8px;">Alerts</div>
        <% for (const alert of summary.alerts) { %>
          <div class="ops-empty" style="border-color:rgba(255,34,68,0.35);color:#ff6080;padding:12px 16px;border-radius:8px;margin-bottom:8px;"><%= alert.message %></div>
        <% } %>
      </div>
    <% } %>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-bottom:24px;">
      <div class="ops-surface" style="padding:20px 22px;border-radius:10px;">
        <div class="ops-section-title" style="margin-bottom:12px;">Provider cost</div>
        <table class="ops-table" style="width:100%;">
          <thead><tr><th style="padding:8px 10px;">Provider</th><th style="padding:8px 10px;">Calls</th><th style="padding:8px 10px;">Cost</th></tr></thead>
          <tbody>
            <% for (const row of summary.byProvider) { %>
              <tr>
                <td style="padding:8px 10px;"><%= row.provider %><div class="ops-inline-note" style="margin-top:2px;"><%= row.model %></div></td>
                <td style="padding:8px 10px;"><%= row.calls.toLocaleString() %></td>
                <td style="padding:8px 10px;"><%= money(row.providerCostMinor) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="ops-surface" style="padding:20px 22px;border-radius:10px;">
        <div class="ops-section-title" style="margin-bottom:12px;">Tier mix</div>
        <table class="ops-table" style="width:100%;">
          <thead><tr><th style="padding:8px 10px;">Tier</th><th style="padding:8px 10px;">Calls</th><th style="padding:8px 10px;">Tokens</th></tr></thead>
          <tbody>
            <% for (const row of summary.byTier) { %>
              <tr>
                <td style="padding:8px 10px;"><%= row.tier %></td>
                <td style="padding:8px 10px;"><%= row.calls.toLocaleString() %></td>
                <td style="padding:8px 10px;"><%= row.tokens.toLocaleString() %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="ops-surface" style="padding:20px 22px;border-radius:10px;">
        <div class="ops-section-title" style="margin-bottom:12px;">Top users</div>
        <table class="ops-table" style="width:100%;">
          <thead><tr><th style="padding:8px 10px;">Tenant</th><th style="padding:8px 10px;">Tokens</th><th style="padding:8px 10px;">Basis</th></tr></thead>
          <tbody>
            <% for (const row of summary.byTenant) { %>
              <tr>
                <td style="padding:8px 10px;"><%= row.tenantId.slice(0, 18) %></td>
                <td style="padding:8px 10px;"><%= row.tokens.toLocaleString() %></td>
                <td style="padding:8px 10px;"><%= money(row.internalChargeBasisMinor) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
