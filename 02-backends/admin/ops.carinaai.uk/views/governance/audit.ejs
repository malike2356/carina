<% title = 'Audit Logs' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Audit Logs</div>
    <div class="ops-page-sub">Tamper-evident log of all administrative and platform-level events.</div>
  </div>
  <div style="display:flex;align-items:center;gap:10px;">
    <input type="text" id="audit-search" placeholder="Filter events..." style="background:var(--panel);border:1px solid var(--border);color:var(--text);padding:5px 10px;border-radius:4px;font-family:inherit;font-size:11px;width:180px;" onkeyup="filterAudit()">
    <button onclick="loadAudit()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;">
  <div class="ops-card"><div class="ops-card-label">Events (24h)</div><div class="ops-card-val cyan" id="au-total">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Admin Actions</div><div class="ops-card-val amber" id="au-admin">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Auth Events</div><div class="ops-card-val green" id="au-auth">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Anomalous</div><div class="ops-card-val red" id="au-anomalous">-</div></div>
</div>

<div class="ops-card">
  <div class="ops-section-title">Event Log</div>
  <div id="au-loading" class="ops-loading">Loading audit log...</div>
  <table class="ops-table" id="au-table" style="display:none;">
    <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Resource</th><th>Result</th><th>IP</th></tr></thead>
    <tbody id="au-body"></tbody>
  </table>
  <div id="au-empty" class="ops-empty" style="display:none;">No audit events found.</div>
</div>

<script>
var allEvents = [];

function loadAudit() {
  fetch('/scout-api/api/audit/search?per_page=200', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      allEvents = d.events || d.logs || d || [];
      if (!Array.isArray(allEvents)) allEvents = [];
      var admin = allEvents.filter(function(e){ return (e.category || e.type || '').includes('admin'); }).length;
      var auth = allEvents.filter(function(e){ return (e.category || e.type || '').includes('auth'); }).length;
      var anom = allEvents.filter(function(e){ return e.anomalous || e.flagged; }).length;
      document.getElementById('au-total').textContent = allEvents.length;
      document.getElementById('au-admin').textContent = admin;
      document.getElementById('au-auth').textContent = auth;
      document.getElementById('au-anomalous').textContent = anom;
      document.getElementById('au-loading').style.display = 'none';
      renderAudit(allEvents);
    })
    .catch(function() {
      document.getElementById('au-loading').style.display = 'none';
      document.getElementById('au-empty').style.display = '';
      document.getElementById('au-empty').textContent = 'Audit endpoint unavailable.';
    });
}

function renderAudit(events) {
  if (!events.length) {
    document.getElementById('au-table').style.display = 'none';
    document.getElementById('au-empty').style.display = '';
    return;
  }
  document.getElementById('au-empty').style.display = 'none';
  document.getElementById('au-table').style.display = '';
  document.getElementById('au-body').innerHTML = events.slice(0, 150).map(function(e) {
    var ts = e.created_at || e.timestamp;
    var rclr = e.result === 'success' || e.result === 'ok' ? 'ops-badge-green' : e.result === 'failure' ? 'ops-badge-red' : 'ops-badge-gray';
    return '<tr' + (e.anomalous ? ' style="background:rgba(255,34,68,0.04);"' : '') + '>' +
      '<td style="white-space:nowrap;">' + (ts ? new Date(ts).toLocaleString() : '-') + '</td>' +
      '<td>' + esc(e.actor || e.user || e.admin || '-') + '</td>' +
      '<td>' + esc(e.action || e.event || '-') + '</td>' +
      '<td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + esc(e.resource || e.target || '-') + '</td>' +
      '<td><span class="ops-badge ' + rclr + '">' + esc(e.result || 'ok') + '</span></td>' +
      '<td style="font-family:monospace;font-size:10px;">' + esc(e.ip || e.remote_ip || '-') + '</td></tr>';
  }).join('');
}

function filterAudit() {
  var q = document.getElementById('audit-search').value.toLowerCase();
  if (!q) { renderAudit(allEvents); return; }
  renderAudit(allEvents.filter(function(e) {
    return JSON.stringify(e).toLowerCase().includes(q);
  }));
}

function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadAudit();
</script>
</div>
