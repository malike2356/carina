<% title = skill.name %>
<div class="ops-page">
<div class="mb-4"><a href="/skills" class="text-[#22c55e] text-sm hover:underline">Back to skills</a></div>
<h1 class="text-2xl font-bold text-white mb-6">Edit skill</h1>

<form method="post" action="/skills/<%= skill.id %>" class="ops-surface p-6">
  <%- include('skills/_form', { skill, toolNames, error }) %>
  <div class="flex flex-wrap gap-3 mt-6">
    <button type="submit" class="bg-[#22c55e] text-black px-6 py-2 rounded font-medium">Save</button>
  </div>
</form>

<div class="flex gap-4 mt-4 text-sm">
  <form method="post" action="/skills/<%= skill.id %>/use">
    <button type="submit" class="ops-link">Mark as used (<%= skill.usage_count %>)</button>
  </form>
  <form method="post" action="/skills/<%= skill.id %>/delete" onsubmit="return confirm('Delete this skill?')">
    <button type="submit" class="text-red-400 hover:underline">Delete</button>
  </form>
</div>
</div>
