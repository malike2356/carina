<% title = 'Skills' %>
<div class="ops-page">
<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-white">Skills</h1>
    <p class="text-sm text-gray-500 mt-1"><%= total.toLocaleString() %> skill<%= total === 1 ? '' : 's' %><% if (search) { %> matching filter<% } %></p>
  </div>
  <a href="/skills/new" class="ops-btn ops-btn-green text-sm">New skill</a>
</div>

<form method="get" class="ops-filter-bar">
  <input
    type="search"
    name="q"
    value="<%= search %>"
    placeholder="Search name or description..."
    class="ops-input ops-input--grow"
  >
  <select name="limit" class="ops-select" style="min-width:110px;">
    <% [25, 50, 100].forEach(function (n) { %>
      <option value="<%= n %>" <%= pageSize === n ? 'selected' : '' %>><%= n %> / page</option>
    <% }) %>
  </select>
  <button type="submit" class="ops-btn ops-btn-green">Filter</button>
</form>

<div class="ops-surface ops-table-wrap">
  <table class="ops-table w-full text-sm">
    <thead class="bg-[#1a1a1a] text-gray-400 text-left">
      <tr>
        <th class="p-3">Name</th>
        <th class="p-3">Description</th>
        <th class="p-3">Triggers</th>
        <th class="p-3">Usage</th>
        <th class="p-3">Updated</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% for (const s of skills) { %>
        <tr class="border-t border-[#2a2a2a] hover:bg-[#1a1a1a]">
          <td class="p-3"><a href="/skills/<%= s.id %>" class="text-[#22c55e] font-medium hover:underline"><%= s.name %></a></td>
          <td class="p-3 text-gray-400 max-w-xs truncate"><%= s.description %></td>
          <td class="p-3">
            <div class="flex flex-wrap gap-1">
              <% for (const kw of (s.trigger_keywords || []).slice(0, 4)) { %>
                <span class="text-xs bg-[#2a2a2a] px-2 py-0.5 rounded"><%= kw %></span>
              <% } %>
            </div>
          </td>
          <td class="p-3"><%= s.usage_count %></td>
          <td class="p-3 text-gray-500"><%= new Date(s.updated_at || s.created_at).toLocaleString() %></td>
          <td class="p-3">
            <a href="/skills/<%= s.id %>" class="text-xs text-gray-400 hover:text-white">Edit</a>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (!skills.length) { %>
  <p class="text-gray-500 mt-4">No skills<%= search ? ' match this filter' : ' yet' %>.</p>
<% } %>

<% if (total > 0) { %>
  <nav class="ops-incident-pagination mt-4" aria-label="Skills pages">
    <% if (page > 1) { %>
      <a href="/skills<%= pageLink(page - 1) %>" class="ops-btn ops-btn-ghost ops-btn-sm">Previous</a>
    <% } else { %>
      <span class="ops-btn ops-btn-ghost ops-btn-sm is-disabled" aria-hidden="true">Previous</span>
    <% } %>

    <div class="ops-incident-page-list">
      <% for (const item of pageWindow) { %>
        <% if (item === 'ellipsis') { %>
          <span class="ops-incident-page is-ellipsis" aria-hidden="true">...</span>
        <% } else if (item === page) { %>
          <span class="ops-incident-page is-active" aria-current="page"><%= item %></span>
        <% } else { %>
          <a class="ops-incident-page" href="/skills<%= pageLink(item) %>"><%= item %></a>
        <% } %>
      <% } %>
    </div>

    <% if (page < totalPages) { %>
      <a href="/skills<%= pageLink(page + 1) %>" class="ops-btn ops-btn-ghost ops-btn-sm">Next</a>
    <% } else { %>
      <span class="ops-btn ops-btn-ghost ops-btn-sm is-disabled" aria-hidden="true">Next</span>
    <% } %>

    <span class="ops-incident-pagination-meta">
      Page <%= page %> of <%= totalPages %> · <%= total.toLocaleString() %> skill<%= total === 1 ? '' : 's' %>
      <% if (search) { %> · filtered<% } %>
    </span>
  </nav>
<% } %>
</div>
