<% title = 'Policy Packs' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Policy Packs</div>
    <div class="ops-page-sub">Pre-built security policy bundles available for deployment.</div>
  </div>
  <button onclick="loadPolicyPacks()" class="ops-btn ops-btn-green ops-btn-sm">Refresh</button>
</div>

<div class="ops-surface">
  <div id="pp-loading" class="ops-loading">Loading policy packs...</div>
  <div id="pp-list" class="ops-pack-list" style="display:none;"></div>
  <div id="pp-empty" class="ops-empty" style="display:none;">No policy packs available.</div>
</div>

<script>
function loadPolicyPacks() {
  document.getElementById('pp-loading').style.display = '';
  document.getElementById('pp-list').style.display = 'none';
  document.getElementById('pp-empty').style.display = 'none';

  fetch('/scout-api/api/policy-packs', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var packs = d.packs || d || [];
      if (!Array.isArray(packs)) packs = [];
      document.getElementById('pp-loading').style.display = 'none';
      if (!packs.length) { document.getElementById('pp-empty').style.display = ''; return; }
      var list = document.getElementById('pp-list');
      list.style.display = '';
      list.innerHTML = packs.map(function(p) {
        var active = p.active || p.enabled;
        return '<div class="ops-pack-row' + (active ? ' is-active' : '') + '">' +
          '<div class="ops-pack-body">' +
          '<div class="ops-pack-name">' + esc(p.name || p.id) + '</div>' +
          '<div class="ops-pack-desc">' + esc(p.description || 'No description provided.') + '</div>' +
          '</div>' +
          '<div class="ops-pack-side">' +
          '<span class="ops-badge ' + (active ? 'ops-badge-green' : 'ops-badge-gray') + '">' + (active ? 'Active' : 'Inactive') + '</span>' +
          (active
            ? '<button onclick="togglePack(\'' + esc(p.id) + '\',false)" class="ops-btn ops-btn-amber ops-btn-sm">Deactivate</button>'
            : '<button onclick="togglePack(\'' + esc(p.id) + '\',true)" class="ops-btn ops-btn-green ops-btn-sm">Activate</button>') +
          '</div></div>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('pp-loading').style.display = 'none';
      document.getElementById('pp-empty').style.display = '';
      document.getElementById('pp-empty').textContent = 'Policy packs endpoint unavailable.';
    });
}
function togglePack(id, enable) {
  fetch('/scout-api/api/policy-packs/' + encodeURIComponent(id) + (enable ? '/activate' : '/deactivate'), {
    method: 'POST', credentials: 'same-origin', headers: {'Content-Type':'application/json'}, body: '{}'
  }).then(function() { loadPolicyPacks(); }).catch(function() {});
}
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadPolicyPacks();
</script>
</div>
