<% title = 'Incident Blog' %>
<% const flash = typeof flashQuery !== 'undefined' ? flashQuery : new URLSearchParams(); %>
<% function statusBadge(status) {
  if (status === 'draft') return 'ops-badge-amber';
  if (status === 'approved') return 'ops-badge-cyan';
  if (status === 'published') return 'ops-badge-green';
  return 'ops-badge-gray';
} %>
<% function truncate(value, max) {
  const text = String(value ?? '');
  return text.length > max ? text.slice(0, max - 1) + '…' : text;
} %>
<% function flashMessage() {
  const ok = flash.get('ok');
  if (ok === 'research') {
    const drafted = flash.get('drafted');
    const skipped = flash.get('skipped');
    const candidates = flash.get('candidates');
    const err = flash.get('err');
    if (drafted !== null) {
      const draftedNum = Number(drafted);
      const base = draftedNum > 0
        ? `Research complete. ${draftedNum} new draft(s), ${skipped ?? 0} skipped, ${candidates ?? 0} candidates reviewed.`
        : `Research finished with no new drafts. ${candidates ?? 0} candidates reviewed, ${skipped ?? 0} skipped.`;
      return err ? `${base} ${err}` : base;
    }
    return 'Research run completed.';
  }
  if (ok === 'reject-drafts') return `Rejected ${flash.get('count') ?? 0} draft(s).`;
  if (ok === 'create') return 'Incident created. Review, approve, then publish when ready.';
  if (ok === 'approve') return 'Incident approved.';
  if (ok === 'publish') return 'Incident published and page regenerated.';
  if (ok === 'reject') return 'Incident rejected.';
  if (ok === 'delete') return 'Incident deleted.';
  if (ok === 'newsletter') return 'Newsletter send triggered.';
  if (ok === 'page') return 'Public incidents page regenerated.';
  if (ok) return 'Action completed.';
  return '';
} %>
<div class="ops-page ops-incident-blog">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Incident Blog</div>
      <div class="ops-page-sub">Curate AI incident stories for the Scout public blog. Research creates drafts only; you approve before anything goes live.</div>
    </div>
    <div class="ops-head-actions">
      <a href="/admin/incident-blog/new" class="ops-btn ops-btn-green ops-btn-sm">New incident</a>
      <a href="/admin/incident-blog/subscribers/list" class="ops-btn ops-btn-ghost ops-btn-sm">Subscribers</a>
    </div>
  </div>

  <% const message = flashMessage(); %>
  <% if (message) { %>
    <% const isResearchWarn = flash.get('ok') === 'research' && Number(flash.get('drafted') ?? 0) === 0; %>
    <div class="ops-flash <%= isResearchWarn ? 'warn' : 'success' %>"><%= message %></div>
  <% } %>
  <% if (flash.get('err') && flash.get('ok') !== 'research') { %><div class="ops-flash error"><%= flash.get('err') %></div><% } %>

  <div class="ops-incident-metrics">
    <div class="ops-incident-metric"><span class="ops-incident-metric-label">Drafts</span><span class="ops-incident-metric-value"><%= stats.draftCount %></span></div>
    <div class="ops-incident-metric"><span class="ops-incident-metric-label">Approved</span><span class="ops-incident-metric-value ok"><%= stats.approvedCount %></span></div>
    <div class="ops-incident-metric"><span class="ops-incident-metric-label">Published</span><span class="ops-incident-metric-value ok"><%= stats.publishedCount %></span></div>
    <div class="ops-incident-metric"><span class="ops-incident-metric-label">Rejected</span><span class="ops-incident-metric-value muted"><%= stats.rejectedCount %></span></div>
    <div class="ops-incident-metric"><span class="ops-incident-metric-label">Subscribers</span><span class="ops-incident-metric-value"><%= stats.subscriberCount %></span></div>
  </div>

  <% if (lastResearchRun) { %>
    <div class="ops-incident-research-banner">
      <div>
        <div class="ops-incident-research-title">Last research run</div>
        <div class="ops-incident-research-sub">
          <%= new Date(lastResearchRun.runAt).toLocaleString() %>
          via <%= lastResearchRun.triggeredBy %>
          · <%= lastResearchRun.draftedCount %> drafted · <%= lastResearchRun.skippedCount %> skipped
        </div>
      </div>
    </div>
  <% } %>

  <div class="ops-surface ops-incident-panel">
    <div class="ops-surface-body">
      <div class="ops-incident-toolbar">
        <form class="ops-incident-filters" method="get" action="/admin/incident-blog">
          <label class="ops-field">
            <span class="ops-field-label">Status</span>
            <select name="status" class="ops-select">
              <option value="">All statuses</option>
              <% for (const value of ['draft', 'approved', 'published', 'rejected']) { %>
                <option value="<%= value %>"<%= filters.status === value ? ' selected' : '' %>><%= value %></option>
              <% } %>
            </select>
          </label>
          <label class="ops-field">
            <span class="ops-field-label">Category</span>
            <select name="category" class="ops-select">
              <option value="">All categories</option>
              <% for (const value of ['financial', 'security', 'brand', 'legal']) { %>
                <option value="<%= value %>"<%= filters.category === value ? ' selected' : '' %>><%= value %></option>
              <% } %>
            </select>
          </label>
          <label class="ops-field">
            <span class="ops-field-label">Sort</span>
            <select name="sort" class="ops-select">
              <% for (const option of sortOptions) { %>
                <option value="<%= option.value %>"<%= filters.sort === option.value ? ' selected' : '' %>><%= option.label %></option>
              <% } %>
            </select>
          </label>
          <label class="ops-field">
            <span class="ops-field-label">Per page</span>
            <select name="limit" class="ops-select">
              <% for (const value of pageSizeOptions) { %>
                <option value="<%= value %>"<%= Number(limit) === value ? ' selected' : '' %>><%= value %></option>
              <% } %>
            </select>
          </label>
          <button class="ops-btn ops-btn-ghost ops-btn-sm" type="submit">Apply</button>
        </form>
        <p class="ops-incident-filter-hint">Pick Status or Category to narrow the list. Default sort is newest added first.</p>

        <div class="ops-incident-actions">
          <form method="post" action="/admin/incident-blog/research-run" class="inline">
            <button class="ops-btn ops-btn-green ops-btn-sm" type="submit">Run research</button>
          </form>
          <form method="post" action="/admin/incident-blog/generate-page" class="inline">
            <button class="ops-btn ops-btn-ghost ops-btn-sm" type="submit">Regenerate page</button>
          </form>
          <form method="post" action="/admin/incident-blog/newsletter/send" class="inline">
            <button class="ops-btn ops-btn-ghost ops-btn-sm" type="submit">Send newsletter</button>
          </form>
          <% if (stats.draftCount > 0) { %>
            <form method="post" action="/admin/incident-blog/reject-drafts" class="inline"
              onsubmit="return confirm('Reject all <%= stats.draftCount %> draft(s)?')">
              <button class="ops-btn ops-btn-ghost ops-btn-sm ops-btn-danger" type="submit">Clear drafts</button>
            </form>
          <% } %>
        </div>
      </div>

      <% if (!incidents.length) { %>
        <div class="ops-empty ops-incident-empty">
          <div class="ops-incident-empty-title">No incidents in this view</div>
          <div class="ops-incident-empty-sub">Run research to discover new leads, or create an incident manually.</div>
          <a href="/admin/incident-blog/new" class="ops-btn ops-btn-green ops-btn-sm">Create incident</a>
        </div>
      <% } else { %>
        <%- include('_pagination') %>
        <div class="ops-incident-list">
          <% for (const incident of incidents) { %>
            <article class="ops-incident-card">
              <div class="ops-incident-card-head">
                <div class="ops-incident-card-main">
                  <div class="ops-incident-card-title"><%= truncate(incident.title, 96) %></div>
                  <div class="ops-incident-card-meta">
                    <span><%= truncate(incident.company, 48) %></span>
                    <span class="ops-incident-card-dot">·</span>
                    <span><%= incident.dateOccurred %></span>
                    <span class="ops-incident-card-dot">·</span>
                    <span class="ops-incident-card-category"><%= incident.category %></span>
                  </div>
                </div>
                <span class="ops-badge <%= statusBadge(incident.status) %>"><%= incident.status %></span>
              </div>
              <div class="ops-incident-card-damage"><%= truncate(incident.damage, 120) %></div>
              <div class="ops-incident-card-actions">
                <a class="ops-btn ops-btn-ghost ops-btn-sm" href="/admin/incident-blog/<%= incident.id %>">Review</a>
                <a class="ops-btn ops-btn-ghost ops-btn-sm" href="/admin/incident-blog/<%= incident.id %>/edit">Edit</a>
                <% if (incident.status === 'draft' || incident.status === 'approved') { %>
                  <form method="post" action="/admin/incident-blog/<%= incident.id %>/approve" class="inline">
                    <button class="ops-btn ops-btn-amber ops-btn-sm" type="submit">Approve</button>
                  </form>
                <% } %>
                <% if (incident.status === 'approved' || incident.status === 'draft') { %>
                  <form method="post" action="/admin/incident-blog/<%= incident.id %>/publish" class="inline">
                    <button class="ops-btn ops-btn-green ops-btn-sm" type="submit">Publish</button>
                  </form>
                <% } %>
                <% if (incident.status !== 'rejected' && incident.status !== 'published') { %>
                  <form method="post" action="/admin/incident-blog/<%= incident.id %>/reject" class="inline">
                    <input type="hidden" name="reason" value="Not suitable for publication">
                    <button class="ops-btn ops-btn-ghost ops-btn-sm" type="submit">Reject</button>
                  </form>
                <% } %>
                <form method="post" action="/admin/incident-blog/<%= incident.id %>/delete" class="inline"
                  onsubmit="return confirm('Delete this incident permanently?')">
                  <button class="ops-btn ops-btn-ghost ops-btn-sm ops-btn-danger" type="submit">Delete</button>
                </form>
              </div>
            </article>
          <% } %>
        </div>
        <%- include('_pagination') %>
      <% } %>
    </div>
  </div>
</div>
