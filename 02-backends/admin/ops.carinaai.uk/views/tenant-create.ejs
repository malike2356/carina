<% title = 'Create tenant' %>
<div class="ops-page">
<div class="mb-6">
  <a href="/tenants" class="text-sm text-[#06b6d4] hover:underline">&larr; All tenants</a>
  <h1 class="text-2xl font-bold text-white mt-2">Create new Carina user</h1>
  <p class="text-sm text-gray-400 mt-1">Manual/direct provisioning. No SaaS checkout required.</p>
</div>

<% if (message) { %>
  <div class="mb-4 rounded-lg border px-4 py-3 text-sm <%= messageIsError ? 'border-red-600/50 bg-red-950/30 text-red-200' : 'border-green-600/50 bg-green-950/30 text-green-200' %>">
    <%= message %>
  </div>
<% } %>

<form method="post" action="/tenants" class="w-full space-y-6">
  <section class="ops-surface p-5 space-y-4">
    <h2 class="text-lg font-semibold text-white">Account</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <label class="block text-sm">
        <span class="text-gray-400">Tenant name</span>
        <input type="text" name="displayName" value="<%= form.displayName %>"
               class="mt-1 w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white" required>
      </label>
      <label class="block text-sm">
        <span class="text-gray-400">Primary email</span>
        <input type="email" name="email" value="<%= form.email %>"
               class="mt-1 w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white" required>
      </label>
      <label class="block text-sm md:col-span-2">
        <span class="text-gray-400">Company name (optional)</span>
        <input type="text" name="companyName" value="<%= form.companyName %>"
               class="mt-1 w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white">
      </label>
    </div>
  </section>

  <section class="ops-surface p-5 space-y-4">
    <h2 class="text-lg font-semibold text-white">Plan and access</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <label class="block text-sm">
        <span class="text-gray-400">Plan / entitlement</span>
        <select name="plan" class="mt-1 w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white">
          <% for (const plan of plans) { %>
            <option value="<%= plan.id %>" <%= form.plan === plan.id ? 'selected' : '' %>>
              <%= plan.name %><% if (plan.monthlyPriceGbp !== null) { %> (GBP <%= plan.monthlyPriceGbp %>/mo)<% } %>
            </option>
          <% } %>
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-400">Provisioning type</span>
        <select name="provisioningType" class="mt-1 w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white">
          <option value="manual" selected>Manual/direct</option>
          <option value="trial">Trial</option>
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-400">Initial access status</span>
        <select name="accessStatus" class="mt-1 w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white">
          <option value="active" selected>Active</option>
          <option value="trial">Trial</option>
          <option value="suspended">Suspended</option>
        </select>
      </label>
    </div>
    <p class="text-xs text-gray-500">Manual/direct tenants are labeled separately from SaaS checkout subscribers.</p>
  </section>

  <section class="ops-surface p-5 space-y-4">
    <h2 class="text-lg font-semibold text-white">Login credentials</h2>
    <label class="flex items-center gap-2 text-sm text-gray-300">
      <input type="checkbox" name="generatePassword" checked class="rounded">
      Generate a temporary password (shown once after creation)
    </label>
    <label class="block text-sm">
      <span class="text-gray-400">Or set password manually (8+ characters)</span>
      <input type="password" name="password" autocomplete="new-password"
             class="mt-1 w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white">
    </label>
  </section>

  <section class="ops-surface p-5 space-y-4">
    <h2 class="text-lg font-semibold text-white">Initial skill packs</h2>
    <% if (!availablePacks.length) { %>
      <p class="text-sm text-gray-500">No packs available. Pair Carina in Settings or install packs in core.</p>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        <% for (const pack of availablePacks) { %>
          <label class="flex items-start gap-2 text-sm text-gray-300 border border-[#2a2a2a] rounded p-3 hover:bg-[#222]">
            <input type="checkbox" name="packs" value="<%= pack.name %>" class="mt-0.5">
            <span>
              <span class="text-white font-medium"><%= pack.name %></span>
              <span class="block text-xs text-gray-500"><%= pack.description %></span>
            </span>
          </label>
        <% } %>
      </div>
    <% } %>
    <p class="text-xs text-gray-500">Tenant packs are stored per tenant in the database, not in ACTIVE_SKILL_PACKS.</p>
  </section>

  <section class="ops-surface p-5 space-y-4">
    <h2 class="text-lg font-semibold text-white">Operator notes</h2>
    <textarea name="notes" rows="3"
              class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white text-sm"
              placeholder="Internal notes about this tenant..."><%= form.notes %></textarea>
  </section>

  <div class="flex gap-3">
    <button type="submit"
            class="px-5 py-2.5 rounded bg-[#22c55e] hover:bg-green-400 text-black font-medium text-sm">
      Create tenant
    </button>
    <a href="/tenants" class="px-5 py-2.5 rounded bg-[#2a2a2a] hover:bg-[#333] text-white text-sm">Cancel</a>
  </div>
</form>
</div>
