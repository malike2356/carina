<% title = 'Subscriptions' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Subscriptions</div>
      <div class="ops-page-sub">All tenant subscription state across SaaS and manual provisioning.</div>
    </div>
    <a href="/tenants/new" class="ops-btn ops-btn-green">Create tenant</a>
  </div>

  <% if (!ready) { %>
    <div class="ops-flash warn">
      Hosted schema not initialized. <a href="/tenants" class="ops-link">Go to Tenants</a> to initialize.
    </div>
  <% } else { %>

    <div class="ops-filter-bar" style="border-bottom:none;padding-bottom:0;margin-bottom:16px;">
      <a href="/subscriptions" class="ops-filter-btn<%= !statusFilter && !sourceFilter ? ' active' : '' %>">All</a>
      <a href="/subscriptions?source=manual" class="ops-filter-btn<%= sourceFilter === 'manual' ? ' active' : '' %>">Manual/direct</a>
      <a href="/subscriptions?source=saas" class="ops-filter-btn<%= sourceFilter === 'saas' ? ' active' : '' %>">SaaS</a>
      <a href="/subscriptions?status=active" class="ops-filter-btn<%= statusFilter === 'active' ? ' active' : '' %>">Active</a>
      <a href="/subscriptions?status=suspended" class="ops-filter-btn<%= statusFilter === 'suspended' ? ' active' : '' %>">Suspended</a>
    </div>

    <div class="ops-surface ops-table-wrap">
      <% if (!subscriptions.length) { %>
        <div class="ops-empty">No subscription records yet.</div>
      <% } else { %>
        <table class="ops-table">
          <thead>
            <tr>
              <th>Tenant</th>
              <th>Plan</th>
              <th>Billing state</th>
              <th>Source</th>
              <th>Access</th>
              <th>Renewal</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% for (const s of subscriptions) { %>
              <tr>
                <td>
                  <div style="font-weight:600;color:var(--heading);"><%= tenantDisplayName(s) %></div>
                  <div class="ops-inline-note" style="margin-top:2px;"><%= s.email %></div>
                </td>
                <td style="color:var(--text);"><%= plans[s.plan]?.name || s.plan %></td>
                <td>
                  <span class="ops-badge <%= s.status === 'active' ? 'ops-badge-green' : 'ops-badge-gray' %>"><%= s.status %></span>
                </td>
                <td style="color:var(--muted);font-size:12px;"><%= provisioningLabel(s.provisioningType, s.provisioningSource) %></td>
                <td style="color:var(--muted);font-size:12px;"><%= s.accessStatus %></td>
                <td style="color:var(--muted);font-size:12px;">
                  <% if (s.stripeSubscriptionId) { %>
                    Stripe
                    <% if (s.currentPeriodEnd) { %>
                      <br>ends <%= new Date(s.currentPeriodEnd).toLocaleDateString() %>
                    <% } %>
                  <% } else { %>
                    Manual (no Stripe)
                  <% } %>
                </td>
                <td><a href="/tenants/<%= s.tenantId %>?tab=subscription" class="ops-link">Manage</a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    </div>
  <% } %>
</div>
