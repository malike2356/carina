<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carina Admin · Login</title>
  <link rel="stylesheet" href="/theme/index.css">
</head>
<body class="ops-auth">
  <form method="post" action="/login" class="ops-auth-card">
    <h1>Carina Admin</h1>
    <p class="ops-auth-lead">VERLOX operator access</p>
    <% if (error) { %>
      <p class="ops-auth-error"><%= error %></p>
    <% } %>
    <% if (typeof callbackUrl === 'string' && callbackUrl) { %>
      <input type="hidden" name="callbackUrl" value="<%= callbackUrl %>">
    <% } %>
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autofocus autocomplete="email">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required autocomplete="current-password">
    <button type="submit" class="ops-auth-submit">Sign in</button>
  </form>
</body>
</html>
