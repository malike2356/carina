<%
  const known = Array.isArray(llm.knownProviders) ? llm.knownProviders : [];
  const configured = known.filter(function (p) { return p.configured; });
  const providerOptions = known.slice().sort(function (a, b) {
    return Number(b.configured) - Number(a.configured) || String(a.displayName || a.name).localeCompare(String(b.displayName || b.name));
  });
  const modelsByProvider = llm.modelsByProvider || {};
  const totals = analytics && analytics.summary && analytics.summary.totals ? analytics.summary.totals : {};
  function scopeRow(id) {
    return (productLlms && productLlms[id]) ? productLlms[id] : { provider: '', model: '' };
  }
  function sel(current, value) {
    return String(current || '') === String(value || '') ? 'selected' : '';
  }
  function modelChoices(provider, current) {
    const list = Array.isArray(modelsByProvider[provider]) ? modelsByProvider[provider].slice() : [];
    const cur = String(current || '').trim();
    if (cur && list.indexOf(cur) === -1) list.unshift(cur);
    return list;
  }
  function providerLabel(p) {
    return (p.displayName || p.name) + (p.configured ? '' : ' (no key)');
  }
%>
