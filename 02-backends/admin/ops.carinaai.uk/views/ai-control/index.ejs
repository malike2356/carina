<div class="ops-page ac">
  <div class="ac-head">
    <div>
      <h1>AI Control</h1>
      <p>One place for LLM routing, product model choices, token usage, trial gates, and embeddings. Old scattered links still work and land here.</p>
    </div>
  </div>

  <% if (saved) { %><div class="ac-flash ok">Saved.</div><% } %>
  <% if (errMsg) { %><div class="ac-flash err"><%= errMsg %></div><% } %>

  <nav class="ac-tabs" aria-label="AI Control sections">
    <% tabs.forEach(function (t) { %>
      <a class="ac-tab<%= tab === t.id ? ' is-active' : '' %>" href="/ai-control?tab=<%= t.id %>"><%= t.label %></a>
    <% }) %>
  </nav>

  <% if (tab === 'overview') { %>
    <div class="ac-grid">
      <div class="ac-card ac-kpi">
        <div class="label">Platform default</div>
        <div class="value"><%= llm.defaultProvider || '-' %> / <%= llm.model || '-' %></div>
        <div class="meta"><%= llm.enabled === false ? 'Rotation locked' : 'Rotation on' %></div>
      </div>
      <div class="ac-card ac-kpi">
        <div class="label">30d provider spend</div>
        <div class="value"><%= money(Number(totals.providerCostMinor || 0)) %></div>
        <div class="meta"><%= Number(totals.calls || 0).toLocaleString() %> calls</div>
      </div>
      <div class="ac-card ac-kpi">
        <div class="label">Configured providers</div>
        <div class="value"><%= (llm.configuredProviders || []).length %></div>
        <div class="meta"><%= (llm.chain || []).join(' → ') || 'no chain' %></div>
      </div>
      <div class="ac-card ac-kpi">
        <div class="label">Trial message cap</div>
        <div class="value"><%= gateValues.AIVA_TRIAL_MESSAGE_LIMIT || '20' %></div>
        <div class="meta">Credit £<%= gateValues.AIVA_TRIAL_CREDIT_GBP || '1' %></div>
      </div>
    </div>

    <div class="ac-grid-2">
      <section class="ac-card">
        <h2>Go to a control</h2>
        <p class="sub">Everything AI-related lives under these tabs. Use these shortcuts when you already know the job.</p>
        <div class="ac-links">
          <a class="primary" href="/ai-control?tab=models">Set models by product</a>
          <a href="/ai-control?tab=usage">Usage and cost</a>
          <a href="/ai-control?tab=gates">Trial and free gates</a>
          <a href="/ai-control?tab=embeddings">Embeddings</a>
          <a href="/llm-providers">Advanced rotation UI</a>
          <a href="/ai-platform/analytics">Full analytics charts</a>
          <a href="/ops-assistant/admin">Ops Assistant health</a>
        </div>
      </section>
      <section class="ac-card">
        <h2>What belongs where</h2>
        <p class="sub">Quick map so settings stop feeling duplicated.</p>
        <table class="ac-table">
          <tr><th>Need</th><th>Use</th></tr>
          <tr><td>Default LLM for Carina + Aiva</td><td>Models → Carina core</td></tr>
          <tr><td>Ops Assistant model</td><td>Models → Ops Assistant</td></tr>
          <tr><td>Trial vs paid Aiva model (live)</td><td>Models → Aiva free trial / paid</td></tr>
          <tr><td>Token spend and charts</td><td>Usage and cost</td></tr>
          <tr><td>Free allowance / soft wall</td><td>Trial and free gates</td></tr>
          <tr><td>Embedding provider</td><td>Embeddings</td></tr>
        </table>
      </section>
    </div>
  <% } %>

  <% if (tab === 'models') { %>
    <%
      const eng = (typeof engine === 'object' && engine) ? engine : {};
      const engAiva = eng.aiva || {};
      const engTrial = engAiva.trial || {};
      const engPaid = engAiva.paid || {};
      const engPlatform = eng.platform || {};
      const allowlist = Array.isArray(llm.providers) && llm.providers.length
        ? llm.providers
        : (llm.configuredProviders || []);
      const allowSet = {};
      allowlist.forEach(function (n) { allowSet[String(n).toLowerCase()] = true; });

      const carinaProv = scopeRow('carina_platform').provider || llm.defaultProvider || '';
      const carinaModel = scopeRow('carina_platform').model || llm.model || '';
      const opsProv = scopeRow('ops_assistant').provider || 'deepseek';
      const opsModel = scopeRow('ops_assistant').model || 'deepseek-chat';
      const trialProv = gateValues.AIVA_TRIAL_LLM_PROVIDER || scopeRow('aiva_trial').provider || 'deepseek';
      const trialModel = gateValues.AIVA_TRIAL_LLM_MODEL || scopeRow('aiva_trial').model || 'deepseek-chat';
      const paidProv = gateValues.AIVA_PAID_LLM_PROVIDER || scopeRow('aiva_paid').provider || llm.defaultProvider || '';
      const paidModel = gateValues.AIVA_PAID_LLM_MODEL || scopeRow('aiva_paid').model || llm.model || '';

      function renderProviderSelect(id, name, selected, modelSelectId) {
        const configuredOpts = providerOptions.filter(function (p) { return p.configured; });
        const otherOpts = providerOptions.filter(function (p) { return !p.configured; });
        let html = '<select id="' + id + '" name="' + name + '" class="ac-provider" data-model-select="' + modelSelectId + '">';
        if (configuredOpts.length) {
          html += '<optgroup label="Configured (' + configuredOpts.length + ')">';
          configuredOpts.forEach(function (p) {
            html += '<option value="' + p.name + '"' + sel(selected, p.name) + '>' + (p.displayName || p.name) + '</option>';
          });
          html += '</optgroup>';
        }
        if (otherOpts.length) {
          html += '<optgroup label="Needs API key (' + otherOpts.length + ')">';
          otherOpts.forEach(function (p) {
            html += '<option value="' + p.name + '"' + sel(selected, p.name) + '>' + (p.displayName || p.name) + ' (no key)</option>';
          });
          html += '</optgroup>';
        }
        html += '</select>';
        return html;
      }
      function renderModelSelect(selectId, name, provider, model) {
        const choices = modelChoices(provider, model);
        const title = choices.length ? (choices.length + ' models available') : 'Loading models';
        let html = '<select id="' + selectId + '" name="' + name + '" class="ac-model-select" aria-label="Model" title="' + title + '">';
        if (!choices.length && !model) html += '<option value="">Loading models…</option>';
        choices.forEach(function (m) {
          html += '<option value="' + m + '"' + sel(model, m) + '>' + m + '</option>';
        });
        html += '<option value="__custom__">Custom model id…</option>';
        html += '</select>';
        return html;
      }
    %>
    <form method="post" action="/ai-control/models" id="ac-models-form">
      <section class="ac-card" style="margin-bottom:14px;">
        <h2>Models by product</h2>
        <p class="sub">
          One matrix for every surface. Provider menus list the full catalog; models load live from Core.
          Aiva trial/paid rows save into billing config keys (what Core reads). Edit them here, not under Billing.
          Pick Custom model id… only if the model is missing from the dropdown.
        </p>
        <% if (llm.error) { %><div class="ac-flash err"><%= llm.error %></div><% } %>
        <% if (eng.error) { %><div class="ac-flash err"><%= eng.error %></div><% } %>

        <div class="ac-grid" style="margin-bottom:16px;">
          <div class="ac-card ac-kpi" style="padding:12px;">
            <div class="label">Platform live</div>
            <div class="value" style="font-size:1rem;"><%= engPlatform.provider || llm.defaultProvider || '-' %> / <%= engPlatform.model || llm.model || '-' %></div>
            <div class="meta">Rotation <%= engPlatform.rotationEnabled === false || llm.enabled === false ? 'OFF' : 'ON' %></div>
          </div>
          <div class="ac-card ac-kpi" style="padding:12px;">
            <div class="label">Aiva trial lane</div>
            <div class="value" style="font-size:1rem;"><%= engTrial.provider || trialProv || '-' %> / <%= engTrial.model || trialModel || '-' %></div>
            <div class="meta"><%= engTrial.source === 'billing_config' ? 'Forced live' : 'Configured' %></div>
          </div>
          <div class="ac-card ac-kpi" style="padding:12px;">
            <div class="label">Aiva paid lane</div>
            <div class="value" style="font-size:1rem;"><%= engPaid.provider || paidProv || '-' %> / <%= engPaid.model || paidModel || '-' %></div>
            <div class="meta"><%= engPaid.source === 'billing_config' ? 'Forced live' : 'Configured' %></div>
          </div>
          <div class="ac-card ac-kpi" style="padding:12px;">
            <div class="label">Providers with keys</div>
            <div class="value" style="font-size:1rem;"><%= configured.length %> / <%= known.length %></div>
            <div class="meta"><%= (engPlatform.chain || llm.chain || []).join(' → ') || 'no chain' %></div>
          </div>
        </div>

        <div class="ac-matrix-wrap">
          <table class="ac-matrix">
            <thead>
              <tr>
                <th style="width:24%;">Surface</th>
                <th style="width:22%;">Provider</th>
                <th style="width:34%;">Model</th>
                <th style="width:20%;">Options</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <div class="surface">
                    <div class="title">Carina core</div>
                    <div class="blurb">Platform default. Aiva inherits this when lane overrides are empty.</div>
                    <span class="badge live">Live</span>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderProviderSelect('carina_platform_provider', 'carina_platform_provider', carinaProv, 'carina_platform_model_select') %>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderModelSelect('carina_platform_model_select', 'carina_platform_model', carinaProv, carinaModel) %>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <select id="rotation_enabled" name="rotation_enabled" aria-label="Rotation">
                      <option value="1" <%= llm.enabled !== false ? 'selected' : '' %>>On (failover)</option>
                      <option value="0" <%= llm.enabled === false ? 'selected' : '' %>>Off (locked)</option>
                    </select>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <div class="surface">
                    <div class="title">Aiva platform</div>
                    <div class="blurb">Baseline when no trial/paid override is set. BYOK still wins per workspace.</div>
                    <span class="badge live">Inherits Carina</span>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <input type="text" value="<%= llm.defaultProvider || '' %>" disabled aria-label="Provider">
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <input type="text" value="<%= llm.model || '' %>" disabled aria-label="Model">
                  </div>
                </td>
                <td></td>
              </tr>
              <tr>
                <td>
                  <div class="surface">
                    <div class="title">Ops Assistant</div>
                    <div class="blurb">Ops chat coach (/ops-assistant). Uses Ops env API keys, not Core keys.</div>
                    <span class="badge live">Live</span>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderProviderSelect('ops_assistant_provider', 'ops_assistant_provider', opsProv, 'ops_assistant_model_select') %>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderModelSelect('ops_assistant_model_select', 'ops_assistant_model', opsProv, opsModel) %>
                  </div>
                </td>
                <td></td>
              </tr>
              <tr>
                <td>
                  <div class="surface">
                    <div class="title">Aiva free trial</div>
                    <div class="blurb">Forced for trial / soft-wall traffic.</div>
                    <span class="badge live">Live</span>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderProviderSelect('aiva_trial_provider', 'aiva_trial_provider', trialProv, 'aiva_trial_model_select') %>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderModelSelect('aiva_trial_model_select', 'aiva_trial_model', trialProv, trialModel) %>
                  </div>
                </td>
                <td></td>
              </tr>
              <tr>
                <td>
                  <div class="surface">
                    <div class="title">Aiva paid users</div>
                    <div class="blurb">Forced for subscribed / prepaid traffic.</div>
                    <span class="badge live">Live</span>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderProviderSelect('aiva_paid_provider', 'aiva_paid_provider', paidProv, 'aiva_paid_model_select') %>
                  </div>
                </td>
                <td>
                  <div class="cell-ctrl">
                    <%- renderModelSelect('aiva_paid_model_select', 'aiva_paid_model', paidProv, paidModel) %>
                  </div>
                </td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div style="margin-top:4px;">
          <div class="title" style="font-size:0.88rem;font-weight:650;color:#f8fafc;">Failover allowlist</div>
          <div class="blurb" style="font-size:0.75rem;color:#64748b;margin:4px 0 0;">
            When rotation is On, Core tries checked providers after the active one fails. Providers without keys stay listed but cannot be enabled until configured.
          </div>
          <div class="ac-allow">
            <% known.forEach(function (p) {
                 const checked = allowSet[String(p.name).toLowerCase()] || (!allowlist.length && p.configured);
            %>
              <label class="ac-allow-item<%= p.configured ? '' : ' is-off' %>">
                <input type="checkbox" name="rotation_providers" value="<%= p.name %>"
                  <%= checked ? 'checked' : '' %>
                  <%= p.configured ? '' : 'disabled' %>>
                <span>
                  <strong><%= p.displayName || p.name %></strong>
                  <div class="meta"><%= p.configured ? 'API key present' : 'No API key' %></div>
                </span>
              </label>
            <% }) %>
          </div>
          <input type="hidden" name="rotation_providers_fallback" value="<%= allowlist.join(',') %>">
        </div>

        <div class="ac-actions">
          <button class="ac-btn" type="submit">Save model assignments</button>
          <a class="ac-tab" href="/llm-providers">Advanced rotation page</a>
        </div>
      </section>
    </form>
    <script>
      (function () {
        var CUSTOM = '__custom__';
        var modelsByProvider = <%- JSON.stringify(modelsByProvider || {}) %>;

        function setModelMeta(selectEl, count, source) {
          var label = count ? (count + ' models') : 'No models';
          if (source) label += ' · ' + source;
          selectEl.title = label;
        }

        function ensureOption(selectEl, value) {
          var v = String(value || '').trim();
          if (!v || v === CUSTOM) return;
          for (var i = 0; i < selectEl.options.length; i++) {
            if (selectEl.options[i].value === v) return;
          }
          var opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          // Insert before the Custom option if present
          var customOpt = null;
          for (var j = 0; j < selectEl.options.length; j++) {
            if (selectEl.options[j].value === CUSTOM) { customOpt = selectEl.options[j]; break; }
          }
          if (customOpt) selectEl.insertBefore(opt, customOpt);
          else selectEl.appendChild(opt);
        }

        function fillModels(selectEl, list, preferred, source) {
          var unique = [];
          var seen = {};
          (list || []).forEach(function (m) {
            var v = String(m || '').trim();
            if (!v || seen[v]) return;
            seen[v] = true;
            unique.push(v);
          });
          unique.sort(function (a, b) { return a.localeCompare(b); });
          var preferredValue = String(preferred || '').trim();
          if (preferredValue && preferredValue !== CUSTOM && !seen[preferredValue]) {
            unique.unshift(preferredValue);
            seen[preferredValue] = true;
          }
          selectEl.innerHTML = '';
          if (!unique.length) {
            var empty = document.createElement('option');
            empty.value = '';
            empty.textContent = 'No models loaded yet';
            selectEl.appendChild(empty);
          } else {
            unique.forEach(function (name) {
              var opt = document.createElement('option');
              opt.value = name;
              opt.textContent = name;
              if (name === preferredValue) opt.selected = true;
              selectEl.appendChild(opt);
            });
          }
          var customOpt = document.createElement('option');
          customOpt.value = CUSTOM;
          customOpt.textContent = 'Custom model id…';
          selectEl.appendChild(customOpt);
          if (preferredValue && seen[preferredValue]) selectEl.value = preferredValue;
          else if (unique[0]) selectEl.value = unique[0];
          setModelMeta(selectEl, unique.length, source || '');
        }

        function askCustomModel(selectEl) {
          var current = '';
          for (var i = 0; i < selectEl.options.length; i++) {
            if (selectEl.options[i].value && selectEl.options[i].value !== CUSTOM) {
              current = selectEl.options[i].value;
              break;
            }
          }
          var entered = window.prompt('Enter a custom model id', current);
          if (entered === null) {
            // Cancel: restore previous non-custom value
            if (selectEl.dataset.prevModel) selectEl.value = selectEl.dataset.prevModel;
            else if (selectEl.options[0]) selectEl.selectedIndex = 0;
            return;
          }
          var value = String(entered).trim();
          if (!value) {
            if (selectEl.dataset.prevModel) selectEl.value = selectEl.dataset.prevModel;
            return;
          }
          ensureOption(selectEl, value);
          selectEl.value = value;
          selectEl.dataset.prevModel = value;
        }

        function onModelChange(selectEl) {
          if (selectEl.value === CUSTOM) {
            askCustomModel(selectEl);
            return;
          }
          selectEl.dataset.prevModel = selectEl.value;
        }

        function loadModels(providerEl) {
          var modelSelectId = providerEl.getAttribute('data-model-select');
          var modelSelect = modelSelectId ? document.getElementById(modelSelectId) : null;
          if (!modelSelect) return;
          var provider = providerEl.value;
          var preferred = modelSelect.dataset.prevModel || modelSelect.value || '';
          if (preferred === CUSTOM) preferred = '';
          var cached = (modelsByProvider[provider] || []).slice();
          fillModels(modelSelect, cached, preferred || cached[0] || '', cached.length ? 'cached' : 'loading');
          modelSelect.dataset.prevModel = modelSelect.value;
          if (!provider) return;
          modelSelect.setAttribute('aria-busy', 'true');
          fetch('/llm-providers/models?provider=' + encodeURIComponent(provider), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
          })
            .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
            .then(function (result) {
              if (!result.ok || !result.data || !Array.isArray(result.data.models)) return;
              modelsByProvider[provider] = result.data.models;
              var keep = preferred || result.data.currentModel || '';
              fillModels(modelSelect, result.data.models, keep, result.data.source || 'live');
              modelSelect.dataset.prevModel = modelSelect.value;
            })
            .catch(function () { /* keep curated */ })
            .finally(function () { modelSelect.removeAttribute('aria-busy'); });
        }

        document.querySelectorAll('select.ac-provider').forEach(function (el) {
          el.addEventListener('change', function () { loadModels(el); });
          loadModels(el);
        });
        document.querySelectorAll('select.ac-model-select').forEach(function (el) {
          el.dataset.prevModel = el.value;
          el.addEventListener('change', function () { onModelChange(el); });
          el.addEventListener('focus', function () {
            if (el.value && el.value !== CUSTOM) el.dataset.prevModel = el.value;
          });
        });
      })();
    </script>
  <% } %>

  <% if (tab === 'usage') { %>
    <div class="ac-grid">
      <div class="ac-card ac-kpi"><div class="label">Calls (30d)</div><div class="value"><%= Number(totals.calls || 0).toLocaleString() %></div></div>
      <div class="ac-card ac-kpi"><div class="label">Tokens</div><div class="value"><%= Number(totals.tokens || 0).toLocaleString() %></div></div>
      <div class="ac-card ac-kpi"><div class="label">Provider spend</div><div class="value"><%= money(Number(totals.providerCostMinor || 0)) %></div></div>
      <div class="ac-card ac-kpi"><div class="label">Platform margin</div><div class="value"><%= money(Number(totals.platformMarginMinor || 0)) %></div></div>
    </div>
    <section class="ac-card">
      <h2>Usage dashboards</h2>
      <p class="sub">All token maths and charts live under these links. This tab is the index so you do not hunt Fleet vs AI Engine.</p>
      <div class="ac-links">
        <a class="primary" href="/ai-platform/analytics">Full analytics charts</a>
        <a href="/ai-usage">Ledger pricing rates (fee / margin %)</a>
        <div style="width:100%;height:0;"></div>
        <a href="/ai-platform/credits">Credits and monthly budget</a>
        <a href="/ai-platform/margins">Margins floor</a>
        <a href="/ai-platform">AI Platform overview</a>
      </div>
    </section>
  <% } %>

