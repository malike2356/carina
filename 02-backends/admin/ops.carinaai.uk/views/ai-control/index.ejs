        <tr><th>Gate</th><th>Value</th></tr>
        <tr><td>Aiva trial messages</td><td><%= gateValues.AIVA_TRIAL_MESSAGE_LIMIT || '20' %></td></tr>
        <tr><td>Aiva trial credit</td><td>£<%= gateValues.AIVA_TRIAL_CREDIT_GBP || '1' %></td></tr>
        <tr><td>Aiva daily cap</td><td>£<%= gateValues.AIVA_TRIAL_DAILY_CAP_GBP || '2' %></td></tr>
        <tr><td>Soft wall BYOK / top-up / upgrade / mini LLM</td><td>
          <%= gateValues.AIVA_SOFT_WALL_ALLOW_BYOK || 'on' %> /
          <%= gateValues.AIVA_SOFT_WALL_ALLOW_TOPUP || 'on' %> /
          <%= gateValues.AIVA_SOFT_WALL_ALLOW_UPGRADE || 'on' %> /
          <%= gateValues.AIVA_SOFT_WALL_ALLOW_MINI_LLM || 'off' %>
        </td></tr>
        <tr><td>Carina free daily msgs / tokens</td><td>
          <%= gateValues.CARINA_CLOUD_FREE_DAILY_MESSAGES || '100' %> /
          <%= gateValues.CARINA_CLOUD_FREE_DAILY_TOKENS || '50000' %>
        </td></tr>
      </table>
      <div class="ac-links">
        <a class="primary" href="/usage-gates">Edit free usage gates</a>
        <a href="/billing-config">Full billing and launch config</a>
        <a href="/ai-control?tab=models">Trial / paid preferred models</a>
      </div>
    </section>
  <% } %>

  <% if (tab === 'embeddings') { %>
    <section class="ac-card">
      <h2>Embeddings</h2>
      <p class="sub">Vector provider and backfill controls stay on the dedicated embeddings page. Status snapshot below.</p>
      <% if (embeddings.error) { %>
        <div class="ac-flash err"><%= embeddings.error %></div>
      <% } else { %>
        <table class="ac-table" style="margin-bottom:14px;">
          <% Object.keys(embeddings).slice(0, 12).forEach(function (key) {
               const val = embeddings[key];
               if (val && typeof val === 'object') return;
          %>
            <tr><td><%= key %></td><td><%= String(val) %></td></tr>
          <% }) %>
        </table>
      <% } %>
      <div class="ac-links">
        <a class="primary" href="/embeddings">Open embeddings controls</a>
      </div>
    </section>
  <% } %>
</div>
