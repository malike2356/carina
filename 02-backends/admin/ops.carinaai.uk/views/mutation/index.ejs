<% title = 'Mutation Engine' %>
<div class="ops-page">
<%- include('_nav') %>

<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Mutation Engine</div>
    <div class="ops-page-sub">Review generated tools, prompt overrides, gap proposals, and TypeScript extensions.</div>
  </div>
</div>

<% if (error) { %>
  <div class="ops-card" style="border-color:rgba(239,68,68,0.4);margin-bottom:16px;">
    <div style="color:#f87171;font-size:13px;"><%= error %></div>
  </div>
<% } %>

<div style="display:grid;grid-template-columns:1fr 2fr;gap:16px;margin-bottom:20px;">
  <div class="ops-card" style="text-align:center;padding:24px;">
    <div class="ops-card-label">Deployment Divergence Score</div>
    <% if (compounding && compounding.divergenceScore != null) { %>
      <div class="ops-card-val green" style="font-size:42px;margin:12px 0;">
        <%= Math.round(Number(compounding.divergenceScore) * 100) %>%
      </div>
    <% } else { %>
      <div class="ops-card-val" style="font-size:28px;margin:12px 0;color:var(--muted);">unavailable</div>
    <% } %>
    <div style="color:var(--muted);font-size:11px;">How far this deployment has adapted from a fresh install.</div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;">
    <div class="ops-card">
      <div class="ops-card-label">Active Generated Tools</div>
      <div class="ops-card-val green"><%= toolStats ? toolStats.active : 'unavailable' %></div>
    </div>
    <div class="ops-card">
      <div class="ops-card-label">Pending Gap Proposals</div>
      <div class="ops-card-val amber"><%= gapProposals.length %></div>
    </div>
    <div class="ops-card">
      <div class="ops-card-label">Staged Prompt Overrides</div>
      <div class="ops-card-val amber"><%= staged.length %></div>
    </div>
    <div class="ops-card">
      <div class="ops-card-label">Staged TS Extensions</div>
      <div class="ops-card-val amber"><%= extensions.length %></div>
    </div>
  </div>
</div>

<div class="ops-card" style="margin-bottom:16px;">
  <div class="ops-section-title">Pending Queue</div>
  <% var queue = []; %>
  <% pendingTools.forEach(function(t) { queue.push({ type: 'TOOL', item: t }); }); %>
  <% staged.forEach(function(p) { queue.push({ type: 'PROMPT', item: p }); }); %>
  <% extensions.forEach(function(e) { queue.push({ type: 'EXTENSION', item: e }); }); %>

  <% if (!queue.length) { %>
    <div class="ops-empty">No items awaiting approval.</div>
  <% } else { %>
    <div class="ops-table-wrap">
      <table class="ops-table">
        <thead>
          <tr><th>Type</th><th>Name / Description</th><th>Staged At</th><th>Action</th></tr>
        </thead>
        <tbody>
          <% queue.forEach(function(row) { %>
            <tr>
              <td><span class="ops-badge ops-badge-cyan"><%= row.type %></span></td>
              <td>
                <% if (row.type === 'TOOL') { %>
                  <a href="/mutation/tools/<%= row.item.id %>" class="ops-link"><%= row.item.name %></a>
                  <div style="color:var(--muted);font-size:11px;"><%= row.item.description || '' %></div>
                <% } else if (row.type === 'PROMPT') { %>
                  <div>v<%= row.item.version %> prompt override</div>
                  <div style="color:var(--muted);font-size:11px;">
                    <%= row.item.rationale || 'No rationale' %>
                    <% if (row.item.confidence != null) { %> · confidence <%= Math.round(row.item.confidence * 100) %>%<% } %>
                  </div>
                <% } else { %>
                  <div><%= row.item.task || row.item.file_path %></div>
                  <div style="font-size:11px;margin-top:4px;">
                    <span class="ops-badge <%= row.item.compile_passed ? 'ops-badge-green' : 'ops-badge-red' %>">compile</span>
                    <span class="ops-badge <%= row.item.test_passed ? 'ops-badge-green' : 'ops-badge-red' %>">tests</span>
                  </div>
                <% } %>
              </td>
              <td style="font-size:12px;color:var(--muted);">
                <% var stagedAt = row.item.createdAt || row.item.created_at || row.item.proposedAt || row.item.proposed_at; %>
                <%= stagedAt ? new Date(stagedAt).toLocaleString() : '-' %>
              </td>
              <td>
                <% if (row.type === 'TOOL') { %>
                  <a href="/mutation/tools/<%= row.item.id %>" class="ops-link">View</a>
                <% } else if (row.type === 'PROMPT') { %>
                  <form method="post" action="/mutation/prompts/<%= row.item.id %>/activate" style="display:inline;">
                    <button type="submit" class="ops-btn-sm">Activate</button>
                  </form>
                <% } else { %>
                  <a href="/mutation/extensions" class="ops-link">Review</a>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div style="display:flex;gap:12px;flex-wrap:wrap;">
  <form method="post" action="/mutation/prune">
    <input type="hidden" name="dry_run" value="true">
    <button type="submit" class="ops-btn">Run Prune (Dry Run)</button>
  </form>
  <a href="/mutation/tools" class="ops-btn ops-btn-ghost">View All Tools</a>
</div>
</div>
