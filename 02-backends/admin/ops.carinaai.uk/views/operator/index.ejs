<% title = 'Operator Tools' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Operator Tools</div>
      <div class="ops-page-sub">Curator, learning pipeline, capabilities audit, and security posture.</div>
    </div>
  </div>

  <%- include('_nav') %>

  <div class="ops-metrics" style="margin-top:16px;">
    <div class="ops-metric"><div class="ops-metric-label">Active skills</div><div class="ops-metric-value ok"><%= status.curator.active %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Draft skills</div><div class="ops-metric-value warn"><%= status.curator.draft %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Learning (24h)</div><div class="ops-metric-value"><%= status.learning.events_last_24h %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Promotions (7d)</div><div class="ops-metric-value ok"><%= status.learning.promotions_last_7d %></div></div>
  </div>

  <div class="ops-surface" style="margin-top:16px;">
    <div class="ops-section">
      <div class="ops-section-title">Pending draft review</div>
      <p class="ops-section-sub">
        <% if (status.learning.last_curator_run_at) { %>
          Last curator run: <%= new Date(status.learning.last_curator_run_at).toLocaleString() %>.
        <% } else { %>
          Curator has not run yet on this host.
        <% } %>
        <a href="/operator/learning/pending" class="ops-link-green">Open review queue</a>
      </p>
    </div>

    <% if (!drafts.length) { %>
      <div class="ops-empty">No drafts waiting for review.</div>
    <% } else { %>
      <div class="ops-table-wrap">
        <table class="ops-table">
          <thead>
            <tr>
              <th>Skill</th>
              <th>Description</th>
              <th>Updated</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% for (const d of drafts.slice(0, 8)) { %>
              <tr>
                <td><a href="/skills/<%= d.skill_id %>" class="ops-link"><%= d.skill_name %></a></td>
                <td class="ops-cell-truncate"><%= d.description %></td>
                <td><%= new Date(d.updated_at).toLocaleString() %></td>
                <td><a href="/operator/learning/pending" class="ops-link-green">Review</a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="ops-surface" style="margin-top:16px;">
    <div class="ops-section">
      <div class="ops-section-title">Sections</div>
      <p class="ops-section-sub">Use the sections below for operator dashboards. Machine-readable JSON lives under <code class="ops-code-inline">/operator/api/*</code>.</p>
    </div>
    <div class="ops-link-grid" style="margin-top:4px;">
      <a class="ops-link-row" href="/operator/learning/pending"><div class="ops-link-row-title">Pending review</div><div class="ops-link-row-sub">Promote or archive draft skills</div></a>
      <a class="ops-link-row" href="/operator/learning/improvements"><div class="ops-link-row-title">Improvements</div><div class="ops-link-row-sub">Created, refined, and rolled-back events</div></a>
      <a class="ops-link-row" href="/operator/status"><div class="ops-link-row-title">Status</div><div class="ops-link-row-sub">Curator counts, kanban, learning metrics</div></a>
      <a class="ops-link-row" href="/operator/capabilities"><div class="ops-link-row-title">Capabilities audit</div><div class="ops-link-row-sub">Tools, skills, channels inventory</div></a>
      <a class="ops-link-row" href="/operator/security"><div class="ops-link-row-title">Security posture</div><div class="ops-link-row-sub">Scout + Carina trust state</div></a>
    </div>
  </div>
</div>
