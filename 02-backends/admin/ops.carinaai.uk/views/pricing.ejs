<% title = 'Platform Pricing' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Platform Pricing</div>
      <div class="ops-page-sub">Prices are served live to the marketing site. Changes take effect immediately.</div>
    </div>
  </div>

  <% if (saved) { %>
    <div class="ops-flash ok">Price updated. The marketing site will reflect the new value on next page load.</div>
  <% } %>
  <% if (errMsg) { %>
    <div class="ops-flash err"><%= errMsg %></div>
  <% } %>

  <div class="ops-surface ops-table-wrap">
    <table class="ops-table">
      <thead>
        <tr>
          <th>Plan</th>
          <th>ID</th>
          <th>Monthly price (GBP)</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(row) { %>
          <tr>
            <td><strong><%= row.label %></strong></td>
            <td><code class="ops-code"><%= row.id %></code></td>
            <td>
              <% if (row.monthly_gbp !== null && row.monthly_gbp !== undefined) { %>
                <span class="ops-badge ops-badge-green">£<%= row.monthly_gbp %>/mo</span>
              <% } else { %>
                <span class="ops-badge ops-badge-gray">Free / custom</span>
              <% } %>
            </td>
            <td>
              <form method="post" action="<%= withV('/pricing/update') %>" class="ops-inline-form">
                <input type="hidden" name="id" value="<%= row.id %>">
                <input
                  type="number"
                  name="monthly_gbp"
                  min="0"
                  step="1"
                  value="<%= row.monthly_gbp !== null && row.monthly_gbp !== undefined ? row.monthly_gbp : '' %>"
                  placeholder="e.g. 49"
                  class="ops-input ops-input--sm"
                  style="width:90px"
                >
                <button type="submit" class="ops-btn ops-btn-green ops-btn-sm">Save</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="ops-section-note" style="margin-top:1.5rem;">
    <p>The public pricing endpoint is at <code class="ops-code">https://core.carinaai.uk/api/public/pricing</code>. The marketing site fetches this on page load. To verify a change, open that URL after saving.</p>
  </div>
</div>
