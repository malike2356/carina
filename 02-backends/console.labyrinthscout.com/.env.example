# Labyrinth Scout - Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Server
SCOUT_PORT=4444
# Production CORS (comma-separated origins). Leave unset in development.
# SCOUT_CORS_ORIGIN=https://console.labyrinthscout.com,https://carinaai.uk,https://labyrinthscout.com

# Database - can share with Carina's DATABASE_URL or use a dedicated one
# Scout reads SCOUT_DATABASE_URL first; falls back to DATABASE_URL
# Local Carina docker-compose exposes Postgres on port 5433
SCOUT_DATABASE_URL=postgresql://carina:secret@localhost:5433/carina_central

# Optional Carina API fallback when Scout uses a separate Postgres (session memory modal)
# CARINA_API_URL=https://core.carinaai.uk
# CARINA_OPS_TOKEN=   # same value as core CARINA_OPS_TOKEN (or CARINA_WEB_PASSWORD)

# Redis - shared with Carina
REDIS_URL=redis://localhost:6379

# Authentication - Carina agents include this in X-Scout-Key header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCOUT_API_KEY=change_me_generate_a_random_64_char_hex_string
# Default subscriber account for operator API keys (ops /scout dashboard widgets).
# UUID from accounts.id; required for /api/attack-surface, /api/findings, /api/reports.
# SCOUT_OPERATOR_ACCOUNT_ID=
SCOUT_ENGINE_URL=http://127.0.0.1:4444
# Leave blank to reuse SCOUT_API_KEY for console-to-engine calls.
SCOUT_ENGINE_API_KEY=

# Optional browser password for /dashboard login.
# If unset, the dashboard falls back to SCOUT_API_KEY.
SCOUT_DASHBOARD_PASSWORD=

# Session secret for the /account subscriber pages (login, key management)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCOUT_SESSION_SECRET=change_me_generate_a_random_64_char_hex_string

# Encrypt alert channel secrets stored in alert_channels (generate once; keep stable across restarts)
# Falls back to SCOUT_SESSION_SECRET if unset. Configure channels via ops.carinaai.uk Settings when paired.
# SCOUT_CONFIG_ENCRYPTION_KEY=

# Alert channels (optional env fallback - prefer ops panel Settings > Alert channels)
SCOUT_TELEGRAM_BOT_TOKEN=
SCOUT_TELEGRAM_CHAT_ID=
SCOUT_RESEND_API_KEY=
SCOUT_ALERT_FROM_EMAIL=hello@carinaai.uk
SCOUT_ALERT_TO_EMAIL=
SCOUT_SLACK_WEBHOOK_URL=
SCOUT_DISCORD_WEBHOOK_URL=
SCOUT_TWILIO_ACCOUNT_SID=
SCOUT_TWILIO_AUTH_TOKEN=
SCOUT_TWILIO_SMS_FROM=
SCOUT_TWILIO_WHATSAPP_FROM=
SCOUT_ALERT_SMS_TO=
SCOUT_ALERT_WHATSAPP_TO=
SCOUT_DASHBOARD_URL=http://localhost:4444

# Legacy aliases (still supported by adapters)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_FROM=scout@verlox.co.uk
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
ALERT_SMS_TO=
ALERT_WHATSAPP_TO=

# Tool Policy
SCOUT_BLOCKLIST=
SCOUT_RATE_LIMIT_MINUTE=15
SCOUT_RATE_LIMIT_HOUR=200

# Egress Filter
SCOUT_ALLOWED_DOMAINS=
SCOUT_BASE_URL=http://localhost:4444
SCOUT_INSTANCE_ID=carina-local
# Set these to true only when the corresponding control-plane features are actually enabled.
SCOUT_EGRESS_FILTER_ENABLED=false
SCOUT_SANDBOX_ENABLED=false

# Proxy mode (disabled by default)
SCOUT_PROXY_ENABLED=false
SCOUT_PROXY_PORT=8080
SCOUT_PROXY_KEY=change-me-in-production

# Public trust dashboard (carinaai.uk/trust)
TRUST_PUBLIC_ENABLED=true
TRUST_ERC8004_STATUS=registering
TRUST_ERC8126_STATUS=enterprise
TRUST_PLATFORM=agent-trust-on-base
TRUST_CHAIN_ID=84532
TRUST_CHAIN_RPC=https://sepolia.base.org
# TRUST_ERC8004_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# TRUST_ATTESTER_PRIVATE_KEY=   # never commit; Scout wallet for ERC-8004 registration + attestations
# TRUST_ATTESTATION_ENABLED=true
# TRUST_ATTESTATION_INTERVAL_DAYS=7
# TRUST_SUBJECT_AGENT_WALLET=     # optional; defaults to identity wallet_address
# TRUST_VERIFICATION_ENABLED=true
# TRUST_VERIFICATION_INTERVAL_DAYS=7
# TRUST_WAV_ENDPOINTS=https://core.carinaai.uk,https://console.labyrinthscout.com/api/public/trust
# TRUST_ERC8126_VALIDATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# --- VPS deploy overrides (set these in .env on the server) ---
# Database password for the dedicated Scout postgres container
# SCOUT_DB_PASSWORD=

# Build context for scout-engine (absolute path on the VPS)
# SCOUT_ENGINE_CONTEXT=/home/malike/apps/scout-engine
# SCOUT_ENGINE_PORT=4455

# --- Connector live sandbox tests (optional; never commit credentials) ---
# Run: cp connectors.live.example.json connectors.live.json && pnpm test:connectors:live
# SCOUT_CONNECTOR_LIVE_TESTS=true
# SCOUT_CONNECTOR_LIVE_CONFIG=/absolute/path/to/connectors.live.json
