{
  "pack_id": "endpoint-v1",
  "version": "1.0.0",
  "description": "High-signal Linux endpoint detections for Labyrinth Protect",
  "rules": [
    {
      "id": "EP-001",
      "title": "Sensor tamper: agent.health degraded",
      "event_type": "agent.health",
      "severity": "critical",
      "when": { "payload.status": ["degraded", "stopped", "tamper"] }
    },
    {
      "id": "EP-002",
      "title": "Unexpected reverse shell port",
      "event_type": "net.conn",
      "severity": "high",
      "when": { "payload.remote_port_in": [4444, 5555, 6666, 1234] }
    },
    {
      "id": "EP-003",
      "title": "Process: curl pipe shell",
      "event_type": "process.exec",
      "severity": "high",
      "when": { "payload.cmd_contains": ["curl|", "wget|", "/dev/tcp/", "|bash", "|sh"] }
    },
    {
      "id": "EP-004",
      "title": "Process: chmod 777 sensitive",
      "event_type": "process.exec",
      "severity": "medium",
      "when": { "payload.cmd_contains": ["chmod 777 /", "chmod -R 777"] }
    },
    {
      "id": "EP-005",
      "title": "Auth session from impossible country stub",
      "event_type": "auth.session",
      "severity": "medium",
      "when": { "payload.risk_tags": ["impossible_travel"] }
    },
    {
      "id": "EP-006",
      "title": "File integrity critical path change",
      "event_type": "file.integrity",
      "severity": "high",
      "when": { "payload.path_prefix": ["/etc/passwd", "/etc/shadow", "/etc/sudoers"] }
    },
    {
      "id": "EP-007",
      "title": "Egress to raw IP on high port",
      "event_type": "net.conn",
      "severity": "medium",
      "when": { "payload.remote_port_gte": 49152, "payload.remote_is_ip": true }
    },
    {
      "id": "EP-008",
      "title": "Process: base64 decode exec",
      "event_type": "process.exec",
      "severity": "high",
      "when": { "payload.cmd_contains": ["base64 -d", "base64 --decode"] }
    },
    {
      "id": "EP-009",
      "title": "Heartbeat missing status ok",
      "event_type": "asset.heartbeat",
      "severity": "low",
      "when": { "payload.status": ["warn", "error"] }
    },
    {
      "id": "EP-010",
      "title": "Process: nmap aggressive",
      "event_type": "process.exec",
      "severity": "medium",
      "when": { "payload.cmd_contains": ["nmap -A", "nmap -sS"] }
    },
    {
      "id": "EP-011",
      "title": "Net conn to known mining pool port",
      "event_type": "net.conn",
      "severity": "high",
      "when": { "payload.remote_port_in": [3333, 8333, 14444] }
    },
    {
      "id": "EP-012",
      "title": "Auth: privileged elevation tag",
      "event_type": "auth.session",
      "severity": "high",
      "when": { "payload.risk_tags": ["privilege_escalation"] }
    }
  ]
}
