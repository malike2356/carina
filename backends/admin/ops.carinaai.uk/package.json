{
  "name": "carina-platform-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-theme.mjs && tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/sync-theme.mjs && tsc",
    "test": "vitest run",
    "theme:sync": "node scripts/sync-theme.mjs",
    "css": "node scripts/sync-theme.mjs && tailwindcss --input tailwind.css --output public/styles.css --content 'views/**/*.ejs'",
    "css:watch": "tailwindcss --input tailwind.css --output public/styles.css --content 'views/**/*.ejs' --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "node-pty": "^1.1.0",
    "pg": "^8.12.0",
    "uuid": "^11.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
