ADMIN_PASSWORD=changeme
SESSION_SECRET=generate-a-random-string-here
CARINA_DB_URL=postgresql://carina:secret@localhost:5432/carina
CARINA_API_URL=https://core.carinaai.uk
# Direct download URL for the Carina Android APK shown in Ops Settings.
CARINA_ANDROID_APK_URL=
# Bearer token for authenticating API calls from this panel to core.carinaai.uk.
# Must match CARINA_OPS_TOKEN in core.carinaai.uk/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is separate from CARINA_WEB_PASSWORD in core (that is a bcrypt hash for the web UI).
CARINA_OPS_TOKEN=
# Path to core.carinaai.uk .env for one-click Connect in Settings.
# Local dev: leave unset; ops auto-discovers ../../servers/core.carinaai.uk/.env
# Docker or new server: set explicitly if auto-discovery cannot reach the file.
CARINA_CORE_ENV_PATH=
# Root of core.carinaai.uk on this host (PTY /ws/tui spawns carina tui from here).
# CARINA_CORE_ROOT=/home/youruser/apps/core.carinaai.uk
# Ops talks to scout-engine for admin control (kill switch) and console for dashboard data.
# /scout dashboard proxies /scout-api/* to SCOUT_CONSOLE_URL (real events, posture, SSE stream).
SCOUT_ADMIN_API_URL=http://127.0.0.1:4455
SCOUT_CONSOLE_URL=http://scout-console:4444
# Public URL for Scout account setup links shown in Fleet > Scout Accounts.
SCOUT_ACCOUNT_PUBLIC_URL=https://console.labyrinthscout.com
# Must match SCOUT_API_KEY in console.labyrinthscout.com/.env
SCOUT_API_KEY=
# Username written into Scout's .htpasswd when updating the console password via Ops.
# Default is 'admin' (the username the Scout bootstrap creates).
# Change to match the username created during your Scout setup (e.g. 'malike' on the VPS).
SCOUT_HTPASSWD_USER=admin
# Path to Scout's .htpasswd file. Set to the bind-mount source path if running in Docker.
SCOUT_HTPASSWD_FILE=/etc/carina/scout/.htpasswd
# Subscriber account UUID for operator dashboard widgets (attack surface, findings, STIX).
# SCOUT_OPERATOR_ACCOUNT_ID=
PORT=4002
# Bearer token for WebSocket PTY bridge (/ws/tui). Optional if using page-issued tokens.
ADMIN_WS_TOKEN=
# TUI mode spawned by PTY bridge: simple (default for browser terminal), operator, or ink
CARINA_TUI_MODE=simple
# Workspace root for PTY sessions. Defaults to /tmp/carina-workspaces in Docker.
# On bare-metal set to a persistent path, e.g. /home/youruser/carina-workspaces
CARINA_WORKSPACE_ROOT=
# Optional override when ops and core are not sibling directories under apps/
# CARINA_CORE_ROOT=/home/youruser/apps/core.carinaai.uk
# CARINA_BIN=/home/youruser/apps/core.carinaai.uk/dist/bin/carina.js
# Legacy bridge ports are unused in the current single-port deployment path.
CARINA_HOSTED_APP_URL=https://app.carinaai.uk
HOSTED_FREE_DAILY_MESSAGES=100
