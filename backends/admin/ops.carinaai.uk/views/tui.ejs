<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carina TUI - Admin</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.min.css" />
  <style>
    body { margin: 0; background: #0a0a0a; display: flex; flex-direction: column; height: 100vh; color: #e4e4e7; font-family: system-ui, sans-serif; }
    #toolbar { padding: 8px 16px; background: #111; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #222; }
    #toolbar span { color: #888; font-family: ui-monospace, monospace; font-size: 13px; }
    #terminal { flex: 1; padding: 8px; min-height: 0; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #333; }
    .status-dot.connected { background: #22c55e; }
    .status-dot.disconnected { background: #ef4444; }
    .toolbar-btn { background: #222; color: #888; border: 1px solid #333; padding: 4px 12px; border-radius: 4px; cursor: pointer; font-size: 13px; }
    .toolbar-btn:hover { color: #e4e4e7; border-color: #444; }
    .toolbar-link { color: #22c55e; text-decoration: none; font-size: 13px; }
    .toolbar-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div id="toolbar">
    <div class="status-dot" id="status-dot"></div>
    <span id="status-text">Connecting...</span>
    <span style="flex:1"></span>
    <a href="/" class="toolbar-link">Back to admin</a>
    <button type="button" class="toolbar-btn" id="reconnect-btn">Reconnect</button>
  </div>
  <div id="terminal"></div>

  <script src="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-web-links@0.11.0/lib/addon-web-links.min.js"></script>
  <script>
    const wsToken = <%- JSON.stringify(wsToken) %>;

    const term = new Terminal({
      theme: {
        background: '#0a0a0a',
        foreground: '#e4e4e7',
        cursor: '#22c55e',
      },
      fontFamily: '"JetBrains Mono", "Fira Code", ui-monospace, monospace',
      fontSize: 14,
      allowProposedApi: true,
      cursorBlink: true,
    });

    const fitAddon = new FitAddon.FitAddon();
    const linksAddon = new WebLinksAddon.WebLinksAddon();
    term.loadAddon(fitAddon);
    term.loadAddon(linksAddon);
    term.open(document.getElementById('terminal'));
    fitAddon.fit();

    let ws;
    let inputDisposable = null;

    function setStatus(state, text) {
      document.getElementById('status-dot').className = 'status-dot ' + state;
      document.getElementById('status-text').textContent = text;
    }

    function sendResize() {
      fitAddon.fit();
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'resize', cols: term.cols, rows: term.rows }));
      }
    }

    function connect() {
      if (inputDisposable) {
        inputDisposable.dispose();
        inputDisposable = null;
      }
      if (ws) {
        ws.close();
        ws = null;
      }

      setStatus('', 'Connecting...');
      const secure = window.isSecureContext || location.protocol === 'https:';
      const proto = secure ? 'wss:' : 'ws:';
      ws = new WebSocket(`${proto}//${location.host}/ws/tui?token=${encodeURIComponent(wsToken)}`);

      ws.onopen = () => {
        setStatus('connected', 'Connected');
        sendResize();
        inputDisposable = term.onData((data) => {
          if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ type: 'input', data }));
          }
        });
      };

      ws.onmessage = (e) => {
        const msg = JSON.parse(e.data);
        if (msg.type === 'output') term.write(msg.data);
        if (msg.type === 'connected') sendResize();
        if (msg.type === 'exit') {
          setStatus('disconnected', `Exited (${msg.exitCode})`);
        }
      };

      ws.onclose = () => {
        setStatus('disconnected', 'Disconnected');
      };

      ws.onerror = () => {
        setStatus('disconnected', 'Connection error');
      };
    }

    function reconnect() {
      term.clear();
      connect();
    }

    window.addEventListener('resize', sendResize);
    document.getElementById('reconnect-btn').addEventListener('click', reconnect);
    connect();
  </script>
</body>
</html>
