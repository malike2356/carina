<% title = 'Kill Switch' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Kill Switch</div>
      <div class="ops-page-sub">Platform-wide halt control. Stops all connected agent instances immediately when triggered.</div>
    </div>
    <div class="ops-head-actions">
      <span id="ks-status-badge" class="ops-badge ops-badge-gray">Checking</span>
    </div>
  </div>

  <div class="ops-surface ks-panel">
    <div class="ks-panel-row">
      <div>
        <div class="ks-state-title" id="ks-hero-title">Checking status...</div>
        <p class="ops-inline-note" id="ks-hero-sub" style="margin-top:6px;max-width:52rem;">
          When triggered, all connected agent instances stop immediately. Actions are logged and auditable.
        </p>
      </div>
      <div class="ops-head-actions">
        <button type="button" onclick="armKs()" class="ops-btn ops-btn-red" id="btn-arm">
          Trigger halt
        </button>
        <button type="button" onclick="disarmKs()" class="ops-btn ops-btn-green" id="btn-disarm">
          Disarm
        </button>
      </div>
    </div>
    <div id="ks-msg" class="ks-msg" hidden></div>
  </div>

  <div class="ops-metrics">
    <div class="ops-metric">
      <div class="ops-metric-label">Registered instances</div>
      <div class="ops-metric-value" id="ks-instance-count">-</div>
      <div class="ops-inline-note" id="ks-instance-status">Checking...</div>
    </div>
    <div class="ops-metric">
      <div class="ops-metric-label">Active now</div>
      <div class="ops-metric-value ok" id="ks-active-count">-</div>
      <div class="ops-inline-note">Agents currently running</div>
    </div>
    <div class="ops-metric">
      <div class="ops-metric-label">Last check</div>
      <div class="ops-metric-value muted" id="ks-last-check" style="font-size:15px;">-</div>
      <div class="ops-inline-note">Auto-refresh every 30s</div>
    </div>
  </div>

  <div class="ops-surface ops-table-wrap">
    <div class="ops-section">
      <div class="ops-section-title">Instance status</div>
      <div class="ops-section-sub">Per-instance kill and resume controls.</div>
      <table class="ops-table" id="ks-instance-table">
        <thead>
          <tr>
            <th>Instance</th>
            <th>Status</th>
            <th>Heartbeat</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="ks-instance-body">
          <tr><td colspan="4" class="ops-empty">Loading instances...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

<script>
var ksTriggered = false;

function setKsVisualState(mode, label) {
  var badge = document.getElementById('ks-status-badge');
  var heroTitle = document.getElementById('ks-hero-title');
  var heroSub = document.getElementById('ks-hero-sub');
  var badgeClass = 'ops-badge ops-badge-gray';
  if (mode === 'triggered') badgeClass = 'ops-badge ops-badge-red';
  else if (mode === 'armed') badgeClass = 'ops-badge ops-badge-amber';
  else if (mode === 'disarmed') badgeClass = 'ops-badge ops-badge-green';
  badge.className = badgeClass;
  badge.textContent = label;

  if (mode === 'triggered') {
    heroTitle.textContent = 'Platform halt is active';
    heroSub.textContent = 'All connected instances should be stopped. Disarm via SSH when the incident is resolved.';
  } else if (mode === 'armed') {
    heroTitle.textContent = 'Kill switch is armed';
    heroSub.textContent = 'The platform is ready. Triggering will stop every connected agent instance immediately.';
  } else if (mode === 'disarmed') {
    heroTitle.textContent = 'Kill switch is disarmed';
    heroSub.textContent = 'Agents are running normally. Arm the switch before triggering a platform-wide halt.';
  } else {
    heroTitle.textContent = 'Kill switch offline';
    heroSub.textContent = 'Could not reach Scout. Check console connectivity before relying on halt controls.';
  }
}

function loadKs() {
  fetch('/scout-api/api/killswitch/status', { credentials: 'same-origin' })
    .then(function(r) { if (!r.ok) throw new Error('status ' + r.status); return r.json(); })
    .then(function(d) {
      ksTriggered = d.triggered === true;
      if (ksTriggered) {
        setKsVisualState('triggered', 'TRIGGERED');
      } else if (d.armed === true) {
        setKsVisualState('armed', 'ARMED');
      } else {
        setKsVisualState('disarmed', 'DISARMED');
      }
      document.getElementById('btn-arm').disabled = ksTriggered;
      document.getElementById('btn-disarm').disabled = !ksTriggered;
    })
    .catch(function() {
      setKsVisualState('offline', 'OFFLINE');
      document.getElementById('btn-arm').disabled = true;
      document.getElementById('btn-disarm').disabled = true;
    });

  loadInstances();
}

function loadInstances() {
  fetch('/scout-api/api/admin/status', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var instances = d.instances || [];
      var activeCount = instances.filter(function(i) { return i.status === 'active'; }).length;
      document.getElementById('ks-instance-count').textContent = String(instances.length);
      document.getElementById('ks-active-count').textContent = String(activeCount);
      document.getElementById('ks-instance-status').textContent = activeCount + ' active / ' + instances.length + ' total';
      document.getElementById('ks-last-check').textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

      var tbody = document.getElementById('ks-instance-body');
      if (!instances.length) {
        tbody.innerHTML = '<tr><td colspan="4" class="ops-empty">No instances registered</td></tr>';
        return;
      }
      tbody.innerHTML = instances.map(function(inst) {
        var color = inst.status === 'active' ? 'ops-badge-green' : inst.status === 'suspended' ? 'ops-badge-red' : 'ops-badge-gray';
        var ago = inst.last_heartbeat ? Math.round((Date.now() - new Date(inst.last_heartbeat).getTime()) / 1000) + 's ago' : 'never';
        return '<tr><td><strong>' + esc(inst.name || inst.id) + '</strong></td>' +
          '<td><span class="ops-badge ' + color + '">' + esc(inst.status) + '</span></td>' +
          '<td style="color:var(--muted);font-size:12px;">' + ago + '</td>' +
          '<td><div class="ops-row-actions">' +
          '<button type="button" onclick="killInstance(\'' + esc(inst.id) + '\')" class="ops-btn ops-btn-ghost ops-btn-sm ops-btn-danger">Kill</button>' +
          (inst.status === 'suspended' ? '<button type="button" onclick="resumeInstance(\'' + esc(inst.id) + '\')" class="ops-btn ops-btn-ghost ops-btn-sm">Resume</button>' : '') +
          '</div></td></tr>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('ks-instance-count').textContent = '-';
      document.getElementById('ks-active-count').textContent = '-';
      document.getElementById('ks-instance-body').innerHTML = '<tr><td colspan="4" class="ops-empty">Scout offline</td></tr>';
    });
}

function setKsMsg(text, kind) {
  var el = document.getElementById('ks-msg');
  if (!text) {
    el.hidden = true;
    el.textContent = '';
    el.className = 'ks-msg';
    return;
  }
  el.hidden = false;
  el.textContent = text;
  el.className = 'ks-msg ops-flash ' + (kind === 'ok' ? 'success' : kind === 'error' ? 'error' : 'warn');
}

function armKs() {
  var reason = prompt('Reason for platform halt (required):');
  if (!reason || !reason.trim()) return;
  if (!confirm('Trigger the kill switch? This halts all active agent instances.')) return;
  setKsMsg('Triggering halt...', '');
  fetch('/scout-api/api/killswitch/trigger', {
    method: 'POST',
    credentials: 'same-origin',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ password: 'ops-panel', reason: reason.trim() })
  })
    .then(function(r) { return r.json().then(function(d) { if (!r.ok) throw new Error(d.error || 'trigger failed'); return d; }); })
    .then(function(d) {
      setKsMsg('Triggered. Stopped ' + (d.agents_stopped || 0) + ' agent(s).', 'ok');
      loadKs();
    })
    .catch(function(err) { setKsMsg(err.message || 'Error - check Scout connection', 'error'); });
}

function disarmKs() {
  setKsMsg('Disarm requires SSH on the server: carina scout disarm', 'warn');
  fetch('/scout-api/api/killswitch/disarm', { method: 'POST', credentials: 'same-origin', headers: {'Content-Type':'application/json'}, body: '{}' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      setKsMsg(d.error || 'Disarm requires server SSH access.', 'error');
    })
    .catch(function() { setKsMsg('Disarm requires SSH on the server.', 'error'); });
}

function killInstance(id) {
  if (!confirm('Kill instance ' + id + '?')) return;
  fetch('/security/kill/' + encodeURIComponent(id), { method: 'POST', credentials: 'same-origin', headers: {'Content-Type':'application/json'}, body: '{"reason":"ops panel"}' })
    .then(function() { loadInstances(); })
    .catch(function() {});
}

function resumeInstance(id) {
  fetch('/security/resume/' + encodeURIComponent(id), { method: 'POST', credentials: 'same-origin', headers: {'Content-Type':'application/json'}, body: '{}' })
    .then(function() { loadInstances(); })
    .catch(function() {});
}

function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

loadKs();
setInterval(loadInstances, 30000);
</script>
</div>
