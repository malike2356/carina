<% title = 'Agent Tools' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Agent Tools</div>
      <div class="ops-page-sub">Global tool category configuration for all hosted workspaces.</div>
    </div>
    <form method="get" action="/admin/agent-tools/tenant/" onsubmit="event.preventDefault(); var value = this.workspaceId.value.trim(); if (value) window.location.href = '/admin/agent-tools/tenant/' + encodeURIComponent(value);">
      <div class="ops-actions" style="margin:0;">
        <input name="workspaceId" placeholder="Workspace ID override" class="ops-input mono" style="width:220px;" />
        <button type="submit" class="ops-btn-ghost">Open tenant</button>
      </div>
    </form>
  </div>

  <% if (message) { %>
    <div class="ops-flash <%= messageIsError ? 'error' : 'success' %>"><%= message %></div>
  <% } %>

  <div class="ops-surface ops-tool-list" style="margin-bottom:16px;">
    <% categories.forEach((cat) => { %>
      <article class="ops-tool-item <%= cat.enabled ? '' : 'opacity-70' %>">
        <div class="ops-tool-head">
          <span class="ops-badge <%= cat.enabled ? 'ops-badge-green' : 'ops-badge-gray' %>"><%= cat.enabled ? 'Enabled' : 'Disabled' %></span>
          <% if (cat.requiresApproval) { %><span class="ops-badge ops-badge-amber">Approval</span><% } %>
          <span class="ops-tool-name"><%= cat.label %></span>
          <span class="ops-tool-code"><%= cat.category %></span>
        </div>
        <% if (cat.description) { %><p class="ops-section-sub" style="margin-bottom:10px;"><%= cat.description %></p><% } %>
        <form method="post" action="/admin/agent-tools/<%= encodeURIComponent(cat.category) %>">
          <div class="ops-form-grid">
            <div class="ops-field"><label class="ops-label">Status</label><select name="enabled" class="ops-select"><option value="true" <%= cat.enabled ? 'selected' : '' %>>Enabled</option><option value="false" <%= !cat.enabled ? 'selected' : '' %>>Disabled</option></select></div>
            <div class="ops-field"><label class="ops-label">Approval</label><select name="requiresApproval" class="ops-select"><option value="false" <%= !cat.requiresApproval ? 'selected' : '' %>>No</option><option value="true" <%= cat.requiresApproval ? 'selected' : '' %>>Yes</option></select></div>
            <div class="ops-field"><label class="ops-label">Max calls / message</label><input type="number" name="maxCalls" value="<%= cat.maxCalls %>" min="1" max="50" class="ops-input" /></div>
            <div class="ops-field"><label class="ops-label">Timeout (ms)</label><input type="number" name="timeoutMs" value="<%= cat.timeoutMs %>" min="1000" max="120000" step="1000" class="ops-input" /></div>
          </div>
          <div class="ops-actions"><button type="submit" class="ops-btn ops-btn-green">Save</button></div>
        </form>
      </article>
    <% }) %>
  </div>

  <div class="ops-surface">
    <div class="ops-section">
      <div class="ops-section-title">Recent tool calls</div>
      <% if (!log?.length) { %>
        <div class="ops-empty">No tool calls recorded yet.</div>
      <% } else { %>
        <table class="ops-table">
          <thead><tr><th>Time</th><th>Tool</th><th>Workspace</th><th>Status</th></tr></thead>
          <tbody>
            <% log.forEach((call) => { %>
              <tr>
                <td><%= new Date(call.createdAt).toLocaleString() %></td>
                <td><%= call.toolName %></td>
                <td style="font-family:'JetBrains Mono',monospace;font-size:11px;"><%= call.workspaceId?.slice(0, 8) || '-' %>...</td>
                <td><%= call.status || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
