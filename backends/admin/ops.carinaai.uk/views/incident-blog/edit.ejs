<% title = incident ? 'Edit incident' : 'Create incident' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title"><%= title %></div>
      <div class="ops-page-sub"><a href="/admin/incident-blog" class="ops-link">Back to incident blog</a></div>
    </div>
  </div>

  <% if (locals.error) { %>
    <div class="ops-flash error"><%= error %></div>
  <% } %>

  <form method="post" action="<%= action %>" class="ops-surface">
    <div class="ops-surface-body">
      <div class="ops-form-grid">
        <label class="ops-field" style="grid-column:1/-1;">
          <span class="ops-field-label">Title</span>
          <input name="title" value="<%= incident ? incident.title : '' %>" class="ops-input" required>
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Slug</span>
          <input name="slug" value="<%= incident ? incident.slug : '' %>" class="ops-input">
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Category</span>
          <select name="category" class="ops-input">
            <% for (const category of ['financial','security','brand','legal']) { %>
              <option value="<%= category %>" <%= incident && incident.category === category ? 'selected' : '' %>><%= category %></option>
            <% } %>
          </select>
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Status</span>
          <select name="status" class="ops-input">
            <% for (const status of ['draft','approved','published','rejected']) { %>
              <option value="<%= status %>" <%= incident && incident.status === status ? 'selected' : (!incident && status === 'draft' ? 'selected' : '') %>><%= status %></option>
            <% } %>
          </select>
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Company</span>
          <input name="company" value="<%= incident ? incident.company : '' %>" class="ops-input">
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Damage</span>
          <input name="damage" value="<%= incident ? incident.damage : '' %>" class="ops-input">
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Date occurred</span>
          <input name="dateOccurred" value="<%= incident ? incident.date_occurred || incident.dateOccurred : '' %>" class="ops-input">
        </label>
        <label class="ops-field" style="grid-column:1/-1;">
          <span class="ops-field-label">Body HTML</span>
          <textarea name="bodyHtml" class="ops-input" style="min-height:160px;"><%= incident ? incident.body_html || incident.bodyHtml : '' %></textarea>
        </label>
        <label class="ops-field" style="grid-column:1/-1;">
          <span class="ops-field-label">Scout fix HTML</span>
          <textarea name="scoutFixHtml" class="ops-input" style="min-height:120px;"><%= incident ? incident.scout_fix_html || incident.scoutFixHtml : '' %></textarea>
        </label>
        <div class="ops-field" style="grid-column:1/-1;">
          <span class="ops-field-label">Sources</span>
          <div id="source-rows">
            <% const sources = incident && incident.sources && incident.sources.length ? incident.sources : [{ label: '', url: '' }]; %>
            <% for (const source of sources) { %>
              <div class="ops-source-row">
                <input name="source_label" placeholder="Label" value="<%= source.label %>" class="ops-input">
                <input name="source_url" placeholder="URL" value="<%= source.url %>" class="ops-input">
                <button type="button" data-remove-source class="ops-btn ops-btn-ghost ops-btn-sm">Remove</button>
              </div>
            <% } %>
          </div>
          <button type="button" class="ops-btn ops-btn-ghost ops-btn-sm" id="add-source" style="margin-top:8px;">Add source</button>
        </div>
      </div>
      <div class="ops-actions" style="margin-top:18px;">
        <button class="ops-btn ops-btn-green" type="submit">Save</button>
        <a class="ops-btn ops-btn-ghost" href="/admin/incident-blog">Cancel</a>
      </div>
    </div>
  </form>
</div>
<script>
  (function () {
    const rows = document.getElementById('source-rows');
    const add = document.getElementById('add-source');
    if (!rows || !add) return;

    function wireRemove(button) {
      button.addEventListener('click', () => {
        const row = button.closest('.ops-source-row');
        if (row) row.remove();
      });
    }

    rows.querySelectorAll('[data-remove-source]').forEach((button) => wireRemove(button));
    add.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'ops-source-row';
      row.innerHTML = '<input name="source_label" placeholder="Label" class="ops-input"><input name="source_url" placeholder="URL" class="ops-input"><button type="button" data-remove-source class="ops-btn ops-btn-ghost ops-btn-sm">Remove</button>';
      rows.appendChild(row);
      const remove = row.querySelector('[data-remove-source]');
      if (remove) wireRemove(remove);
    });
  })();
</script>
