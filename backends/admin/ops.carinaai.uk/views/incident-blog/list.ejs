<% title = 'Incident Blog' %>
<% const flash = new URLSearchParams(locals.query || ''); %>
<% function statusBadge(status) {
  if (status === 'draft') return 'ops-badge-amber';
  if (status === 'approved') return 'ops-badge-cyan';
  if (status === 'published') return 'ops-badge-green';
  return 'ops-badge-gray';
} %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Incident Blog</div>
      <div class="ops-page-sub">Draft, approve, and publish security incident records for the public blog.</div>
    </div>
    <div class="ops-head-actions">
      <a href="/admin/incident-blog/new" class="ops-btn ops-btn-green ops-btn-sm">Create new</a>
      <a href="/admin/incident-blog/subscribers/list" class="ops-btn ops-btn-ghost ops-btn-sm">Subscribers</a>
    </div>
  </div>

  <% if (flash.get('ok')) { %><div class="ops-flash success">Action completed.</div><% } %>
  <% if (flash.get('err')) { %><div class="ops-flash error"><%= flash.get('err') %></div><% } %>

  <div class="ops-metrics" style="margin-bottom:16px;">
    <div class="ops-metric"><div class="ops-metric-label">Drafts</div><div class="ops-metric-value"><%= stats.draftCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Approved</div><div class="ops-metric-value ok"><%= stats.approvedCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Published</div><div class="ops-metric-value ok"><%= stats.publishedCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Rejected</div><div class="ops-metric-value muted"><%= stats.rejectedCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Subscribers</div><div class="ops-metric-value"><%= stats.subscriberCount %></div></div>
  </div>

  <div class="ops-surface ops-table-wrap">
    <div class="ops-surface-body">
      <form class="ops-filter-bar" method="get" action="/admin/incident-blog">
        <label class="ops-field">
          <span class="ops-field-label">Status</span>
          <input type="text" name="status" value="<%= filters.status %>" placeholder="draft, published..." class="ops-input">
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Category</span>
          <input type="text" name="category" value="<%= filters.category %>" placeholder="financial, security..." class="ops-input">
        </label>
        <button class="ops-btn ops-btn-green ops-btn-sm" type="submit">Filter</button>
      </form>

      <div class="ops-actions" style="margin-bottom:16px;">
        <form method="post" action="/admin/incident-blog/research-run" class="inline">
          <button class="ops-btn ops-btn-amber ops-btn-sm" type="submit">Run research</button>
        </form>
        <form method="post" action="/admin/incident-blog/newsletter/send" class="inline">
          <button class="ops-btn ops-btn-amber ops-btn-sm" type="submit">Send newsletter</button>
        </form>
        <form method="post" action="/admin/incident-blog/generate-page" class="inline">
          <button class="ops-btn ops-btn-green ops-btn-sm" type="submit">Regenerate page</button>
        </form>
      </div>

      <% if (!incidents.length) { %>
        <div class="ops-empty">No incidents yet. <a href="/admin/incident-blog/new" class="ops-link">Create the first record</a>.</div>
      <% } else { %>
        <table class="ops-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Company</th>
              <th>Damage</th>
              <th>Status</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% for (const incident of incidents) { %>
              <tr>
                <td style="font-weight:600;color:var(--heading);"><%= incident.title %></td>
                <td><%= incident.company %></td>
                <td style="color:var(--red);"><%= incident.damage %></td>
                <td><span class="ops-badge <%= statusBadge(incident.status) %>"><%= incident.status %></span></td>
                <td style="color:var(--muted);font-size:12px;"><%= incident.dateOccurred %></td>
                <td>
                  <div class="ops-row-actions">
                    <a class="ops-btn ops-btn-ghost ops-btn-sm" href="/admin/incident-blog/<%= incident.id %>">View</a>
                    <a class="ops-btn ops-btn-ghost ops-btn-sm" href="/admin/incident-blog/<%= incident.id %>/edit">Edit</a>
                    <form method="post" action="/admin/incident-blog/<%= incident.id %>/approve" class="inline">
                      <button class="ops-btn ops-btn-amber ops-btn-sm" type="submit">Approve</button>
                    </form>
                    <form method="post" action="/admin/incident-blog/<%= incident.id %>/publish" class="inline">
                      <button class="ops-btn ops-btn-green ops-btn-sm" type="submit">Publish</button>
                    </form>
                    <form method="post" action="/admin/incident-blog/<%= incident.id %>/reject" class="inline">
                      <input type="hidden" name="reason" value="Duplicate or needs review">
                      <button class="ops-btn ops-btn-ghost ops-btn-sm" type="submit">Reject</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
