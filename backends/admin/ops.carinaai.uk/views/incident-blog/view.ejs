<% title = incident.title %>
<% function statusBadge(status) {
  if (status === 'draft') return 'ops-badge-amber';
  if (status === 'approved') return 'ops-badge-cyan';
  if (status === 'published') return 'ops-badge-green';
  return 'ops-badge-gray';
} %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title"><%= incident.title %></div>
      <div class="ops-page-sub"><a href="/admin/incident-blog" class="ops-link">Back to incident blog</a></div>
    </div>
    <span class="ops-badge <%= statusBadge(incident.status) %>"><%= incident.status %></span>
  </div>

  <% const flash = new URLSearchParams(locals.query || ''); %>
  <% if (flash.get('ok')) { %><div class="ops-flash success">Action completed.</div><% } %>
  <% if (flash.get('err')) { %><div class="ops-flash error"><%= flash.get('err') %></div><% } %>

  <div class="ops-surface" style="margin-bottom:16px;">
    <div class="ops-surface-body">
      <dl class="ops-kv-grid">
        <div><dt>Category</dt><dd><%= incident.category %></dd></div>
        <div><dt>Company</dt><dd><%= incident.company %></dd></div>
        <div><dt>Damage</dt><dd style="color:var(--red);"><%= incident.damage %></dd></div>
        <div><dt>Date</dt><dd><%= incident.dateOccurred %></dd></div>
        <div><dt>Slug</dt><dd class="mono" style="font-family:'JetBrains Mono',monospace;font-size:12px;"><%= incident.slug %></dd></div>
      </dl>
    </div>
  </div>

  <div class="ops-surface" style="margin-bottom:16px;">
    <div class="ops-surface-body">
      <div class="ops-section-title">Incident body</div>
      <div class="ops-rich-body"><%- incident.body_html || incident.bodyHtml %></div>
      <div class="ops-section-title" style="margin-top:20px;">Scout fix</div>
      <div class="ops-rich-body" style="border-color:color-mix(in srgb, var(--green) 25%, var(--border-subtle));">
        <%- incident.scout_fix_html || incident.scoutFixHtml %>
      </div>
      <% if (incident.rejection_reason) { %>
        <div class="ops-flash warn" style="margin-top:16px;margin-bottom:0;">
          <strong>Rejection reason:</strong> <%= incident.rejection_reason %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="ops-actions">
    <a class="ops-btn ops-btn-ghost ops-btn-sm" href="/admin/incident-blog/<%= incident.id %>/edit">Edit</a>
    <form method="post" action="/admin/incident-blog/<%= incident.id %>/approve" class="inline">
      <button class="ops-btn ops-btn-amber ops-btn-sm" type="submit">Approve</button>
    </form>
    <form method="post" action="/admin/incident-blog/<%= incident.id %>/publish" class="inline">
      <button class="ops-btn ops-btn-green ops-btn-sm" type="submit">Publish</button>
    </form>
    <form method="post" action="/admin/incident-blog/<%= incident.id %>/reject" class="inline">
      <input type="hidden" name="reason" value="Needs revision">
      <button class="ops-btn ops-btn-ghost ops-btn-sm" type="submit">Reject</button>
    </form>
    <form method="post" action="/admin/incident-blog/<%= incident.id %>/delete" class="inline"
      onsubmit="return confirm('Delete this incident permanently?')">
      <button class="ops-btn ops-btn-ghost ops-btn-sm ops-btn-danger" type="submit">Delete</button>
    </form>
  </div>
</div>
