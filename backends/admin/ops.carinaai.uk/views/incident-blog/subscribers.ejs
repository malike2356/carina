<% title = 'Incident Subscribers' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Incident subscribers</div>
      <div class="ops-page-sub"><a href="/admin/incident-blog" class="ops-link">Back to incident blog</a></div>
    </div>
  </div>

  <div class="ops-surface ops-table-wrap">
    <% if (!subscribers.length) { %>
      <div class="ops-empty">No subscribers yet.</div>
    <% } else { %>
      <table class="ops-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Confirmed</th>
            <th>Subscribed</th>
            <th>Unsubscribed</th>
            <th>Last sent</th>
          </tr>
        </thead>
        <tbody>
          <% for (const subscriber of subscribers) { %>
            <tr>
              <td style="font-weight:500;color:var(--heading);"><%= subscriber.email %></td>
              <td>
                <span class="ops-badge <%= subscriber.confirmed ? 'ops-badge-green' : 'ops-badge-gray' %>">
                  <%= subscriber.confirmed ? 'Yes' : 'No' %>
                </span>
              </td>
              <td style="color:var(--muted);font-size:12px;"><%= subscriber.subscribedAt ? new Date(subscriber.subscribedAt).toLocaleString() : '' %></td>
              <td style="color:var(--muted);font-size:12px;"><%= subscriber.unsubscribedAt ? new Date(subscriber.unsubscribedAt).toLocaleString() : '' %></td>
              <td style="color:var(--muted);font-size:12px;"><%= subscriber.lastSentAt ? new Date(subscriber.lastSentAt).toLocaleString() : '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
