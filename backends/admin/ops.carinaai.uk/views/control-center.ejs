<% title = 'Control Center' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Control Center</div>
      <div class="ops-page-sub">Internal admin surfaces and live core control points.</div>
    </div>
    <% if (coreConnected) { %>
      <form method="post" action="/control-center/reload-secrets">
        <button type="submit" class="ops-btn ops-btn-green">Reload secrets</button>
      </form>
    <% } %>
  </div>

  <% if (reloadOk) { %><div class="ops-flash success">Secrets reload requested.</div><% } %>
  <% if (reloadErr) { %><div class="ops-flash error"><%= reloadErr %></div><% } %>

  <% if (!coreConnected) { %>
    <div class="ops-flash warn">Core is not paired. Connect Carina in Settings to unlock live control panels.</div>
  <% } else { %>
    <div class="ops-metrics">
      <div class="ops-metric"><div class="ops-metric-label">Core</div><div class="ops-metric-value ok">Connected</div></div>
      <div class="ops-metric"><div class="ops-metric-label">Skill packs</div><div class="ops-metric-value"><%= packs?.active?.length ?? 0 %> active</div></div>
      <div class="ops-metric"><div class="ops-metric-label">Extensions</div><div class="ops-metric-value"><%= extensions?.extensions?.length ?? 0 %> loaded</div></div>
      <div class="ops-metric"><div class="ops-metric-label">Logs</div><div class="ops-metric-value"><%= logs?.count ?? 0 %> recent</div></div>
    </div>
  <% } %>

  <div class="ops-surface" style="margin-bottom:16px;">
    <div class="ops-section">
      <div class="ops-section-title">Quick links</div>
      <div class="ops-link-grid">
        <a href="/settings" class="ops-link-row"><div class="ops-link-row-title">Settings</div><div class="ops-link-row-sub">Passwords, pairing, alerts</div></a>
        <a href="/ai-platform" class="ops-link-row"><div class="ops-link-row-title">AI Platform</div><div class="ops-link-row-sub">Workbench, agents, vaults</div></a>
        <a href="/tenants" class="ops-link-row"><div class="ops-link-row-title">Tenants</div><div class="ops-link-row-sub">Provisioning and billing</div></a>
        <a href="/security" class="ops-link-row"><div class="ops-link-row-title">Security</div><div class="ops-link-row-sub">Scout events, kill, resume</div></a>
      </div>
    </div>
  </div>

  <div class="ops-split ops-surface" style="margin-bottom:16px;">
    <section class="ops-section">
      <div class="ops-section-title">Core status</div>
      <dl class="ops-kv-grid">
        <div><dt>Env audit</dt><dd><%= env?.audit ? `${env.audit.ok} ok / ${env.audit.warn} warn / ${env.audit.fail} fail` : 'Unavailable' %></dd></div>
        <div><dt>Web password</dt><dd><%= webPassword?.set ? 'Set' : 'Unset' %></dd></div>
        <div><dt>Paired devices</dt><dd><%= hostStatus ? hostStatus.pairedDevices : 'Unavailable' %></dd></div>
        <div><dt>Telemetry</dt><dd><%= telemetryHealth?.healthy ? 'Healthy' : 'Attention needed' %></dd></div>
      </dl>
      <% if (packs?.active?.length) { %>
        <div class="ops-actions" style="margin-top:14px;">
          <% for (const pack of packs.active) { %><span class="ops-badge ops-badge-cyan"><%= pack %></span><% } %>
        </div>
      <% } %>
    </section>
    <section class="ops-section">
      <div class="ops-section-title">Control plane</div>
      <% if (hostStatus) { %>
        <dl class="ops-kv-grid">
          <div><dt>Gateway</dt><dd><%= hostStatus.running ? 'Running' : 'Stopped' %></dd></div>
          <div><dt>Version</dt><dd><%= hostStatus.version %></dd></div>
          <div><dt>Agents</dt><dd><%= hostStatus.agents %></dd></div>
          <div><dt>Scout</dt><dd><%= hostStatus.scoutEnabled ? 'Enabled' : 'Disabled' %></dd></div>
        </dl>
      <% } else { %><p class="ops-empty">Core control status unavailable.</p><% } %>
    </section>
  </div>

  <div class="ops-split ops-surface" style="margin-bottom:16px;">
    <section class="ops-section">
      <div class="ops-section-title">Extensions</div>
      <% if (extensions?.extensions) { %>
        <dl class="ops-kv-grid">
          <div><dt>Runtime</dt><dd><%= extensions.runtimeEnabled ? 'Enabled' : 'Disabled' %></dd></div>
          <div><dt>Loaded</dt><dd><%= extensions.extensions.length %></dd></div>
          <div><dt>Healthy</dt><dd><%= extensions.extensions.filter((ext) => ext.health !== 'fail').length %></dd></div>
        </dl>
      <% } else { %><p class="ops-empty">Extension inventory unavailable.</p><% } %>
    </section>
    <section class="ops-section">
      <div class="ops-section-title">Telemetry checks</div>
      <% if (telemetryHealth?.checks?.length) { %>
        <table class="ops-table">
          <tbody>
            <% for (const check of telemetryHealth.checks.slice(0, 6)) { %>
              <tr>
                <td style="color:var(--heading);"><%= check.id %></td>
                <td style="color:<%= check.status === 'ok' ? 'var(--green)' : check.status === 'warn' ? 'var(--amber)' : 'var(--red)' %>;"><%= check.detail %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } else { %><p class="ops-empty">Telemetry overview unavailable.</p><% } %>
    </section>
  </div>

  <div class="ops-split ops-surface">
    <section class="ops-section">
      <div class="ops-section-title">Recent ops data</div>
      <dl class="ops-kv-grid">
        <div><dt>Sessions</dt><dd><%= sessions?.summary?.total ?? 0 %></dd></div>
        <div><dt>Logs</dt><dd><%= logs?.count ?? 0 %></dd></div>
        <div><dt>Eval reports</dt><dd><%= evalReports?.reports?.length ?? 0 %></dd></div>
        <div><dt>Devices</dt><dd><%= devices?.devices?.length ?? 0 %></dd></div>
      </dl>
    </section>
    <section class="ops-section">
      <div class="ops-section-title">Managed surfaces</div>
      <div class="ops-link-grid">
        <% for (const item of opsSurfaces) { %>
          <a href="<%= item.href %>" class="ops-link-row"><div class="ops-link-row-title"><%= item.label %></div></a>
        <% } %>
      </div>
      <div class="ops-section-divider"></div>
      <div class="ops-section-sub">Workspace surfaces (external)</div>
      <div class="ops-link-grid">
        <% for (const item of workspaceSurfaces) { %>
          <a href="<%= item.href %>" target="_blank" rel="noopener noreferrer" class="ops-link-row"><div class="ops-link-row-title"><%= item.label %></div></a>
        <% } %>
      </div>
    </section>
  </div>
</div>
