<section class="panel">
  <header class="panel-header">
    <h1>Standing Orders</h1>
    <p class="muted">Persistent agent directives injected into every turn.</p>
  </header>

  <% if (!ready) { %>
    <p class="muted">Standing orders table not found. Run core DB migrations first.</p>
  <% } else { %>

  <form method="post" action="<%= withV('/standing-orders/add') %>" class="stack gap-sm" style="margin-bottom: 1.5rem;">
    <label>
      Agent ID
      <input type="text" name="agent_id" value="*" placeholder="* for all agents">
    </label>
    <label>
      Directive
      <textarea name="directive" rows="3" required maxlength="2000" placeholder="Always respond in plain text"></textarea>
    </label>
    <button type="submit" class="btn btn-primary">Add standing order</button>
  </form>

  <table class="data-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Agent</th>
        <th>Directive</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr><td colspan="5" class="muted">No standing orders yet.</td></tr>
      <% } %>
      <% orders.forEach(function(order) { %>
        <tr>
          <td><code><%= order.id.slice(0, 8) %></code></td>
          <td><%= order.agent_id %></td>
          <td><%= order.directive %></td>
          <td><%= order.enabled ? 'enabled' : 'disabled' %></td>
          <td class="actions">
            <form method="post" action="<%= withV('/standing-orders/' + order.id + '/toggle') %>" style="display:inline">
              <button type="submit" class="btn btn-sm">Toggle</button>
            </form>
            <form method="post" action="<%= withV('/standing-orders/' + order.id + '/delete') %>" style="display:inline" onsubmit="return confirm('Delete this order?')">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
