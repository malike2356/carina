<% title = 'Users' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Users</div>
      <div class="ops-page-sub">Manage operator panel access</div>
    </div>
    <div class="ops-head-actions">
      <a href="/users/new" class="ops-btn ops-btn-green">Add user</a>
    </div>
  </div>

  <% if (locals.error) { %>
    <div class="ops-flash error"><%= error %></div>
  <% } %>
  <% const flash = new URLSearchParams(locals.query || ''); %>
  <% if (flash.get('created')) { %><div class="ops-flash success">User created.</div><% } %>
  <% if (flash.get('updated')) { %><div class="ops-flash success">User updated.</div><% } %>
  <% if (flash.get('deleted')) { %><div class="ops-flash success">User deleted.</div><% } %>
  <% if (flash.get('deactivated')) { %><div class="ops-flash warn">User deactivated.</div><% } %>
  <% if (flash.get('activated')) { %><div class="ops-flash success">User re-activated.</div><% } %>
  <% if (flash.get('password_set')) { %><div class="ops-flash success">Password updated.</div><% } %>

  <div class="ops-surface ops-table-wrap">
    <% if (!users.length) { %>
      <div class="ops-empty">
        No operator users yet.
        <a href="/users/new" class="ops-btn ops-btn-green" style="margin-top:12px;display:inline-flex;">Add your first user</a>
      </div>
    <% } else { %>
      <table class="ops-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Last login</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td>
                <div style="font-weight:600;color:var(--heading);"><%= u.name %></div>
              </td>
              <td style="color:var(--text);"><%= u.email %></td>
              <td>
                <span class="ops-badge <%= u.role === 'superadmin' ? 'ops-badge-cyan' : u.role === 'admin' ? 'ops-badge-green' : 'ops-badge-gray' %>"><%= u.role %></span>
              </td>
              <td>
                <span class="ops-badge <%= u.is_active ? 'ops-badge-green' : 'ops-badge-red' %>">
                  <%= u.is_active ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td style="color:var(--muted);font-size:12px;">
                <%= u.last_login_at ? new Date(u.last_login_at).toLocaleString() : 'Never' %>
              </td>
              <td>
                <div class="ops-row-actions">
                  <a href="/users/<%= u.id %>/edit" class="ops-btn ops-btn-ghost ops-btn-sm">Edit</a>
                  <form method="post" action="/users/<%= u.id %>/reset-password" class="inline">
                    <button type="submit" class="ops-btn ops-btn-ghost ops-btn-sm">Reset link</button>
                  </form>
                  <% if (u.is_active) { %>
                    <form method="post" action="/users/<%= u.id %>/deactivate" class="inline"
                      onsubmit="return confirm('Deactivate <%= u.name %>?')">
                      <button type="submit" class="ops-btn ops-btn-ghost ops-btn-sm ops-btn-danger">Deactivate</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/users/<%= u.id %>/activate" class="inline">
                      <button type="submit" class="ops-btn ops-btn-ghost ops-btn-sm">Activate</button>
                    </form>
                  <% } %>
                  <form method="post" action="/users/<%= u.id %>/delete" class="inline"
                    onsubmit="return confirm('Permanently delete <%= u.name %>? This cannot be undone.')">
                    <button type="submit" class="ops-btn ops-btn-ghost ops-btn-sm ops-btn-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
