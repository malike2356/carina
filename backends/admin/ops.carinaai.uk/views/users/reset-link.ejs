<div class="max-w-lg">
  <div class="mb-6">
    <h2 class="text-xl font-semibold text-white">Password Reset Link</h2>
    <a href="/users" class="text-sm text-gray-400 hover:text-gray-200">Back to users</a>
  </div>

  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6">
    <p class="text-sm text-gray-300 mb-4">
      Send this link to <strong class="text-white"><%= user.name %></strong> (<%= user.email %>).
      It expires in <strong class="text-white">24 hours</strong> and can only be used once.
    </p>
    <div class="bg-[#0f0f0f] border border-[#333] rounded p-3 font-mono text-sm text-green-400 break-all select-all mb-4">
      <%= resetUrl %>
    </div>
    <button onclick="navigator.clipboard.writeText('<%= resetUrl %>').then(() => this.textContent = 'Copied!')"
            class="px-4 py-2 bg-[#22c55e] text-black text-sm font-medium rounded hover:opacity-90">
      Copy link
    </button>
    <p class="text-xs text-gray-500 mt-4">Do not share this link publicly. It grants full access to set a new password for this account.</p>
  </div>
</div>
