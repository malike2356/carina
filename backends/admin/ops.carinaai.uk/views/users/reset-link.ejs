<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Password reset link</div>
      <div class="ops-page-sub"><a href="/users" class="ops-inline-link">Back to users</a></div>
    </div>
  </div>

  <div class="ops-surface" style="max-width:640px;border-color:rgba(0,200,100,0.35);">
    <div class="ops-section">
      <div class="ops-section-title">One-time setup link</div>
      <p class="ops-section-sub">
        Send this link to <strong><%= user.name %></strong> (<%= user.email %>).
        It expires in <strong>24 hours</strong> and can only be used once.
      </p>
      <input type="text" readonly value="<%= resetUrl %>" class="ops-input mono" style="margin-bottom:14px;" onclick="this.select()">
      <div class="ops-actions" style="margin-top:0;">
        <button type="button" id="copy-reset-link" class="ops-btn ops-btn-green">Copy link</button>
      </div>
      <p class="ops-inline-note" style="margin-top:14px;">Do not share this link publicly. It grants access to set a new password for this account.</p>
    </div>
  </div>
</div>

<script>
document.getElementById('copy-reset-link').addEventListener('click', function() {
  var url = <%= JSON.stringify(resetUrl) %>;
  navigator.clipboard.writeText(url).then(function() {
    var btn = document.getElementById('copy-reset-link');
    btn.textContent = 'Copied';
    setTimeout(function() { btn.textContent = 'Copy link'; }, 2000);
  });
});
</script>
