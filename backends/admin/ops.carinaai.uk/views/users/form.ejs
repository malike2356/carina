<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title"><%= title %></div>
      <div class="ops-page-sub"><a href="/users" class="ops-link">Back to users</a></div>
    </div>
  </div>

  <% if (error) { %>
    <div class="ops-flash error"><%= error %></div>
  <% } %>

  <form method="post" action="/users/<%= user ? user.id + '/edit' : 'new' %>" class="ops-surface" style="max-width:560px;">
    <div class="ops-section">
      <div class="ops-form-grid">
        <label class="ops-field">
          <span class="ops-field-label">Full name</span>
          <input type="text" id="name" name="name" required value="<%= user ? user.name : '' %>" class="ops-input">
        </label>
        <label class="ops-field">
          <span class="ops-field-label">Email</span>
          <input type="email" id="email" name="email" required value="<%= user ? user.email : '' %>" class="ops-input">
        </label>
        <% if (!user) { %>
          <label class="ops-field" style="grid-column:1/-1;">
            <span class="ops-field-label">Password</span>
            <input type="password" id="password" name="password" required minlength="8" class="ops-input">
            <span class="ops-inline-note">Minimum 8 characters. User can change after first login.</span>
          </label>
        <% } %>
        <label class="ops-field" style="grid-column:1/-1;">
          <span class="ops-field-label">Role</span>
          <select id="role" name="role" class="ops-input">
            <option value="admin" <%= (!user || user.role === 'admin') ? 'selected' : '' %>>Admin - full ops access</option>
            <option value="superadmin" <%= (user && user.role === 'superadmin') ? 'selected' : '' %>>Superadmin - admin + user management</option>
            <option value="viewer" <%= (user && user.role === 'viewer') ? 'selected' : '' %>>Viewer - read only</option>
          </select>
        </label>
      </div>
      <div class="ops-actions" style="margin-top:18px;">
        <button type="submit" class="ops-btn ops-btn-green">
          <%= user ? 'Save changes' : 'Create user' %>
        </button>
        <a href="/users" class="ops-btn ops-btn-ghost">Cancel</a>
      </div>
    </div>
  </form>
</div>
