<% title = 'Skill Packs' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Skill Packs</div>
      <div class="ops-page-sub">Enable or disable Carina skill packs for core. Saved to the persistent operator store.</div>
    </div>
    <a href="<%= carinaApiUrl %>/packs" target="_blank" rel="noopener" class="ops-link">Open core /packs</a>
  </div>

  <% if (error) { %>
    <div class="ops-flash error"><%= error %><% if (!paired) { %> <a href="/settings" class="ops-link">Go to Settings</a><% } %></div>
  <% } %>
  <% if (saved) { %><div class="ops-flash success">Skill pack selection saved. Core picked up the change immediately.</div><% } %>
  <% if (lastChange) { %><p class="ops-inline-note" style="margin-bottom:16px;">Last update: <%= new Date(lastChange.created_at).toLocaleString() %> by <%= lastChange.actor %></p><% } %>

  <% if (paired && available.length) { %>
    <form method="post" action="/packs">
      <div class="ops-surface ops-table-wrap">
        <table class="ops-table">
          <thead><tr><th style="width:56px;">On</th><th>Pack</th><th>Description</th><th>Skills</th></tr></thead>
          <tbody>
            <% for (const pack of available) { %>
              <tr>
                <td><input type="checkbox" name="packs" value="<%= pack.name %>" <%= active.has(pack.name) ? 'checked' : '' %> /></td>
                <td><div style="font-weight:600;color:var(--heading);"><%= pack.name %></div><div class="ops-inline-note"><%= pack.category || 'general' %> · v<%= pack.version %></div></td>
                <td style="color:var(--muted);"><%= pack.description %></td>
                <td style="color:var(--muted);"><%= pack.skillCount ?? 0 %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="ops-actions">
        <button type="submit" class="ops-btn ops-btn-green">Save active packs</button>
        <span class="ops-inline-note">Uncheck all for general-purpose mode (no optional packs).</span>
      </div>
    </form>
  <% } else if (paired && !error && !available.length) { %>
    <div class="ops-empty">No bundled skill packs reported by core.</div>
  <% } %>

  <% if (audit.length) { %>
    <div class="ops-section" style="margin-top:24px;padding:0;">
      <div class="ops-section-title">Recent changes</div>
      <div class="ops-surface" style="margin-top:12px;">
        <% for (const entry of audit) { %>
          <div class="ops-tool-item">
            <div style="font-weight:500;color:var(--heading);"><%= new Date(entry.created_at).toLocaleString() %> · <%= entry.actor %> · <%= entry.source %></div>
            <div class="ops-inline-note" style="margin-top:4px;">
              Before: <%= entry.packs_before.length ? entry.packs_before.join(', ') : '(none)' %>
            </div>
            <div class="ops-inline-note">
              After: <%= entry.packs_after.length ? entry.packs_after.join(', ') : '(none)' %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (paired && evalReports && evalReports.length) { %>
    <div class="ops-section" style="margin-top:24px;padding:0;">
      <div class="ops-section-title">Recent skill eval runs</div>
      <p class="ops-inline-note" style="margin-bottom:12px;">Offline harness only; does not affect chat latency.</p>
      <div class="ops-surface">
        <% for (const report of evalReports) { %>
          <div class="ops-tool-item" style="display:flex;justify-content:space-between;gap:12px;">
            <div>
              <span style="color:var(--heading);font-weight:500;"><%= report.pack %></span>
              · <%= (report.passRate * 100).toFixed(0) %>% pass
              · <span class="ops-inline-note"><%= new Date(report.generatedAt).toLocaleString() %></span>
            </div>
            <code class="ops-inline-note"><%= report.runId.slice(0, 8) %></code>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
