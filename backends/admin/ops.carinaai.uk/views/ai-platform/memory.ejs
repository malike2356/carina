<% title = 'Memory Stores' %>
<div class="ops-page">
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Memory Stores</h1>
<% if (saved) { %><p class="text-sm text-[#22c55e] mb-4">Saved.</p><% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <form method="post" action="/ai-platform/memory" class="ops-stat-cell space-y-3 h-fit">
    <h2 class="text-sm font-semibold text-white">Create store</h2>
    <input name="name" required placeholder="Store name" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <select name="scope" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
      <option value="org">org</option>
      <option value="agent">agent</option>
      <option value="session">session</option>
      <option value="user">user</option>
    </select>
    <textarea name="notes" rows="3" placeholder="Notes" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white"></textarea>
    <button type="submit" class="w-full py-2 bg-[#22c55e] text-black rounded text-sm font-medium">Create</button>
  </form>

  <div class="lg:col-span-2 ops-stat-cell">
    <% if (!stores.length) { %>
      <p class="text-gray-500 text-sm">No memory stores. Carina episodic memories live under <a href="/memories" class="ops-link">Memories</a>; this registry tracks platform-scoped stores.</p>
    <% } else { %>
      <table class="ops-table w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
            <th class="py-2 pr-3">Name</th>
            <th class="py-2 pr-3">Scope</th>
            <th class="py-2 pr-3">Items</th>
            <th class="py-2 pr-3">Status</th>
            <th class="py-2">Edit</th>
          </tr>
        </thead>
        <tbody>
          <% for (const s of stores) { %>
            <tr class="border-b border-[#2a2a2a]/50 align-top">
              <td class="py-2 pr-3 text-white"><%= s.name %></td>
              <td class="py-2 pr-3 text-gray-400"><%= s.scope %></td>
              <td class="py-2 pr-3 text-gray-500"><%= s.itemCount %></td>
              <td class="py-2 pr-3"><%= s.status %></td>
              <td class="py-2">
                <form method="post" action="/ai-platform/memory/<%= s.id %>" class="space-y-1">
                  <input name="name" value="<%= s.name %>" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-2 py-1 text-xs text-white">
                  <select name="scope" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-2 py-1 text-xs text-white">
                    <option value="org" <%= s.scope === 'org' ? 'selected' : '' %>>org</option>
                    <option value="agent" <%= s.scope === 'agent' ? 'selected' : '' %>>agent</option>
                    <option value="session" <%= s.scope === 'session' ? 'selected' : '' %>>session</option>
                    <option value="user" <%= s.scope === 'user' ? 'selected' : '' %>>user</option>
                  </select>
                  <select name="status" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-2 py-1 text-xs text-white">
                    <option value="active" <%= s.status === 'active' ? 'selected' : '' %>>active</option>
                    <option value="archived" <%= s.status === 'archived' ? 'selected' : '' %>>archived</option>
                  </select>
                  <button type="submit" class="text-xs text-[#06b6d4] hover:underline">Save</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
</div>
