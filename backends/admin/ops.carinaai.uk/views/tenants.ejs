<% title = 'Tenants' %>
<div class="ops-page">
  <div class="ops-page-head">
    <div>
      <div class="ops-page-title">Hosted tenants</div>
      <div class="ops-page-sub">Provision Carina users, manage plans, billing, usage, and skill packs.</div>
    </div>
    <div class="ops-actions" style="margin-top:0;">
      <% if (ready) { %>
        <a href="/tenants/new" class="ops-btn ops-btn-green">Create tenant</a>
      <% } %>
      <a href="<%= hostedAppUrl %>" target="_blank" rel="noopener" class="ops-link">Open <%= hostedAppUrl %></a>
    </div>
  </div>

<% if (message) { %>
  <div class="ops-flash <%= messageIsError ? 'error' : 'success' %>"><%= message %></div>
<% } %>

<% if (!ready) { %>
  <div class="ops-flash warn">
    <p style="font-weight:600;margin-bottom:8px;">Hosted mode not initialized</p>
    <p>The <code class="ops-code">hosted_users</code> table was not found in <code class="ops-code">CARINA_DB_URL</code>.</p>
    <p class="ops-inline-note" style="margin-top:8px;">Initialize the schema here to enable direct provisioning from this panel.</p>
    <form method="post" action="/tenants/init-schema" class="ops-actions">
      <button type="submit" class="ops-btn ops-btn-amber">Initialize hosted schema</button>
    </form>
  </div>
<% } else { %>

  <% if (summary) { %>
  <div class="ops-metrics">
    <div class="ops-metric"><div class="ops-metric-label">Total</div><div class="ops-metric-value"><%= summary.total %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Manual/direct</div><div class="ops-metric-value"><%= summary.manualCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">SaaS</div><div class="ops-metric-value"><%= summary.saasCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Suspended</div><div class="ops-metric-value warn"><%= summary.suspendedCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Free tier</div><div class="ops-metric-value"><%= summary.freeCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Pro tier</div><div class="ops-metric-value ok"><%= summary.proCount %></div></div>
    <div class="ops-metric"><div class="ops-metric-label">Tokens (month)</div><div class="ops-metric-value"><%= summary.monthlyTokens.toLocaleString() %></div></div>
  </div>
  <% } %>

  <div class="ops-filter-bar" style="border-bottom:none;padding-bottom:0;margin-bottom:16px;">
    <a href="/tenants" class="ops-filter-btn<%= !tierFilter && !provisioningFilter && !accessFilter ? ' active' : '' %>">All</a>
    <a href="/tenants?provisioning=manual" class="ops-filter-btn<%= provisioningFilter === 'manual' ? ' active' : '' %>">Manual/direct</a>
    <a href="/tenants?provisioning=saas" class="ops-filter-btn<%= provisioningFilter === 'saas' ? ' active' : '' %>">SaaS</a>
    <a href="/tenants?access=suspended" class="ops-filter-btn<%= accessFilter === 'suspended' ? ' active' : '' %>">Suspended</a>
    <a href="/tenants?tier=free" class="ops-filter-btn<%= tierFilter === 'free' ? ' active' : '' %>">Free</a>
    <a href="/tenants?tier=pro" class="ops-filter-btn<%= tierFilter === 'pro' ? ' active' : '' %>">Pro</a>
  </div>

  <div class="ops-surface ops-table-wrap">
    <% if (!tenants.length) { %>
      <div class="ops-empty">No tenants yet. <a href="/tenants/new" class="ops-link">Create your first tenant</a></div>
    <% } else { %>
      <table class="ops-table">
        <thead>
          <tr>
            <th>Name / email</th>
            <th>Status</th>
            <th>Provisioning</th>
            <th>Plan</th>
            <th>Usage</th>
            <th>Packs</th>
            <th>Updated</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const t of tenants) { %>
            <tr>
              <td>
                <div style="font-weight:600;color:var(--heading);"><%= tenantDisplayName(t) %></div>
                <div class="ops-inline-note" style="margin-top:2px;"><%= t.email %></div>
              </td>
              <td>
                <span class="ops-badge <%= t.accessStatus === 'active' ? 'ops-badge-green' : t.accessStatus === 'suspended' ? 'ops-badge-red' : 'ops-badge-amber' %>"><%= t.accessStatus %></span>
                <span class="ops-badge ops-badge-gray" style="margin-left:4px;"><%= t.tier %></span>
              </td>
              <td style="color:var(--muted);font-size:12px;"><%= provisioningLabel(t.provisioningType, t.provisioningSource) %></td>
              <td style="color:var(--text);">
                <%= t.subscriptionPlan || 'free' %>
                <% if (t.subscriptionStatus) { %><span class="ops-inline-note">(<%= t.subscriptionStatus %>)</span><% } %>
              </td>
              <td style="color:var(--text);">
                <div><%= t.messagesToday %> msgs today</div>
                <div class="ops-inline-note"><%= t.monthlyTokens.toLocaleString() %> tokens/mo</div>
              </td>
              <td style="color:var(--text);"><%= t.packCount %></td>
              <td style="color:var(--muted);font-size:12px;"><%= t.updatedAt ? new Date(t.updatedAt).toLocaleDateString() : new Date(t.createdAt).toLocaleDateString() %></td>
              <td><a href="/tenants/<%= t.id %>" class="ops-link">Manage</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>
</div>
