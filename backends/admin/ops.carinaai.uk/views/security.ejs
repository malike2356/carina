<% title = 'Security' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Security Overview</div>
    <div class="ops-page-sub">Live Scout telemetry, instance control, and event stream.</div>
  </div>
  <div class="ops-toolbar-actions">
    <span id="sse-dot" class="status-dot"></span>
    <span id="sse-label" class="ops-inline-note" style="margin-top:0;">Connecting...</span>
  </div>
</div>

<% if (!scoutOnline) { %>
  <div id="offline-banner" class="ops-card" style="margin-bottom:14px;border-color:rgba(212,175,55,0.3);background:rgba(212,175,55,0.06);color:var(--amber);font-size:11px;">
    Labyrinth Scout is not running at <code style="color:var(--heading);"><%= scoutUrl %></code>.
    Start scout-engine on the VPS or check supervisor.
  </div>
<% } else { %>
  <div id="offline-banner" style="display:none;margin-bottom:14px;"></div>
<% } %>

<div class="ops-grid ops-grid-4 ops-grid-surface" style="margin-bottom:14px;">
  <div class="ops-card">
    <div class="ops-card-label">Critical (24h)</div>
    <div class="ops-card-val red" id="stat-critical"><%= scoutOnline ? stats.critical : '-' %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Warning (24h)</div>
    <div class="ops-card-val amber" id="stat-warning"><%= scoutOnline ? stats.warning : '-' %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Info (24h)</div>
    <div class="ops-card-val cyan" id="stat-info"><%= scoutOnline ? stats.info : '-' %></div>
  </div>
  <div class="ops-card">
    <div class="ops-card-label">Breach (24h)</div>
    <div class="ops-card-val red" id="stat-breach"><%= scoutOnline ? stats.breach : '-' %></div>
  </div>
</div>

<div class="ops-grid ops-grid-2-rail" style="gap:14px;">
  <div class="ops-card">
    <div class="ops-toolbar" style="margin-bottom:12px;">
      <div class="ops-section-title" style="margin:0;flex:1;">Live Events</div>
      <% ['all', 'critical', 'warning', 'info', 'breach'].forEach(function(f) { %>
        <button type="button" data-filter="<%= f %>" class="filter-btn ops-filter-btn<%= f === 'all' ? ' active' : '' %>">
          <%= f === 'all' ? 'All' : f.charAt(0).toUpperCase() + f.slice(1) %>
        </button>
      <% }) %>
    </div>
    <div id="event-stream" class="ops-event-stream"></div>
  </div>

  <div class="ops-card">
    <div class="ops-section-title">Agent Instances</div>
    <div id="instances-panel">
      <% if (!instances.length) { %>
        <div class="ops-empty">No instances registered.</div>
      <% } %>
      <% for (const inst of instances) { %>
        <div class="instance-row ops-card" style="margin-bottom:8px;padding:10px 12px;" data-id="<%= inst.id %>">
          <div style="display:flex;justify-content:space-between;gap:8px;">
            <div style="min-width:0;">
              <div style="color:var(--heading);font-weight:600;font-size:11px;"><%= inst.name %></div>
              <div style="color:var(--muted);font-size:10px;overflow:hidden;text-overflow:ellipsis;"><%= inst.id %></div>
              <span class="instance-status ops-badge <%= inst.status === 'active' ? 'ops-badge-green' : inst.status === 'suspended' ? 'ops-badge-red' : 'ops-badge-gray' %>" style="margin-top:6px;">
                <%= inst.status %>
              </span>
              <div class="instance-heartbeat" style="color:var(--muted);font-size:10px;margin-top:4px;" data-heartbeat="<%= inst.last_heartbeat || '' %>">
                Last seen: <%= inst.secondsAgo != null ? inst.secondsAgo + 's ago' : 'never' %>
              </div>
            </div>
            <div class="instance-actions" style="flex-shrink:0;display:flex;flex-direction:column;gap:4px;">
              <% if (inst.status === 'active') { %>
                <button type="button" class="kill-btn ops-btn ops-btn-red" style="padding:4px 8px;" data-id="<%= inst.id %>" data-name="<%= inst.name %>">Kill</button>
              <% } else if (inst.status === 'suspended') { %>
                <button type="button" class="resume-btn ops-btn ops-btn-green" style="padding:4px 8px;" data-id="<%= inst.id %>">Resume</button>
              <% } %>
            </div>
          </div>
          <p class="instance-error" style="display:none;color:var(--red);font-size:10px;margin-top:6px;"></p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div id="kill-modal" class="ops-modal-backdrop" style="display:none;">
  <div class="ops-modal">
    <div class="ops-section-title">Kill Instance</div>
    <p id="kill-target-name" style="color:var(--muted);font-size:11px;margin-bottom:10px;"></p>
    <textarea id="kill-reason" rows="3" placeholder="Reason for suspension..." class="ops-input" style="margin-bottom:12px;"></textarea>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
      <button type="button" id="kill-cancel" class="ops-btn" style="border-color:var(--border);color:var(--muted);">Cancel</button>
      <button type="button" id="kill-confirm" class="ops-btn ops-btn-red">Confirm kill</button>
    </div>
  </div>
</div>

<script>
  const SCOUT_ONLINE = <%= scoutOnline ? 'true' : 'false' %>;
  const SCOUT_URL = '<%= scoutUrl %>';
  let activeFilter = 'all';
  let reconnectDelay = 2000;
  let es = null;
  let killTargetId = null;

  const streamEl = document.getElementById('event-stream');
  const sseDot = document.getElementById('sse-dot');
  const sseLabel = document.getElementById('sse-label');
  const offlineBanner = document.getElementById('offline-banner');
  const killModal = document.getElementById('kill-modal');

  function setDot(connected) {
    sseDot.className = 'status-dot ' + (connected ? 'live' : 'dead');
    sseLabel.textContent = connected ? 'SSE connected' : 'SSE disconnected';
    if (connected) sseLabel.style.color = 'var(--green)';
  }

  function showOfflineBanner() {
    offlineBanner.style.display = '';
    offlineBanner.className = 'ops-card';
    offlineBanner.style.marginBottom = '14px';
    offlineBanner.style.borderColor = 'rgba(212,175,55,0.3)';
    offlineBanner.style.background = 'rgba(212,175,55,0.06)';
    offlineBanner.style.color = 'var(--amber)';
    offlineBanner.style.fontSize = '11px';
    offlineBanner.innerHTML =
      'Labyrinth Scout is not running at <code style="color:var(--heading);">' + SCOUT_URL + '</code>.';
    setDot(false);
  }

  function severityBadge(sev) {
    if (sev === 'critical' || sev === 'breach') return 'ops-badge-red';
    if (sev === 'warning') return 'ops-badge-amber';
    return 'ops-badge-cyan';
  }

  function formatTime(iso) {
    try {
      const d = new Date(iso);
      return d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    } catch { return '--:--:--'; }
  }

  function appendEvent(ev) {
    const sev = (ev.severity || 'info').toLowerCase();
    if (activeFilter !== 'all' && sev !== activeFilter) return;

    const row = document.createElement('div');
    row.className = 'event-row ops-event-row';
    row.dataset.severity = sev;
    const desc = (ev.description || '').slice(0, 80);
    const inst = ev.instance_id || ev.source || '-';
    row.innerHTML =
      '<span style="color:var(--muted);flex-shrink:0;">' + formatTime(ev.created_at) + '</span>' +
      '<span class="ops-badge ' + severityBadge(sev) + '">' + sev + '</span>' +
      '<span style="color:var(--muted);">' + (ev.event_type || '') + '</span>' +
      '<span style="color:var(--text);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + desc + '</span>' +
      '<span style="color:var(--muted);flex-shrink:0;">' + inst + '</span>';
    streamEl.appendChild(row);
    row.style.backgroundColor = 'rgba(0,200,100,0.08)';
    setTimeout(function() { row.style.backgroundColor = ''; }, 1000);
    streamEl.scrollTop = streamEl.scrollHeight;
  }

  function updateStats(s) {
    if (!s) return;
    const map = { critical: 'stat-critical', warning: 'stat-warning', info: 'stat-info', breach: 'stat-breach' };
    for (const [k, id] of Object.entries(map)) {
      const el = document.getElementById(id);
      if (el && s[k] != null) el.textContent = s[k];
    }
  }

  function connectStream() {
    if (es) { es.close(); es = null; }
    es = new EventSource('/security/stream');
    es.onopen = function() { setDot(true); reconnectDelay = 2000; };
    es.onerror = function() {
      setDot(false);
      es.close();
      setTimeout(connectStream, reconnectDelay);
      reconnectDelay = Math.min(reconnectDelay * 2, 30000);
    };
    es.onmessage = function(e) {
      try {
        const msg = JSON.parse(e.data);
        if (msg.type === 'event') appendEvent(msg.data);
        if (msg.type === 'stats') updateStats(msg.data);
        if (msg.type === 'offline') showOfflineBanner();
      } catch {}
    };
  }

  document.querySelectorAll('.filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activeFilter = btn.dataset.filter || 'all';
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.querySelectorAll('.event-row').forEach(function(row) {
        const sev = row.dataset.severity || '';
        row.style.display = (activeFilter === 'all' || sev === activeFilter) ? '' : 'none';
      });
    });
  });

  document.getElementById('kill-cancel')?.addEventListener('click', function() { killModal.style.display = 'none'; });
  document.getElementById('kill-confirm')?.addEventListener('click', async function() {
    if (!killTargetId) return;
    const reason = document.getElementById('kill-reason').value.trim() || 'ops panel kill';
    const row = document.querySelector('.instance-row[data-id="' + killTargetId + '"]');
    const errEl = row?.querySelector('.instance-error');
    try {
      const r = await fetch('/security/kill/' + encodeURIComponent(killTargetId), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Kill failed');
      const statusEl = row?.querySelector('.instance-status');
      if (statusEl) { statusEl.textContent = 'suspended'; statusEl.className = 'instance-status ops-badge ops-badge-red'; }
      const actions = row?.querySelector('.instance-actions');
      if (actions) {
        actions.innerHTML = '<button type="button" class="resume-btn ops-btn ops-btn-green" style="padding:4px 8px;" data-id="' + killTargetId + '">Resume</button>';
        bindResume(actions.querySelector('.resume-btn'));
      }
      killModal.style.display = 'none';
      if (errEl) errEl.style.display = 'none';
    } catch (err) {
      if (errEl) { errEl.textContent = err.message || 'Kill failed'; errEl.style.display = ''; }
    }
  });

  function bindKill(btn) {
    btn?.addEventListener('click', function() {
      killTargetId = btn.dataset.id;
      document.getElementById('kill-target-name').textContent = btn.dataset.name || killTargetId;
      document.getElementById('kill-reason').value = '';
      killModal.style.display = 'flex';
    });
  }

  async function doResume(id, row) {
    const errEl = row?.querySelector('.instance-error');
    try {
      const r = await fetch('/security/resume/' + encodeURIComponent(id), { method: 'POST' });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Resume failed');
      const statusEl = row?.querySelector('.instance-status');
      if (statusEl) { statusEl.textContent = 'active'; statusEl.className = 'instance-status ops-badge ops-badge-green'; }
      const actions = row?.querySelector('.instance-actions');
      if (actions) {
        actions.innerHTML = '<button type="button" class="kill-btn ops-btn ops-btn-red" style="padding:4px 8px;" data-id="' + id + '" data-name="' + id + '">Kill</button>';
        bindKill(actions.querySelector('.kill-btn'));
      }
      if (errEl) errEl.style.display = 'none';
    } catch (err) {
      if (errEl) { errEl.textContent = err.message || 'Resume failed'; errEl.style.display = ''; }
    }
  }

  function bindResume(btn) {
    btn?.addEventListener('click', function() {
      const id = btn.dataset.id;
      const row = document.querySelector('.instance-row[data-id="' + id + '"]');
      doResume(id, row);
    });
  }

  document.querySelectorAll('.kill-btn').forEach(bindKill);
  document.querySelectorAll('.resume-btn').forEach(bindResume);

  setInterval(function() {
    document.querySelectorAll('.instance-heartbeat').forEach(function(el) {
      const hb = el.dataset.heartbeat;
      if (!hb) return;
      const sec = Math.max(0, Math.floor((Date.now() - new Date(hb).getTime()) / 1000));
      el.textContent = 'Last seen: ' + sec + 's ago';
    });
  }, 5000);

  if (SCOUT_ONLINE) {
    fetch('/security/events').then(function(r) { return r.ok ? r.json() : null; }).then(function(data) {
      const events = data?.events ?? data ?? [];
      if (Array.isArray(events)) {
        events.slice().reverse().forEach(appendEvent);
      }
    }).catch(function() {});
    connectStream();
  } else {
    setDot(false);
    sseLabel.textContent = 'Scout offline';
  }
</script>
</div>
