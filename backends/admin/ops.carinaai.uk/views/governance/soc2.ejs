<% title = 'SOC2' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">SOC2 Compliance</div>
    <div class="ops-page-sub">Trust Service Criteria posture across Security, Availability, Confidentiality, Processing Integrity, and Privacy.</div>
  </div>
  <div style="display:flex;gap:8px;">
    <form method="post" action="/governance/soc2/sync" style="margin:0;">
      <input type="hidden" name="refresh" value="1">
      <button type="submit" class="ops-btn" style="padding:5px 12px;">Sync evidence</button>
    </form>
    <button onclick="loadSoc2()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
  </div>
</div>

<% if (typeof query !== 'undefined' && query.synced === '1') { %>
  <div class="ops-flash ok" style="margin-bottom:12px;">
    Synced <%= query.inserted || '0' %> evidence row(s) across <%= query.controls || '0' %> Scout control(s).
  </div>
<% } %>
<% if (typeof query !== 'undefined' && query.sync_error) { %>
  <div class="ops-flash error" style="margin-bottom:12px;">
    Sync failed: <%= query.sync_error %>
  </div>
<% } %>

<div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:20px;">
  <div class="ops-card" style="text-align:center;">
    <div class="ops-card-label" style="font-size:8px;">Security</div>
    <div class="ops-card-val purple" id="soc2-cc" style="font-size:18px;">-</div>
  </div>
  <div class="ops-card" style="text-align:center;">
    <div class="ops-card-label" style="font-size:8px;">Availability</div>
    <div class="ops-card-val cyan" id="soc2-a" style="font-size:18px;">-</div>
  </div>
  <div class="ops-card" style="text-align:center;">
    <div class="ops-card-label" style="font-size:8px;">Confidentiality</div>
    <div class="ops-card-val green" id="soc2-c" style="font-size:18px;">-</div>
  </div>
  <div class="ops-card" style="text-align:center;">
    <div class="ops-card-label" style="font-size:8px;">Processing</div>
    <div class="ops-card-val amber" id="soc2-pi" style="font-size:18px;">-</div>
  </div>
  <div class="ops-card" style="text-align:center;">
    <div class="ops-card-label" style="font-size:8px;">Privacy</div>
    <div class="ops-card-val cyan" id="soc2-p" style="font-size:18px;">-</div>
  </div>
</div>

<div class="ops-card">
  <div class="ops-section-title">Control Evidence</div>
  <div id="soc2-loading" class="ops-loading">Loading SOC2 data...</div>
  <table class="ops-table" id="soc2-table" style="display:none;">
    <thead><tr><th>Control ID</th><th>Category</th><th>Description</th><th>Status</th><th>Evidence</th></tr></thead>
    <tbody id="soc2-body"></tbody>
  </table>
  <div id="soc2-empty" class="ops-empty" style="display:none;">SOC2 posture data unavailable. Configure controls in Settings.</div>
</div>

<script>
function loadSoc2() {
  fetch('/scout-api/api/compliance/score', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var compliance = d.compliance || {};
      var controls = compliance.controls || [];
      document.getElementById('soc2-cc').textContent = d.complianceScore || d.scoutScore || '-';
      document.getElementById('soc2-a').textContent = compliance.coveragePercent || '-';
      document.getElementById('soc2-c').textContent = compliance.coveredControls || '-';
      document.getElementById('soc2-pi').textContent = compliance.totalControls || '-';
      document.getElementById('soc2-p').textContent = controls.length || '-';
      document.getElementById('soc2-loading').style.display = 'none';
      if (!controls.length) { document.getElementById('soc2-empty').style.display = ''; return; }
      document.getElementById('soc2-table').style.display = '';
      document.getElementById('soc2-body').innerHTML = controls.slice(0, 100).map(function(c) {
        var clr = c.covered ? 'ops-badge-green' : 'ops-badge-amber';
        return '<tr><td style="font-family:monospace;font-size:10px;color:var(--cyan);">' + esc(c.controlId || c.id || c.control_id || '-') + '</td>' +
          '<td>' + esc(c.criteriaGroup || c.category || '-') + '</td>' +
          '<td>' + esc((c.name || c.description || c.title || '-').slice(0, 70)) + '</td>' +
          '<td><span class="ops-badge ' + clr + '">' + esc(c.covered ? 'pass' : 'pending') + '</span></td>' +
          '<td style="color:var(--muted);font-size:10px;">' + esc(c.evidenceCount != null ? String(c.evidenceCount) + ' evidence item(s)' : '-') + '</td></tr>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('soc2-loading').style.display = 'none';
      document.getElementById('soc2-empty').style.display = '';
    });
}
function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
loadSoc2();
</script>
</div>
