<% title = 'Trust Verify' %>
<div class="ops-page">
<div class="ops-page-head">
  <div>
    <div class="ops-page-title">Trust Verify</div>
    <div class="ops-page-sub">On-chain attestations, ERC-8126 verifications, and paired instance status.</div>
  </div>
  <button onclick="loadTrust()" class="ops-btn ops-btn-green" style="padding:5px 12px;">Refresh</button>
</div>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;">
  <div class="ops-card"><div class="ops-card-label">Active Instances</div><div class="ops-card-val green" id="tr-verified">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Offline / Pending</div><div class="ops-card-val amber" id="tr-pending">-</div></div>
  <div class="ops-card"><div class="ops-card-label">Trust Events (24h)</div><div class="ops-card-val red" id="tr-failed">-</div></div>
</div>

<div class="ops-card" style="margin-bottom:16px;">
  <div class="ops-section-title">Paired Instances</div>
  <div id="tr-inst-loading" class="ops-loading">Loading instance status...</div>
  <table class="ops-table" id="tr-inst-table" style="display:none;">
    <thead><tr><th>Instance</th><th>Status</th><th>Last Heartbeat</th><th>Agent ID</th></tr></thead>
    <tbody id="tr-inst-body"></tbody>
  </table>
  <div id="tr-inst-empty" class="ops-empty" style="display:none;">No paired instances.</div>
</div>

<div class="ops-card">
  <div class="ops-section-title">Trust History</div>
  <div id="tr-loading" class="ops-loading">Loading trust history...</div>
  <table class="ops-table" id="tr-table" style="display:none;">
    <thead><tr><th>When</th><th>Type</th><th>Score</th><th>Chain</th><th>Status</th></tr></thead>
    <tbody id="tr-body"></tbody>
  </table>
  <div id="tr-empty" class="ops-empty" style="display:none;">No attestations or verifications recorded yet.</div>
</div>

<script>
function loadTrust() {
  document.getElementById('tr-loading').style.display = '';
  document.getElementById('tr-table').style.display = 'none';
  document.getElementById('tr-empty').style.display = 'none';
  document.getElementById('tr-inst-loading').style.display = '';
  document.getElementById('tr-inst-table').style.display = 'none';
  document.getElementById('tr-inst-empty').style.display = 'none';

  Promise.all([
    fetch('/scout-api/api/trust/history', { credentials: 'same-origin' }).then(function(r) {
      if (!r.ok) throw new Error('history ' + r.status);
      return r.json();
    }),
    fetch('/scout-api/api/admin/status', { credentials: 'same-origin' }).then(function(r) {
      if (!r.ok) throw new Error('status ' + r.status);
      return r.json();
    }),
    fetch('/scout-api/api/public/trust', { credentials: 'same-origin' }).then(function(r) {
      return r.ok ? r.json() : null;
    }).catch(function() { return null; }),
  ]).then(function(results) {
    var history = results[0] || {};
    var status = results[1] || {};
    var trust = results[2] || {};
    var instances = status.instances || [];
    var active = instances.filter(function(i) { return i.status === 'active' || i.status === 'online'; }).length;
    var pending = instances.length - active;
    var stats = status.stats || {};
    var events24h = (stats.critical || 0) + (stats.warning || 0) + (stats.breach || 0);

    document.getElementById('tr-verified').textContent = active;
    document.getElementById('tr-pending').textContent = pending;
    document.getElementById('tr-failed').textContent = events24h;

    document.getElementById('tr-inst-loading').style.display = 'none';
    if (!instances.length) {
      document.getElementById('tr-inst-empty').style.display = '';
    } else {
      document.getElementById('tr-inst-table').style.display = '';
      document.getElementById('tr-inst-body').innerHTML = instances.map(function(i) {
        var clr = i.status === 'active' || i.status === 'online' ? 'ops-badge-green' : 'ops-badge-amber';
        var hb = i.last_heartbeat;
        return '<tr><td>' + esc(i.name || i.id || '-') + '</td>' +
          '<td><span class="ops-badge ' + clr + '">' + esc(i.status || '-') + '</span></td>' +
          '<td>' + (hb ? new Date(hb).toLocaleString() : '-') + '</td>' +
          '<td style="font-family:monospace;font-size:10px;">' + esc(history.agent_id || trust.identity && trust.identity.agent_id || '-') + '</td></tr>';
      }).join('');
    }

    var rows = [];
    (history.attestations || []).forEach(function(a) {
      rows.push({
        at: a.submitted_at,
        type: a.kind || 'attestation',
        score: a.score,
        chain: a.tx_hash ? String(a.tx_hash).slice(0, 10) + '...' : '-',
        verified: true,
      });
    });
    (history.verifications || []).forEach(function(v) {
      rows.push({
        at: v.submitted_at,
        type: v.kind || 'erc8126',
        score: v.unified_risk_score,
        chain: v.response_tx_hash ? String(v.response_tx_hash).slice(0, 10) + '...' : '-',
        verified: Boolean(v.response_tx_hash),
      });
    });
    rows.sort(function(a, b) {
      return new Date(b.at || 0).getTime() - new Date(a.at || 0).getTime();
    });

    document.getElementById('tr-loading').style.display = 'none';
    if (!rows.length) {
      document.getElementById('tr-empty').style.display = '';
      return;
    }
    document.getElementById('tr-table').style.display = '';
    document.getElementById('tr-body').innerHTML = rows.slice(0, 80).map(function(h) {
      return '<tr><td>' + (h.at ? new Date(h.at).toLocaleString() : '-') + '</td>' +
        '<td>' + esc(h.type || '-') + '</td>' +
        '<td>' + esc(h.score != null ? h.score : '-') + '</td>' +
        '<td style="font-family:monospace;font-size:10px;">' + esc(h.chain || '-') + '</td>' +
        '<td><span class="ops-badge ' + (h.verified ? 'ops-badge-green' : 'ops-badge-amber') + '">' +
        (h.verified ? 'verified' : 'pending') + '</span></td></tr>';
    }).join('');
  }).catch(function() {
    document.getElementById('tr-loading').style.display = 'none';
    document.getElementById('tr-inst-loading').style.display = 'none';
    document.getElementById('tr-empty').style.display = '';
    document.getElementById('tr-empty').textContent = 'Trust data unavailable. Check SCOUT_API_KEY in ops.';
  });
}

function esc(s) {
  return String(s).replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

loadTrust();
</script>
</div>
