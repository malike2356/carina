# Runtime image: pre-built dist + node_modules from host (run pnpm build first).
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache tini docker-cli util-linux
COPY package.json ./
COPY dist ./dist
COPY node_modules ./node_modules
COPY views ./views
COPY public ./public
EXPOSE 4001
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
