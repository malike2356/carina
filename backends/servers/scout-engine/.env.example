# Labyrinth Scout - Event Ingestion Server
# Copy to .env and fill in real values. Never commit .env.

# Server
SCOUT_PORT=4444

# Database - shares PostgreSQL with Carina
SCOUT_DATABASE_URL=postgresql://carina:carina@localhost:5432/carina

# Redis - shared with Carina, used for pub/sub event broadcasting
REDIS_URL=redis://localhost:6379

# API key required for event POST, heartbeat, and status endpoints
SCOUT_API_KEY=change-me-in-production
