# Carina Mobile environment template.
# Copy to .env and fill in real values. Never commit .env or secrets.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time; treat them as public.

# Expo push token project ID. Get it from `npx eas init` (see DEPLOY.md).
EXPO_PUBLIC_EAS_PROJECT_ID=

# Carina Cloud base URL used by the app and EAS build profiles.
EXPO_PUBLIC_CARINA_CLOUD_URL=https://app.carinaai.uk

# Labyrinth Scout public trust API for the trust tab and status chip.
EXPO_PUBLIC_SCOUT_TRUST_URL=https://console.labyrinthscout.com/api/public/trust

# Optional: Expo account owner slug (defaults to "verlox" in app.config.ts).
EXPO_OWNER=

# Path to the Firebase google-services.json for Android FCM (native builds only).
# The file itself is a credential; keep it out of git.
GOOGLE_SERVICES_JSON=
