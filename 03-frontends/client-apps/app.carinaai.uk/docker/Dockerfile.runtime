# Runtime image for VPS: expects a pre-built Next.js standalone tree in the build
# context (server.js, .next/, node_modules/, public/). Build the app before
# `docker compose build carina-cloud`, e.g. via app.carinaai.uk/deploy.sh.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4100
ENV HOSTNAME=0.0.0.0
RUN apk add --no-cache tini
COPY server.js package.json ./
COPY .next ./.next
COPY public ./public
COPY node_modules ./node_modules
EXPOSE 4100
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]
