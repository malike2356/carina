DATABASE_URL=postgresql://carina:secret@localhost:5433/carina_cloud
VAULT_SECRET=change-me-to-a-random-32-char-minimum-secret
# Used to encrypt workspace SSO client secrets and SAML certificates at rest
BETTER_AUTH_SECRET=change-me-auth-secret
BETTER_AUTH_URL=http://localhost:4100
# Public app URLs (app.carinaai.uk = full cloud; admin.hireaiva.co.uk = Aiva backend)
NEXT_PUBLIC_APP_URL=http://localhost:4100
# Marketing: https://hireaiva.co.uk/
AIVA_PRODUCT_HOST=admin.hireaiva.co.uk
AIVA_PRODUCT_HOSTS=admin.hireaiva.co.uk
AIVA_APP_URL=https://admin.hireaiva.co.uk
NEXT_PUBLIC_AIVA_APP_URL=https://admin.hireaiva.co.uk
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_CARINA_OPS_STARTER=price_
STRIPE_PRICE_CARINA_OPS_TEAM=price_
CARINA_CORE_URL=http://localhost:3000
# Internal Skills Hub URL for Docker (carina-cloud -> carina-hub). Local dev uses 127.0.0.1:3001 via __hub-proxy.
SKILLS_HUB_INTERNAL_URL=http://carina-hub:3001
# Use false on cloud unless CARINA_OPS_TOKEN is set on both app and core
CARINA_USE_CORE_PROXY=false
# Bearer token for core /api/chat/stream and /api/security/* when proxy is enabled.
# Must match CARINA_OPS_TOKEN in core.carinaai.uk/.env on the VPS.
# Production: store in /home/malike/secrets/app.carinaai.uk.env (see scripts/ensure-vps-secrets.sh).
CARINA_OPS_TOKEN=
# Shared secret for internal webhooks (research, etc.)
CARINA_INTERNAL_KEY=
# Required for password reset emails (app -> core transactional API). Must match core CARINA_INTERNAL_KEY.
# Platform Whisper keys for /api/transcribe (workspace BYOK overrides per provider).
# Cloud default: set GROQ_API_KEY so Firefox/Safari users get platform Whisper without BYOK.
# Local Whisper fallback: core Docker (CARINA_CORE_URL) and/or python3 + faster-whisper in the
# carina-cloud image (docker/Dockerfile.runtime). Models cache under CARINA_HOME/whisper-models.
# Set CARINA_LOCAL_WHISPER=false to skip the app-local Whisper subprocess probe.
GROQ_API_KEY=
OPENAI_API_KEY=
# CARINA_LOCAL_WHISPER=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional error monitoring (init only after cookie consent in browser)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
