{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carina",
  "version": "0.1.0",
  "identifier": "uk.carinaai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carina",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src http://localhost:3333 http://localhost:3000 https://api.carinaai.uk; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["carina"]
      }
    },
    "updater": {
      "active": false,
      "dialog": false,
      "endpoints": [
        "https://releases.carinaai.uk/desktop/{{target}}/{{current_version}}"
      ],
      "pubkey": ""
    },
    "sql": {
      "preload": ["sqlite:carina-cache.db"]
    }
  }
}
