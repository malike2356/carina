<% title = 'Environments' %>
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-4">Environments</h1>
<% if (saved) { %><p class="text-sm text-[#22c55e] mb-4">Saved.</p><% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <form method="post" action="/ai-platform/environments" class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4 space-y-3 h-fit">
    <h2 class="text-sm font-semibold text-white">Add environment</h2>
    <input name="name" required placeholder="Name (e.g. production)" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <input name="apiBaseUrl" placeholder="API base URL" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
    <textarea name="notes" rows="3" placeholder="Notes" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white"></textarea>
    <button type="submit" class="w-full py-2 bg-[#22c55e] text-black rounded text-sm font-medium">Create</button>
  </form>

  <div class="lg:col-span-2 bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <% if (!environments.length) { %>
      <p class="text-gray-500 text-sm">No environments defined.</p>
    <% } else { %>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
            <th class="py-2 pr-3">Name</th>
            <th class="py-2 pr-3">Slug</th>
            <th class="py-2 pr-3">API URL</th>
            <th class="py-2 pr-3">Health</th>
            <th class="py-2 pr-3">Status</th>
            <th class="py-2">Edit</th>
          </tr>
        </thead>
        <tbody>
          <% for (const e of environments) { %>
            <% const h = health[e.id] || 'skip'; %>
            <tr class="border-b border-[#2a2a2a]/50 align-top">
              <td class="py-2 pr-3 text-white"><%= e.name %></td>
              <td class="py-2 pr-3 text-gray-500 font-mono text-xs"><%= e.slug %></td>
              <td class="py-2 pr-3 text-gray-400 text-xs break-all"><%= e.apiBaseUrl || '' %></td>
              <td class="py-2 pr-3">
                <% if (h === 'ok') { %><span class="text-[#22c55e]">OK</span>
                <% } else if (h === 'fail') { %><span class="text-red-400">Fail</span>
                <% } else { %><span class="text-gray-600">N/A</span><% } %>
              </td>
              <td class="py-2 pr-3"><%= e.status %></td>
              <td class="py-2">
                <form method="post" action="/ai-platform/environments/<%= e.id %>" class="space-y-1">
                  <input name="name" value="<%= e.name %>" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-2 py-1 text-xs text-white">
                  <input name="apiBaseUrl" value="<%= e.apiBaseUrl || '' %>" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-2 py-1 text-xs text-white">
                  <select name="status" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-2 py-1 text-xs text-white">
                    <option value="active" <%= e.status === 'active' ? 'selected' : '' %>>active</option>
                    <option value="archived" <%= e.status === 'archived' ? 'selected' : '' %>>archived</option>
                  </select>
                  <button type="submit" class="text-xs text-[#06b6d4] hover:underline">Save</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
