<% title = 'Margins' %>
<%- include('../partials/ai-platform-nav') %>

<h1 class="text-2xl font-bold text-white mb-2">Margin health</h1>
<p class="text-sm text-gray-400 mb-6">
  Platform view for <%= summary.month %>. Floor: <%= Math.round(summary.floor * 100) %>% gross margin on managed credit revenue.
  Provider economics are VERLOX-internal only.
</p>

<% if (loadError) { %>
  <p class="text-sm text-red-400 mb-4"><%= loadError %></p>
<% } %>

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
  <% const cards = [
    ['Credits billed', summary.totals.creditsBilled.toLocaleString()],
    ['Provider cost', '$' + summary.totals.providerCostUsd.toFixed(4)],
    ['Credit revenue (est.)', '$' + summary.totals.creditRevenueUsd.toFixed(4)],
    ['Platform margin', summary.totals.grossMargin == null ? 'n/a' : Math.round(summary.totals.grossMargin * 100) + '%'],
  ]; %>
  <% for (const [label, val] of cards) { %>
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-3">
      <p class="text-gray-400 text-xs"><%= label %></p>
      <p class="text-lg font-bold text-white"><%= val %></p>
    </div>
  <% } %>
</div>

<section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
  <h2 class="text-sm font-semibold text-white mb-3">Per organization</h2>
  <% if (!summary.orgs.length) { %>
    <p class="text-gray-500 text-sm">No ledger activity this month.</p>
  <% } else { %>
    <table class="w-full text-xs">
      <thead>
        <tr class="text-left text-gray-500 border-b border-[#2a2a2a]">
          <th class="py-2 pr-3">Organization</th>
          <th class="py-2 pr-3">Plan</th>
          <th class="py-2 pr-3">Credits billed</th>
          <th class="py-2 pr-3">Provider cost</th>
          <th class="py-2 pr-3">Revenue (est.)</th>
          <th class="py-2 pr-3">Margin</th>
          <th class="py-2">Status</th>
        </tr>
      </thead>
      <tbody>
        <% for (const row of summary.orgs) { %>
          <tr class="border-b border-[#2a2a2a] text-gray-300">
            <td class="py-2 pr-3 text-white"><%= row.orgName %></td>
            <td class="py-2 pr-3"><%= row.planId.replace(/_/g, ' ') %></td>
            <td class="py-2 pr-3"><%= row.creditsBilled.toLocaleString() %></td>
            <td class="py-2 pr-3">$<%= row.providerCostUsd.toFixed(4) %></td>
            <td class="py-2 pr-3">$<%= row.creditRevenueUsd.toFixed(4) %></td>
            <td class="py-2 pr-3">
              <%= row.grossMargin == null ? 'n/a' : Math.round(row.grossMargin * 100) + '%' %>
            </td>
            <td class="py-2">
              <% if (row.byokCostOnly) { %>
                <span class="text-gray-400">BYOK cost only</span>
              <% } else if (row.belowFloor) { %>
                <span class="text-red-400 font-semibold">Below floor</span>
              <% } else { %>
                <span class="text-[#22c55e]">OK</span>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</section>

<p class="text-xs text-gray-500 mt-6">Data source: Carina core <code>/api/carina-ops/admin/margins</code> (ops bearer token).</p>
