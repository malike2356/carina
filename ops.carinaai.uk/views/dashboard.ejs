<% title = 'Dashboard' %>
<h1 class="text-2xl font-bold text-white mb-6">Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <p class="text-gray-400 text-sm">Total memories</p>
    <p class="text-2xl font-bold text-white mt-1"><%= stats.totalMemories %></p>
  </div>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <p class="text-gray-400 text-sm">Sessions</p>
    <p class="text-2xl font-bold text-white mt-1"><%= stats.sessions %></p>
  </div>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <p class="text-gray-400 text-sm">Skills saved</p>
    <p class="text-2xl font-bold text-white mt-1"><%= stats.skills %></p>
  </div>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <p class="text-gray-400 text-sm">Most-used skill</p>
    <p class="text-lg font-semibold text-[#22c55e] mt-1">
      <%= stats.topSkill ? stats.topSkill.name + ' (' + stats.topSkill.usage_count + ')' : 'None yet' %>
    </p>
  </div>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <p class="text-gray-400 text-sm">RAG chunks</p>
    <p class="text-2xl font-bold text-white mt-1"><%= stats.ragChunks %></p>
    <p class="text-xs text-gray-500 mt-1">Packs: <%= stats.packs.length ? stats.packs.join(', ') : 'none' %></p>
  </div>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <p class="text-gray-400 text-sm">Unread emails</p>
    <p class="text-2xl font-bold text-white mt-1"><%= stats.unreadEmails %></p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <h2 class="text-lg font-semibold text-white mb-3">Recent sessions</h2>
    <% if (!recentSessions.length) { %>
      <p class="text-gray-500 text-sm">No sessions yet.</p>
    <% } else { %>
      <ul class="space-y-2 text-sm">
        <% for (const s of recentSessions) { %>
          <li class="flex justify-between gap-2 border-b border-[#2a2a2a] pb-2">
            <a href="/memories/session/<%= s.session_id %>" class="text-[#06b6d4] hover:underline truncate">
              <%= s.session_id.slice(0, 12) %>...
            </a>
            <span class="text-gray-500 shrink-0"><%= s.message_count %> msgs</span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>
  <section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <h2 class="text-lg font-semibold text-white mb-3">Recently written skills</h2>
    <% if (!recentSkills.length) { %>
      <p class="text-gray-500 text-sm">No skills yet.</p>
    <% } else { %>
      <ul class="space-y-2 text-sm">
        <% for (const sk of recentSkills) { %>
          <li class="flex justify-between gap-2 border-b border-[#2a2a2a] pb-2">
            <a href="/skills/<%= sk.id %>" class="text-[#22c55e] hover:underline"><%= sk.name %></a>
            <span class="text-gray-500"><%= new Date(sk.created_at).toLocaleDateString() %></span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>
</div>
