<% title = tenantDisplayName(tenant) %>
<div class="mb-4">
  <a href="/tenants" class="text-sm text-[#06b6d4] hover:underline">&larr; All tenants</a>
  <div class="flex flex-wrap items-start justify-between gap-4 mt-2">
    <div>
      <h1 class="text-2xl font-bold text-white"><%= tenantDisplayName(tenant) %></h1>
      <p class="text-sm text-gray-400"><%= tenant.email %></p>
      <p class="text-xs text-gray-600 font-mono mt-1"><%= tenant.id %></p>
    </div>
    <div class="flex flex-wrap gap-2 text-xs">
      <span class="px-2 py-1 rounded bg-gray-800 text-gray-300"><%= tenant.tier %> tier</span>
      <span class="px-2 py-1 rounded <%= tenant.accessStatus === 'active' ? 'bg-green-900/50 text-green-300' : tenant.accessStatus === 'suspended' ? 'bg-red-900/50 text-red-300' : 'bg-amber-900/50 text-amber-300' %>">
        <%= tenant.accessStatus %>
      </span>
      <span class="px-2 py-1 rounded bg-[#06b6d4]/20 text-[#06b6d4]">
        <%= provisioningLabel(tenant.provisioningType, tenant.provisioningSource) %>
      </span>
    </div>
  </div>
</div>

<% if (message) { %>
  <div class="mb-4 rounded-lg border px-4 py-3 text-sm <%= messageIsError ? 'border-red-600/50 bg-red-950/30 text-red-200' : 'border-green-600/50 bg-green-950/30 text-green-200' %>">
    <%= message %>
  </div>
<% } %>

<% if (tempPassword) { %>
  <div class="mb-4 rounded-lg border border-[#06b6d4]/50 bg-cyan-950/30 px-4 py-4 text-sm">
    <p class="font-medium text-cyan-100 mb-2">Credentials (shown once)</p>
    <p class="text-cyan-200">Temporary password: <code class="font-mono bg-black/40 px-2 py-0.5 rounded"><%= tempPassword %></code></p>
    <% if (createdApiKey) { %>
      <p class="text-cyan-200 mt-2">API key: <code class="font-mono bg-black/40 px-2 py-0.5 rounded text-xs"><%= createdApiKey %></code></p>
    <% } %>
    <p class="text-xs text-cyan-300/70 mt-2">Share these securely with the tenant. They can log in at the hosted app.</p>
  </div>
<% } %>

<%- include('partials/tenant-tabs') %>

<% if (tab === 'overview') { %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4 lg:col-span-2">
      <h2 class="text-lg font-semibold text-white mb-3">Account overview</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <div><dt class="text-gray-500">Display name</dt><dd class="text-white"><%= tenant.displayName || 'n/a' %></dd></div>
        <div><dt class="text-gray-500">Company</dt><dd class="text-white"><%= tenant.companyName || 'n/a' %></dd></div>
        <div><dt class="text-gray-500">API key</dt><dd class="font-mono text-[#06b6d4]"><%= tenant.apiKeyMasked %></dd></div>
        <div><dt class="text-gray-500">Schema</dt><dd class="font-mono text-gray-300"><%= tenant.schemaName %></dd></div>
        <div><dt class="text-gray-500">Created</dt><dd><%= new Date(tenant.createdAt).toLocaleString() %></dd></div>
        <div><dt class="text-gray-500">Updated</dt><dd><%= tenant.updatedAt ? new Date(tenant.updatedAt).toLocaleString() : 'n/a' %></dd></div>
        <div><dt class="text-gray-500">Active plan</dt><dd class="text-white"><%= tenant.subscription?.plan || tenant.subscriptionPlan || 'free' %></dd></div>
        <div><dt class="text-gray-500">BYOK providers</dt><dd><%= tenant.providerCount %></dd></div>
      </dl>
    </div>
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Quick usage</h2>
      <dl class="text-sm space-y-2 text-gray-400">
        <div><dt class="text-gray-500">Messages today</dt>
          <dd class="text-white text-xl font-bold"><%= tenant.usageSummary.messagesToday %>
            <% if (tenant.usageSummary.dailyLimit) { %>
              <span class="text-sm font-normal text-gray-500">/ <%= tenant.usageSummary.dailyLimit %></span>
            <% } %>
          </dd>
        </div>
        <div><dt class="text-gray-500">Tokens this month</dt>
          <dd class="text-white"><%= tenant.usageSummary.tokensUsed.toLocaleString() %>
            <% if (tenant.usageSummary.tokenLimit) { %>
              <span class="text-gray-500">/ <%= tenant.usageSummary.tokenLimitLabel %></span>
            <% } %>
          </dd>
        </div>
        <div><dt class="text-gray-500">Skill packs</dt><dd class="text-white"><%= tenant.installedPacks.length %></dd></div>
      </dl>
    </div>
  </div>

  <form method="post" action="/tenants/<%= tenant.id %>/notes" class="mt-6 bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <h2 class="text-lg font-semibold text-white mb-3">Operator notes</h2>
    <textarea name="notes" rows="4" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-white text-sm"><%= tenant.notes || '' %></textarea>
    <button type="submit" class="mt-3 text-sm bg-[#2a2a2a] hover:bg-[#333] text-white px-3 py-1.5 rounded">Save notes</button>
  </form>

<% } else if (tab === 'subscription') { %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Current subscription</h2>
      <% if (tenant.subscription) { %>
        <dl class="text-sm space-y-2 text-gray-400">
          <div><dt class="text-gray-500">Plan</dt><dd class="text-white font-medium"><%= tenant.subscription.plan %></dd></div>
          <div><dt class="text-gray-500">Status</dt><dd><%= tenant.subscription.status %></dd></div>
          <div><dt class="text-gray-500">Provisioning</dt>
            <dd><%= provisioningLabel(tenant.provisioningType, tenant.subscription.provisioningSource) %></dd>
          </div>
          <% if (tenant.subscription.stripeSubscriptionId) { %>
            <div><dt class="text-gray-500">Stripe subscription</dt>
              <dd class="font-mono text-xs"><%= tenant.subscription.stripeSubscriptionId %></dd>
            </div>
          <% } %>
          <% if (tenant.subscription.currentPeriodStart) { %>
            <div><dt class="text-gray-500">Period</dt>
              <dd><%= new Date(tenant.subscription.currentPeriodStart).toLocaleDateString() %>
                - <%= tenant.subscription.currentPeriodEnd ? new Date(tenant.subscription.currentPeriodEnd).toLocaleDateString() : 'n/a' %>
              </dd>
            </div>
          <% } %>
          <% if (tenant.subscription.trialEndsAt) { %>
            <div><dt class="text-gray-500">Trial ends</dt>
              <dd><%= new Date(tenant.subscription.trialEndsAt).toLocaleString() %></dd>
            </div>
          <% } %>
          <% if (tenant.subscription.cancelledAt) { %>
            <div><dt class="text-gray-500">Cancelled</dt>
              <dd class="text-red-300"><%= new Date(tenant.subscription.cancelledAt).toLocaleString() %></dd>
            </div>
          <% } %>
          <% if (tenant.subscription.scoutApiKeyMasked) { %>
            <div><dt class="text-gray-500">Scout API key</dt>
              <dd class="font-mono text-xs"><%= tenant.subscription.scoutApiKeyMasked %></dd>
            </div>
          <% } %>
        </dl>
      <% } else { %>
        <p class="text-sm text-gray-500">No subscription row. Assign a plan below.</p>
      <% } %>
    </div>

    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Assign manual plan</h2>
      <p class="text-xs text-gray-500 mb-4">Changes apply immediately without Stripe checkout. Logged in audit trail.</p>
      <form method="post" action="/tenants/<%= tenant.id %>/subscription" class="space-y-3">
        <select name="plan" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
          <% for (const plan of plans) { %>
            <option value="<%= plan.id %>" <%= (tenant.subscription?.plan || tenant.subscriptionPlan) === plan.id ? 'selected' : '' %>>
              <%= plan.name %>
            </option>
          <% } %>
        </select>
        <button type="submit" class="text-sm bg-[#22c55e] hover:bg-green-400 text-black px-4 py-2 rounded font-medium">
          Update plan
        </button>
      </form>
      <% if (tenant.stripeCustomerId) { %>
        <p class="text-xs text-gray-600 mt-4">Stripe customer: <span class="font-mono"><%= tenant.stripeCustomerId %></span></p>
      <% } %>
    </div>
  </div>

<% } else if (tab === 'payments') { %>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <h2 class="text-lg font-semibold text-white mb-3">Invoices and payments</h2>
    <% if (!stripeConfigured) { %>
      <div class="rounded border border-amber-700/40 bg-amber-950/20 px-4 py-3 text-sm text-amber-200 mb-4">
        Stripe is not configured on this server. Payment records appear here when Stripe webhooks populate the database.
        Manual/direct tenants typically have no invoices.
      </div>
    <% } %>
    <% if (!tenant.invoices.length) { %>
      <p class="text-sm text-gray-500">No invoices yet.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-gray-500 border-b border-[#2a2a2a]">
            <tr>
              <th class="text-left py-2 pr-3">Date</th>
              <th class="text-left py-2 pr-3">Stripe ID</th>
              <th class="text-right py-2 pr-3">Amount</th>
              <th class="text-left py-2 pr-3">Status</th>
              <th class="text-left py-2">Failure</th>
            </tr>
          </thead>
          <tbody class="text-gray-300">
            <% for (const inv of tenant.invoices) { %>
              <tr class="border-t border-[#2a2a2a]">
                <td class="py-2 pr-3"><%= new Date(inv.createdAt).toLocaleDateString() %></td>
                <td class="py-2 pr-3 font-mono text-xs"><%= inv.stripeInvoiceId %></td>
                <td class="py-2 pr-3 text-right"><%= (inv.amount / 100).toFixed(2) %> <%= inv.currency.toUpperCase() %></td>
                <td class="py-2 pr-3"><%= inv.status %></td>
                <td class="py-2 text-red-300 text-xs"><%= inv.failureReason || '' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
    <p class="text-xs text-gray-600 mt-4">Payment data is read-only. Refunds must be processed in Stripe.</p>
  </div>

<% } else if (tab === 'usage') { %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <p class="text-gray-400 text-sm">Messages today</p>
      <p class="text-2xl font-bold text-white mt-1"><%= tenant.usageSummary.messagesToday %></p>
      <% if (tenant.usageSummary.dailyLimit) { %>
        <p class="text-xs text-gray-500"><%= tenant.usageSummary.dailyLimit - tenant.usageSummary.messagesToday %> remaining</p>
      <% } %>
    </div>
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <p class="text-gray-400 text-sm">Tokens this month</p>
      <p class="text-2xl font-bold text-white mt-1"><%= tenant.usageSummary.tokensUsed.toLocaleString() %></p>
      <% if (tenant.usageSummary.tokenLimit) { %>
        <p class="text-xs text-gray-500">Limit: <%= tenant.usageSummary.tokenLimitLabel %></p>
      <% } %>
    </div>
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <p class="text-gray-400 text-sm">Est. cost (month)</p>
      <p class="text-2xl font-bold text-white mt-1">$<%= tenant.usageSummary.costEstimate.toFixed(4) %></p>
    </div>
  </div>

  <% if (!tenant.usageSummary.hasData) { %>
    <div class="rounded-lg border border-[#2a2a2a] bg-[#1a1a1a] px-4 py-6 text-center text-sm text-gray-500">
      No usage data yet for this tenant.
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
        <h2 class="text-lg font-semibold text-white mb-3">By model (this month)</h2>
        <table class="w-full text-xs">
          <thead class="text-gray-500"><tr><th class="text-left py-1">Model</th><th class="text-right py-1">Tokens</th><th class="text-right py-1">Cost</th></tr></thead>
          <tbody class="text-gray-300">
            <% for (const row of tenant.usageSummary.byModel) { %>
              <tr class="border-t border-[#2a2a2a]"><td class="py-1 font-mono"><%= row.model %></td><td class="py-1 text-right"><%= row.tokens.toLocaleString() %></td><td class="py-1 text-right">$<%= row.cost.toFixed(4) %></td></tr>
            <% } %>
          </tbody>
        </table>
      </section>
      <section class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
        <h2 class="text-lg font-semibold text-white mb-3">Daily (last 30 days)</h2>
        <div class="max-h-64 overflow-y-auto">
          <table class="w-full text-xs">
            <thead class="text-gray-500 sticky top-0 bg-[#1a1a1a]"><tr><th class="text-left py-1">Date</th><th class="text-right py-1">Tokens</th><th class="text-right py-1">Cost</th></tr></thead>
            <tbody class="text-gray-300">
              <% for (const row of tenant.usageSummary.byDate) { %>
                <tr class="border-t border-[#2a2a2a]"><td class="py-1"><%= row.date %></td><td class="py-1 text-right"><%= row.tokens.toLocaleString() %></td><td class="py-1 text-right">$<%= row.cost.toFixed(4) %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  <% } %>

  <form method="post" action="/tenants/<%= tenant.id %>/reset-quota" class="mt-6">
    <button type="submit" class="text-sm bg-[#2a2a2a] hover:bg-[#333] text-white px-3 py-1.5 rounded">
      Reset daily message quota
    </button>
  </form>

<% } else if (tab === 'packs') { %>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <h2 class="text-lg font-semibold text-white mb-2">Tenant skill packs</h2>
    <p class="text-xs text-gray-500 mb-4">These are tenant-level entitlements, separate from operator/global packs on the Skill Packs page.</p>
    <form method="post" action="/tenants/<%= tenant.id %>/packs">
      <% if (!availablePacks.length) { %>
        <p class="text-sm text-gray-500">No packs available from Carina.</p>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-4">
          <% for (const pack of availablePacks) { %>
            <label class="flex items-start gap-2 text-sm border border-[#2a2a2a] rounded p-3 hover:bg-[#222]">
              <input type="checkbox" name="packs" value="<%= pack.name %>"
                     <%= tenant.installedPacks.includes(pack.name) ? 'checked' : '' %> class="mt-0.5">
              <span>
                <span class="text-white font-medium"><%= pack.name %></span>
                <span class="block text-xs text-gray-500"><%= pack.description %></span>
              </span>
            </label>
          <% } %>
        </div>
        <button type="submit" class="text-sm bg-[#22c55e] hover:bg-green-400 text-black px-4 py-2 rounded font-medium">
          Save pack assignment
        </button>
      <% } %>
    </form>
    <% if (tenant.installedPacks.length) { %>
      <p class="text-xs text-gray-600 mt-4">Currently installed: <%= tenant.installedPacks.join(', ') %></p>
    <% } %>
  </div>

<% } else if (tab === 'access') { %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Access status</h2>
      <form method="post" action="/tenants/<%= tenant.id %>/access" class="space-y-3">
        <select name="accessStatus" class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 text-sm text-white">
          <option value="active" <%= tenant.accessStatus === 'active' ? 'selected' : '' %>>Active</option>
          <option value="trial" <%= tenant.accessStatus === 'trial' ? 'selected' : '' %>>Trial</option>
          <option value="suspended" <%= tenant.accessStatus === 'suspended' ? 'selected' : '' %>>Suspended</option>
        </select>
        <button type="submit" class="text-sm bg-[#22c55e] hover:bg-green-400 text-black px-4 py-2 rounded font-medium">
          Update access
        </button>
      </form>
    </div>
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
      <h2 class="text-lg font-semibold text-white mb-3">Message tier</h2>
      <form method="post" action="/tenants/<%= tenant.id %>/tier" class="flex gap-2">
        <select name="tier" class="bg-[#0f0f0f] border border-[#2a2a2a] rounded px-2 py-1 text-sm text-white">
          <option value="free" <%= tenant.tier === 'free' ? 'selected' : '' %>>free</option>
          <option value="pro" <%= tenant.tier === 'pro' ? 'selected' : '' %>>pro</option>
        </select>
        <button type="submit" class="text-sm bg-[#2a2a2a] hover:bg-[#333] text-white px-3 py-1 rounded">Set tier</button>
      </form>
      <p class="text-xs text-gray-600 mt-3">Free tier enforces daily message limits. Pro tier removes the cap.</p>
    </div>
  </div>

  <section class="mt-6 bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4">
    <h2 class="text-lg font-semibold text-white mb-3">BYOK providers</h2>
    <% if (!tenant.providers.length) { %>
      <p class="text-sm text-gray-500">No provider keys configured.</p>
    <% } else { %>
      <ul class="space-y-2 text-sm">
        <% for (const p of tenant.providers) { %>
          <li class="flex justify-between border-b border-[#2a2a2a] pb-2">
            <span class="text-[#06b6d4] font-mono"><%= p.provider %></span>
            <span class="<%= p.enabled ? 'text-green-400' : 'text-gray-500' %>"><%= p.enabled ? 'active' : 'disabled' %></span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>

<% } else if (tab === 'audit') { %>
  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg overflow-hidden">
    <% if (!auditLog.length) { %>
      <p class="p-6 text-sm text-gray-500">No admin actions logged yet.</p>
    <% } else { %>
      <table class="w-full text-sm">
        <thead class="text-gray-500 border-b border-[#2a2a2a] bg-[#141414]">
          <tr>
            <th class="text-left px-4 py-3">When</th>
            <th class="text-left px-4 py-3">Action</th>
            <th class="text-left px-4 py-3">Actor</th>
            <th class="text-left px-4 py-3">Details</th>
          </tr>
        </thead>
        <tbody class="text-gray-300 divide-y divide-[#2a2a2a]">
          <% for (const entry of auditLog) { %>
            <tr>
              <td class="px-4 py-3 text-xs text-gray-500 whitespace-nowrap"><%= new Date(entry.createdAt).toLocaleString() %></td>
              <td class="px-4 py-3"><%= formatAuditAction(entry.action) %></td>
              <td class="px-4 py-3 text-xs"><%= entry.actor %></td>
              <td class="px-4 py-3 text-xs font-mono text-gray-500"><%= JSON.stringify(entry.details) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>
