<% title = 'New skill' %>
<h1 class="text-2xl font-bold text-white mb-6">Create skill</h1>
<form method="post" action="/skills/new" class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6">
  <%- include('skills/_form', { skill, toolNames, error }) %>
  <button type="submit" class="mt-6 bg-[#22c55e] text-black px-6 py-2 rounded font-medium">Save skill</button>
</form>
