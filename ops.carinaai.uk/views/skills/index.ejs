<% title = 'Skills' %>
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-white">Skills</h1>
  <a href="/skills/new" class="bg-[#22c55e] text-black px-4 py-2 rounded font-medium text-sm">New skill</a>
</div>

<div class="overflow-x-auto border border-[#2a2a2a] rounded-lg">
  <table class="w-full text-sm">
    <thead class="bg-[#1a1a1a] text-gray-400 text-left">
      <tr>
        <th class="p-3">Name</th>
        <th class="p-3">Description</th>
        <th class="p-3">Triggers</th>
        <th class="p-3">Usage</th>
        <th class="p-3">Updated</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% for (const s of skills) { %>
        <tr class="border-t border-[#2a2a2a] hover:bg-[#1a1a1a]">
          <td class="p-3"><a href="/skills/<%= s.id %>" class="text-[#22c55e] font-medium hover:underline"><%= s.name %></a></td>
          <td class="p-3 text-gray-400 max-w-xs truncate"><%= s.description %></td>
          <td class="p-3">
            <div class="flex flex-wrap gap-1">
              <% for (const kw of (s.trigger_keywords || []).slice(0, 4)) { %>
                <span class="text-xs bg-[#2a2a2a] px-2 py-0.5 rounded"><%= kw %></span>
              <% } %>
            </div>
          </td>
          <td class="p-3"><%= s.usage_count %></td>
          <td class="p-3 text-gray-500"><%= new Date(s.updated_at || s.created_at).toLocaleString() %></td>
          <td class="p-3">
            <a href="/skills/<%= s.id %>" class="text-xs text-gray-400 hover:text-white">Edit</a>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% if (!skills.length) { %><p class="text-gray-500 mt-4">No skills yet.</p><% } %>
