<% title = 'RAG Corpus' %>
<div class="flex flex-wrap justify-between items-center gap-4 mb-6">
  <h1 class="text-2xl font-bold text-white">RAG Corpus</h1>
  <button type="button" id="re-ingest" class="bg-[#22c55e] text-black px-4 py-2 rounded text-sm font-medium">
    Re-ingest
  </button>
</div>

<form method="get" class="flex flex-wrap gap-3 mb-4 text-sm">
  <select name="pack" class="bg-[#1a1a1a] border border-[#2a2a2a] rounded px-3 py-2 text-white">
    <option value="all" <%= pack === 'all' ? 'selected' : '' %>>All packs</option>
    <% for (const p of packs) { %>
      <option value="<%= p %>" <%= pack === p ? 'selected' : '' %>><%= p %></option>
    <% } %>
  </select>
  <input type="search" name="q" value="<%= search %>" placeholder="Search source..."
         class="bg-[#1a1a1a] border border-[#2a2a2a] rounded px-3 py-2 text-white">
  <button type="submit" class="bg-[#2a2a2a] text-white px-4 py-2 rounded">Filter</button>
</form>

<pre id="ingest-log" class="hidden mb-4 bg-[#0f0f0f] border border-[#2a2a2a] rounded p-3 text-xs text-gray-400 max-h-40 overflow-y-auto"></pre>

<div class="overflow-x-auto border border-[#2a2a2a] rounded-lg">
  <table class="w-full text-sm">
    <thead class="bg-[#1a1a1a] text-gray-400 text-left">
      <tr>
        <th class="p-3">Pack</th>
        <th class="p-3">Source</th>
        <th class="p-3">Preview</th>
        <th class="p-3">Embedding</th>
      </tr>
    </thead>
    <tbody>
      <% for (const c of chunks) { %>
        <tr class="border-t border-[#2a2a2a]">
          <td class="p-3"><span class="text-[#22c55e]"><%= c.pack %></span></td>
          <td class="p-3 font-mono text-xs text-gray-400 max-w-[200px] truncate"><%= c.source %></td>
          <td class="p-3 max-w-lg truncate text-gray-300"><%= c.content.slice(0, 150) %></td>
          <td class="p-3"><%= c.embedding != null ? 'yes' : 'no' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<p class="text-gray-500 text-sm mt-3">Page <%= page %> of <%= totalPages %> (<%= total %> chunks). Read-only; use Re-ingest to refresh.</p>

<script>
  document.getElementById('re-ingest')?.addEventListener('click', () => {
    const log = document.getElementById('ingest-log');
    log.classList.remove('hidden');
    log.textContent = 'Starting ingest...\n';
    const es = new EventSource('/rag/ingest');
    es.onmessage = (e) => {
      if (e.data === '[DONE]') { es.close(); return; }
      try {
        const d = JSON.parse(e.data);
        log.textContent += (d.line || '') + '\n';
        log.scrollTop = log.scrollHeight;
      } catch { log.textContent += e.data + '\n'; }
    };
    es.onerror = () => { es.close(); log.textContent += 'Stream ended.\n'; };
  });
</script>
