<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carina Admin · Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-[#0f0f0f] text-[#e0e0e0]">
  <form method="post" action="/login" class="w-full max-w-sm bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-8">
    <h1 class="text-xl font-bold text-white mb-2">Carina Admin</h1>
    <p class="text-sm text-gray-400 mb-6">VERLOX operator access</p>
    <% if (error) { %>
      <p class="text-red-400 text-sm mb-4"><%= error %></p>
    <% } %>
    <label class="block text-sm text-gray-400 mb-1" for="password">Password</label>
    <input type="password" id="password" name="password" required autofocus
           class="w-full bg-[#0f0f0f] border border-[#2a2a2a] rounded px-3 py-2 mb-4 text-white focus:border-[#22c55e] outline-none">
    <button type="submit"
            class="w-full bg-[#22c55e] text-black font-medium py-2 rounded hover:opacity-90">
      Sign in
    </button>
  </form>
</body>
</html>
