<% title = 'Memories' %>
<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold text-white">Memories</h1>
</div>

<form method="get" class="flex flex-wrap gap-3 mb-4 text-sm">
  <input type="search" name="q" value="<%= search %>" placeholder="Search content..."
         class="bg-[#1a1a1a] border border-[#2a2a2a] rounded px-3 py-2 text-white min-w-[200px]">
  <select name="role" class="bg-[#1a1a1a] border border-[#2a2a2a] rounded px-3 py-2 text-white">
    <option value="all" <%= role === 'all' ? 'selected' : '' %>>All roles</option>
    <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option>
    <option value="assistant" <%= role === 'assistant' ? 'selected' : '' %>>Assistant</option>
  </select>
  <input type="text" name="session" value="<%= sessionFilter %>" placeholder="Session ID filter..."
         class="bg-[#1a1a1a] border border-[#2a2a2a] rounded px-3 py-2 text-white min-w-[180px]">
  <button type="submit" class="bg-[#22c55e] text-black px-4 py-2 rounded font-medium">Filter</button>
</form>

<div class="overflow-x-auto border border-[#2a2a2a] rounded-lg">
  <table class="w-full text-sm">
    <thead class="bg-[#1a1a1a] text-gray-400 text-left">
      <tr>
        <th class="p-3">Time</th>
        <th class="p-3">Session</th>
        <th class="p-3">Role</th>
        <th class="p-3">Preview</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% for (const m of memories) { %>
        <tr class="border-t border-[#2a2a2a] hover:bg-[#1a1a1a]">
          <td class="p-3 text-gray-500 whitespace-nowrap"><%= new Date(m.created_at).toLocaleString() %></td>
          <td class="p-3">
            <a href="/memories/session/<%= m.session_id %>" class="text-[#06b6d4] hover:underline font-mono text-xs">
              <%= m.session_id.slice(0, 8) %>...
            </a>
          </td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-xs font-medium <%= m.role === 'user' ? 'badge-user' : 'badge-assistant' %>">
              <%= m.role %>
            </span>
          </td>
          <td class="p-3 max-w-md truncate">
            <a href="/memories/<%= m.id %>" class="hover:text-white"><%= m.content.slice(0, 120) %></a>
          </td>
          <td class="p-3">
            <form method="post" action="/memories/<%= m.id %>/delete" onsubmit="return confirm('Delete this memory?')">
              <button type="submit" class="text-red-400 hover:text-red-300 text-xs">Delete</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (!memories.length) { %>
  <p class="text-gray-500 mt-4">No memories found.</p>
<% } %>

<div class="flex gap-2 mt-4 text-sm">
  <% if (page > 1) { %>
    <a href="?page=<%= page - 1 %>&q=<%= encodeURIComponent(search) %>&role=<%= role %>&session=<%= encodeURIComponent(sessionFilter) %>"
       class="text-[#22c55e] hover:underline">Previous</a>
  <% } %>
  <span class="text-gray-500">Page <%= page %> of <%= totalPages %> (<%= total %> total)</span>
  <% if (page < totalPages) { %>
    <a href="?page=<%= page + 1 %>&q=<%= encodeURIComponent(search) %>&role=<%= role %>&session=<%= encodeURIComponent(sessionFilter) %>"
       class="text-[#22c55e] hover:underline">Next</a>
  <% } %>
</div>
