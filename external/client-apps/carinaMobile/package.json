{
  "name": "carina-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Carina mobile companion; general-purpose agent, Scout trust, Carina Cloud + self-hosted",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:preview": "eas build --profile preview --platform all",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --profile production --platform ios --latest",
    "submit:android": "eas submit --profile production --platform android --latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~52.0.0",
    "expo-application": "^6.0.2",
    "expo-camera": "^16.0.18",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.0",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-speech-recognition": "^0.2.22",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-android-widget": "^0.20.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "eas-cli": "^16.0.0",
    "typescript": ">=5.7.2 <6.0.0",
    "vitest": ">=3.0.0 <4.0.0"
  }
}
