# EAS builds are launched from the mobile app, but this repository archives the
# parent project directory. Upload only the mobile project.
*
!.easignore
!03-frontends/
!03-frontends/client-apps/
!03-frontends/client-apps/carinaMobile/
!03-frontends/client-apps/carinaMobile/**

# Mobile local dependencies and generated outputs.
03-frontends/client-apps/carinaMobile/node_modules/
03-frontends/client-apps/carinaMobile/.pnpm-store/
03-frontends/client-apps/carinaMobile/.expo/
03-frontends/client-apps/carinaMobile/dist/
03-frontends/client-apps/carinaMobile/web-build/
03-frontends/client-apps/carinaMobile/.env
03-frontends/client-apps/carinaMobile/.env*.local
03-frontends/client-apps/carinaMobile/*.apk
03-frontends/client-apps/carinaMobile/*.aab
03-frontends/client-apps/carinaMobile/*.ipa
03-frontends/client-apps/carinaMobile/*.log
03-frontends/client-apps/carinaMobile/.turbo/
03-frontends/client-apps/carinaMobile/coverage/
03-frontends/client-apps/carinaMobile/**/*.tsbuildinfo
03-frontends/client-apps/carinaMobile/android/.gradle/
03-frontends/client-apps/carinaMobile/android/.kotlin/
03-frontends/client-apps/carinaMobile/android/build/
03-frontends/client-apps/carinaMobile/android/app/build/
03-frontends/client-apps/carinaMobile/android/app/.cxx/
03-frontends/client-apps/carinaMobile/android/app/intermediates/
03-frontends/client-apps/carinaMobile/android/app/outputs/
03-frontends/client-apps/carinaMobile/ios/build/
03-frontends/client-apps/carinaMobile/ios/Pods/
03-frontends/client-apps/carinaMobile/ios/DerivedData/
03-frontends/client-apps/carinaMobile/_qa-screenshots/
