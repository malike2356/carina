# EAS builds are launched from verlox/carina/03-frontends/client-apps/carinaMobile,
# but the repository root is two levels higher. Upload only the mobile project.
*
!.easignore
!verlox/
!verlox/carina/
!verlox/carina/03-frontends/
!verlox/carina/03-frontends/client-apps/
!verlox/carina/03-frontends/client-apps/carinaMobile/
!verlox/carina/03-frontends/client-apps/carinaMobile/**

# Mobile local dependencies and generated outputs.
verlox/carina/03-frontends/client-apps/carinaMobile/node_modules/
verlox/carina/03-frontends/client-apps/carinaMobile/.pnpm-store/
verlox/carina/03-frontends/client-apps/carinaMobile/.expo/
verlox/carina/03-frontends/client-apps/carinaMobile/dist/
verlox/carina/03-frontends/client-apps/carinaMobile/web-build/
verlox/carina/03-frontends/client-apps/carinaMobile/.env
verlox/carina/03-frontends/client-apps/carinaMobile/.env*.local
verlox/carina/03-frontends/client-apps/carinaMobile/*.apk
verlox/carina/03-frontends/client-apps/carinaMobile/*.aab
verlox/carina/03-frontends/client-apps/carinaMobile/*.ipa
verlox/carina/03-frontends/client-apps/carinaMobile/*.log
verlox/carina/03-frontends/client-apps/carinaMobile/.turbo/
verlox/carina/03-frontends/client-apps/carinaMobile/coverage/
verlox/carina/03-frontends/client-apps/carinaMobile/**/*.tsbuildinfo
verlox/carina/03-frontends/client-apps/carinaMobile/android/.gradle/
verlox/carina/03-frontends/client-apps/carinaMobile/android/.kotlin/
verlox/carina/03-frontends/client-apps/carinaMobile/android/build/
verlox/carina/03-frontends/client-apps/carinaMobile/android/app/build/
verlox/carina/03-frontends/client-apps/carinaMobile/android/app/.cxx/
verlox/carina/03-frontends/client-apps/carinaMobile/android/app/intermediates/
verlox/carina/03-frontends/client-apps/carinaMobile/android/app/outputs/
verlox/carina/03-frontends/client-apps/carinaMobile/ios/build/
verlox/carina/03-frontends/client-apps/carinaMobile/ios/Pods/
verlox/carina/03-frontends/client-apps/carinaMobile/ios/DerivedData/
verlox/carina/03-frontends/client-apps/carinaMobile/_qa-screenshots/
