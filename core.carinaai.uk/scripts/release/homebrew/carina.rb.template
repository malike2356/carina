class Carina < Formula
  desc "Carina AI agent gateway and CLI"
  homepage "https://carinaai.uk"
  version "VERSION_PLACEHOLDER"
  url "https://registry.npmjs.org/@carina/core/-/core-VERSION_PLACEHOLDER.tgz"
  sha256 "SHA256_PLACEHOLDER"

  depends_on "node@22"

  def install
    system "npm", "install", "-g", "--prefix=#{libexec}", "file://#{cached_download}"
    bin.install_symlink Dir["#{libexec}/bin/*"]
  end

  test do
    system "#{bin}/carina", "--version"
  end
end
