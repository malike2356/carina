{
  "name": "@verlox/carina-core",
  "version": "0.2.0",
  "description": "Carina kernel: tools, memory, model routing, channels, and CLI (MIT). Domain packs install separately.",
  "homepage": "https://carinaai.uk",
  "bugs": {
    "url": "https://carinaai.uk/docs/"
  },
  "main": "./dist/public-api/index.js",
  "types": "./dist/src/public-api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/public-api/index.d.ts",
      "import": "./dist/public-api/index.js"
    },
    "./pack": {
      "types": "./dist/src/public-api/pack.d.ts",
      "import": "./dist/public-api/pack.js"
    },
    "./tool": {
      "types": "./dist/src/public-api/tool.d.ts",
      "import": "./dist/public-api/tool.js"
    },
    "./channel": {
      "types": "./dist/src/public-api/channel.d.ts",
      "import": "./dist/public-api/channel.js"
    },
    "./memory": {
      "types": "./dist/src/public-api/memory.d.ts",
      "import": "./dist/public-api/memory.js"
    },
    "./provider": {
      "types": "./dist/src/public-api/provider.d.ts",
      "import": "./dist/public-api/provider.js"
    },
    "./internal/*": "./dist/src/*",
    "./package.json": "./package.json",
    "./bin/carina": "./dist/bin/carina.js"
  },
  "bin": {
    "carina": "./dist/bin/carina.js"
  },
  "files": [
    "dist/",
    "templates/",
    "brain/",
    "install.sh",
    "README.cli.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/kernel/STABLE_API.md",
    "docs/kernel/COMMERCIAL_BOUNDARIES.md",
    "docs/rfc/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "node_modules/.bin/tsc && mkdir -p dist/src/security dist/src/web dist/src/skills/hub dist/src/platform && cp src/security/injection-patterns.json dist/src/security/ && cp -r src/web/pricing dist/src/web/ && cp -r src/skills/hub/public dist/src/skills/hub/ && cp src/platform/platform-knowledge.md dist/src/platform/ && node scripts/sync-public-api-dist.mjs",
    "build:workspace": "pnpm build && pnpm --filter @verlox/carina-web build && pnpm --filter @verlox/carina-scout build && pnpm --filter @verlox/pack-property build && pnpm --filter @verlox/pack-health build && pnpm --filter @verlox/pack-borehole-africa build",
    "cli": "tsx src/index.ts",
    "carina": "tsx bin/carina.ts",
    "hub": "tsx src/skills/hub/server.ts",
    "ingest": "tsx src/skills/ingestion.ts --pack property-uk",
    "test": "vitest run",
    "test:smoke": "bash scripts/smoke-install.sh",
    "test:pack-contents": "bash scripts/test-pack-contents.sh",
    "boundary-check": "tsx scripts/check-kernel-boundaries.ts",
    "test:watch": "vitest",
    "admin": "tsx ../ops.carinaai.uk/server.ts",
    "prepublishOnly": "pnpm build && pnpm boundary-check && pnpm test && pnpm test:smoke && node scripts/prune-pack-dist.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "llm",
    "carina",
    "kernel"
  ],
  "author": "VERLOX Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malike2356/carina-agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@verlox/carina-scout": "^0.2.0",
    "@verlox/carina-web": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@verlox/carina-web": {
      "optional": true
    },
    "@verlox/carina-scout": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/generative-ai": "^0.24.1",
    "@inquirer/prompts": "^7.10.1",
    "@slack/bolt": "^4.6.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.6.2",
    "croner": "^10.0.1",
    "discord.js": "^14.19.3",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "ioredis": "^5.11.0",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "^1.1.0",
    "nodemailer": "^8.0.11",
    "openai": "^6.41.0",
    "pg": "^8.21.0",
    "pgvector": "^0.3.0",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "readline-sync": "^1.4.10",
    "resend": "^6.12.4",
    "stripe": "^20.4.0",
    "tsx": "^4.22.4",
    "twilio": "^5.12.2",
    "uuid": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@verlox/pack-borehole-africa": "workspace:*",
    "@verlox/pack-health": "workspace:*",
    "@verlox/pack-property": "workspace:*",
    "@verlox/carina-scout": "workspace:*",
    "@verlox/carina-web": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.0",
    "@types/node": "^25.9.1",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
