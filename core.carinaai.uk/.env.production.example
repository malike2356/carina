# Production .env for Carina on Contabo VPS
# Copy to .env on the VPS: /opt/carina/.env
# Never commit this file with real values.

NODE_ENV=production
WEB_PORT=3000
WEB_ENABLED=true
SKIP_CLI=true
HOSTED_MODE=true

# --- LLM Providers ---
DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
# Primary: Gemini text-embedding-004 (cheapest)
GEMINI_API_KEY=
# OpenAI key above is used for text-embedding-3-small (1536 dims)
# If OpenAI quota is an issue, switch to Gemini embeddings (Phase 2)

# --- Database ---
DATABASE_URL=postgresql://carina:CHANGE_ME@postgres:5432/carina

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Search ---
BRAVE_SEARCH_API_KEY=

# --- Email (Resend - already verified for carinaai.uk) ---
RESEND_API_KEY=

# --- Stripe (hosted billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SCOUT_STANDARD=
STRIPE_PRICE_CARINA_BUNDLE=
STRIPE_PRICE_ENTERPRISE=

# --- Auth (hosted mode) ---
JWT_SECRET=GENERATE_RANDOM_64_CHARS_HERE

# --- Property APIs ---
PROPERTY_DATA_API_KEY=
LAND_REGISTRY_API_KEY=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://app.carinaai.uk/webhooks/telegram

# --- WhatsApp (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Skills Hub ---
SKILLS_HUB_DATABASE_URL=postgresql://carina:CHANGE_ME@postgres:5432/carina_skills_hub
SKILLS_HUB_PORT=3001
SKILLS_HUB_PUBLISH_KEY=GENERATE_RANDOM_32_CHARS_HERE

# --- CORS ---
CORS_ORIGIN=https://app.carinaai.uk

# --- Skill auto-write ---
SKILL_AUTO_WRITE=true
