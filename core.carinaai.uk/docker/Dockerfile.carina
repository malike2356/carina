FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY package.json pnpm-lock.yaml* .npmrc* pnpm-workspace.yaml ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile 2>/dev/null || pnpm install
RUN pnpm rebuild better-sqlite3
COPY tsconfig.json ./
COPY scripts ./scripts
COPY plugins ./plugins
COPY src ./src
COPY bin ./bin
COPY locales ./locales
RUN pnpm build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache tini wget curl
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/packages/web/package.json ./packages/web/package.json
COPY --from=build /app/packages/web/dist ./packages/web/dist
COPY --from=build /app/packages/web/assets ./packages/web/assets
COPY --from=build /app/packages/web/public ./packages/web/public
COPY --from=build /app/locales ./locales
COPY src/skills/packs ./src/skills/packs
COPY brain ./brain
RUN ln -sfn ../brain dist/brain
RUN mkdir -p node_modules/@verlox \
  && ln -sfn ../.. node_modules/@verlox/carina-core \
  && ln -sfn ../../packages/web node_modules/@verlox/carina-web
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY docker/healthcheck.sh /usr/local/bin/carina-healthcheck
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /usr/local/bin/carina-healthcheck
ENV CARINA_HOME=/data/.carina
ENV CARINA_LOCALES_DIR=/app/locales
ENV WEB_ENABLED=true
ENV WEB_PORT=3000
VOLUME ["/data"]
EXPOSE 3000 3001
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD /usr/local/bin/carina-healthcheck
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/src/index.js"]
