CARINA_USE_CORE_PROXY=false
# Bearer token for core /api/chat/stream and /api/security/* when proxy is enabled.
# Must match CARINA_OPS_TOKEN in core.carinaai.uk/.env on the VPS.
# Production: store in /home/malike/secrets/app.carinaai.uk.env (see scripts/ensure-vps-secrets.sh).
CARINA_OPS_TOKEN=
# Shared secret for internal webhooks (research, etc.)
CARINA_INTERNAL_KEY=
# Platform Whisper keys for /api/transcribe (workspace BYOK overrides per provider)
