{
  "manifest_version": 3,
  "name": "Propreneur Capture",
  "version": "2.0.0",
  "description": "Capture property listings from Rightmove, Zoopla, OnTheMarket, OpenRent, and SpareRoom into your Propreneur workspace.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.rightmove.co.uk/*",
    "https://www.zoopla.co.uk/*",
    "https://www.onthemarket.com/*",
    "https://www.openrent.co.uk/*",
    "https://www.spareroom.co.uk/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Capture to Propreneur",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
