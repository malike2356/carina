# Propreneur v2 — copy to .env and fill in. Never commit .env.
# See brain/knowledge/63-config-php-inventory.md and CLAUDE.md for database setup.
#
# If Postgres errors with "remaining connection slots are reserved for SUPERUSER":
# many hung `php artisan test` / `tinker` processes each hold a DB connection. Run:
#   pkill -f 'php artisan test'; pkill -f 'php artisan tinker --execute'
# (keep `php artisan serve`), or restart PostgreSQL. Then raise max_connections if needed.

APP_NAME=Propreneur
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://propreneur.test:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default connection (tenant context after resolution; tests force propreneur_testing in phpunit.xml)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=propreneur_central
DB_USERNAME=propreneur
DB_PASSWORD=local_dev_password

CENTRAL_DB_DRIVER=pgsql
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=5432
CENTRAL_DB_DATABASE=propreneur_central
CENTRAL_DB_USERNAME=propreneur
CENTRAL_DB_PASSWORD=local_dev_password

TENANCY_DB_DRIVER=pgsql
TENANCY_MAINTENANCE_DB=propreneur_central

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Sessions: "database" matches production but adds session read/write on Postgres. If you see
# FATAL: remaining connection slots are reserved for roles with the SUPERUSER attribute,
# use "file" (or "redis") for local dev, restart php artisan serve, and free Postgres slots
# (stop extra queue workers / Horizon / duplicate servers; or raise max_connections).
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=redis

# Optional: stale threshold (seconds) for job scheduler admin heartbeat
# PLATFORM_SCHEDULER_HEARTBEAT_STALE_SECONDS=180

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Inbound CRM email webhook (POST /webhooks/email/inbound on each tenant host)
# Mailgun: webhook signing key from Mailgun Settings > Webhooks (falls back to MAILGUN_SECRET)
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_SECRET=
# Postmark: server token for X-Postmark-Signature verification (falls back to POSTMARK_API_KEY)
POSTMARK_SERVER_TOKEN=
# Optional shared secret header X-Propreneur-Inbound-Secret for other providers
INBOUND_EMAIL_WEBHOOK_SECRET=
# INBOUND_EMAIL_WEBHOOK_REQUIRE_SIGNATURE=true

# Tenancy (stancl)
TENANT_BASE_DOMAIN=propreneur.test

# Meilisearch / Scout (if used)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# AI — chat priority (first with a key wins for chat)
AI_DEFAULT_PROVIDER=anthropic
AI_PRIORITY=anthropic,groq,deepseek,openrouter,openai,google
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_PROVIDER_PRIORITY=openai,openrouter,groq,google

# Carina web UI voice (Whisper-compatible): try openai then groq
AI_SPEECH_TRANSCRIPTION_PRIORITY=openai,groq
AI_SPEECH_OPENAI_MODEL=whisper-1
AI_SPEECH_GROQ_MODEL=whisper-large-v3-turbo
AI_SPEECH_TRANSCRIPTION_TIMEOUT=120

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_AI_MODEL=gemini-2.0-flash

# Tavily (optional live web for Carina)
CARINA_TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Carina on-demand PropertyData.co.uk (parallel lite bundle per turn when the question matches UK market research)
CARINA_PROPERTYDATA_ENABLED=true
CARINA_PROPERTYDATA_TIMEOUT=8
CARINA_PROPERTYDATA_MAX_POSTCODES=2

# Carina RAG
CARINA_RAG_CHUNK_SIZE=1000
CARINA_RAG_CHUNK_OVERLAP=200
CARINA_RAG_MAX_DOCUMENTS=200
CARINA_CONVERSATION_RETENTION_DAYS=90
CARINA_RATE_TENANT_HOURLY=500
CARINA_RATE_TENANT_DAILY=5000
CARINA_RATE_USER_HOURLY=100
CARINA_RATE_USER_DAILY=1000

# Carina platform knowledge training (admin /admin/carina/knowledge-training)
CARINA_MASTERBRAIN_PATH=
# Optional absolute paths when brain trees live outside the Laravel root (defaults: brain/knowledge, brain/masterbrain, brain/prompts under base_path). See config/paths.php.
BRAIN_KNOWLEDGE_PATH=
BRAIN_MASTERBRAIN_PATH=
BRAIN_PROMPTS_PATH=
CARINA_TRAINING_MIME_STRICT=true
CARINA_TRAINING_CLAMSCAN_BINARY=
CARINA_TRAINING_PDF_FALLBACK=true
CARINA_TRAINING_OCR=true
CARINA_TRAINING_PDFTOTEXT_BINARY=
CARINA_TRAINING_PDFTOPPM_BINARY=
CARINA_TRAINING_TESSERACT_BINARY=
CARINA_TRAINING_TEMPLATE_TENANT_ID=
CARINA_TRAINING_ZIP_MAX_UNCOMPRESSED=25000000
CARINA_TRAINING_ZIP_MAX_ENTRIES=40

# Stripe billing (see config/billing.php for STRIPE_PRICE_* keys)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PUBLISHABLE_KEY=
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=

# Listing import — free URL parse vs paid partner normaliser (see config/listings.php)
LISTINGS_IMPORT_DRIVER=url
LISTINGS_PARTNER_ENABLED=false
LISTINGS_PARTNER_BASE_URL=
LISTINGS_PARTNER_TOKEN=
LISTINGS_PARTNER_AUTH_SCHEME=bearer
LISTINGS_PARTNER_API_KEY_HEADER=X-Api-Key
LISTINGS_PARTNER_IMPORT_PATH=/listings/import
LISTINGS_PARTNER_URL_FIELD=url
LISTINGS_CHAIN_TRY_PARTNER_FIRST=true

# Opt-in portal listing automation (watches under Deal Engine sourcing; suggested deals)
LISTING_AUTOMATION_ENABLED=true
LISTING_AUTOMATION_SCHEDULER_ENABLED=true
LISTING_AUTOMATION_MAX_URLS_PER_WATCH=8
LISTING_AUTOMATION_DELAY_MICROSECONDS=750000
LISTING_AUTOMATION_SEARCH_TIMEOUT=20

# Licensed listing feeds — batch poll (set LISTINGS_FEED_POLL_ENABLED when you have a contract + adapter URL)
LISTINGS_FEED_POLL_ENABLED=false
LISTINGS_FEED_BATCH_POLL_URL=
LISTINGS_FEED_BATCH_POLL_METHOD=GET
LISTINGS_FEED_BATCH_BEARER_TOKEN=
LISTINGS_FEED_BATCH_TIMEOUT=120
LISTINGS_FEED_IMAGE_HANDLING=licensed_cdn
LISTINGS_FEED_DEDUPE_STRATEGY=portal_ids
LISTINGS_FEED_MAX_ITEMS_PER_RUN=200
LISTINGS_FEED_DEFAULT_ACTOR_USER_ID=
LISTINGS_FEED_DEFAULT_STRATEGY=btl
LISTINGS_FEED_DEAL_STATUS=draft

# Commercial programme credentials (enable flags only after signing; never commit secrets)
LISTINGS_RIGHTMOVE_RTDF_ENABLED=false
LISTINGS_RIGHTMOVE_RTDF_BASE_URL=
LISTINGS_RIGHTMOVE_RTDF_CLIENT_ID=
LISTINGS_RIGHTMOVE_RTDF_CLIENT_SECRET=
LISTINGS_RIGHTMOVE_RTDF_TENANT_SCOPE=
LISTINGS_ZOOPLA_PARTNER_ENABLED=false
LISTINGS_ZOOPLA_PARTNER_BASE_URL=
LISTINGS_ZOOPLA_PARTNER_API_KEY=
LISTINGS_OTM_PARTNER_ENABLED=false
LISTINGS_OTM_PARTNER_BASE_URL=
LISTINGS_OTM_PARTNER_CLIENT_ID=
LISTINGS_OTM_PARTNER_CLIENT_SECRET=
LISTINGS_AGGREGATOR_ADAPTER_ENABLED=false
LISTINGS_AGGREGATOR_ADAPTER_BASE_URL=
LISTINGS_AGGREGATOR_ADAPTER_TOKEN=
LISTINGS_FEED_WEBHOOK_ENABLED=false
LISTINGS_FEED_WEBHOOK_SIGNING_SECRET=

# Integrations / third parties (optional)
# PropertyData: optional fallback when no key is stored in Admin Platform keys Integrations tab (platform_settings).
# PROPERTYDATA_PUBLIC_URL=  # optional; default https://www.propertydata.co.uk — used for Manual search + Market intelligence hub browser links
PROPERTYDATA_API_KEY=
# PROPERTY_DATA_API_KEY=  # optional legacy alias; merged with PROPERTYDATA_API_KEY in config
PROPERTY_DATA_HTTP_FORCE_IPV4=false
# MHCLG domestic EPC open data (epc.opendatacommunities.org). Same values as Platform keys Integrations tab if you use the UI.
# HTTP Basic: Base64(your_account_email:api_key_from_welcome_email)
EPC_OPENDATA_AUTH_EMAIL=
EPC_OPENDATA_API_KEY=
# EPC_OPENDATA_BASE_URL=https://epc.opendatacommunities.org
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Backup / Slack (optional)
BACKUP_SLACK_WEBHOOK_URL=

# Horizon
HORIZON_PATH=horizon

# Dev account password (used by DevAccountSeeder and scripts/migrate_tenant.php)
DEV_ACCOUNT_PASSWORD=

# Lead funnel ad platforms (Meta, LinkedIn, TikTok)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
