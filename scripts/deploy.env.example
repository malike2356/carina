# Copy to deploy.env (gitignored) and adjust. Never commit deploy.env.
#
#   cp scripts/deploy.env.example scripts/deploy.env
#
# Run deploy-to-production.sh on LOCAL DEV (tsalach), NOT on the VPS.
#
# Hosts:
#   tsalach     = local dev (git + this script)
#   aman        = Contabo VPS MIS  → DEPLOY_SSH / DEPLOY_REMOTE_ROOT below
#   HostGator   = marketing only  → ~/propreneur.co.uk (git pull; see propreneur.co.uk/README.md)

# SSH target (user@host or host with SSH config alias)
DEPLOY_SSH="malike@80.190.81.208"

# Laravel root on the server (no trailing slash)
DEPLOY_REMOTE_ROOT="/www/wwwroot/propreneur-v2"

# Branch to pull locally before rsync
DEPLOY_GIT_BRANCH="main"

# PHP on the server (aaPanel 8.3)
DEPLOY_REMOTE_PHP="/www/server/php/83/bin/php"

# Composer on the server (aaPanel wrapper recommended)
DEPLOY_REMOTE_COMPOSER="/usr/local/bin/composer"

# Unix user that owns runtime files (aaPanel / PHP-FPM)
DEPLOY_REMOTE_USER="www"

# Supervisor program names (from /etc/supervisor/conf.d/)
DEPLOY_SUPERVISOR_HORIZON="propreneur-horizon"
DEPLOY_SUPERVISOR_SCHEDULER="propreneur-scheduler"

# Set to 1 to run `npm ci && npm run build` on the server after rsync
# (use when you do not pass --build-assets locally)
DEPLOY_BUILD_ON_SERVER="0"
