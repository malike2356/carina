{
  "name": "labyrinth-scout",
  "version": "0.1.0",
  "description": "Security control plane for Carina AI agent instances",
  "type": "module",
  "bin": {
    "scout": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && mkdir -p dist/security dist/deception && cp src/security/injection-patterns.json dist/security/ && cp src/deception/decoy-tokens.json dist/deception/",
    "docs:build": "vitepress build docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "tsx scripts/doctor.ts",
    "trust:register": "tsx scripts/register-trust-identity.ts",
    "trust:register:mainnet": "tsx scripts/register-trust-identity-mainnet.ts",
    "trust:attest": "tsx scripts/submit-trust-attestation.ts",
    "trust:verify": "tsx scripts/submit-trust-verification.ts"
  },
  "dependencies": {
    "@open-agent-economy/trust-sdk": "^1.2.0",
    "@verlox/carina-transport": "file:../core.carinaai.uk/packages/transport",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-session": "^1.18.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "uuid": "^14.0.0",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8",
    "vue": "^3.5.38"
  },
  "overrides": {
    "ws": "8.21.0",
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
